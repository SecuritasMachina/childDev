@page "/insights"
@inject AppDbContext Db
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor
@inject WebAnalyticsService Analytics

<PageTitle>My Insights – ChildDev</PageTitle>

@if (AccountGuid is null)
{
    Nav.NavigateTo("/login");
    return;
}

<MudText Typo="Typo.h5" Class="mb-4">
    <MudIcon Icon="@Icons.Material.Filled.BarChart" Class="mr-2" />
    My Activity Insights
</MudText>

@* Domain achievement stats *@
<MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-2" Style="text-transform:uppercase;letter-spacing:1px;">
    Achievements
</MudText>
<MudGrid Class="mb-6">
    <MudItem xs="6" sm="3">
        <MudPaper Elevation="2" Class="pa-4 text-center stat-card-goals" Style="border-radius:12px;">
            <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Warning" Style="font-size:2rem;" />
            <MudText Typo="Typo.h4" Class="mt-1">@GoalsCompletedAllTime</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Goal@(GoalsCompletedAllTime == 1 ? "" : "s") Completed</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Elevation="2" Class="pa-4 text-center stat-card-todos" Style="border-radius:12px;">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Style="font-size:2rem;" />
            <MudText Typo="Typo.h4" Class="mt-1">@TodosCompletedAllTime</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Todo@(TodosCompletedAllTime == 1 ? "" : "s") Done</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Elevation="2" Class="pa-4 text-center stat-card-journal" Style="border-radius:12px;">
            <MudIcon Icon="@Icons.Material.Filled.Book" Color="Color.Info" Style="font-size:2rem;" />
            <MudText Typo="Typo.h4" Class="mt-1">@JournalTotal</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Journal Entries</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Elevation="2" Class="pa-4 text-center" Style="border-radius:12px;border-left:4px solid #7986CB;">
            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Primary" Style="font-size:2rem;" />
            <MudText Typo="Typo.h4" Class="mt-1">@GoalProgressTotal</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Progress Notes</MudText>
            @if (GoalProgressTotal >= 5)
            {
                var insightLevel = GoalProgressTotal >= 50 ? "🌟 Legendary" : GoalProgressTotal >= 25 ? "🏆 Champion" : GoalProgressTotal >= 10 ? "⭐ Strong" : GoalProgressTotal >= 5 ? "🚀 Momentum" : "⚡ Getting Started";
                <MudText Typo="Typo.caption" Color="Color.Warning">@insightLevel pace!</MudText>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@if (GoalsTotalAllTime > 0)
{
    var completionPct = GoalsTotalAllTime == 0 ? 0 : (int)(GoalsCompletedAllTime * 100.0 / GoalsTotalAllTime);
    var rateColor = completionPct >= 75 ? Color.Success : completionPct >= 40 ? Color.Warning : Color.Default;
    <MudPaper Elevation="1" Class="pa-4 mb-4" Style="border-radius:12px;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.PieChart" Color="@rateColor" Size="Size.Small" Class="mr-1" />
            <MudText Typo="Typo.body2" Style="flex:1">Goal Completion Rate</MudText>
            <MudText Typo="Typo.body2" Style="font-weight:600;">@GoalsCompletedAllTime of @GoalsTotalAllTime</MudText>
            <MudChip T="string" Size="Size.Small" Color="@rateColor" Class="ml-2">@completionPct%</MudChip>
        </MudStack>
        <MudProgressLinear Value="@completionPct" Color="@rateColor" Rounded="true" Size="Size.Medium" />
    </MudPaper>
}

@if (!string.IsNullOrWhiteSpace(TopMood))
{
    <MudPaper Elevation="1" Class="pa-3 mb-6 d-flex align-items-center" Style="border-radius:12px;gap:12px;">
        <MudIcon Icon="@Icons.Material.Filled.Mood" Color="Color.Secondary" />
        <MudText Typo="Typo.body2">Most journaled mood: <strong>@TopMood</strong> (@TopMoodCount @(TopMoodCount == 1 ? "time" : "times"))</MudText>
    </MudPaper>
}

@if (!string.IsNullOrWhiteSpace(TopGoalName))
{
    <MudPaper Elevation="2" Class="pa-4 mb-6"
              Style="border-radius:16px;border:2px solid var(--mud-palette-warning);background:linear-gradient(135deg,rgba(255,193,7,.07) 0%,rgba(255,255,255,0) 100%);">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-1">
            <MudText Typo="Typo.h4" Style="line-height:1">🏆</MudText>
            <MudText Typo="Typo.overline" Color="Color.Warning" Style="font-weight:700;letter-spacing:1.5px;">Most Worked Goal</MudText>
        </MudStack>
        <MudText Typo="Typo.h6" Class="mb-1">@TopGoalName</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            @TopGoalNoteCount progress note@(TopGoalNoteCount == 1 ? "" : "s") — your hardest-worked goal!
        </MudText>
        <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                   Href="@($"/goals/{TopGoalGuid}")"
                   StartIcon="@Icons.Material.Filled.TrendingUp">View Progress</MudButton>
    </MudPaper>
}

@* Month-over-month trends *@
<MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-2" Style="text-transform:uppercase;letter-spacing:1px;">
    This Month vs Last Month
</MudText>
<MudPaper Elevation="1" Class="pa-0 mb-6" Style="border-radius:12px;overflow:hidden;">
    @{
        static (Color color, string icon, string label) Trend(int curr, int prev)
        {
            if (prev == 0 && curr == 0) return (Color.Default, "→", "—");
            if (prev == 0) return (Color.Success, "↑", $"+{curr} new");
            var pct = (int)((curr - prev) * 100.0 / prev);
            return pct > 0
                ? (Color.Success, "↑", $"+{pct}%")
                : pct < 0
                    ? (Color.Error, "↓", $"{pct}%")
                    : (Color.Default, "→", "same");
        }
        var (gColor, gIcon, gLabel) = Trend(ThisMonthGoals, LastMonthGoals);
        var (tColor, tIcon, tLabel) = Trend(ThisMonthTodos, LastMonthTodos);
        var (jColor, jIcon, jLabel) = Trend(ThisMonthJournal, LastMonthJournal);
    }
    <MudStack Spacing="0">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="pa-3" Style="border-bottom:1px solid rgba(0,0,0,.06);">
            <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Warning" Size="Size.Small" Class="mr-2" />
            <MudText Typo="Typo.body2" Style="flex:1">Goals completed</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mr-4">@LastMonthGoals last mo.</MudText>
            <MudText Typo="Typo.body2" Style="font-weight:600;min-width:28px;text-align:right">@ThisMonthGoals</MudText>
            <MudText Typo="Typo.caption" Color="@gColor" Style="min-width:52px;text-align:right">@gIcon @gLabel</MudText>
        </MudStack>
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="pa-3" Style="border-bottom:1px solid rgba(0,0,0,.06);">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" Class="mr-2" />
            <MudText Typo="Typo.body2" Style="flex:1">Todos completed</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mr-4">@LastMonthTodos last mo.</MudText>
            <MudText Typo="Typo.body2" Style="font-weight:600;min-width:28px;text-align:right">@ThisMonthTodos</MudText>
            <MudText Typo="Typo.caption" Color="@tColor" Style="min-width:52px;text-align:right">@tIcon @tLabel</MudText>
        </MudStack>
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="pa-3">
            <MudIcon Icon="@Icons.Material.Filled.Book" Color="Color.Info" Size="Size.Small" Class="mr-2" />
            <MudText Typo="Typo.body2" Style="flex:1">Journal entries</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mr-4">@LastMonthJournal last mo.</MudText>
            <MudText Typo="Typo.body2" Style="font-weight:600;min-width:28px;text-align:right">@ThisMonthJournal</MudText>
            <MudText Typo="Typo.caption" Color="@jColor" Style="min-width:52px;text-align:right">@jIcon @jLabel</MudText>
        </MudStack>
    </MudStack>
</MudPaper>

<MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-2 mt-2" Style="text-transform:uppercase;letter-spacing:1px;">
    Usage Activity
</MudText>

@{
    var weekTrend = TotalLastWeek == 0 ? 0 : (int)((TotalThisWeek - TotalLastWeek) * 100.0 / TotalLastWeek);
    var trendColor = weekTrend >= 0 ? Color.Success : Color.Error;
    var trendIcon = weekTrend >= 0 ? Icons.Material.Filled.TrendingUp : Icons.Material.Filled.TrendingDown;
    var trendText = TotalLastWeek == 0
        ? "no prior week"
        : weekTrend == 0 ? "same as last week" : $"{Math.Abs(weekTrend)}% vs last week";
}
<MudGrid Class="mb-6">
    <MudItem xs="12" sm="3">
        <MudPaper Elevation="2" Class="pa-4 text-center">
            <MudIcon Icon="@Icons.Material.Filled.TouchApp" Color="Color.Primary" Style="font-size:2rem;" />
            <MudText Typo="Typo.h4" Class="mt-1">@TotalLast30</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Actions (30 days)</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudPaper Elevation="2" Class="pa-4 text-center">
            <MudIcon Icon="@trendIcon" Color="@trendColor" Style="font-size:2rem;" />
            <MudText Typo="Typo.h4" Class="mt-1">@TotalThisWeek</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">This week</MudText>
            <MudText Typo="Typo.caption" Color="@trendColor">@trendText</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudPaper Elevation="2" Class="pa-4 text-center">
            <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Color="Color.Info" Style="font-size:2rem;" />
            <MudText Typo="Typo.h4" Class="mt-1">@ActiveDaysLast30</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Active days (30)</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudPaper Elevation="2" Class="pa-4 text-center">
            <MudIcon Icon="@Icons.Material.Filled.LocalFireDepartment"
                     Color="@(CurrentStreak >= 7 ? Color.Error : CurrentStreak >= 3 ? Color.Warning : Color.Default)"
                     Style="font-size:2rem;" />
            <MudText Typo="Typo.h4" Class="mt-1">@CurrentStreak</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Day streak</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

@if (DailyChartSeries.Count > 0)
{
    <MudPaper Elevation="1" Class="pa-4 mb-6">
        <MudText Typo="Typo.subtitle2" Class="mb-3">Daily Activity — Last 14 Days</MudText>
        <MudChart ChartType="ChartType.Bar"
                  ChartSeries="@DailyChartSeries"
                  XAxisLabels="@DailyChartLabels"
                  Width="100%" Height="160px"
                  ChartOptions="@(new ChartOptions { YAxisTicks = 1 })" />
    </MudPaper>
}

<MudGrid>
    <MudItem xs="12" sm="6">
        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.subtitle2" Class="mb-3">Top Features Used (last 30 days)</MudText>
            @foreach (var item in TopEvents)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.body2" Style="flex:1">@FormatEventName(item.Key)</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">@item.Value</MudChip>
                </MudStack>
            }
            @if (!TopEvents.Any())
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No feature usage tracked yet.</MudText>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.subtitle2" Class="mb-3">Pages Visited (last 30 days)</MudText>
            @foreach (var item in PageViews)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.body2" Style="flex:1">@FormatPageName(item.Key)</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Info">@item.Value</MudChip>
                </MudStack>
            }
            @if (!PageViews.Any())
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No page views tracked yet.</MudText>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private string? AccountGuid;
    private int TotalLast30;
    private int TotalThisWeek;
    private int TotalLastWeek;
    private int ActiveDaysLast30;
    private int CurrentStreak;
    private List<ChartSeries> DailyChartSeries = [];
    private string[] DailyChartLabels = [];
    private Dictionary<string, int> TopEvents = new();
    private Dictionary<string, int> PageViews = new();

    // Domain entity stats
    private int GoalsCompletedAllTime;
    private int GoalsTotalAllTime;
    private int TodosCompletedAllTime;
    private int JournalTotal;
    private int GoalProgressTotal;
    private string? TopMood;
    private int TopMoodCount;
    private string? TopGoalName;
    private string? TopGoalGuid;
    private int TopGoalNoteCount;

    // Month-over-month trends
    private int ThisMonthGoals;
    private int LastMonthGoals;
    private int ThisMonthTodos;
    private int LastMonthTodos;
    private int ThisMonthJournal;
    private int LastMonthJournal;

    protected override async Task OnInitializedAsync()
    {
        AccountGuid = HttpContextAccessor.HttpContext?.Session.GetString("AccountGuid");
        if (AccountGuid is null) return;
        await Task.WhenAll(LoadInsights(), LoadDomainStats());
        await Analytics.TrackAsync("page_view", AccountGuid, "insights");
    }

    private async Task LoadDomainStats()
    {
        GoalsCompletedAllTime = await Db.Goals
            .CountAsync(g => g.AccountFk == AccountGuid && g.DeletedAt == null && g.CompletionDate != null);
        GoalsTotalAllTime = await Db.Goals
            .CountAsync(g => g.AccountFk == AccountGuid && g.DeletedAt == null);

        TodosCompletedAllTime = await Db.Todos
            .CountAsync(t => t.AccountFk == AccountGuid && t.DeletedAt == null && t.CompletedAt != null);

        JournalTotal = await Db.Journals
            .CountAsync(j => j.AccountFk == AccountGuid && j.DeletedAt == null);

        GoalProgressTotal = await Db.GoalProgresses
            .CountAsync(p => p.AccountFk == AccountGuid && p.DeletedAt == null);

        var moods = await Db.Journals
            .Where(j => j.AccountFk == AccountGuid && j.DeletedAt == null && j.Mood != null && j.Mood != "")
            .GroupBy(j => j.Mood!)
            .Select(g => new { Mood = g.Key, Count = g.Count() })
            .OrderByDescending(x => x.Count)
            .FirstOrDefaultAsync();
        if (moods is not null)
        {
            TopMood = moods.Mood;
            TopMoodCount = moods.Count;
        }

        // Goal with the most progress notes ("Top Goal" spotlight)
        var topGoalProgress = await Db.GoalProgresses
            .Where(p => p.AccountFk == AccountGuid && p.DeletedAt == null)
            .GroupBy(p => p.GoalFk)
            .Select(g => new { GoalFk = g.Key, Count = g.Count() })
            .OrderByDescending(x => x.Count)
            .FirstOrDefaultAsync();
        if (topGoalProgress is not null && topGoalProgress.Count > 0)
        {
            var topGoal = await Db.Goals.FirstOrDefaultAsync(g => g.Guid == topGoalProgress.GoalFk && g.DeletedAt == null);
            if (topGoal is not null)
            {
                TopGoalName = topGoal.GoalText;
                TopGoalGuid = topGoal.Guid;
                TopGoalNoteCount = topGoalProgress.Count;
            }
        }

        // Month-over-month windows (calendar months, local time)
        var today = DateTimeOffset.Now.LocalDateTime;
        var thisMonthStart = new DateTimeOffset(new DateTime(today.Year, today.Month, 1), TimeZoneInfo.Local.GetUtcOffset(DateTime.Now)).ToUnixTimeMilliseconds();
        var lastMonthStart = new DateTimeOffset(new DateTime(today.Year, today.Month, 1).AddMonths(-1), TimeZoneInfo.Local.GetUtcOffset(DateTime.Now)).ToUnixTimeMilliseconds();

        ThisMonthGoals = await Db.Goals
            .CountAsync(g => g.AccountFk == AccountGuid && g.DeletedAt == null
                          && g.CompletionDate != null && g.CompletionDate >= thisMonthStart);
        LastMonthGoals = await Db.Goals
            .CountAsync(g => g.AccountFk == AccountGuid && g.DeletedAt == null
                          && g.CompletionDate != null && g.CompletionDate >= lastMonthStart && g.CompletionDate < thisMonthStart);

        ThisMonthTodos = await Db.Todos
            .CountAsync(t => t.AccountFk == AccountGuid && t.DeletedAt == null
                          && t.CompletedAt != null && t.CompletedAt >= thisMonthStart);
        LastMonthTodos = await Db.Todos
            .CountAsync(t => t.AccountFk == AccountGuid && t.DeletedAt == null
                          && t.CompletedAt != null && t.CompletedAt >= lastMonthStart && t.CompletedAt < thisMonthStart);

        ThisMonthJournal = await Db.Journals
            .CountAsync(j => j.AccountFk == AccountGuid && j.DeletedAt == null && j.EnteredDate >= thisMonthStart);
        LastMonthJournal = await Db.Journals
            .CountAsync(j => j.AccountFk == AccountGuid && j.DeletedAt == null
                          && j.EnteredDate >= lastMonthStart && j.EnteredDate < thisMonthStart);
    }

    private async Task LoadInsights()
    {
        var nowMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        var day30Ms = DateTimeOffset.UtcNow.AddDays(-30).ToUnixTimeMilliseconds();
        var day7Ms = DateTimeOffset.UtcNow.AddDays(-7).ToUnixTimeMilliseconds();
        var day14Ms = DateTimeOffset.UtcNow.AddDays(-14).ToUnixTimeMilliseconds();

        var last30 = await Db.AnalyticsEvents
            .Where(e => e.AccountGuid == AccountGuid && e.Timestamp >= day30Ms)
            .ToListAsync();

        TotalLast30 = last30.Count;
        TotalThisWeek = last30.Count(e => e.Timestamp >= day7Ms);
        TotalLastWeek = last30.Count(e => e.Timestamp >= day14Ms && e.Timestamp < day7Ms);

        var activeDates = last30
            .Select(e => DateTimeOffset.FromUnixTimeMilliseconds(e.Timestamp).LocalDateTime.Date)
            .ToHashSet();
        ActiveDaysLast30 = activeDates.Count;

        // Current streak: consecutive days ending today with at least one action
        var today = DateTimeOffset.UtcNow.LocalDateTime.Date;
        CurrentStreak = 0;
        var streakDay = today;
        while (activeDates.Contains(streakDay))
        {
            CurrentStreak++;
            streakDay = streakDay.AddDays(-1);
        }

        TopEvents = last30
            .Where(e => e.EventName != "page_view")
            .GroupBy(e => e.EventName)
            .OrderByDescending(g => g.Count())
            .Take(8)
            .ToDictionary(g => g.Key, g => g.Count());

        PageViews = last30
            .Where(e => e.EventName == "page_view" && e.Page != null)
            .GroupBy(e => e.Page!)
            .OrderByDescending(g => g.Count())
            .ToDictionary(g => g.Key, g => g.Count());

        BuildDailyChart(last30, day14Ms, nowMs);
    }

    private void BuildDailyChart(List<AnalyticsEvent> events, long fromMs, long nowMs)
    {
        var today = DateTimeOffset.UtcNow.LocalDateTime.Date;
        var labels = new string[14];
        var counts = new double[14];

        for (int i = 13; i >= 0; i--)
        {
            var d = today.AddDays(-(13 - i));
            labels[i] = d.ToString("M/d");
            var startMs = new DateTimeOffset(DateTime.SpecifyKind(d, DateTimeKind.Local)).ToUnixTimeMilliseconds();
            var endMs = startMs + 86_400_000L;
            counts[i] = events.Count(e => e.Timestamp >= startMs && e.Timestamp < endMs);
        }

        DailyChartLabels = labels;
        DailyChartSeries = [new ChartSeries { Name = "Actions", Data = counts }];
    }

    private static string FormatEventName(string name) => name switch
    {
        "goal_add" => "Add goal",
        "goal_edit" => "Edit goal",
        "goal_complete" => "Complete goal",
        "goal_reopen" => "Reopen goal",
        "goal_delete" => "Delete goal",
        "goal_filter" => "Filter goals",
        "progress_add" => "Add progress note",
        "progress_edit" => "Edit progress note",
        "progress_delete" => "Delete progress note",
        "progress_quickadd" => "Quick progress note",
        "journal_add" => "Add journal entry",
        "journal_edit" => "Edit journal entry",
        "journal_delete" => "Delete journal entry",
        "journal_quickadd" => "Quick journal entry",
        "journal_filter" => "Filter journal",
        "todo_add" => "Add todo",
        "todo_edit" => "Edit todo",
        "todo_complete" => "Complete todo",
        "todo_uncomplete" => "Restore todo",
        "todo_delete" => "Delete todo",
        "todo_filter" => "Filter todos",
        "login" => "Login",
        "logout" => "Logout",
        "register" => "Register",
        "settings_change_nickname" => "Change nickname",
        "settings_change_pin" => "Change PIN",
        _ => name.Replace("_", " ")
    };

    private static string FormatPageName(string page) => page switch
    {
        "home" => "Goals dashboard",
        "todos" => "Todos",
        "journal" => "Journal",
        "goal_detail" => "Goal detail",
        "insights" => "Insights",
        "settings" => "Settings",
        _ => page
    };
}
