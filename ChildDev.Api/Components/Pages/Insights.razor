        TodosThisWeek = allTodosEver.Count(ms => ms >= wow7MsTodo);
        TodosLastWeek = allTodosEver.Count(ms => ms >= wow14MsTodo && ms < wow7MsTodo);
        var allJournalEver = await Db.Journals.Where(j => j.AccountFk == AccountGuid && j.DeletedAt == null).Select(j => j.EnteredDate).ToListAsync();
        var wow7MsJournal = wow7MsTodo;
        var wow14MsJournal = wow14MsTodo;
        JournalThisWeek = allJournalEver.Count(ms => ms >= wow7MsJournal);
        JournalLastWeek = allJournalEver.Count(ms => ms >= wow14MsJournal && ms < wow7MsJournal);
        var allProgressEver = await Db.GoalProgresses.Where(p => p.AccountFk == AccountGuid && p.DeletedAt == null).Select(p => p.UpdatedOn).ToListAsync();
        // Unique goals worked on this week vs last week (WoW)
        var progressGoalWow = await Db.GoalProgresses
            .Where(p => p.AccountFk == AccountGuid && p.DeletedAt == null && p.UpdatedOn >= wow14MsTodo)
            .Select(p => new { p.GoalFk, p.UpdatedOn })
            .ToListAsync();
        GoalsWorkedThisWeek = progressGoalWow.Where(p => p.UpdatedOn >= wow7MsTodo).Select(p => p.GoalFk).Distinct().Count();
        GoalsWorkedLastWeek = progressGoalWow.Where(p => p.UpdatedOn >= wow14MsTodo && p.UpdatedOn < wow7MsTodo).Select(p => p.GoalFk).Distinct().Count();
        // Avg notes per week (from first note to now)
        if (allProgressEver.Count >= 5)
        {
            var apwFirstMs = allProgressEver.Min();
            var apwWeeks = Math.Max((DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - apwFirstMs) / (7.0 * 86_400_000.0), 1.0);
            AvgProgressNotesPerWeek = allProgressEver.Count / apwWeeks;
        }

        // Week-over-week progress note velocity
        var wowNowMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        var wow7Ms = wowNowMs - 7L * 86_400_000L;
        var wow14Ms = wowNowMs - 14L * 86_400_000L;
        NotesThisWeekProgress = allProgressEver.Count(ms => ms >= wow7Ms);
        NotesLastWeekProgress = allProgressEver.Count(ms => ms >= wow14Ms && ms < wow7Ms);

        // Active days this week vs last week (any progress or journal activity)
        var allActivityEver = allProgressEver.Concat(allJournalEver).ToList();
        ActiveDaysThisWeek = allActivityEver
            .Where(ms => ms >= wow7Ms)
            .Select(ms => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime))
            .Distinct()
            .Count();
        ActiveDaysLastWeek = allActivityEver
            .Where(ms => ms >= wow14Ms && ms < wow7Ms)
            .Select(ms => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime))
            .Distinct()
            .Count();

        // Longest all-time consecutive day streak for progress notes
        var allProgressDates = allProgressEver
            .Select(ms => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime))
            .ToHashSet()
            .OrderBy(d => d)
            .ToList();
        LongestProgressDayStreak = 0;
        int currentRun = 0;
        for (int pdi = 0; pdi < allProgressDates.Count; pdi++)
        {
            if (pdi == 0 || allProgressDates[pdi] == allProgressDates[pdi - 1].AddDays(1))
                currentRun++;
            else
                currentRun = 1;
            if (currentRun > LongestProgressDayStreak) LongestProgressDayStreak = currentRun;
        }

        // Average journal entries per month since first entry
        if (allJournalEver.Count >= 5)
        {
            var jampEarliestMs = allJournalEver.Min();
            var jampMonthsElapsed = Math.Max((DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - jampEarliestMs) / (30.44 * 86_400_000.0), 1.0);
            JournalAvgPerMonth = allJournalEver.Count / jampMonthsElapsed;
        }

        // Journal consistency score: distinct journaling days in last 30 days
        var jcs30Ms = DateTimeOffset.UtcNow.AddDays(-30).ToUnixTimeMilliseconds();
        JournalConsistencyScore30 = allJournalEver
            .Where(ms => ms >= jcs30Ms)
            .Select(ms => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime))
            .ToHashSet()
            .Count;

        // Journal consistency score for current year
        var jcsYearStart = new DateTimeOffset(new DateTime(DateTime.Today.Year, 1, 1), TimeZoneInfo.Local.GetUtcOffset(DateTime.Today)).ToUnixTimeMilliseconds();
        JournalConsistencyScoreYear = allJournalEver
            .Where(ms => ms >= jcsYearStart)
            .Select(ms => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime))
            .ToHashSet()
            .Count;
        JournalYearDaysElapsed = DateTime.Today.DayOfYear;

        // Best day of week for progress notes
        if (allProgressEver.Count >= 5)
        {
            var bestDow = allProgressEver
                .GroupBy(ms => DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime.DayOfWeek)
                .OrderByDescending(g => g.Count())
                .First();
            BestProgressDayOfWeek = bestDow.Key.ToString();
            BestProgressDayOfWeekCount = bestDow.Count();
        }

        if (allProgressEver.Count >= 10)
        {
            int pMorning = allProgressEver.Count(ms => DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime.Hour < 12);
            int pAfternoon = allProgressEver.Count(ms => { var h = DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime.Hour; return h >= 12 && h < 17; });
            int pEvening = allProgressEver.Count(ms => DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime.Hour >= 17);
            var pMax = Math.Max(pMorning, Math.Max(pAfternoon, pEvening));
            if (pMax * 100 / allProgressEver.Count >= 50)
                ProgressTimeOfDay = pMorning == pMax ? "morning 🌅" : pAfternoon == pMax ? "afternoon ☀️" : "evening 🌙";
        }

        // Best time of day for journaling
        if (allJournalEver.Count >= 10)
        {
            int jMorning = allJournalEver.Count(ms => DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime.Hour < 12);
            int jAfternoon = allJournalEver.Count(ms => { var h = DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime.Hour; return h >= 12 && h < 17; });
            int jEvening = allJournalEver.Count(ms => DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime.Hour >= 17);
            var jMax = Math.Max(jMorning, Math.Max(jAfternoon, jEvening));
            if (jMax * 100 / allJournalEver.Count >= 50)
                JournalTimeOfDay = jMorning == jMax ? "morning 🌅" : jAfternoon == jMax ? "afternoon ☀️" : "evening 🌙";
        }

        // Best day of week for journal entries
        if (allJournalEver.Count >= 5)
        {
            var bestJDow = allJournalEver
                .GroupBy(ms => DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime.DayOfWeek)
                .OrderByDescending(g => g.Count())
                .First();
            BestJournalDayOfWeek = bestJDow.Key.ToString();
            BestJournalDayOfWeekCount = bestJDow.Count();
        }

        // Journal streak: consecutive days ending today with at least one journal entry
        var journalDateSet = allJournalEver
            .Select(ms => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime))
            .ToHashSet();
        JournalStreak = 0;
        var jStreakDay = DateOnly.FromDateTime(DateTime.Today);
        while (journalDateSet.Contains(jStreakDay)) { JournalStreak++; jStreakDay = jStreakDay.AddDays(-1); }

        // Completion velocity: avg days between last 3 goal completions
        var completionDates = await Db.Goals
            .Where(g => g.AccountFk == AccountGuid && g.DeletedAt == null && g.CompletionDate != null)
            .OrderByDescending(g => g.CompletionDate)
            .Take(4)
            .Select(g => g.CompletionDate!.Value)
            .ToListAsync();
        CompletionVelocityMsg = null;
        if (completionDates.Count >= 2)
        {
            var gaps = new List<long>();
            for (int ci = 0; ci < completionDates.Count - 1; ci++)
                gaps.Add(completionDates[ci] - completionDates[ci + 1]);
            var avgDays = (int)(gaps.Average() / 86_400_000.0);
            if (avgDays > 0)
                CompletionVelocityMsg = avgDays <= 30
                    ? $"🎯 You complete a goal every ~{avgDays} days — incredible pace! You're a goal-finishing machine!"
                    : avgDays <= 90
                        ? $"🎯 You complete a goal every ~{avgDays} days — solid, steady progress toward your dreams!"
                        : $"🎯 You complete a goal every ~{avgDays} days — each one is a real achievement worth celebrating!";
        }

        // Average goal completion lifespan (start to finish)
        var durationRows = await Db.Goals
            .Where(g => g.AccountFk == AccountGuid && g.DeletedAt == null && g.CompletionDate != null)
            .Select(g => new { g.CompletionDate, g.EnteredDate, g.GoalText })
            .ToListAsync();
        if (durationRows.Count >= 2)
        {
            AvgGoalCompletionDays = (int)durationRows.Average(r => (r.CompletionDate!.Value - r.EnteredDate) / 86_400_000.0);
            var fastest = durationRows.OrderBy(r => r.CompletionDate!.Value - r.EnteredDate).First();
            FastestGoalDays = (int)Math.Max(1, (fastest.CompletionDate!.Value - fastest.EnteredDate) / 86_400_000.0);
            FastestGoalName = fastest.GoalText;
        }

        var allEver = allTodosEver.Concat(allJournalEver).Concat(allProgressEver).ToList();
        TotalActiveDaysEver = allEver
            .Select(ms => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime))
            .Distinct().Count();
        var allEverDateSet = allEver
            .Select(ms => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime))
            .ToHashSet();
        for (int spi = 0; spi < 7; spi++)
            Last7DaysActive[spi] = allEverDateSet.Contains(DateOnly.FromDateTime(DateTime.Today.AddDays(-6 + spi)));

        // All-time longest streak across all activity
        var lseSorted = allEverDateSet.OrderBy(d => d).ToList();
        LongestStreakEver = 0;
        var lseRun = 0;
        for (int lsei = 0; lsei < lseSorted.Count; lsei++)
        {
            if (lsei == 0 || lseSorted[lsei] == lseSorted[lsei - 1].AddDays(1))
                lseRun++;
            else
                lseRun = 1;
            if (lseRun > LongestStreakEver) LongestStreakEver = lseRun;
        }

        if (allEver.Count >= 5)
        {
            var bestDayGroup = allEver
                .GroupBy(ms => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime))
                .OrderByDescending(g => g.Count())
                .FirstOrDefault();
            if (bestDayGroup is not null && bestDayGroup.Count() >= 3)
            {
                BestDayEverDate = bestDayGroup.Key.ToString("MMMM d, yyyy");
                BestDayEverCount = bestDayGroup.Count();
            }

            var bestWeekGroup = allEver
                .GroupBy(ms => {
                    var d = DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime);
                    var offset = ((int)d.DayOfWeek + 6) % 7;
                    return d.AddDays(-offset);
                })
                .OrderByDescending(g => g.Count())
                .FirstOrDefault();
            if (bestWeekGroup is not null && bestWeekGroup.Count() >= 4)
            {
                var weekEnd = bestWeekGroup.Key.AddDays(6);
                BestWeekEver = bestWeekGroup.Key.Year == weekEnd.Year
                    ? $"{bestWeekGroup.Key:MMM d}–{weekEnd:MMM d, yyyy}"
                    : $"{bestWeekGroup.Key:MMM d, yyyy}–{weekEnd:MMM d, yyyy}";
                BestWeekEverCount = bestWeekGroup.Count();
            }

            var bestMonthGroup = allEver
                .GroupBy(ms => DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime.ToString("yyyy-MM"))
                .OrderByDescending(g => g.Count())
                .FirstOrDefault();
            if (bestMonthGroup is not null && bestMonthGroup.Count() >= 5)
            {
                if (DateTime.TryParseExact(bestMonthGroup.Key + "-01", "yyyy-MM-dd", null, System.Globalization.DateTimeStyles.None, out var bmd))
                    BestMonthEver = bmd.ToString("MMMM yyyy");
                BestMonthEverCount = bestMonthGroup.Count();
            }

            var quarterGroups = allProgressEver
                .GroupBy(ms => { var d = DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime; return (d.Year * 10) + ((d.Month - 1) / 3 + 1); })
                .ToList();
            if (quarterGroups.Count >= 2)
            {
                var bestQ = quarterGroups.OrderByDescending(g => g.Count()).First();
                var qNum = bestQ.Key % 10;
                var qYear = bestQ.Key / 10;
                string[] qLabels = ["Q1 (Jan–Mar)", "Q2 (Apr–Jun)", "Q3 (Jul–Sep)", "Q4 (Oct–Dec)"];
                MostProductiveQuarter = $"{qLabels[qNum - 1]} {qYear}";
                MostProductiveQuarterCount = bestQ.Count();
            }
        }

        // Monthly activity trend: last 6 months of progress notes + journal entries + goal completions
        if (allProgressEver.Count >= 3 || allJournalEver.Count >= 3)
        {
            var today2 = DateTime.Today;
            var months = Enumerable.Range(0, 6)
                .Select(i => new DateTime(today2.Year, today2.Month, 1).AddMonths(-5 + i))
                .ToList();
            MonthlyTrendLabels = months.Select(m => m.ToString("MMM")).ToArray();
            var progressNotesByMonth = months.Select(m =>
            {
                var mStart = new DateTimeOffset(m, TimeZoneInfo.Local.GetUtcOffset(m)).ToUnixTimeMilliseconds();
                var mEnd = new DateTimeOffset(m.AddMonths(1), TimeZoneInfo.Local.GetUtcOffset(m.AddMonths(1))).ToUnixTimeMilliseconds();
                return (double)allProgressEver.Count(ms => ms >= mStart && ms < mEnd);
            }).ToArray();
            var journalByMonth = months.Select(m =>
            {
                var mStart = new DateTimeOffset(m, TimeZoneInfo.Local.GetUtcOffset(m)).ToUnixTimeMilliseconds();
                var mEnd = new DateTimeOffset(m.AddMonths(1), TimeZoneInfo.Local.GetUtcOffset(m.AddMonths(1))).ToUnixTimeMilliseconds();
                return (double)allJournalEver.Count(ms => ms >= mStart && ms < mEnd);
            }).ToArray();
            MonthlyTrendSeries =
            [
                new ChartSeries { Name = "Progress Notes", Data = progressNotesByMonth },
                new ChartSeries { Name = "Journal Entries", Data = journalByMonth }
            ];
            // Add goals completed per month if user has 2+ completions in the window
            if (durationRows.Count >= 2)
            {
                var completionsByMonth = months.Select(m =>
                {
                    var mStart = new DateTimeOffset(m, TimeZoneInfo.Local.GetUtcOffset(m)).ToUnixTimeMilliseconds();
                    var mEnd = new DateTimeOffset(m.AddMonths(1), TimeZoneInfo.Local.GetUtcOffset(m.AddMonths(1))).ToUnixTimeMilliseconds();
                    return (double)durationRows.Count(r => r.CompletionDate.HasValue && r.CompletionDate.Value >= mStart && r.CompletionDate.Value < mEnd);
                }).ToArray();
                if (completionsByMonth.Any(c => c > 0))
                    MonthlyTrendSeries.Add(new ChartSeries { Name = "Goals Completed", Data = completionsByMonth });
            }
        }
    }

    private async Task LoadInsights()
    {
        var nowMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        var day30Ms = DateTimeOffset.UtcNow.AddDays(-30).ToUnixTimeMilliseconds();
        var day7Ms = DateTimeOffset.UtcNow.AddDays(-7).ToUnixTimeMilliseconds();
        var day14Ms = DateTimeOffset.UtcNow.AddDays(-14).ToUnixTimeMilliseconds();

        var last30 = await Db.AnalyticsEvents
            .Where(e => e.AccountGuid == AccountGuid && e.Timestamp >= day30Ms)
            .ToListAsync();

        TotalLast30 = last30.Count;
        TotalThisWeek = last30.Count(e => e.Timestamp >= day7Ms);
        TotalLastWeek = last30.Count(e => e.Timestamp >= day14Ms && e.Timestamp < day7Ms);

        var activeDates = last30
            .Select(e => DateTimeOffset.FromUnixTimeMilliseconds(e.Timestamp).LocalDateTime.Date)
            .ToHashSet();
        ActiveDaysLast30 = activeDates.Count;

        // Current streak: consecutive days ending today with at least one action
        var today = DateTimeOffset.UtcNow.LocalDateTime.Date;
        CurrentStreak = 0;
        var streakDay = today;
        while (activeDates.Contains(streakDay))
        {
            CurrentStreak++;
            streakDay = streakDay.AddDays(-1);
        }

        TopEvents = last30
            .Where(e => e.EventName != "page_view")
            .GroupBy(e => e.EventName)
            .OrderByDescending(g => g.Count())
            .Take(8)
            .ToDictionary(g => g.Key, g => g.Count());

        PageViews = last30
            .Where(e => e.EventName == "page_view" && e.Page != null)
            .GroupBy(e => e.Page!)
            .OrderByDescending(g => g.Count())
            .ToDictionary(g => g.Key, g => g.Count());

        BuildDailyChart(last30, day14Ms, nowMs);

        var dayGroups = last30
            .GroupBy(e => DateTimeOffset.FromUnixTimeMilliseconds(e.Timestamp).LocalDateTime.DayOfWeek)
            .OrderByDescending(g => g.Count())
            .FirstOrDefault();
        if (dayGroups is not null && dayGroups.Count() >= 3)
        {
            MostActiveDayName = dayGroups.Key.ToString();
            MostActiveDayCount = dayGroups.Count();
        }
    }

    private void BuildDailyChart(List<AnalyticsEvent> events, long fromMs, long nowMs)
    {
        var today = DateTimeOffset.UtcNow.LocalDateTime.Date;
        var labels = new string[14];
        var counts = new double[14];

        for (int i = 13; i >= 0; i--)
        {
            var d = today.AddDays(-(13 - i));
            labels[i] = d.ToString("M/d");
            var startMs = new DateTimeOffset(DateTime.SpecifyKind(d, DateTimeKind.Local)).ToUnixTimeMilliseconds();
            var endMs = startMs + 86_400_000L;
            counts[i] = events.Count(e => e.Timestamp >= startMs && e.Timestamp < endMs);
        }

        DailyChartLabels = labels;
        DailyChartSeries = [new ChartSeries { Name = "Actions", Data = counts }];
    }

