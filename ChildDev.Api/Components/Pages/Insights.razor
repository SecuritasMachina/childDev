            @if (!PageViews.Any())
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No page views tracked yet.</MudText>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private string? AccountGuid;
    private int TotalLast30;
    private int TotalThisWeek;
    private int TotalLastWeek;
    private int ActiveDaysLast30;
    private int CurrentStreak;
    private List<ChartSeries> DailyChartSeries = [];
    private string[] DailyChartLabels = [];
    private Dictionary<string, int> TopEvents = new();
    private Dictionary<string, int> PageViews = new();

    // Domain entity stats
    private int GoalsCompletedAllTime;
    private int GoalsTotalAllTime;
    private int GoalsWithMeasurableOutcome;
    private int YtdGoalsCompleted;
    private List<(string Name, long CompletionDate, long EnteredDate)> RecentCompletedGoals = [];
    private int TodosCompletedAllTime;
    private int YtdTodosCompleted;
    private int JournalTotal;
    private double JournalAvgPerMonth;
    private int GoalProgressTotal;
    private string? TopMood;
    private int TopMoodCount;
    private List<(string Mood, int Count)> TopMoods = [];
    private string? TopGoalName;
    private string? TopGoalGuid;
    private int TopGoalNoteCount;
    private string? NeglectedGoalName;
    private string? NeglectedGoalGuid;
    private string? MostActiveDayName;
    private int MostActiveDayCount;
    private string? MostActiveGoalName;
    private string? MostActiveGoalGuid;
    private int MostActiveGoalNoteCount;
    private Dictionary<DateOnly, int> ProgressHeatmap = new();
    private string? TopProgressWeekday;
    private int TopProgressWeekdayCount;
    private int DaysSinceLastProgress = -1;
    private string? LongestActiveGoalName;
    private int LongestActiveGoalDays;
    private string? LongestActiveGoalGuid;
    private List<(string Day, int Count)> WeekdayLeaderboard = [];
    private string? BestDayEverDate;
    private int BestDayEverCount;
    private string? BestMonthEver;
    private int BestMonthEverCount;
    private int JournalStreak;
    private int LongestProgressDayStreak;
    private int JournalConsistencyScore30;
    private int JournalConsistencyScoreYear;
    private int JournalYearDaysElapsed;
    private List<ChartSeries> GoalNotesChartSeries = [];
    private string[] GoalNotesChartLabels = [];

    // Month-over-month trends
    private int ThisMonthGoals;
    private int LastMonthGoals;
    private int ThisMonthTodos;
    private int LastMonthTodos;
    private int ThisMonthJournal;
    private int LastMonthJournal;
    private int ThisMonthProgress;
    private int LastMonthProgress;
    private int NotesThisWeekProgress;
    private int ActiveDaysThisWeek;
    private int ActiveDaysLastWeek;
    private int NotesLastWeekProgress;
    private string? CompletionVelocityMsg;
    private string? BestProgressDayOfWeek;
    private int BestProgressDayOfWeekCount;
    private string? BestJournalDayOfWeek;
    private int BestJournalDayOfWeekCount;
    private int TotalActiveDaysEver;
    private bool[] Last7DaysActive = new bool[7];
    private string? MostProductiveQuarter;
    private int MostProductiveQuarterCount;
    private int JourneyYears;
    private int JourneyMonths;
    private double AvgProgressNotesPerWeek;

    protected override async Task OnInitializedAsync()
    {
        AccountGuid = HttpContextAccessor.HttpContext?.Session.GetString("AccountGuid");
        if (AccountGuid is null) return;
        await Task.WhenAll(LoadInsights(), LoadDomainStats());
        await Analytics.TrackAsync("page_view", AccountGuid, "insights");
    }

    private async Task LoadDomainStats()
    {
        GoalsCompletedAllTime = await Db.Goals
            .CountAsync(g => g.AccountFk == AccountGuid && g.DeletedAt == null && g.CompletionDate != null);
        GoalsTotalAllTime = await Db.Goals
            .CountAsync(g => g.AccountFk == AccountGuid && g.DeletedAt == null);
        GoalsWithMeasurableOutcome = await Db.Goals
            .CountAsync(g => g.AccountFk == AccountGuid && g.DeletedAt == null && g.MeasurableOutcome != null && g.MeasurableOutcome != "");
        var ytdGoalYearStart = new DateTimeOffset(new DateTime(DateTime.Today.Year, 1, 1), TimeZoneInfo.Local.GetUtcOffset(DateTime.Today)).ToUnixTimeMilliseconds();
        YtdGoalsCompleted = await Db.Goals
            .CountAsync(g => g.AccountFk == AccountGuid && g.DeletedAt == null && g.CompletionDate != null && g.CompletionDate.Value >= ytdGoalYearStart);

        var rcgRows = await Db.Goals
            .Where(g => g.AccountFk == AccountGuid && g.DeletedAt == null && g.CompletionDate != null)
            .OrderByDescending(g => g.CompletionDate)
            .Take(3)
            .Select(g => new { g.GoalText, g.CompletionDate, g.EnteredDate })
            .ToListAsync();
        RecentCompletedGoals = rcgRows.Select(g => (g.GoalText ?? "", g.CompletionDate!.Value, g.EnteredDate)).ToList();

        TodosCompletedAllTime = await Db.Todos
            .CountAsync(t => t.AccountFk == AccountGuid && t.DeletedAt == null && t.CompletedAt != null);

        JournalTotal = await Db.Journals
            .CountAsync(j => j.AccountFk == AccountGuid && j.DeletedAt == null);

        GoalProgressTotal = await Db.GoalProgresses
            .CountAsync(p => p.AccountFk == AccountGuid && p.DeletedAt == null);

        // Most active goal: goal with most progress notes
        var magTop = await Db.GoalProgresses
            .Where(p => p.AccountFk == AccountGuid && p.DeletedAt == null)
            .GroupBy(p => p.GoalFk)
            .Select(g => new { GoalFk = g.Key, Count = g.Count() })
            .OrderByDescending(x => x.Count)
            .FirstOrDefaultAsync();
        if (magTop is not null && magTop.Count >= 10)
        {
            var magGoal = await Db.Goals
                .Where(g => g.Guid == magTop.GoalFk && g.AccountFk == AccountGuid && g.DeletedAt == null)
                .Select(g => new { g.GoalText, g.Guid })
                .FirstOrDefaultAsync();
            if (magGoal is not null)
            {
                MostActiveGoalName = magGoal.GoalText;
                MostActiveGoalGuid = magGoal.Guid;
                MostActiveGoalNoteCount = magTop.Count;
            }
        }

        // Longest active goal (oldest EnteredDate among non-completed active goals)
        var longestGoal = await Db.Goals
            .Where(g => g.AccountFk == AccountGuid && g.DeletedAt == null && g.CompletionDate == null)
            .OrderBy(g => g.EnteredDate)
            .Select(g => new { g.Guid, g.GoalText, g.EnteredDate })
            .FirstOrDefaultAsync();
        if (longestGoal is not null)
        {
            LongestActiveGoalName = longestGoal.GoalText;
            LongestActiveGoalGuid = longestGoal.Guid;
            LongestActiveGoalDays = (int)((DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - longestGoal.EnteredDate) / 86_400_000L);
        }

        // First goal ever (for journey anniversary)
        var firstGoalMs = await Db.Goals
            .Where(g => g.AccountFk == AccountGuid && g.DeletedAt == null)
            .MinAsync(g => (long?)g.EnteredDate);
        if (firstGoalMs.HasValue)
        {
            var journeyDays = (int)((DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - firstGoalMs.Value) / 86_400_000L);
            JourneyYears = journeyDays / 365;
            JourneyMonths = journeyDays / 30;
        }

        var moodRows = await Db.Journals
            .Where(j => j.AccountFk == AccountGuid && j.DeletedAt == null && j.Mood != null && j.Mood != "")
            .GroupBy(j => j.Mood!)
            .Select(g => new { Mood = g.Key, Count = g.Count() })
            .OrderByDescending(x => x.Count)
            .Take(3)
            .ToListAsync();
        TopMoods = moodRows.Select(m => (m.Mood, m.Count)).ToList();
        if (moodRows.Count > 0)
        {
            TopMood = moodRows[0].Mood;
            TopMoodCount = moodRows[0].Count;
        }

        // Goal with the most progress notes ("Top Goal" spotlight)
        var topGoalProgress = await Db.GoalProgresses
            .Where(p => p.AccountFk == AccountGuid && p.DeletedAt == null)
            .GroupBy(p => p.GoalFk)
            .Select(g => new { GoalFk = g.Key, Count = g.Count() })
            .OrderByDescending(x => x.Count)
            .FirstOrDefaultAsync();
        if (topGoalProgress is not null && topGoalProgress.Count > 0)
        {
            var topGoal = await Db.Goals.FirstOrDefaultAsync(g => g.Guid == topGoalProgress.GoalFk && g.DeletedAt == null);
            if (topGoal is not null)
            {
                TopGoalName = topGoal.GoalText;
                TopGoalGuid = topGoal.Guid;
                TopGoalNoteCount = topGoalProgress.Count;
            }
        }

        // Most-neglected active goal: active goal with fewest notes (excluding goals with 0 notes if any have notes)
        var activeGoalGuids = await Db.Goals
            .Where(g => g.AccountFk == AccountGuid && g.DeletedAt == null && g.CompletionDate == null)
            .Select(g => g.Guid)
            .ToListAsync();
        if (activeGoalGuids.Count >= 2)
        {
            var activeProgressCounts = await Db.GoalProgresses
                .Where(p => activeGoalGuids.Contains(p.GoalFk) && p.DeletedAt == null)
                .GroupBy(p => p.GoalFk)
                .Select(g => new { GoalFk = g.Key, Count = g.Count() })
                .ToListAsync();
            var neglectedGuid = activeGoalGuids
                .Where(guid => guid != TopGoalGuid)
                .OrderBy(guid => activeProgressCounts.FirstOrDefault(x => x.GoalFk == guid)?.Count ?? 0)
                .FirstOrDefault();
            if (neglectedGuid is not null)
            {
                var neglectedGoal = await Db.Goals.FirstOrDefaultAsync(g => g.Guid == neglectedGuid && g.DeletedAt == null);
                if (neglectedGoal is not null)
                {
                    NeglectedGoalName = neglectedGoal.GoalText;
                    NeglectedGoalGuid = neglectedGoal.Guid;
                }
            }
        }

        // Top 5 goals by progress note count for bar chart
        var top5GoalProgress = await Db.GoalProgresses
            .Where(p => p.AccountFk == AccountGuid && p.DeletedAt == null)
            .GroupBy(p => p.GoalFk)
            .Select(g => new { GoalFk = g.Key, Count = g.Count() })
            .OrderByDescending(x => x.Count)
            .Take(5)
            .ToListAsync();
        if (top5GoalProgress.Count >= 2)
        {
            var top5Guids = top5GoalProgress.Select(x => x.GoalFk).ToList();
            var top5Goals = await Db.Goals
                .Where(g => top5Guids.Contains(g.Guid) && g.DeletedAt == null)
                .Select(g => new { g.Guid, g.GoalText })
                .ToListAsync();
            var goalNameDict = top5Goals.ToDictionary(g => g.Guid, g => g.GoalText ?? g.Guid);
            GoalNotesChartLabels = top5GoalProgress
                .Select(x => { var n = goalNameDict.GetValueOrDefault(x.GoalFk, "?"); return n.Length > 14 ? n[..14] + "…" : n; })
                .ToArray();
            GoalNotesChartSeries = [new ChartSeries { Name = "Progress Notes", Data = top5GoalProgress.Select(x => (double)x.Count).ToArray() }];
        }

        // Month-over-month windows (calendar months, local time)
        var today = DateTimeOffset.Now.LocalDateTime;
        var thisMonthStart = new DateTimeOffset(new DateTime(today.Year, today.Month, 1), TimeZoneInfo.Local.GetUtcOffset(DateTime.Now)).ToUnixTimeMilliseconds();
        var lastMonthStart = new DateTimeOffset(new DateTime(today.Year, today.Month, 1).AddMonths(-1), TimeZoneInfo.Local.GetUtcOffset(DateTime.Now)).ToUnixTimeMilliseconds();

        ThisMonthGoals = await Db.Goals
            .CountAsync(g => g.AccountFk == AccountGuid && g.DeletedAt == null
                          && g.CompletionDate != null && g.CompletionDate >= thisMonthStart);
        LastMonthGoals = await Db.Goals
            .CountAsync(g => g.AccountFk == AccountGuid && g.DeletedAt == null
                          && g.CompletionDate != null && g.CompletionDate >= lastMonthStart && g.CompletionDate < thisMonthStart);

        ThisMonthTodos = await Db.Todos
            .CountAsync(t => t.AccountFk == AccountGuid && t.DeletedAt == null
                          && t.CompletedAt != null && t.CompletedAt >= thisMonthStart);
        LastMonthTodos = await Db.Todos
            .CountAsync(t => t.AccountFk == AccountGuid && t.DeletedAt == null
                          && t.CompletedAt != null && t.CompletedAt >= lastMonthStart && t.CompletedAt < thisMonthStart);

        ThisMonthJournal = await Db.Journals
            .CountAsync(j => j.AccountFk == AccountGuid && j.DeletedAt == null && j.EnteredDate >= thisMonthStart);
        LastMonthJournal = await Db.Journals
            .CountAsync(j => j.AccountFk == AccountGuid && j.DeletedAt == null
                          && j.EnteredDate >= lastMonthStart && j.EnteredDate < thisMonthStart);

        ThisMonthProgress = await Db.GoalProgresses
            .CountAsync(p => p.AccountFk == AccountGuid && p.DeletedAt == null && p.UpdatedOn >= thisMonthStart);
        LastMonthProgress = await Db.GoalProgresses
            .CountAsync(p => p.AccountFk == AccountGuid && p.DeletedAt == null
                          && p.UpdatedOn >= lastMonthStart && p.UpdatedOn < thisMonthStart);

        // Days since last progress note
        var lastProgressMs = await Db.GoalProgresses
            .Where(p => p.AccountFk == AccountGuid && p.DeletedAt == null)
            .MaxAsync(p => (long?)p.UpdatedOn);
        if (lastProgressMs.HasValue)
            DaysSinceLastProgress = (int)((DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - lastProgressMs.Value) / 86_400_000L);

        // Progress heatmap: notes per day for last 35 days
        var day35Ms = DateTimeOffset.UtcNow.AddDays(-35).ToUnixTimeMilliseconds();
        var recentProgressTs = await Db.GoalProgresses
            .Where(p => p.AccountFk == AccountGuid && p.DeletedAt == null && p.UpdatedOn >= day35Ms)
            .Select(p => p.UpdatedOn)
            .ToListAsync();
        ProgressHeatmap = recentProgressTs
            .GroupBy(ms => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime))
            .ToDictionary(g => g.Key, g => g.Count());

        var topDayGroup = recentProgressTs
            .GroupBy(ms => DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime.DayOfWeek)
            .OrderByDescending(g => g.Count())
            .FirstOrDefault();
        if (topDayGroup is not null && topDayGroup.Count() >= 2)
        {
            TopProgressWeekday = topDayGroup.Key.ToString();
            TopProgressWeekdayCount = topDayGroup.Count();
        }

        // All-activity weekday leaderboard: combine todos, journals, progress notes (last 90 days)
        var day90Ms = DateTimeOffset.UtcNow.AddDays(-90).ToUnixTimeMilliseconds();
        var todoTs = await Db.Todos
            .Where(t => t.AccountFk == AccountGuid && t.DeletedAt == null && t.CompletedAt != null && t.CompletedAt >= day90Ms)
            .Select(t => t.CompletedAt!.Value).ToListAsync();
        var journalTs = await Db.Journals
            .Where(j => j.AccountFk == AccountGuid && j.DeletedAt == null && j.EnteredDate >= day90Ms)
            .Select(j => j.EnteredDate).ToListAsync();
        var progressTs = await Db.GoalProgresses
            .Where(p => p.AccountFk == AccountGuid && p.DeletedAt == null && p.UpdatedOn >= day90Ms)
            .Select(p => p.UpdatedOn).ToListAsync();
        var allTs = todoTs.Concat(journalTs).Concat(progressTs).ToList();
        if (allTs.Count >= 7)
        {
            WeekdayLeaderboard = allTs
                .GroupBy(ms => DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime.DayOfWeek)
                .OrderByDescending(g => g.Count())
                .Select(g => (g.Key.ToString(), g.Count()))
                .ToList();
        }

        // All-time best day: combine all entities, group by date, find max
        var allTodosEver = await Db.Todos.Where(t => t.AccountFk == AccountGuid && t.DeletedAt == null && t.CompletedAt != null).Select(t => t.CompletedAt!.Value).ToListAsync();
        var ytdStartMs = new DateTimeOffset(new DateTime(DateTime.Today.Year, 1, 1), TimeZoneInfo.Local.GetUtcOffset(DateTime.Now)).ToUnixTimeMilliseconds();
        YtdTodosCompleted = allTodosEver.Count(ms => ms >= ytdStartMs);
        var allJournalEver = await Db.Journals.Where(j => j.AccountFk == AccountGuid && j.DeletedAt == null).Select(j => j.EnteredDate).ToListAsync();
        var allProgressEver = await Db.GoalProgresses.Where(p => p.AccountFk == AccountGuid && p.DeletedAt == null).Select(p => p.UpdatedOn).ToListAsync();
        // Avg notes per week (from first note to now)
        if (allProgressEver.Count >= 5)
        {
            var apwFirstMs = allProgressEver.Min();
            var apwWeeks = Math.Max((DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - apwFirstMs) / (7.0 * 86_400_000.0), 1.0);
            AvgProgressNotesPerWeek = allProgressEver.Count / apwWeeks;
        }

        // Week-over-week progress note velocity
        var wowNowMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        var wow7Ms = wowNowMs - 7L * 86_400_000L;
        var wow14Ms = wowNowMs - 14L * 86_400_000L;
        NotesThisWeekProgress = allProgressEver.Count(ms => ms >= wow7Ms);
        NotesLastWeekProgress = allProgressEver.Count(ms => ms >= wow14Ms && ms < wow7Ms);

        // Active days this week vs last week (any progress or journal activity)
        var allActivityEver = allProgressEver.Concat(allJournalEver).ToList();
        ActiveDaysThisWeek = allActivityEver
            .Where(ms => ms >= wow7Ms)
            .Select(ms => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime))
            .Distinct()
            .Count();
        ActiveDaysLastWeek = allActivityEver
            .Where(ms => ms >= wow14Ms && ms < wow7Ms)
            .Select(ms => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime))
            .Distinct()
            .Count();

        // Longest all-time consecutive day streak for progress notes
        var allProgressDates = allProgressEver
            .Select(ms => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime))
            .ToHashSet()
            .OrderBy(d => d)
            .ToList();
        LongestProgressDayStreak = 0;
        int currentRun = 0;
        for (int pdi = 0; pdi < allProgressDates.Count; pdi++)
        {
            if (pdi == 0 || allProgressDates[pdi] == allProgressDates[pdi - 1].AddDays(1))
                currentRun++;
            else
                currentRun = 1;
            if (currentRun > LongestProgressDayStreak) LongestProgressDayStreak = currentRun;
        }

        // Average journal entries per month since first entry
        if (allJournalEver.Count >= 5)
        {
            var jampEarliestMs = allJournalEver.Min();
            var jampMonthsElapsed = Math.Max((DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - jampEarliestMs) / (30.44 * 86_400_000.0), 1.0);
            JournalAvgPerMonth = allJournalEver.Count / jampMonthsElapsed;
        }

        // Journal consistency score: distinct journaling days in last 30 days
        var jcs30Ms = DateTimeOffset.UtcNow.AddDays(-30).ToUnixTimeMilliseconds();
        JournalConsistencyScore30 = allJournalEver
            .Where(ms => ms >= jcs30Ms)
            .Select(ms => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime))
            .ToHashSet()
            .Count;

        // Journal consistency score for current year
        var jcsYearStart = new DateTimeOffset(new DateTime(DateTime.Today.Year, 1, 1), TimeZoneInfo.Local.GetUtcOffset(DateTime.Today)).ToUnixTimeMilliseconds();
        JournalConsistencyScoreYear = allJournalEver
            .Where(ms => ms >= jcsYearStart)
            .Select(ms => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime))
            .ToHashSet()
            .Count;
        JournalYearDaysElapsed = DateTime.Today.DayOfYear;

        // Best day of week for progress notes
        if (allProgressEver.Count >= 5)
        {
            var bestDow = allProgressEver
                .GroupBy(ms => DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime.DayOfWeek)
                .OrderByDescending(g => g.Count())
                .First();
            BestProgressDayOfWeek = bestDow.Key.ToString();
            BestProgressDayOfWeekCount = bestDow.Count();
        }

        // Best day of week for journal entries
        if (allJournalEver.Count >= 5)
        {
            var bestJDow = allJournalEver
                .GroupBy(ms => DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime.DayOfWeek)
                .OrderByDescending(g => g.Count())
                .First();
            BestJournalDayOfWeek = bestJDow.Key.ToString();
            BestJournalDayOfWeekCount = bestJDow.Count();
        }

        // Journal streak: consecutive days ending today with at least one journal entry
        var journalDateSet = allJournalEver
            .Select(ms => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime))
            .ToHashSet();
        JournalStreak = 0;
        var jStreakDay = DateOnly.FromDateTime(DateTime.Today);
        while (journalDateSet.Contains(jStreakDay)) { JournalStreak++; jStreakDay = jStreakDay.AddDays(-1); }

        // Completion velocity: avg days between last 3 goal completions
        var completionDates = await Db.Goals
            .Where(g => g.AccountFk == AccountGuid && g.DeletedAt == null && g.CompletionDate != null)
            .OrderByDescending(g => g.CompletionDate)
            .Take(4)
            .Select(g => g.CompletionDate!.Value)
            .ToListAsync();
        CompletionVelocityMsg = null;
        if (completionDates.Count >= 2)
        {
            var gaps = new List<long>();
            for (int ci = 0; ci < completionDates.Count - 1; ci++)
                gaps.Add(completionDates[ci] - completionDates[ci + 1]);
            var avgDays = (int)(gaps.Average() / 86_400_000.0);
            if (avgDays > 0)
                CompletionVelocityMsg = avgDays <= 30
                    ? $"🎯 You complete a goal every ~{avgDays} days — incredible pace! You're a goal-finishing machine!"
                    : avgDays <= 90
                        ? $"🎯 You complete a goal every ~{avgDays} days — solid, steady progress toward your dreams!"
                        : $"🎯 You complete a goal every ~{avgDays} days — each one is a real achievement worth celebrating!";
        }

        var allEver = allTodosEver.Concat(allJournalEver).Concat(allProgressEver).ToList();
        TotalActiveDaysEver = allEver
            .Select(ms => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime))
            .Distinct().Count();
        var allEverDateSet = allEver
            .Select(ms => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime))
            .ToHashSet();
        for (int spi = 0; spi < 7; spi++)
            Last7DaysActive[spi] = allEverDateSet.Contains(DateOnly.FromDateTime(DateTime.Today.AddDays(-6 + spi)));
        if (allEver.Count >= 5)
        {
            var bestDayGroup = allEver
                .GroupBy(ms => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime))
                .OrderByDescending(g => g.Count())
                .FirstOrDefault();
            if (bestDayGroup is not null && bestDayGroup.Count() >= 3)
            {
                BestDayEverDate = bestDayGroup.Key.ToString("MMMM d, yyyy");
                BestDayEverCount = bestDayGroup.Count();
            }

            var bestMonthGroup = allEver
                .GroupBy(ms => DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime.ToString("yyyy-MM"))
                .OrderByDescending(g => g.Count())
                .FirstOrDefault();
            if (bestMonthGroup is not null && bestMonthGroup.Count() >= 5)
            {
                if (DateTime.TryParseExact(bestMonthGroup.Key + "-01", "yyyy-MM-dd", null, System.Globalization.DateTimeStyles.None, out var bmd))
                    BestMonthEver = bmd.ToString("MMMM yyyy");
                BestMonthEverCount = bestMonthGroup.Count();
            }

            var quarterGroups = allProgressEver
                .GroupBy(ms => { var d = DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime; return (d.Year * 10) + ((d.Month - 1) / 3 + 1); })
                .ToList();
            if (quarterGroups.Count >= 2)
            {
                var bestQ = quarterGroups.OrderByDescending(g => g.Count()).First();
                var qNum = bestQ.Key % 10;
                var qYear = bestQ.Key / 10;
                string[] qLabels = ["Q1 (Jan–Mar)", "Q2 (Apr–Jun)", "Q3 (Jul–Sep)", "Q4 (Oct–Dec)"];
                MostProductiveQuarter = $"{qLabels[qNum - 1]} {qYear}";
                MostProductiveQuarterCount = bestQ.Count();
            }
        }
    }

    private async Task LoadInsights()
    {
        var nowMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        var day30Ms = DateTimeOffset.UtcNow.AddDays(-30).ToUnixTimeMilliseconds();
        var day7Ms = DateTimeOffset.UtcNow.AddDays(-7).ToUnixTimeMilliseconds();
        var day14Ms = DateTimeOffset.UtcNow.AddDays(-14).ToUnixTimeMilliseconds();

        var last30 = await Db.AnalyticsEvents
            .Where(e => e.AccountGuid == AccountGuid && e.Timestamp >= day30Ms)
            .ToListAsync();

        TotalLast30 = last30.Count;
        TotalThisWeek = last30.Count(e => e.Timestamp >= day7Ms);
        TotalLastWeek = last30.Count(e => e.Timestamp >= day14Ms && e.Timestamp < day7Ms);

        var activeDates = last30
            .Select(e => DateTimeOffset.FromUnixTimeMilliseconds(e.Timestamp).LocalDateTime.Date)
            .ToHashSet();
        ActiveDaysLast30 = activeDates.Count;

        // Current streak: consecutive days ending today with at least one action
        var today = DateTimeOffset.UtcNow.LocalDateTime.Date;
        CurrentStreak = 0;
        var streakDay = today;
        while (activeDates.Contains(streakDay))
        {
            CurrentStreak++;
            streakDay = streakDay.AddDays(-1);
        }

        TopEvents = last30
            .Where(e => e.EventName != "page_view")
            .GroupBy(e => e.EventName)
            .OrderByDescending(g => g.Count())
            .Take(8)
            .ToDictionary(g => g.Key, g => g.Count());

        PageViews = last30
            .Where(e => e.EventName == "page_view" && e.Page != null)
            .GroupBy(e => e.Page!)
            .OrderByDescending(g => g.Count())
            .ToDictionary(g => g.Key, g => g.Count());

        BuildDailyChart(last30, day14Ms, nowMs);

        var dayGroups = last30
            .GroupBy(e => DateTimeOffset.FromUnixTimeMilliseconds(e.Timestamp).LocalDateTime.DayOfWeek)
            .OrderByDescending(g => g.Count())
            .FirstOrDefault();
        if (dayGroups is not null && dayGroups.Count() >= 3)
        {
            MostActiveDayName = dayGroups.Key.ToString();
            MostActiveDayCount = dayGroups.Count();
        }
    }

    private void BuildDailyChart(List<AnalyticsEvent> events, long fromMs, long nowMs)
    {
        var today = DateTimeOffset.UtcNow.LocalDateTime.Date;
        var labels = new string[14];
        var counts = new double[14];

        for (int i = 13; i >= 0; i--)
        {
            var d = today.AddDays(-(13 - i));
            labels[i] = d.ToString("M/d");
            var startMs = new DateTimeOffset(DateTime.SpecifyKind(d, DateTimeKind.Local)).ToUnixTimeMilliseconds();
            var endMs = startMs + 86_400_000L;
            counts[i] = events.Count(e => e.Timestamp >= startMs && e.Timestamp < endMs);
        }

        DailyChartLabels = labels;
        DailyChartSeries = [new ChartSeries { Name = "Actions", Data = counts }];
    }

