@if (GoalMomentumRanking.Count >= 2)
{
    var gmMax = Math.Max(GoalMomentumRanking.Max(x => x.Notes28d), 1);
    <MudPaper Elevation="1" Class="pa-4 mb-6" Style="border-radius:14px;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Speed" Color="Color.Primary" Size="Size.Small" />
            <MudText Typo="Typo.subtitle2" Style="flex:1;">Goal Momentum — Last 28 Days</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">WoW trend →</MudText>
        </MudStack>
        @foreach (var (name, guid, notes28d, notes7d, priorNotes7d) in GoalMomentumRanking)
        {
            var gmPct = (int)(notes28d * 100.0 / gmMax);
            var gmColor = notes28d == 0 ? "var(--mud-palette-text-disabled)" : gmPct >= 80 ? "var(--mud-palette-success)" : gmPct >= 40 ? "var(--mud-palette-primary)" : "var(--mud-palette-warning)";
            var gmLabel = name.Length > 40 ? name[..40] + "…" : name;
            var wowDelta = notes7d - priorNotes7d;
            var (wowIcon, wowColor, wowTip) = wowDelta > 0
                ? (Icons.Material.Filled.TrendingUp, Color.Success, $"+{wowDelta} vs prior week")
                : wowDelta < 0
                    ? (Icons.Material.Filled.TrendingDown, Color.Warning, $"{wowDelta} vs prior week")
                    : (Icons.Material.Filled.TrendingFlat, Color.Default, "Same pace as prior week");
            var showTrend = notes7d > 0 || priorNotes7d > 0;
            <MudStack Spacing="0" Class="mb-2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudLink Href="@($"/goals/{guid}")" Typo="Typo.body2" Style="flex:1;font-weight:500;">@gmLabel</MudLink>
                    @if (showTrend)
                    {
                        <MudTooltip Text="@wowTip">
                            <MudIcon Icon="@wowIcon" Color="@wowColor" Size="Size.Small" />
                        </MudTooltip>
                    }
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="min-width:55px;text-align:right;">@notes28d note@(notes28d == 1 ? "" : "s")</MudText>
                </MudStack>
                <div style="background:var(--mud-palette-lines-default);border-radius:4px;height:6px;overflow:hidden;">
                    <div style="@($"width:{gmPct}%;background:{gmColor};height:100%;border-radius:4px;")"></div>
                </div>
            </MudStack>
        }
    </MudPaper>
}
@{
    var commitScore = Math.Min(
        Math.Min(CurrentStreak * 3, 30) +
        Math.Min(ActiveDaysLast30 * 2, 40) +
        Math.Min(GoalProgressTotal, 30),
