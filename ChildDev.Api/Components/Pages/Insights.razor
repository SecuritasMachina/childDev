    <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.CalendarToday" Class="mb-6" Dense="true">
        📅 Your most active progress day is <strong>@TopProgressWeekday</strong> — @TopProgressWeekdayCount notes logged on that day in the last 5 weeks! Keep the @TopProgressWeekday momentum going! 💪
    </MudAlert>
}

@{
    var wdOrdered = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };
    var wdShort = new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };
    var wdDict = WeekdayLeaderboard.Count >= 3
        ? WeekdayLeaderboard.ToDictionary(x => x.Day, x => x.Count)
        : new Dictionary<string, int>();
    var wdMax = WeekdayLeaderboard.Count >= 3 ? WeekdayLeaderboard.Max(x => x.Count) : 0;
    var wdBest = WeekdayLeaderboard.Count >= 3 ? WeekdayLeaderboard[0].Day : "";
}
@if (WeekdayLeaderboard.Count >= 3)
{
    <MudPaper Elevation="1" Class="pa-3 mb-6" Style="border-radius:12px;">
        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight:600;letter-spacing:0.5px;" Class="mb-3">
            📊 Activity by Day of Week (last 90 days)
        </MudText>
        @for (int wdi = 0; wdi < 7; wdi++)
        {
            var wdFullName = wdOrdered[wdi];
            var wdLabel = wdShort[wdi];
            var wdCount = wdDict.GetValueOrDefault(wdFullName, 0);
            var wdBarPct = wdMax > 0 ? (int)(wdCount * 100.0 / wdMax) : 0;
            var wdIsBest = wdFullName == wdBest && wdCount > 0;
            var wdBarColor = wdIsBest ? "var(--mud-palette-warning)" : wdi < 5 ? "var(--mud-palette-primary)" : "var(--mud-palette-secondary)";
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:5px;">
                <span style="font-size:0.75rem;font-weight:@(wdIsBest ? "700" : "400");min-width:30px;color:var(--mud-palette-text-@(wdIsBest ? "primary" : "secondary"));">@wdLabel</span>
                <div style="flex:1;background:var(--mud-palette-lines-default);border-radius:4px;height:12px;overflow:hidden;">
                    <div style="width:@(wdBarPct)%;height:100%;background:@wdBarColor;border-radius:4px;transition:width .4s ease;"></div>
                </div>
                <span style="font-size:0.7rem;color:var(--mud-palette-text-secondary);min-width:24px;text-align:right;">@wdCount</span>
                @if (wdIsBest) { <span style="font-size:0.7rem;">🏆</span> }
            </div>
        }
    </MudPaper>
}

