@page "/insights"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor
@inject WebAnalyticsService Analytics
@implements IDisposable

<PageTitle>My Insights – LevelUp</PageTitle>

@if (AccountGuid is null)
{
    Nav.NavigateTo("/login");
    return;
}

<MudText Typo="Typo.h5" Class="mb-4">
    <MudIcon Icon="@Icons.Material.Filled.BarChart" Class="mr-2" />
    My Activity Insights
</MudText>

@* Auto-generated progress narrative *@
@{
    var narStreak = CurrentStreak >= 7 ? $"You're on a 🔥 {CurrentStreak}-day streak — that's incredible consistency!"
                  : CurrentStreak >= 3 ? $"You've got a {CurrentStreak}-day streak going — keep it alive!"
                  : CurrentStreak == 1 ? "You got active today — a streak starts with day one! 🌱"
                  : ActiveDaysLast30 > 0 ? "You've had some great active days this month — every session counts!"
                  : "Your journey is waiting — every expert was once a beginner.";
    var narProgress = GoalProgressTotal >= 50
        ? $"With {GoalProgressTotal} progress notes logged, you're at Legendary status — your dedication is extraordinary! 🌟"
        : GoalProgressTotal >= 25
            ? $"You've written {GoalProgressTotal} progress notes — Champion-level commitment! 🏆"
            : GoalProgressTotal >= 10
                ? $"You've logged {GoalProgressTotal} progress notes — you're building real strength! ⭐"
                : GoalProgressTotal >= 5
                    ? $"You've written {GoalProgressTotal} progress notes — momentum is building! 🚀"
                    : GoalProgressTotal >= 1
                        ? $"You've started with {GoalProgressTotal} progress note{(GoalProgressTotal == 1 ? "" : "s")} — every great journey begins here! ⚡"
                        : null;
    var narGoals = GoalsCompletedAllTime >= 5
        ? $"And you've completed {GoalsCompletedAllTime} goals — that track record proves you're someone who finishes what they start. 🎯"
        : GoalsCompletedAllTime >= 1
            ? $"You've already completed {GoalsCompletedAllTime} goal{(GoalsCompletedAllTime == 1 ? "" : "s")} — proof that you can make it happen. 🎯"
            : TopGoalName is not null
                ? $"Your most-worked goal — \"{(TopGoalName.Length > 40 ? TopGoalName[..40] + "…" : TopGoalName)}\" — shows where your heart is. Keep going! 💪"
                : null;
}
@if (narProgress is not null)
{
    <MudPaper Elevation="2" Class="pa-4 mb-6" Style="border-radius:16px;background:linear-gradient(135deg,rgba(57,73,171,.06) 0%,rgba(255,255,255,0) 100%);border-left:4px solid var(--mud-palette-primary);">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.AutoStories" Color="Color.Primary" />
            <MudText Typo="Typo.subtitle2" Color="Color.Primary" Style="font-weight:700;">Your Progress Story</MudText>
        </MudStack>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">@narStreak</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">@narProgress</MudText>
        @if (narGoals is not null)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">@narGoals</MudText>
        }
    </MudPaper>
}

@if (JourneyYears >= 1)
{
    var annMsg = JourneyYears >= 2
        ? $"🗓️ <strong>You've been on this journey for {JourneyYears} years!</strong> That kind of long-term commitment is rare — you should be incredibly proud of how far you've come!"
        : "🗓️ <strong>One full year on this journey!</strong> 365 days of setting goals and showing up — that's a real transformation. Here's to the next year! 🥳";
    <MudAlert Severity="Severity.Success" Icon="@Icons.Material.Filled.Celebration" Dense="true" Class="mb-4">@((MarkupString)annMsg)</MudAlert>
}
else if (JourneyMonths >= 6)
{
    var moMsg = JourneyMonths >= 9
        ? $"🌟 <strong>Nearly a year on your journey!</strong> {JourneyMonths} months of goal-setting — you're building something truly lasting."
        : $"🌱 <strong>{JourneyMonths} months into your journey!</strong> Half a year of working toward your goals — the consistency is paying off!";
    <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.AutoAwesome" Dense="true" Class="mb-4">@((MarkupString)moMsg)</MudAlert>
}
@* Domain achievement stats *@
<MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-2" Style="text-transform:uppercase;letter-spacing:1px;">
    Achievements
</MudText>
<MudGrid Class="mb-6">
    <MudItem xs="6" sm="3">
        <MudPaper Elevation="2" Class="pa-4 text-center stat-card-goals" Style="border-radius:12px;">
            <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Warning" Style="font-size:2rem;" />
            <MudText Typo="Typo.h4" Class="mt-1">@GoalsCompletedAllTime</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Goal@(GoalsCompletedAllTime == 1 ? "" : "s") Completed</MudText>
            @if (GoalsCompletedAllTime >= 3 && GoalsTotalAllTime > 0)
            {
                var gcPct = (int)Math.Round(GoalsCompletedAllTime * 100.0 / GoalsTotalAllTime);
                <MudText Typo="Typo.caption" Color="@(gcPct >= 60 ? Color.Success : Color.Info)">@gcPct% completion rate</MudText>
            }
            @if (YtdGoalsCompleted >= 2)
            {
                <MudText Typo="Typo.caption" Color="Color.Success">🎯 @YtdGoalsCompleted this year!</MudText>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Elevation="2" Class="pa-4 text-center stat-card-todos" Style="border-radius:12px;">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Style="font-size:2rem;" />
            <MudText Typo="Typo.h4" Class="mt-1">@TodosCompletedAllTime</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Todo@(TodosCompletedAllTime == 1 ? "" : "s") Done</MudText>
            @if (YtdTodosCompleted >= 5)
            {
                <MudText Typo="Typo.caption" Color="Color.Success">🎯 @YtdTodosCompleted this year!</MudText>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Elevation="2" Class="pa-4 text-center stat-card-journal" Style="border-radius:12px;">
            <MudIcon Icon="@Icons.Material.Filled.Book" Color="Color.Info" Style="font-size:2rem;" />
            <MudText Typo="Typo.h4" Class="mt-1">@JournalTotal</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Journal Entries</MudText>
            @if (JournalAvgPerMonth >= 1)
            {
                <MudText Typo="Typo.caption" Color="Color.Info">avg @JournalAvgPerMonth.ToString("F1")/month</MudText>
            }
            @if (TotalJournalWords >= 50)
            {
                var jwLabel = TotalJournalWords >= 10000 ? $"📖 {TotalJournalWords / 1000}k words" : $"📝 {TotalJournalWords} words";
                <MudText Typo="Typo.caption" Color="Color.Secondary">@jwLabel</MudText>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Elevation="2" Class="pa-4 text-center" Style="border-radius:12px;border-left:4px solid #7986CB;">
            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Primary" Style="font-size:2rem;" />
            <MudText Typo="Typo.h4" Class="mt-1">@GoalProgressTotal</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Progress Notes</MudText>
            @if (GoalProgressTotal >= 5)
            {
                var insightLevel = GoalProgressTotal >= 50 ? "🌟 Legendary" : GoalProgressTotal >= 25 ? "🏆 Champion" : GoalProgressTotal >= 10 ? "⭐ Strong" : GoalProgressTotal >= 5 ? "🚀 Momentum" : "⚡ Getting Started";
                <MudText Typo="Typo.caption" Color="Color.Warning">@insightLevel pace!</MudText>
            }
            @if (TotalActiveDaysEver >= 10)
            {
                <MudText Typo="Typo.caption" Color="Color.Info">📅 Active on @TotalActiveDaysEver days ever!</MudText>
            }
            @if (GoalsTotalAllTime >= 3 && GoalProgressTotal >= 3)
            {
                var apgAvg = (GoalProgressTotal / (double)GoalsTotalAllTime);
                <MudText Typo="Typo.caption" Color="Color.Secondary">avg @apgAvg.ToString("F1") notes/goal</MudText>
            }
            @if (AvgProgressNotesPerWeek >= 0.5)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">avg @AvgProgressNotesPerWeek.ToString("F1")/week</MudText>
            }
            @if (TotalProgressNoteWords >= 50)
            {
                var pwLabel = TotalProgressNoteWords >= 10000 ? $"✍️ {TotalProgressNoteWords / 1000}k words" : $"✍️ {TotalProgressNoteWords} words";
                <MudText Typo="Typo.caption" Color="Color.Secondary">@pwLabel</MudText>
            }
            @if (TotalActiveDaysEver >= 14 && TotalLast30 >= 3)
            {
                var vtAllTimePace = GoalProgressTotal / (double)TotalActiveDaysEver;
                var vtRecentPace = TotalLast30 / 30.0;
                var vtPct = (int)Math.Round(vtRecentPace / vtAllTimePace * 100);
                var vtLabel = vtPct >= 120 ? $"📈 {vtPct}% of avg pace — accelerating!" : vtPct >= 80 ? $"✅ {vtPct}% of avg pace — on track!" : $"📉 {vtPct}% of avg pace — pick it up!";
                <MudText Typo="Typo.caption" Color="@(vtPct >= 80 ? Color.Success : Color.Warning)">@vtLabel</MudText>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@{
    Severity freshSeverity = Severity.Normal;
    string? freshMsg = null;
    if (DaysSinceLastProgress == 0) { freshSeverity = Severity.Success; freshMsg = "🔥 You logged a progress note today — keep that momentum going!"; }
    else if (DaysSinceLastProgress == 1) { freshSeverity = Severity.Success; freshMsg = "⭐ Last progress note was yesterday — great consistency!"; }
    else if (DaysSinceLastProgress <= 3) { freshSeverity = Severity.Success; freshMsg = $"💪 Last progress note was {DaysSinceLastProgress} days ago — solid consistency!"; }
    else if (DaysSinceLastProgress <= 7) { freshSeverity = Severity.Info; freshMsg = $"📝 It's been {DaysSinceLastProgress} days since your last progress note — ready to log another update?"; }
    else if (DaysSinceLastProgress <= 13) { freshSeverity = Severity.Warning; freshMsg = $"⏰ {DaysSinceLastProgress} days since your last progress note — your goals are waiting!"; }
    else if (DaysSinceLastProgress >= 14) { freshSeverity = Severity.Warning; freshMsg = $"🌱 It's been {DaysSinceLastProgress} days since your last progress note. Every note moves you forward — add one today!"; }
}
@if (freshMsg is not null)
{
    <MudAlert Severity="@freshSeverity" Class="mb-4" Dense="true">@freshMsg</MudAlert>
}
@if (NotesThisWeekProgress > 0 || NotesLastWeekProgress > 0)
{
    var wowPMsg = NotesLastWeekProgress == 0
        ? $"📈 {NotesThisWeekProgress} progress note{(NotesThisWeekProgress == 1 ? "" : "s")} this week — great start! Keep the momentum going!"
        : NotesThisWeekProgress > NotesLastWeekProgress
            ? $"📈 <strong>{NotesThisWeekProgress} notes this week</strong> vs {NotesLastWeekProgress} last week — you're stepping it up! 🚀"
            : NotesThisWeekProgress == NotesLastWeekProgress
                ? $"📊 <strong>{NotesThisWeekProgress} progress notes this week</strong>, same as last week — rock-solid consistency!"
                : $"📉 {NotesThisWeekProgress} notes this week vs {NotesLastWeekProgress} last week — can you match last week's pace?";
    var wowPSeverity = NotesLastWeekProgress == 0 || NotesThisWeekProgress >= NotesLastWeekProgress ? Severity.Success : Severity.Normal;
    <MudAlert Severity="@wowPSeverity" Icon="@Icons.Material.Filled.TrendingUp" Dense="true" Class="mb-4">@((MarkupString)wowPMsg)</MudAlert>
}
@if (ActiveDaysThisWeek > 0 || ActiveDaysLastWeek > 0)
{
    var adMsg = ActiveDaysLastWeek == 0
        ? $"📅 You were active on <strong>{ActiveDaysThisWeek} day{(ActiveDaysThisWeek == 1 ? "" : "s")}</strong> this week — great consistency!"
        : ActiveDaysThisWeek > ActiveDaysLastWeek
            ? $"📅 <strong>{ActiveDaysThisWeek} active days this week</strong> vs {ActiveDaysLastWeek} last week — you're showing up more! 🌟"
            : ActiveDaysThisWeek == ActiveDaysLastWeek
                ? $"📅 <strong>{ActiveDaysThisWeek} active days</strong> this week and last — beautifully consistent!"
                : $"📅 {ActiveDaysThisWeek} active day{(ActiveDaysThisWeek == 1 ? "" : "s")} this week vs {ActiveDaysLastWeek} last week — aim to match or beat last week!";
    var adSeverity = ActiveDaysLastWeek == 0 || ActiveDaysThisWeek >= ActiveDaysLastWeek ? Severity.Info : Severity.Normal;
    <MudAlert Severity="@adSeverity" Icon="@Icons.Material.Filled.CalendarToday" Dense="true" Class="mb-4">@((MarkupString)adMsg)</MudAlert>
}
@if (TotalActiveDaysEver >= 7)
{
    var sphDotStr = string.Concat(Enumerable.Range(0, 7).Select(i => Last7DaysActive[i] ? "✅" : "⬜"));
    var sphActiveCount = Last7DaysActive.Count(b => b);
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-4">
        Your last 7 days: @sphDotStr (@sphActiveCount active)
    </MudText>
}
@if (JournalStreak >= 2)
{
    var jStreakMsg = JournalStreak >= 14 ? $"📓 Journal streak: {JournalStreak} days — that's exceptional consistency! Your reflections are building something meaningful. 🌟"
                  : JournalStreak >= 7  ? $"📓 Journal streak: {JournalStreak} days! A full week of journaling — you're building a powerful habit! 💪"
                  :                       $"📓 Journal streak: {JournalStreak} days! Keep writing — every entry adds to your story!";
    <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.Book" Dense="true" Class="mb-4">
        @jStreakMsg
    </MudAlert>
}

@if (JournalConsistencyScore30 >= 3)
{
    var jcsPct = (int)(JournalConsistencyScore30 * 100.0 / 30);
    var jcsMsg = jcsPct >= 80 ? $"📓 <strong>{jcsPct}% journaling consistency</strong> last month — {JournalConsistencyScore30} active days! Exceptional habit building!"
              : jcsPct >= 50 ? $"📓 <strong>{jcsPct}% journaling consistency</strong> — {JournalConsistencyScore30} active days this month. You're building a solid reflection habit!"
              :                 $"📓 You journaled on {JournalConsistencyScore30} days last month ({jcsPct}% consistency) — every entry counts!";
    <MudAlert Severity="@(jcsPct >= 80 ? Severity.Success : Severity.Info)" Icon="@Icons.Material.Filled.Book" Dense="true" Class="mb-4">@((MarkupString)jcsMsg)</MudAlert>
}
@if (JournalConsistencyScoreYear >= 5 && JournalYearDaysElapsed >= 14)
{
    var jcyPct = (int)(JournalConsistencyScoreYear * 100.0 / JournalYearDaysElapsed);
    var jcyMsg = jcyPct >= 50 ? $"📓 <strong>{jcyPct}% journaling consistency this year</strong> — {JournalConsistencyScoreYear} days logged out of {JournalYearDaysElapsed}! You're making reflection a real habit!"
               : jcyPct >= 25 ? $"📓 You've journaled on <strong>{JournalConsistencyScoreYear} days</strong> this year ({jcyPct}% consistency) — every entry builds your story!"
               :                 $"📓 {JournalConsistencyScoreYear} journaling days so far this year — {jcyPct}% consistency. Keep going — small steps add up!";
    <MudAlert Severity="@(jcyPct >= 50 ? Severity.Success : Severity.Info)" Icon="@Icons.Material.Filled.CalendarMonth" Dense="true" Class="mb-4">@((MarkupString)jcyMsg)</MudAlert>
}
@if (LongestProgressDayStreak >= 3)
{
    var lpsMsg = LongestProgressDayStreak >= 14 ? $"🌟 All-time best: <strong>{LongestProgressDayStreak} consecutive days</strong> logging progress — that's legendary dedication!"
              : LongestProgressDayStreak >= 7  ? $"🏆 Your longest daily streak ever: <strong>{LongestProgressDayStreak} days</strong> in a row — champion-level consistency!"
              :                                   $"⭐ Your longest daily streak: <strong>{LongestProgressDayStreak} days</strong> in a row — every streak starts with one day!";
    <MudAlert Severity="Severity.Success" Icon="@Icons.Material.Filled.LocalFireDepartment" Dense="true" Class="mb-4">@((MarkupString)lpsMsg)</MudAlert>
}
@if (BestProgressDayOfWeek is not null)
{
    <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.CalendarToday" Dense="true" Class="mb-4">
        📅 You log the most progress notes on <strong>@BestProgressDayOfWeek</strong>s (@BestProgressDayOfWeekCount total) — that's your power day!
    </MudAlert>
}
@if (ProgressTimeOfDay is not null)
{
    <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.Schedule" Dense="true" Class="mb-4">
        ⏰ You tend to log progress notes in the <strong>@ProgressTimeOfDay</strong> — lean into that rhythm for maximum consistency!
    </MudAlert>
}
@if (BestJournalDayOfWeek is not null)
{
    <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.MenuBook" Dense="true" Class="mb-4">
        📓 You journal most on <strong>@BestJournalDayOfWeek</strong>s (@BestJournalDayOfWeekCount entries total) — make that your reflection ritual!
    </MudAlert>
}
@if (JournalTimeOfDay is not null)
{
    <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.Schedule" Dense="true" Class="mb-4">
        📓 You tend to journal in the <strong>@JournalTimeOfDay</strong> — that's your natural reflection time. Lean into it for daily consistency!
    </MudAlert>
}
@if (CompletionVelocityMsg is not null)
{
    <MudAlert Severity="Severity.Success" Icon="@Icons.Material.Filled.Speed" Dense="true" Class="mb-4">@CompletionVelocityMsg</MudAlert>
}
@if (RecentCompletedGoals.Count >= 1)
{
    <MudPaper Elevation="1" Class="pa-4 mb-4" Style="border-radius:12px;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
            <MudText Typo="Typo.body2" Style="font-weight:700;">🏆 Recent Goal Wins</MudText>
        </MudStack>
        @foreach (var (guid, name, completionDate, enteredDate) in RecentCompletedGoals)
        {
            var rcgDone = DateTimeOffset.FromUnixTimeMilliseconds(completionDate).LocalDateTime;
            var rcgDays = Math.Max((int)((completionDate - enteredDate) / 86_400_000L), 1);
            var rcgDur = rcgDays >= 365 ? $"{rcgDays / 365}yr" : rcgDays >= 30 ? $"{rcgDays / 30}mo" : $"{rcgDays}d";
            var rcgName = name.Length > 50 ? name[..50] + "…" : name;
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Success" Size="Size.Small" />
                <MudStack Spacing="0" Style="flex:1;">
                    <MudText Typo="Typo.body2" Style="font-weight:600;">@rcgName</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Completed @rcgDone.ToString("MMM d, yyyy") · @rcgDur journey</MudText>
                </MudStack>
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                           Href="@($"/goals/{guid}")">View</MudButton>
            </MudStack>
        }
    </MudPaper>
}
@if (GoalsTotalAllTime > 0)
{
    var completionPct = GoalsTotalAllTime == 0 ? 0 : (int)(GoalsCompletedAllTime * 100.0 / GoalsTotalAllTime);
    var rateColor = completionPct >= 75 ? Color.Success : completionPct >= 40 ? Color.Warning : Color.Default;
    <MudPaper Elevation="1" Class="pa-4 mb-4" Style="border-radius:12px;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.PieChart" Color="@rateColor" Size="Size.Small" Class="mr-1" />
            <MudText Typo="Typo.body2" Style="flex:1">Goal Completion Rate</MudText>
            <MudText Typo="Typo.body2" Style="font-weight:600;">@GoalsCompletedAllTime of @GoalsTotalAllTime</MudText>
            <MudChip T="string" Size="Size.Small" Color="@rateColor" Class="ml-2">@completionPct%</MudChip>
        </MudStack>
        <MudProgressLinear Value="@completionPct" Color="@rateColor" Rounded="true" Size="Size.Medium" />
        @if (completionPct >= 75 && GoalsTotalAllTime >= 3)
        {
            <MudAlert Severity="Severity.Success" Icon="@Icons.Material.Filled.EmojiEvents" Dense="true" Class="mt-3">
                🏆 <strong>Completionist!</strong> You complete @completionPct% of your goals — that's extraordinary follow-through! Keep setting and conquering!
            </MudAlert>
        }
        @if (AvgGoalCompletionDays > 0)
        {
            var avgDurStr = AvgGoalCompletionDays >= 365
                ? $"~{AvgGoalCompletionDays / 365} year{(AvgGoalCompletionDays / 365 == 1 ? "" : "s")}"
                : AvgGoalCompletionDays >= 30
                    ? $"~{AvgGoalCompletionDays / 30} month{(AvgGoalCompletionDays / 30 == 1 ? "" : "s")}"
                    : $"~{AvgGoalCompletionDays} day{(AvgGoalCompletionDays == 1 ? "" : "s")}";
            var avgDurMsg = AvgGoalCompletionDays <= 14
                ? "lightning-fast achievement!"
                : AvgGoalCompletionDays <= 60
                    ? "solid, focused commitment."
                    : "deep, long-term dedication.";
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-3">
                <MudIcon Icon="@Icons.Material.Filled.Timer" Size="Size.Small" Color="Color.Info" />
                <MudText Typo="Typo.body2">
                    Average goal takes you <strong>@avgDurStr</strong> to complete — @avgDurMsg
                </MudText>
            </MudStack>
        }
        @if (FastestGoalDays >= 1 && FastestGoalName is not null)
        {
            var fgDurStr = FastestGoalDays >= 30 ? $"{FastestGoalDays / 30} month{(FastestGoalDays / 30 == 1 ? "" : "s")}" : $"{FastestGoalDays} day{(FastestGoalDays == 1 ? "" : "s")}";
            var fgName = FastestGoalName.Length > 45 ? FastestGoalName[..45] + "…" : FastestGoalName;
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-2">
                <MudIcon Icon="@Icons.Material.Filled.Bolt" Size="Size.Small" Color="Color.Warning" />
                <MudText Typo="Typo.body2">
                    Fastest win: <strong>"@fgName"</strong> in @fgDurStr ⚡
                </MudText>
            </MudStack>
        }
    </MudPaper>
}

@if (GoalsTotalAllTime >= 2 && GoalsWithMeasurableOutcome >= 1)
{
    var gmoActiveCount = GoalsTotalAllTime - GoalsCompletedAllTime;
    var gmoPct = (int)(GoalsWithMeasurableOutcome * 100.0 / Math.Max(GoalsTotalAllTime, 1));
    var gmoMsg = gmoPct >= 80
        ? $"🎯 <strong>{GoalsWithMeasurableOutcome} of {GoalsTotalAllTime} goals have clear measurable targets</strong> — goals with targets are far more likely to succeed!"
        : gmoPct >= 50
        ? $"🎯 <strong>{GoalsWithMeasurableOutcome} of {GoalsTotalAllTime} goals</strong> have measurable outcomes set. Adding targets to more goals helps you track success!"
        : $"💡 <strong>{GoalsWithMeasurableOutcome} of {GoalsTotalAllTime} goals</strong> have a measurable target set — consider adding outcomes to the rest for better tracking!";
    <MudAlert Severity="@(gmoPct >= 80 ? Severity.Success : Severity.Info)" Icon="@Icons.Material.Filled.TrackChanges" Dense="true" Class="mb-4">@((MarkupString)gmoMsg)</MudAlert>
}
@if (LongestActiveGoalDays >= 14 && !string.IsNullOrWhiteSpace(LongestActiveGoalName))
{
    var lgDuration = LongestActiveGoalDays >= 365
        ? $"{LongestActiveGoalDays / 365} year{(LongestActiveGoalDays / 365 == 1 ? "" : "s")}"
        : LongestActiveGoalDays >= 30
            ? $"{LongestActiveGoalDays / 30} month{(LongestActiveGoalDays / 30 == 1 ? "" : "s")}"
            : $"{LongestActiveGoalDays} days";
    var lgName = LongestActiveGoalName.Length > 50 ? LongestActiveGoalName[..50] + "…" : LongestActiveGoalName;
    <MudAlert Severity="Severity.Success" Icon="@Icons.Material.Filled.AccessTime" Dense="true" Class="mb-4">
        🌱 <strong>Long-term commitment!</strong> "@lgName" has been an active goal for <strong>@lgDuration</strong> — that kind of persistence is truly admirable!
        @if (!string.IsNullOrWhiteSpace(LongestActiveGoalGuid))
        {
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success"
                       Href="@($"/goals/{LongestActiveGoalGuid}")" Class="ml-1">View</MudButton>
        }
    </MudAlert>
}

@if (TopMoods.Count > 0)
{
    var moodNow = DateTimeOffset.Now.LocalDateTime;
    var thisMonthLabel = moodNow.ToString("MMMM");
    var lastMonthLabel = moodNow.AddMonths(-1).ToString("MMMM");
    var showTrend = ThisMonthMoods.Count > 0 && LastMonthMoods.Count > 0;
    <MudPaper Elevation="1" Class="pa-3 mb-6" Style="border-radius:12px;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.Mood" Color="Color.Secondary" />
            <MudText Typo="Typo.body2" Style="font-weight:600;">Your top moods</MudText>
        </MudStack>
        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mb-2">
            @foreach (var (mood, count) in TopMoods)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">@mood (@count)</MudChip>
            }
        </MudStack>
        @if (showTrend)
        {
            var thisMoodTop = ThisMonthMoods.Count > 0 ? ThisMonthMoods[0].Mood : null;
            var lastMoodTop = LastMonthMoods.Count > 0 ? LastMonthMoods[0].Mood : null;
            var moodShift = thisMoodTop != null && lastMoodTop != null && thisMoodTop != lastMoodTop
                ? $"Top mood shifted: {lastMoodTop} → {thisMoodTop} this month"
                : thisMoodTop != null && lastMoodTop != null && thisMoodTop == lastMoodTop
                ? $"Consistent top mood: {thisMoodTop} ✅"
                : null;
            <MudDivider Class="my-2" />
            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight:600;letter-spacing:0.5px;" Class="mb-1">Mood trend</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">@lastMonthLabel</MudText>
                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                        @foreach (var (mood, count) in LastMonthMoods)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" Style="font-size:0.7rem;height:22px;">@mood @count×</MudChip>
                        }
                    </MudStack>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.caption" Color="Color.Primary" Class="mb-1" Style="font-weight:600;">@thisMonthLabel</MudText>
                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                        @foreach (var (mood, count) in ThisMonthMoods)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled" Style="font-size:0.7rem;height:22px;">@mood @count×</MudChip>
                        }
                    </MudStack>
                </MudItem>
            </MudGrid>
            @if (moodShift is not null)
            {
                <MudText Typo="Typo.caption" Color="Color.Info" Class="mt-1">📊 @moodShift</MudText>
            }
        }
        else if (ThisMonthMoods.Count > 0)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                @thisMonthLabel: @string.Join(", ", ThisMonthMoods.Select(m => $"{m.Mood} {m.Count}×"))
            </MudText>
        }
    </MudPaper>
}

