@page "/settings"
@inject AppDbContext Db
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor
@inject ISnackbar Snackbar
@inject WebAnalyticsService Analytics
@inject IJSRuntime JS

<PageTitle>Settings – ChildDev</PageTitle>

@if (AccountGuid is null)
{
    Nav.NavigateTo("/login");
    return;
}

<MudText Typo="Typo.h5" Class="mb-4">
    <MudIcon Icon="@Icons.Material.Filled.Settings" Class="mr-2" />
    Account Settings
</MudText>

<MudGrid>
    <MudItem xs="12" sm="6">
        <MudCard Elevation="2" Class="mb-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Account Info</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Nickname</MudText>
                <MudText Typo="Typo.body1" Class="mb-3">@CurrentNickName</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Account ID</MudText>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-3">
                    <MudText Typo="Typo.caption" Style="font-family:monospace;flex:1;">@AccountGuid</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Color="Color.Primary"
                                   title="Copy Account ID" OnClick="CopyAccountId" />
                </MudStack>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Member Since</MudText>
                <MudText Typo="Typo.body1">@CreatedOnDisplay</MudText>
            </MudCardContent>
        </MudCard>

        @if (TotalGoals > 0 || TotalProgressNotes > 0)
        {
            <MudCard Elevation="2" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Your Progress at a Glance</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid Spacing="2">
                        <MudItem xs="6">
                            <MudText Typo="Typo.h5" Color="Color.Primary">@TotalGoals</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Total Goals</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.h5" Color="Color.Success">@TotalProgressNotes</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Progress Notes</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.h5" Color="Color.Info">@TotalJournalEntries</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Journal Entries</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.h5" Color="Color.Warning">@TotalTodosCompleted<span style="font-size:1rem;opacity:.6;">/@TotalTodos</span></MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Todos Done</MudText>
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>
        }

        <MudCard Elevation="2" Class="mb-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Change Nickname</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudTextField @bind-Value="NewNickName" Label="New Nickname" Variant="Variant.Outlined"
                              Immediate="true" HelperText="1–50 characters" Class="mb-3" />
                @if (NickNameError is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-3">@NickNameError</MudAlert>
                }
            </MudCardContent>
            <MudCardActions Class="px-4 pb-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ChangeNickName"
                           Disabled="@(string.IsNullOrWhiteSpace(NewNickName) || NewNickName.Trim() == CurrentNickName || NewNickName.Trim().Length > 50)">Save Nickname</MudButton>
            </MudCardActions>
        </MudCard>

        <MudCard Elevation="2">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Change PIN</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudTextField @bind-Value="CurrentPin" Label="Current PIN" InputType="InputType.Password"
                              Variant="Variant.Outlined" Immediate="true" Class="mb-3" />
                <MudTextField @bind-Value="NewPin" Label="New PIN" InputType="InputType.Password"
                              Variant="Variant.Outlined" Immediate="true" HelperText="At least 4 characters" Class="mb-3" />
                <MudTextField @bind-Value="ConfirmNewPin" Label="Confirm New PIN" InputType="InputType.Password"
                              Variant="Variant.Outlined" Immediate="true" Class="mb-3"
                              Error="@PinMismatch" ErrorText="PINs do not match" />
                @if (PinError is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-3">@PinError</MudAlert>
                }
            </MudCardContent>
            <MudCardActions Class="px-4 pb-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ChangePin"
                           Disabled="@(string.IsNullOrWhiteSpace(CurrentPin) || NewPin.Length < 4 || NewPin != ConfirmNewPin)">Change PIN</MudButton>
            </MudCardActions>
        </MudCard>
        <MudCard Elevation="2" Class="mb-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Progress Report</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.body2" Class="mb-3">
                    Download a text summary of all your goals, progress notes, and recent journal entries.
                </MudText>
            </MudCardContent>
            <MudCardActions Class="px-4 pb-4">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Download"
                           OnClick="DownloadProgressReport">Download Report</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.DataObject"
                           OnClick="ExportDataJson" Class="ml-2">Export All Data</MudButton>
            </MudCardActions>
        </MudCard>
        <MudCard Elevation="2" Class="mb-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.Android" Style="color:#3DDC84;" />
                        <MudText Typo="Typo.h6">Mobile App Setup</MudText>
                    </MudStack>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.body2" Class="mb-2">
                    To sync your goals with the Android app, enter this Account ID and your PIN during login.
                </MudText>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-3">
                    <MudTextField Value="@AccountGuid" Label="Account ID" Variant="Variant.Outlined"
                                  ReadOnly="true" Style="font-family:monospace;font-size:0.78rem;" />
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Color="Color.Primary"
                                   title="Copy Account ID" OnClick="CopyAccountId" />
                </MudStack>
                <MudLink Href="/downloads/ChildDev.apk" Color="Color.Primary" Style="font-weight:600;">
                    <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small" Class="mr-1" />
                    Download ChildDev for Android
                </MudLink>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private string? AccountGuid;
    private string CurrentNickName = string.Empty;
    private string CreatedOnDisplay = string.Empty;
    private int TotalGoals;
    private int TotalProgressNotes;
    private int TotalJournalEntries;
    private int TotalTodos;
    private int TotalTodosCompleted;

    private string NewNickName = string.Empty;
    private string? NickNameError;

    private string CurrentPin = string.Empty;
    private string NewPin = string.Empty;
    private string ConfirmNewPin = string.Empty;
    private bool PinMismatch => ConfirmNewPin.Length > 0 && NewPin != ConfirmNewPin;
    private string? PinError;

    protected override async Task OnInitializedAsync()
    {
        AccountGuid = HttpContextAccessor.HttpContext?.Session.GetString("AccountGuid");
        if (AccountGuid is null) return;

        var display = await Db.Accounts
            .Where(a => a.Guid == AccountGuid)
            .Select(a => new { a.NickName, a.CreatedOn })
            .FirstOrDefaultAsync();
        if (display is null) { Nav.NavigateTo("/login"); return; }

        CurrentNickName = display.NickName;
        NewNickName = display.NickName;
        CreatedOnDisplay = DateTimeOffset.FromUnixTimeMilliseconds(display.CreatedOn).LocalDateTime.ToString("MMMM d, yyyy");
        TotalGoals = await Db.Goals.CountAsync(g => g.AccountFk == AccountGuid && g.DeletedAt == null);
        TotalProgressNotes = await Db.GoalProgresses.CountAsync(p => p.AccountFk == AccountGuid && p.DeletedAt == null);
        TotalJournalEntries = await Db.Journals.CountAsync(j => j.AccountFk == AccountGuid && j.DeletedAt == null);
        var allTodos = await Db.Todos.Where(t => t.AccountFk == AccountGuid && t.DeletedAt == null).Select(t => t.CompletedAt).ToListAsync();
        TotalTodos = allTodos.Count;
        TotalTodosCompleted = allTodos.Count(c => c != null);
        await Analytics.TrackAsync("page_view", AccountGuid, "settings");
    }

    private async Task ChangeNickName()
    {
        NickNameError = null;
        var nick = NewNickName.Trim();
        if (string.IsNullOrWhiteSpace(nick) || nick.Length > 50)
        {
            NickNameError = "Nickname must be 1–50 characters.";
            return;
        }
        if (nick == CurrentNickName)
        {
            NickNameError = "That's already your nickname.";
            return;
        }
        if (await Db.Accounts.AnyAsync(a => a.NickName == nick && a.Guid != AccountGuid))
        {
            NickNameError = "Nickname already taken.";
            return;
        }

        var rows = await Db.Accounts
            .Where(a => a.Guid == AccountGuid)
            .ExecuteUpdateAsync(s => s.SetProperty(a => a.NickName, nick));
        if (rows == 0) return;
        HttpContextAccessor.HttpContext!.Session.SetString("NickName", nick);
        CurrentNickName = nick;
        await Analytics.TrackAsync("settings_change_nickname", AccountGuid, "settings");
        Snackbar.Add("Nickname updated!", Severity.Success);
    }

    private async Task ChangePin()
    {
        PinError = null;
        if (PinMismatch) return;
        if (string.IsNullOrWhiteSpace(CurrentPin))
        {
            PinError = "Enter your current PIN.";
            return;
        }
        if (NewPin.Length < 4)
        {
            PinError = "New PIN must be at least 4 characters.";
            return;
        }

        var pinHash = await Db.Accounts
            .Where(a => a.Guid == AccountGuid)
            .Select(a => a.PinHash)
            .FirstOrDefaultAsync();
        if (pinHash is null) return;
        if (!BCrypt.Net.BCrypt.Verify(CurrentPin, pinHash))
        {
            PinError = "Current PIN is incorrect.";
            return;
        }

        var newHash = BCrypt.Net.BCrypt.HashPassword(NewPin);
        await Db.Accounts
            .Where(a => a.Guid == AccountGuid)
            .ExecuteUpdateAsync(s => s.SetProperty(a => a.PinHash, newHash));
        CurrentPin = string.Empty;
        NewPin = string.Empty;
        ConfirmNewPin = string.Empty;
        await Analytics.TrackAsync("settings_change_pin", AccountGuid, "settings");
        Snackbar.Add("PIN changed!", Severity.Success);
    }

    private async Task CopyAccountId()
    {
        if (AccountGuid is null) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", AccountGuid);
        await Analytics.TrackAsync("settings_copy_account_id", AccountGuid, "settings");
        Snackbar.Add("Account ID copied!", Severity.Info);
    }

    private async Task DownloadProgressReport()
    {
        if (AccountGuid is null) return;
        var sb = new System.Text.StringBuilder();
        var now = DateTime.Now;
        sb.AppendLine($"ChildDev Progress Report — {CurrentNickName}");
        sb.AppendLine($"Generated: {now:MMMM d, yyyy}");
        sb.AppendLine(new string('=', 50));

        var goals = await Db.Goals
            .Where(g => g.AccountFk == AccountGuid && g.DeletedAt == null)
            .OrderByDescending(g => g.EnteredDate)
            .ToListAsync();
        var activeGoals = goals.Where(g => g.CompletionDate == null).ToList();
        var completedGoals = goals.Where(g => g.CompletionDate != null).ToList();

        sb.AppendLine();
        sb.AppendLine($"ACTIVE GOALS ({activeGoals.Count})");
        sb.AppendLine(new string('-', 30));
        foreach (var g in activeGoals)
        {
            sb.AppendLine($"• {g.GoalText}");
            if (!string.IsNullOrWhiteSpace(g.MeasurableOutcome))
                sb.AppendLine($"  Success measure: {g.MeasurableOutcome}");
            var noteCount = await Db.GoalProgresses.CountAsync(p => p.GoalFk == g.Guid && p.DeletedAt == null);
            sb.AppendLine($"  Progress notes: {noteCount}");
            var latestNote = await Db.GoalProgresses
                .Where(p => p.GoalFk == g.Guid && p.DeletedAt == null)
                .OrderByDescending(p => p.UpdatedOn)
                .FirstOrDefaultAsync();
            if (latestNote?.NextStepItems is not null)
            {
                var snip = latestNote.NextStepItems.Length > 120 ? latestNote.NextStepItems[..120] + "…" : latestNote.NextStepItems;
                var d = DateTimeOffset.FromUnixTimeMilliseconds(latestNote.UpdatedOn).LocalDateTime;
                sb.AppendLine($"  Last note ({d:MMM d}): {snip}");
            }
        }

        if (completedGoals.Count > 0)
        {
            sb.AppendLine();
            sb.AppendLine($"COMPLETED GOALS ({completedGoals.Count})");
            sb.AppendLine(new string('-', 30));
            foreach (var g in completedGoals.Take(10))
            {
                var d = DateTimeOffset.FromUnixTimeMilliseconds(g.CompletionDate!.Value).LocalDateTime;
                sb.AppendLine($"✅ {g.GoalText} (completed {d:MMM d, yyyy})");
            }
        }

        sb.AppendLine();
        sb.AppendLine("RECENT JOURNAL ENTRIES");
        sb.AppendLine(new string('-', 30));
        var journals = await Db.Journals
            .Where(j => j.AccountFk == AccountGuid && j.DeletedAt == null)
            .OrderByDescending(j => j.EnteredDate)
            .Take(10)
            .ToListAsync();
        foreach (var j in journals)
        {
            var d = DateTimeOffset.FromUnixTimeMilliseconds(j.EnteredDate).LocalDateTime;
            sb.Append($"[{d:MMM d}]");
            if (!string.IsNullOrWhiteSpace(j.Mood)) sb.Append($" {j.Mood}");
            if (!string.IsNullOrWhiteSpace(j.Notes))
            {
                var snip = j.Notes.Length > 100 ? j.Notes[..100] + "…" : j.Notes;
                sb.Append($" — {snip}");
            }
            sb.AppendLine();
        }

        sb.AppendLine();
        sb.AppendLine($"SUMMARY");
        sb.AppendLine(new string('-', 30));
        sb.AppendLine($"Goals set: {TotalGoals} | Active: {activeGoals.Count} | Completed: {completedGoals.Count}");
        sb.AppendLine($"Progress notes: {TotalProgressNotes}");
        sb.AppendLine($"Journal entries: {TotalJournalEntries}");
        sb.AppendLine($"Todos done: {TotalTodosCompleted} / {TotalTodos}");

        var content = sb.ToString();
        var filename = $"childdev-report-{now:yyyy-MM-dd}.txt";
        await JS.InvokeVoidAsync("eval", $"(function(){{var a=document.createElement('a');a.href='data:text/plain;charset=utf-8,'+encodeURIComponent({System.Text.Json.JsonSerializer.Serialize(content)});a.download={System.Text.Json.JsonSerializer.Serialize(filename)};a.click();}})()");
        await Analytics.TrackAsync("settings_download_report", AccountGuid, "settings");
        Snackbar.Add("Progress report downloaded!", Severity.Success);
    }

    private async Task ExportDataJson()
    {
        if (AccountGuid is null) return;
        var goals = await Db.Goals
            .Where(g => g.AccountFk == AccountGuid && g.DeletedAt == null)
            .OrderByDescending(g => g.EnteredDate)
            .ToListAsync();
        var progressByGoal = await Db.GoalProgresses
            .Where(p => p.AccountFk == AccountGuid && p.DeletedAt == null)
            .OrderByDescending(p => p.UpdatedOn)
            .ToListAsync();
        var journals = await Db.Journals
            .Where(j => j.AccountFk == AccountGuid && j.DeletedAt == null)
            .OrderByDescending(j => j.EnteredDate)
            .ToListAsync();
        var todos = await Db.Todos
            .Where(t => t.AccountFk == AccountGuid && t.DeletedAt == null)
            .OrderByDescending(t => t.UpdatedOn)
            .ToListAsync();

        var export = new
        {
            ExportedAt = DateTime.UtcNow.ToString("o"),
            NickName = CurrentNickName,
            Goals = goals.Select(g => new
            {
                g.Guid, g.GoalText, g.MeasurableOutcome,
                EnteredDate = DateTimeOffset.FromUnixTimeMilliseconds(g.EnteredDate).ToString("o"),
                CompletionDate = g.CompletionDate.HasValue ? DateTimeOffset.FromUnixTimeMilliseconds(g.CompletionDate.Value).ToString("o") : null,
                ProgressNotes = progressByGoal.Where(p => p.GoalFk == g.Guid).Select(p => new
                {
                    p.NextStepItems,
                    UpdatedOn = DateTimeOffset.FromUnixTimeMilliseconds(p.UpdatedOn).ToString("o")
                }).ToList()
            }).ToList(),
            JournalEntries = journals.Select(j => new
            {
                j.Notes, j.Activity, j.Mood, j.Tags,
                EnteredDate = DateTimeOffset.FromUnixTimeMilliseconds(j.EnteredDate).ToString("o")
            }).ToList(),
            Todos = todos.Select(t => new
            {
                t.Title, t.Notes,
                DueDate = t.DueDate.HasValue ? DateTimeOffset.FromUnixTimeMilliseconds(t.DueDate.Value).ToString("o") : null,
                CompletedAt = t.CompletedAt.HasValue ? DateTimeOffset.FromUnixTimeMilliseconds(t.CompletedAt.Value).ToString("o") : null
            }).ToList()
        };

        var opts = new System.Text.Json.JsonSerializerOptions { WriteIndented = true };
        var json = System.Text.Json.JsonSerializer.Serialize(export, opts);
        var filename = $"childdev-export-{DateTime.Now:yyyy-MM-dd}.json";
        await JS.InvokeVoidAsync("eval", $"(function(){{var a=document.createElement('a');a.href='data:application/json;charset=utf-8,'+encodeURIComponent({System.Text.Json.JsonSerializer.Serialize(json)});a.download={System.Text.Json.JsonSerializer.Serialize(filename)};a.click();}})()");
        await Analytics.TrackAsync("settings_export_json", AccountGuid, "settings");
        Snackbar.Add("Data exported!", Severity.Success);
    }
}
