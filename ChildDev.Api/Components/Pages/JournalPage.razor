    private void ShufflePrompt()
    {
        _promptIdx = (_promptIdx + 1) % WpPrompts.Length;
        _ = Analytics.TrackAsync("journal_shuffle_prompt", AccountGuid, "journal");
    }

    protected override async Task OnInitializedAsync()
    {
        AccountGuid = HttpContextAccessor.HttpContext?.Session.GetString("AccountGuid");
        if (AccountGuid is null) return;
        _promptIdx = DateTime.Today.DayOfYear % WpPrompts.Length;
        var activeGoals = await Db.Goals
            .Where(g => g.AccountFk == AccountGuid && g.DeletedAt == null && g.CompletionDate == null && g.GoalText != null)
            .OrderByDescending(g => g.EnteredDate)
            .Select(g => new { g.GoalText, g.Guid })
            .Take(8)
            .ToListAsync();
        ActiveGoalNames = activeGoals.Select(g => g.GoalText!).ToList();
        _activeGoalNameToGuid = activeGoals.ToDictionary(g => g.GoalText!, g => g.Guid, StringComparer.OrdinalIgnoreCase);
        if (!string.IsNullOrWhiteSpace(TagParam))
            TagFilter = TagParam;
        await LoadEntries();
        await Analytics.TrackAsync("page_view", AccountGuid, "journal");
    }

    private async Task LoadEntries()
    {
        AllEntries = await Db.Journals
            .Where(j => j.AccountFk == AccountGuid && j.DeletedAt == null)
            .OrderByDescending(j => j.EnteredDate)
            .ToListAsync();
        var journalDates = AllEntries
            .Select(j => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(j.EnteredDate).LocalDateTime))
            .ToHashSet();
        HasEntryToday = journalDates.Contains(DateOnly.FromDateTime(DateTime.Today));
        MonthJournalDays = journalDates
            .Where(d => d.Year == DateTime.Today.Year && d.Month == DateTime.Today.Month)
            .ToHashSet();
        JournalStreak = 0;
        var jsDay = DateOnly.FromDateTime(DateTime.Today);
        while (journalDates.Contains(jsDay))
        {
            JournalStreak++;
            jsDay = jsDay.AddDays(-1);
        }

        // Longest journaling streak ever
        var sortedJDates = journalDates.OrderBy(d => d).ToList();
        LongestJournalStreak = 0;
        var ljCurrent = 0;
        LongestJournalGap = 0;
        for (int lji = 0; lji < sortedJDates.Count; lji++)
        {
            if (lji == 0 || sortedJDates[lji] == sortedJDates[lji - 1].AddDays(1))
                ljCurrent++;
            else
            {
                var gap = (sortedJDates[lji].ToDateTime(TimeOnly.MinValue) - sortedJDates[lji - 1].ToDateTime(TimeOnly.MinValue)).Days;
                if (gap > LongestJournalGap) LongestJournalGap = gap;
                ljCurrent = 1;
            }
            if (ljCurrent > LongestJournalStreak) LongestJournalStreak = ljCurrent;
        }

        var wowNowJMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        var wow7JMs = wowNowJMs - 7L * 86_400_000L;
        var wow14JMs = wowNowJMs - 14L * 86_400_000L;
        JournalThisWeek = AllEntries.Count(j => j.EnteredDate >= wow7JMs);
        JournalLastWeek = AllEntries.Count(j => j.EnteredDate >= wow14JMs && j.EnteredDate < wow7JMs);

        TotalWordsWritten = AllEntries
            .Where(j => !string.IsNullOrWhiteSpace(j.Notes))
            .Sum(j => j.Notes!.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length);
        BestEntryWordCount = AllEntries
            .Where(j => !string.IsNullOrWhiteSpace(j.Notes))
            .Select(j => j.Notes!.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length)
            .DefaultIfEmpty(0).Max();

        var jLocalNow = DateTimeOffset.Now.LocalDateTime;
        var jMonthStartMs = new DateTimeOffset(new DateTime(jLocalNow.Year, jLocalNow.Month, 1), TimeZoneInfo.Local.GetUtcOffset(DateTime.Now)).ToUnixTimeMilliseconds();
        JournalThisMonth = AllEntries.Count(j => j.EnteredDate >= jMonthStartMs);
        JournalThisMonthName = jLocalNow.ToString("MMMM");
        var jLastMonthDate = new DateTime(jLocalNow.Year, jLocalNow.Month, 1).AddMonths(-1);
        var jLastMonthStartMs = new DateTimeOffset(jLastMonthDate, TimeZoneInfo.Local.GetUtcOffset(DateTime.Now)).ToUnixTimeMilliseconds();
        JournalLastMonth = AllEntries.Count(j => j.EnteredDate >= jLastMonthStartMs && j.EnteredDate < jMonthStartMs);
        var jYearStartMs = new DateTimeOffset(new DateTime(jLocalNow.Year, 1, 1), TimeZoneInfo.Local.GetUtcOffset(DateTime.Now)).ToUnixTimeMilliseconds();
        JournalDaysThisYear = AllEntries
            .Where(j => j.EnteredDate >= jYearStartMs)
            .Select(j => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(j.EnteredDate).LocalDateTime))
            .Distinct().Count();
        JournalDaysThisMonth = AllEntries
            .Where(j => j.EnteredDate >= jMonthStartMs)
            .Select(j => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(j.EnteredDate).LocalDateTime))
            .Distinct().Count();
        var mtmGroup = AllEntries
            .Where(j => j.EnteredDate >= jMonthStartMs && !string.IsNullOrWhiteSpace(j.Mood))
            .GroupBy(j => j.Mood!.Trim(), StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(g => g.Count())
            .FirstOrDefault();
        if (mtmGroup is not null && mtmGroup.Count() >= 3)
            MonthTopMood = mtmGroup.Key;

        var bestMonthGroup = AllEntries
            .GroupBy(j => DateTimeOffset.FromUnixTimeMilliseconds(j.EnteredDate).LocalDateTime.ToString("yyyy-MM"))
            .OrderByDescending(g => g.Count())
            .FirstOrDefault();
        if (bestMonthGroup is not null && bestMonthGroup.Count() >= 3)
        {
            if (DateTime.TryParseExact(bestMonthGroup.Key + "-01", "yyyy-MM-dd", null, System.Globalization.DateTimeStyles.None, out var bestMonthDt))
                BestJournalMonth = bestMonthDt.ToString("MMMM yyyy");
            BestJournalMonthCount = bestMonthGroup.Count();
        }
        BuildTagCloud();
        BuildMoodCloud();
        BuildActivityCloud();

        // "On this day" — entries from same month/day in prior years
        var otdToday = DateOnly.FromDateTime(DateTime.Today);
        OnThisDayEntries = AllEntries
            .Select(j => (Entry: j, Date: DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(j.EnteredDate).LocalDateTime)))
            .Where(x => x.Date.Month == otdToday.Month && x.Date.Day == otdToday.Day && x.Date.Year < otdToday.Year)
            .OrderByDescending(x => x.Date.Year)
            .Take(3)
            .Select(x => (x.Entry, otdToday.Year - x.Date.Year))
            .ToList();

        ApplyFilter();
    }

    private void BuildTagCloud()
    {
        AllTags = AllEntries
            .Where(j => !string.IsNullOrWhiteSpace(j.Tags))
            .SelectMany(j => j.Tags!.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            .GroupBy(t => t, StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(g => g.Count())
            .ThenBy(g => g.Key)
            .Select(g => (g.Key, g.Count()))
            .ToList();
        // Clear tag filter if the selected tag no longer exists
        if (TagFilter is not null && !AllTags.Any(t => t.Tag.Equals(TagFilter, StringComparison.OrdinalIgnoreCase)))
            TagFilter = null;
    }

    private void OnTagFilterChanged(string? tag)
    {
        TagFilter = TagFilter == tag ? null : tag;
        ApplyFilter();
        if (tag is not null && AccountGuid is not null)
            _ = Analytics.TrackAsync("journal_tag_filter", AccountGuid, "journal", tag);
    }

    private void BuildMoodCloud()
    {
        AllMoods = AllEntries
            .Where(j => !string.IsNullOrWhiteSpace(j.Mood))
            .GroupBy(j => j.Mood!, StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(g => g.Count())
            .ThenBy(g => g.Key)
            .Select(g => (g.Key, g.Count()))
            .ToList();
        if (MoodFilter is not null && !AllMoods.Any(m => m.Mood.Equals(MoodFilter, StringComparison.OrdinalIgnoreCase)))
            MoodFilter = null;
    }

    private void OnMoodFilterChanged(string? mood)
    {
        MoodFilter = MoodFilter == mood ? null : mood;
        ApplyFilter();
        if (mood is not null && AccountGuid is not null)
            _ = Analytics.TrackAsync("journal_mood_filter", AccountGuid, "journal", mood);
    }

    private void BuildActivityCloud()
    {
        AllActivities = AllEntries
            .Where(j => !string.IsNullOrWhiteSpace(j.Activity))
            .GroupBy(j => j.Activity!, StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(g => g.Count())
            .ThenBy(g => g.Key)
            .Select(g => (g.Key, g.Count()))
            .ToList();
        if (ActivityFilter is not null && !AllActivities.Any(a => a.Activity.Equals(ActivityFilter, StringComparison.OrdinalIgnoreCase)))
            ActivityFilter = null;
    }

    private void OnActivityFilterChanged(string? activity)
    {
        ActivityFilter = ActivityFilter == activity ? null : activity;
        ApplyFilter();
        if (activity is not null && AccountGuid is not null)
            _ = Analytics.TrackAsync("journal_activity_filter", AccountGuid, "journal", activity);
    }

    private void OnFilterChanged(string value)
    {
        FilterText = value;
        ApplyFilter();
    }

    private void OnDateFilterChanged(string value)
    {
        DateFilter = value ?? "All";
        ApplyFilter();
        if (AccountGuid is not null && DateFilter != "All")
            _ = Analytics.TrackAsync("journal_filter", AccountGuid, "journal", DateFilter);
    }

    private void ApplyFilter()
    {
        var weekStartMs = DateTimeOffset.UtcNow.AddDays(-7).ToUnixTimeMilliseconds();
        var monthStartMs = DateTimeOffset.UtcNow.AddDays(-30).ToUnixTimeMilliseconds();

        IEnumerable<Journal> filtered = DateFilter switch
        {
            "Week" => AllEntries.Where(j => j.EnteredDate >= weekStartMs),
            "Month" => AllEntries.Where(j => j.EnteredDate >= monthStartMs),
            _ => AllEntries
        };

        if (!string.IsNullOrWhiteSpace(FilterText))
        {
            var q = FilterText.Trim();
            filtered = filtered.Where(j =>
                (j.Notes?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (j.Activity?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (j.Mood?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (j.EmotionReason?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (j.Tags?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        if (TagFilter is not null)
        {
            filtered = filtered.Where(j =>
                j.Tags != null &&
                j.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .Any(t => t.Equals(TagFilter, StringComparison.OrdinalIgnoreCase)));
        }

        if (MoodFilter is not null)
            filtered = filtered.Where(j => j.Mood != null && j.Mood.Equals(MoodFilter, StringComparison.OrdinalIgnoreCase));

        if (ActivityFilter is not null)
            filtered = filtered.Where(j => j.Activity != null && j.Activity.Equals(ActivityFilter, StringComparison.OrdinalIgnoreCase));

        _filteredEntries = filtered.ToList();
        _displayCount = PageSize;
        Entries = _filteredEntries.Take(_displayCount).ToList();
    }

    private void LoadMore()
    {
        _displayCount += PageSize;
        Entries = _filteredEntries.Take(_displayCount).ToList();
    }

    private async Task CopyEntryText(Journal j)
    {
        var sb = new System.Text.StringBuilder();
        var dt = DateTimeOffset.FromUnixTimeMilliseconds(j.EnteredDate).LocalDateTime;
        sb.AppendLine($"[{dt:MMMM d, yyyy}]");
        if (!string.IsNullOrWhiteSpace(j.Activity)) sb.AppendLine($"Activity: {j.Activity}");
        if (!string.IsNullOrWhiteSpace(j.Mood)) sb.AppendLine($"Mood: {j.Mood}");
        if (!string.IsNullOrWhiteSpace(j.Notes)) sb.AppendLine(j.Notes);
        if (!string.IsNullOrWhiteSpace(j.EmotionReason)) sb.AppendLine($"Why: {j.EmotionReason}");
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", sb.ToString().TrimEnd());
        await Analytics.TrackAsync("journal_copy_entry", AccountGuid, "journal");
        Snackbar.Add("Journal entry copied!", Severity.Info);
    }

    private void OpenAddDialog()
    {
        NewNotes = string.Empty;
        NewActivity = string.Empty;
        NewMood = string.Empty;
        NewEmotionReason = string.Empty;
        NewTags = string.Empty;
        NewEnteredDate = DateTime.Today;
        ShowAddDialog = true;
    }

    private void OpenAddDialogWithPrompt()
    {
        NewNotes = WpPrompts[_promptIdx];
        NewActivity = string.Empty;
        NewMood = string.Empty;
        NewEmotionReason = string.Empty;
        NewTags = string.Empty;
        NewEnteredDate = DateTime.Today;
        ShowAddDialog = true;
    }

    private static string? JournalMilestoneMessage(int count) => count switch
    {
        10  => "🎉 10 journal entries! You've built a real reflection habit — keep going!",
        25  => "🌟 25 journal entries! A quarter-century of reflections — that's incredible dedication!",
        50  => "🏆 50 journal entries! Half-century milestone — you're a journaling champion!",
        100 => "🌟🌟 100 journal entries! LEGENDARY! You've written a life chapter worth reading!",
        200 => "🏅 200 entries! You're in elite journaling territory — absolutely extraordinary!",
        _   => count % 100 == 0 ? $"🎊 {count} journal entries — you're unstoppable!" : null
    };

    private async Task AddEntry()
    {
        if (string.IsNullOrWhiteSpace(NewNotes) && string.IsNullOrWhiteSpace(NewActivity)) return;

        var newWordCount = string.IsNullOrWhiteSpace(NewNotes)
            ? 0
            : NewNotes.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries).Length;
        var prevBest = BestEntryWordCount;
        var newTotalCount = AllEntries.Count + 1;

        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        var enteredMs = NewEnteredDate.HasValue
            ? new DateTimeOffset(DateTime.SpecifyKind(NewEnteredDate.Value, DateTimeKind.Local)).ToUnixTimeMilliseconds()
            : now;
        Db.Journals.Add(new Journal
        {
            Guid = System.Guid.NewGuid().ToString(),
            AccountFk = AccountGuid!,
            Notes = string.IsNullOrWhiteSpace(NewNotes) ? null : NewNotes.Trim(),
            Activity = string.IsNullOrWhiteSpace(NewActivity) ? null : NewActivity.Trim(),
            Mood = string.IsNullOrWhiteSpace(NewMood) ? null : NewMood.Trim(),
            EmotionReason = string.IsNullOrWhiteSpace(NewEmotionReason) ? null : NewEmotionReason.Trim(),
            Tags = string.IsNullOrWhiteSpace(NewTags) ? null : NewTags.Trim(),
            EnteredDate = enteredMs,
            UpdatedOn = now
        });
        await Db.SaveChangesAsync();
        await Analytics.TrackAsync("journal_add", AccountGuid, "journal");

        NewNotes = string.Empty;
        NewActivity = string.Empty;
        NewMood = string.Empty;
        NewEmotionReason = string.Empty;
        NewTags = string.Empty;
        NewEnteredDate = DateTime.Today;
        ShowAddDialog = false;

        var milestoneMsg = JournalMilestoneMessage(newTotalCount);
        if (milestoneMsg is not null)
        {
            await Analytics.TrackAsync("journal_milestone", AccountGuid, "journal", newTotalCount.ToString());
            Snackbar.Add(milestoneMsg, Severity.Success, opts => opts.VisibleStateDuration = 7000);
        }
        else if (newWordCount >= 50 && newWordCount > prevBest)
        {
            await Analytics.TrackAsync("journal_personal_best_words", AccountGuid, "journal", newWordCount.ToString());
            Snackbar.Add($"🏆 Personal best! {newWordCount} words — your longest journal entry ever! Amazing! 🌟", Severity.Success, opts => opts.VisibleStateDuration = 6000);
        }
        else
        {
            Snackbar.Add("Entry saved!", Severity.Success);
        }

        await LoadEntries();
    }

    private void OpenEditEntry(Journal j)
    {
        EditingGuid = j.Guid;
        EditNotes = j.Notes ?? string.Empty;
        EditActivity = j.Activity ?? string.Empty;
        EditMood = j.Mood ?? string.Empty;
        EditEmotionReason = j.EmotionReason ?? string.Empty;
        EditTags = j.Tags ?? string.Empty;
        EditEnteredDate = DateTimeOffset.FromUnixTimeMilliseconds(j.EnteredDate).LocalDateTime.Date;
        ShowEditDialog = true;
    }

    private async Task SaveEditEntry()
    {
        if (string.IsNullOrWhiteSpace(EditNotes) && string.IsNullOrWhiteSpace(EditActivity)) return;
        if (EditingGuid is null) return;
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        var notes = string.IsNullOrWhiteSpace(EditNotes) ? null : EditNotes.Trim();
        var activity = string.IsNullOrWhiteSpace(EditActivity) ? null : EditActivity.Trim();
        var mood = string.IsNullOrWhiteSpace(EditMood) ? null : EditMood.Trim();
        var emotionReason = string.IsNullOrWhiteSpace(EditEmotionReason) ? null : EditEmotionReason.Trim();
        var tags = string.IsNullOrWhiteSpace(EditTags) ? null : EditTags.Trim();
        var enteredMs = EditEnteredDate.HasValue
            ? new DateTimeOffset(DateTime.SpecifyKind(EditEnteredDate.Value, DateTimeKind.Local)).ToUnixTimeMilliseconds()
            : now;
        var rows = await Db.Journals
            .Where(j => j.Guid == EditingGuid && j.AccountFk == AccountGuid)
            .ExecuteUpdateAsync(s => s
                .SetProperty(j => j.Notes, notes)
                .SetProperty(j => j.Activity, activity)
                .SetProperty(j => j.Mood, mood)
                .SetProperty(j => j.EmotionReason, emotionReason)
                .SetProperty(j => j.Tags, tags)
                .SetProperty(j => j.EnteredDate, enteredMs)
                .SetProperty(j => j.UpdatedOn, now));
        if (rows == 0) return;
        await Analytics.TrackAsync("journal_edit", AccountGuid, "journal");
        ShowEditDialog = false;
        Snackbar.Add("Entry updated!", Severity.Success);
        await LoadEntries();
    }

    private async Task ConfirmDeleteEntry()
    {
        var guid = _confirmDeleteGuid;
        _confirmDeleteGuid = null;
        if (guid is null) return;
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        var rows = await Db.Journals
            .Where(j => j.Guid == guid && j.AccountFk == AccountGuid && j.DeletedAt == null)
            .ExecuteUpdateAsync(s => s
                .SetProperty(j => j.DeletedAt, now)
                .SetProperty(j => j.UpdatedOn, now));
        if (rows == 0) return;
        await Analytics.TrackAsync("journal_delete", AccountGuid, "journal");
        Snackbar.Add("Entry deleted.", Severity.Info);
        await LoadEntries();
    }
}
