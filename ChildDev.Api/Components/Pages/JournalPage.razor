@page "/journal"
@inject AppDbContext Db
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor
@inject ISnackbar Snackbar
@inject WebAnalyticsService Analytics

<PageTitle>Journal – ChildDev</PageTitle>

@if (AccountGuid is null)
{
    Nav.NavigateTo("/login");
    return;
}

<MudText Typo="Typo.h5" Class="mb-4">
    <MudIcon Icon="@Icons.Material.Filled.Book" Class="mr-2" />
    Journal
</MudText>

<MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-4" Spacing="2">
    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="() => ShowAddDialog = true">New Entry</MudButton>
    @if (AllEntries.Any())
    {
        <MudChipSet T="string" SelectionMode="SelectionMode.SingleSelection"
                    SelectedValue="@DateFilter"
                    SelectedValueChanged="@((string v) => OnDateFilterChanged(v))">
            <MudChip T="string" Value="@("All")" Variant="Variant.Filled" Color="Color.Default">All</MudChip>
            <MudChip T="string" Value="@("Week")" Variant="Variant.Filled" Color="Color.Info">This Week</MudChip>
            <MudChip T="string" Value="@("Month")" Variant="Variant.Filled" Color="Color.Info">This Month</MudChip>
        </MudChipSet>
        <MudSpacer />
        <MudTextField Value="@FilterText" ValueChanged="@((string v) => OnFilterChanged(v))"
                      Placeholder="Search entries…" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true" Immediate="true" Style="min-width:220px"
                      AdornmentColor="Color.Secondary" />
    }
</MudStack>

@if (!AllEntries.Any())
{
    <MudText Typo="Typo.body2" Color="Color.Secondary">No journal entries yet. Write the first one!</MudText>
}
else if (!Entries.Any())
{
    <MudText Typo="Typo.body2" Color="Color.Secondary">No entries matching "@FilterText".</MudText>
}
else
{
    <MudGrid>
        @foreach (var j in Entries)
        {
            var enteredDate = DateTimeOffset.FromUnixTimeMilliseconds(j.EnteredDate).LocalDateTime;
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="2" Class="h-100">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@enteredDate.ToString("MMM d, yyyy")</MudText>
                            @if (!string.IsNullOrWhiteSpace(j.Activity))
                            {
                                <MudText Typo="Typo.body2" Class="mt-1"><strong>@j.Activity</strong></MudText>
                            }
                        </CardHeaderContent>
                        <CardHeaderActions>
                            @if (!string.IsNullOrWhiteSpace(j.Mood))
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary">@j.Mood</MudChip>
                            }
                        </CardHeaderActions>
                    </MudCardHeader>
                    @if (!string.IsNullOrWhiteSpace(j.Notes))
                    {
                        <MudCardContent Class="pt-0">
                            <MudText Typo="Typo.body2">@(j.Notes.Length > 200 ? j.Notes[..200] + "…" : j.Notes)</MudText>
                        </MudCardContent>
                    }
                    <MudCardActions>
                        @if (!string.IsNullOrWhiteSpace(j.Tags))
                        {
                            @foreach (var tag in j.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@tag</MudChip>
                            }
                        }
                        <MudSpacer />
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="() => OpenEditEntry(j)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                       Color="Color.Error" OnClick="() => DeleteEntry(j.Guid)" />
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

<MudDialog @bind-Visible="ShowAddDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.EditNote" Class="mr-2" />
            New Journal Entry
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="NewNotes" Label="What happened? What did you observe?" Variant="Variant.Outlined"
                      Lines="4" Class="mb-4" AutoFocus="true" />
        <MudTextField @bind-Value="NewActivity" Label="Activity (optional)" Variant="Variant.Outlined" Class="mb-4" />
        <MudTextField @bind-Value="NewMood" Label="Mood (optional)" Variant="Variant.Outlined" Class="mb-4" />
        <MudTextField @bind-Value="NewTags" Label="Tags (optional, comma-separated)" Variant="Variant.Outlined" Class="mb-4" />
        <MudDatePicker @bind-Date="NewEnteredDate" Label="Entry date" Variant="Variant.Outlined" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => ShowAddDialog = false">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddEntry">Save Entry</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="ShowEditDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2" />
            Edit Entry
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="EditNotes" Label="Notes" Variant="Variant.Outlined"
                      Lines="4" Class="mb-4" AutoFocus="true" />
        <MudTextField @bind-Value="EditActivity" Label="Activity (optional)" Variant="Variant.Outlined" Class="mb-4" />
        <MudTextField @bind-Value="EditMood" Label="Mood (optional)" Variant="Variant.Outlined" Class="mb-4" />
        <MudTextField @bind-Value="EditTags" Label="Tags (optional, comma-separated)" Variant="Variant.Outlined" Class="mb-4" />
        <MudDatePicker @bind-Date="EditEnteredDate" Label="Entry date" Variant="Variant.Outlined" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => ShowEditDialog = false">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveEditEntry">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private string? AccountGuid;
    private List<Journal> AllEntries = [];
    private List<Journal> Entries = [];
    private string FilterText = string.Empty;
    private string DateFilter = "All";
    private bool ShowAddDialog;
    private string NewNotes = string.Empty;
    private string NewActivity = string.Empty;
    private string NewMood = string.Empty;
    private string NewTags = string.Empty;
    private DateTime? NewEnteredDate = DateTime.Today;
    private bool ShowEditDialog;
    private string? EditingGuid;
    private string EditNotes = string.Empty;
    private string EditActivity = string.Empty;
    private string EditMood = string.Empty;
    private string EditTags = string.Empty;
    private DateTime? EditEnteredDate;

    protected override async Task OnInitializedAsync()
    {
        AccountGuid = HttpContextAccessor.HttpContext?.Session.GetString("AccountGuid");
        if (AccountGuid is null) return;
        await LoadEntries();
        await Analytics.TrackAsync("page_view", AccountGuid, "journal");
    }

    private async Task LoadEntries()
    {
        AllEntries = await Db.Journals
            .Where(j => j.AccountFk == AccountGuid && j.DeletedAt == null)
            .OrderByDescending(j => j.EnteredDate)
            .ToListAsync();
        ApplyFilter();
    }

    private void OnFilterChanged(string value)
    {
        FilterText = value;
        ApplyFilter();
    }

    private void OnDateFilterChanged(string value)
    {
        DateFilter = value ?? "All";
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var weekStartMs = DateTimeOffset.UtcNow.AddDays(-7).ToUnixTimeMilliseconds();
        var monthStartMs = DateTimeOffset.UtcNow.AddDays(-30).ToUnixTimeMilliseconds();

        IEnumerable<Journal> filtered = DateFilter switch
        {
            "Week" => AllEntries.Where(j => j.EnteredDate >= weekStartMs),
            "Month" => AllEntries.Where(j => j.EnteredDate >= monthStartMs),
            _ => AllEntries
        };

        if (!string.IsNullOrWhiteSpace(FilterText))
        {
            var q = FilterText.Trim();
            filtered = filtered.Where(j =>
                (j.Notes?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (j.Activity?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (j.Mood?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (j.Tags?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        Entries = filtered.ToList();
    }

    private async Task AddEntry()
    {
        if (string.IsNullOrWhiteSpace(NewNotes) && string.IsNullOrWhiteSpace(NewActivity)) return;

        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        var enteredMs = NewEnteredDate.HasValue
            ? new DateTimeOffset(NewEnteredDate.Value, TimeSpan.Zero).ToUnixTimeMilliseconds()
            : now;
        Db.Journals.Add(new Journal
        {
            Guid = System.Guid.NewGuid().ToString(),
            AccountFk = AccountGuid!,
            Notes = string.IsNullOrWhiteSpace(NewNotes) ? null : NewNotes.Trim(),
            Activity = string.IsNullOrWhiteSpace(NewActivity) ? null : NewActivity.Trim(),
            Mood = string.IsNullOrWhiteSpace(NewMood) ? null : NewMood.Trim(),
            Tags = string.IsNullOrWhiteSpace(NewTags) ? null : NewTags.Trim(),
            EnteredDate = enteredMs,
            UpdatedOn = now
        });
        await Db.SaveChangesAsync();
        await Analytics.TrackAsync("journal_add", AccountGuid, "journal");

        NewNotes = string.Empty;
        NewActivity = string.Empty;
        NewMood = string.Empty;
        NewTags = string.Empty;
        NewEnteredDate = DateTime.Today;
        ShowAddDialog = false;
        Snackbar.Add("Entry saved!", Severity.Success);
        await LoadEntries();
    }

    private void OpenEditEntry(Journal j)
    {
        EditingGuid = j.Guid;
        EditNotes = j.Notes ?? string.Empty;
        EditActivity = j.Activity ?? string.Empty;
        EditMood = j.Mood ?? string.Empty;
        EditTags = j.Tags ?? string.Empty;
        EditEnteredDate = DateTimeOffset.FromUnixTimeMilliseconds(j.EnteredDate).LocalDateTime.Date;
        ShowEditDialog = true;
    }

    private async Task SaveEditEntry()
    {
        if (string.IsNullOrWhiteSpace(EditNotes) && string.IsNullOrWhiteSpace(EditActivity)) return;
        if (EditingGuid is null) return;
        var entry = await Db.Journals.FirstOrDefaultAsync(j => j.Guid == EditingGuid && j.AccountFk == AccountGuid);
        if (entry is null) return;
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        entry.Notes = string.IsNullOrWhiteSpace(EditNotes) ? null : EditNotes.Trim();
        entry.Activity = string.IsNullOrWhiteSpace(EditActivity) ? null : EditActivity.Trim();
        entry.Mood = string.IsNullOrWhiteSpace(EditMood) ? null : EditMood.Trim();
        entry.Tags = string.IsNullOrWhiteSpace(EditTags) ? null : EditTags.Trim();
        if (EditEnteredDate.HasValue)
            entry.EnteredDate = new DateTimeOffset(EditEnteredDate.Value, TimeSpan.Zero).ToUnixTimeMilliseconds();
        entry.UpdatedOn = now;
        await Db.SaveChangesAsync();
        await Analytics.TrackAsync("journal_edit", AccountGuid, "journal");
        ShowEditDialog = false;
        Snackbar.Add("Entry updated!", Severity.Success);
        await LoadEntries();
    }

    private async Task DeleteEntry(string guid)
    {
        var entry = await Db.Journals.FirstOrDefaultAsync(j => j.Guid == guid && j.AccountFk == AccountGuid);
        if (entry is null) return;
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        entry.DeletedAt = now;
        entry.UpdatedOn = now;
        await Db.SaveChangesAsync();
        await Analytics.TrackAsync("journal_delete", AccountGuid, "journal");
        Snackbar.Add("Entry deleted.", Severity.Info);
        await LoadEntries();
    }
}
