@page "/journal"
@inject AppDbContext Db
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor
@inject ISnackbar Snackbar
@inject WebAnalyticsService Analytics
@inject IJSRuntime JS

<PageTitle>Journal – ChildDev</PageTitle>

@if (AccountGuid is null)
{
    Nav.NavigateTo("/login");
    return;
}

<MudText Typo="Typo.h5" Class="mb-4">
    <MudIcon Icon="@Icons.Material.Filled.Book" Class="mr-2" />
    Journal
</MudText>

<MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-4" Spacing="2">
    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenAddDialog">New Entry</MudButton>
    @if (AllEntries.Any())
    {
        <MudChipSet T="string" SelectionMode="SelectionMode.SingleSelection"
                    SelectedValue="@DateFilter"
                    SelectedValueChanged="@((string v) => OnDateFilterChanged(v))">
            <MudChip T="string" Value="@("All")" Variant="Variant.Filled" Color="Color.Default">All</MudChip>
            <MudChip T="string" Value="@("Week")" Variant="Variant.Filled" Color="Color.Info">This Week</MudChip>
            <MudChip T="string" Value="@("Month")" Variant="Variant.Filled" Color="Color.Info">This Month</MudChip>
        </MudChipSet>
        <MudSpacer />
        <MudTextField Value="@FilterText" ValueChanged="@((string v) => OnFilterChanged(v))"
                      Placeholder="Search entries…" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true" Immediate="true" Style="min-width:220px"
                      AdornmentColor="Color.Secondary" />
    }
</MudStack>

@if (JournalStreak >= 2)
{
    var jsMsg = JournalStreak >= 14 ? $"🌟 {JournalStreak}-day journaling streak — absolutely legendary! You're a journaling champion!"
              : JournalStreak >= 7  ? $"🔥 {JournalStreak}-day journaling streak — incredible consistency! Keep it going!"
              : JournalStreak >= 4  ? $"💪 {JournalStreak}-day journaling streak — you're building a great habit!"
              :                       $"⭐ {JournalStreak}-day journaling streak — you're on a roll!";
    <MudAlert Severity="@(JournalStreak >= 7 ? Severity.Success : Severity.Info)" Dense="true" Class="mb-3">@jsMsg</MudAlert>
}
@if (JournalStreak >= 1 && !HasEntryToday)
{
    var spMsg = JournalStreak >= 7 ? $"⚠️ <strong>Don't break your {JournalStreak}-day streak!</strong> Write a quick journal entry today to keep the fire going."
              : JournalStreak >= 3 ? $"🛡️ <strong>Protect your {JournalStreak}-day streak!</strong> A short entry today keeps your habit alive."
              :                      $"✍️ <strong>You're on a {JournalStreak}-day streak</strong> — add an entry today to keep it going!";
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.Warning">
        @((MarkupString)spMsg)
        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning" OnClick="OpenAddDialog" Class="ml-2">Write entry</MudButton>
    </MudAlert>
}
@if (LongestJournalStreak > JournalStreak && LongestJournalStreak >= 3)
{
    var ljsMsg = JournalStreak >= LongestJournalStreak
        ? $"🏆 <strong>You're matching your all-time best streak of {LongestJournalStreak} days!</strong> Don't break it now!"
        : $"📜 Your longest journaling streak ever: <strong>{LongestJournalStreak} days</strong> — can you beat it?";
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.History">@((MarkupString)ljsMsg)</MudAlert>
}

@if (!HasEntryToday)
{
    <MudAlert Severity="Severity.Normal" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.Lightbulb">
        <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="1" Style="flex:1;">
            <MudText Typo="Typo.body2" Style="flex:1;">💡 <strong>Today's prompt:</strong> @WpPrompts[_promptIdx]</MudText>
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="OpenAddDialogWithPrompt">Write now</MudButton>
            <MudTooltip Text="Try another prompt">
                <MudIconButton Icon="@Icons.Material.Filled.Shuffle" Size="Size.Small" Color="Color.Secondary"
                               OnClick="ShufflePrompt" aria-label="Try another prompt" />
            </MudTooltip>
        </MudStack>
    </MudAlert>
}
@{
    var jemMilestones = new[] { 200, 100, 50, 25, 10 };
    var jemHit = jemMilestones.FirstOrDefault(m => AllEntries.Count >= m);
    var jemMsg = jemHit switch
    {
        200 => $"🌟 <strong>200 journal entries!</strong> You've written a novel's worth of reflections — truly extraordinary! Your story is remarkable.",
        100 => $"🏆 <strong>100 journal entries!</strong> Triple digits — that's a commitment to self-growth that most people never make. Be proud!",
        50  => $"⭐ <strong>50 journal entries!</strong> Half a century of reflections — you're building a powerful record of your growth journey!",
        25  => $"🚀 <strong>25 journal entries!</strong> A quarter century of reflections — you're turning journaling into a real habit!",
        10  => $"💪 <strong>10 journal entries!</strong> Double digits — you're not just trying, you're building a real journaling practice!",
        _   => null
    };
}
@if (jemMsg is not null)
{
    <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.MenuBook">@((MarkupString)jemMsg)</MudAlert>
}
@if (BestJournalMonth is not null)
{
    <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.Star">
        🏅 Your best journaling month was <strong>@BestJournalMonth</strong> — @BestJournalMonthCount entries! Can you beat it?
    </MudAlert>
}
@if (JournalDaysThisYear >= 10)
{
    var jdyMsg = JournalDaysThisYear >= 100 ? $"🌟 You've journaled on <strong>{JournalDaysThisYear} different days</strong> this year — that's extraordinary dedication!"
               : JournalDaysThisYear >= 50  ? $"🏆 You've journaled on <strong>{JournalDaysThisYear} different days</strong> this year — impressive consistency!"
               : JournalDaysThisYear >= 25  ? $"📅 You've journaled on <strong>{JournalDaysThisYear} different days</strong> this year — you're building a strong habit!"
               :                              $"📅 You've journaled on <strong>{JournalDaysThisYear} different days</strong> this year — keep showing up!";
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.CalendarToday">@((MarkupString)jdyMsg)</MudAlert>
}
@if (LongestJournalGap >= 14)
{
    var lgDaysMsg = LongestJournalGap >= 60 ? $"Your longest journaling gap was <strong>{LongestJournalGap} days</strong> — a long pause. You came back though, and that's what matters!"
                  : LongestJournalGap >= 30 ? $"Your longest journaling gap was <strong>{LongestJournalGap} days</strong> — see if you can keep future gaps shorter than that!"
                  :                           $"Your longest journaling gap was <strong>{LongestJournalGap} days</strong> — aim to journal at least once a week so gaps stay small!";
    <MudAlert Severity="Severity.Normal" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.HourglassEmpty">@((MarkupString)lgDaysMsg)</MudAlert>
}
@if (JournalThisWeek > 0 || JournalLastWeek > 0)
{
    var jWowMsg = JournalLastWeek == 0
        ? $"📖 {JournalThisWeek} journal entr{(JournalThisWeek == 1 ? "y" : "ies")} this week — great start! Keep the reflection going!"
        : JournalThisWeek > JournalLastWeek
            ? $"📈 {JournalThisWeek} entries this week vs {JournalLastWeek} last week — you're journaling more! Keep that momentum!"
            : JournalThisWeek == JournalLastWeek
                ? $"📖 {JournalThisWeek} entries this week, same as last week — nice consistency!"
                : $"📉 {JournalThisWeek} entr{(JournalThisWeek == 1 ? "y" : "ies")} this week vs {JournalLastWeek} last week — can you match your previous pace?";
    var jWowSeverity = JournalLastWeek == 0 || JournalThisWeek >= JournalLastWeek ? Severity.Info : Severity.Normal;
    <MudAlert Severity="@jWowSeverity" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.TrendingUp">@jWowMsg</MudAlert>
}
@if (JournalThisMonth >= 1)
{
    var jMonthMsg = JournalThisMonth >= 20 ? $"📓 In {JournalThisMonthName} you've written <strong>{JournalThisMonth} journal entries</strong> — outstanding! This might be your best month yet!"
                  : JournalThisMonth >= 10 ? $"📓 In {JournalThisMonthName} you've written <strong>{JournalThisMonth} entries</strong> — double digits this month! Your reflection habit is really growing!"
                  : JournalThisMonth >= 4  ? $"📓 In {JournalThisMonthName} you've already written <strong>{JournalThisMonth} entries</strong> — great journaling momentum this month!"
                  :                          $"📓 You've written <strong>{JournalThisMonth} entr{(JournalThisMonth == 1 ? "y" : "ies")}</strong> in {JournalThisMonthName} — every entry is part of your growth story!";
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.CalendarMonth">@((MarkupString)jMonthMsg)</MudAlert>
    @if (JournalLastMonth > 0)
    {
        var jMomDiff = JournalThisMonth - JournalLastMonth;
        var jMomMsg = jMomDiff > 0 ? $"📈 +{jMomDiff} vs last month ({JournalLastMonth} entries) — your journaling is growing!"
                    : jMomDiff < 0 ? $"📉 {JournalLastMonth} entries last month — can you match or beat it this month?"
                    :                $"📖 Same pace as last month ({JournalLastMonth} entries) — nice consistency!";
        <MudText Typo="Typo.caption" Color="@(jMomDiff >= 0 ? Color.Success : Color.Warning)" Class="mb-3">@jMomMsg</MudText>
    }
}
@if (JournalDaysThisMonth >= 3)
{
    var jdtmElapsed = DateTime.Today.Day;
    var jdtmPct = (int)(JournalDaysThisMonth * 100.0 / jdtmElapsed);
    var jdtmMsg = jdtmPct >= 80
        ? $"📅 <strong>{JournalDaysThisMonth} of {jdtmElapsed} days</strong> journaled this month — almost every day! You're a consistency machine! 🔥"
        : jdtmPct >= 50
            ? $"📅 <strong>{JournalDaysThisMonth} of {jdtmElapsed} days</strong> journaled this month — more than half the days so far. Solid habit!"
            : $"📅 <strong>{JournalDaysThisMonth} of {jdtmElapsed} days</strong> journaled this month — can you hit more days before the month ends?";
    <MudAlert Severity="@(jdtmPct >= 80 ? Severity.Success : Severity.Info)" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.CalendarViewMonth">@((MarkupString)jdtmMsg)</MudAlert>
}
@if (MonthTopMood is not null)
{
    var mtmEmojiMap = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase) {
        {"happy","😊"}, {"sad","😢"}, {"calm","😌"}, {"excited","🤩"}, {"tired","😴"},
        {"angry","😠"}, {"anxious","😟"}, {"grateful","🙏"}, {"proud","💪"}, {"focused","🎯"}
    };
    var mtmEmoji = mtmEmojiMap.GetValueOrDefault(MonthTopMood, "💭");
    <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.Mood">
        This month your most common feeling is <strong>@MonthTopMood @mtmEmoji</strong> — that says a lot about how you're growing!
    </MudAlert>
}

@{
    var totw7Ms = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - 7L * 86_400_000L;
    var totwTag = AllEntries
        .Where(j => j.EnteredDate >= totw7Ms && !string.IsNullOrWhiteSpace(j.Tags))
        .SelectMany(j => j.Tags!.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        .GroupBy(t => t, StringComparer.OrdinalIgnoreCase)
        .OrderByDescending(g => g.Count())
        .Select(g => (Tag: g.Key, Count: g.Count()))
        .FirstOrDefault();
}
@if (totwTag.Tag is not null && totwTag.Count >= 2)
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.LocalOffer">
        🏷️ <strong>Tag of the week:</strong> "@totwTag.Tag" — you used it @totwTag.Count times this week!
    </MudAlert>
}
@{
    var mtdPositiveMoods = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "happy", "excited", "grateful", "calm", "proud", "focused" };
    var mtdRecent = AllEntries.Where(j => !string.IsNullOrWhiteSpace(j.Mood)).Take(5).ToList();
    var mtdPositiveCount = mtdRecent.Count(j => mtdPositiveMoods.Contains(j.Mood!.Trim()));
}
@if (mtdRecent.Count >= 5 && mtdPositiveCount >= 4)
{
    var mtdMsg = mtdPositiveCount == 5
        ? "🌟 <strong>All 5 recent entries show a positive mood</strong> — you're in a great headspace! Keep nurturing that energy!"
        : "😊 <strong>Your recent entries show a mostly positive trend</strong> — 4 of your last 5 moods are upbeat! That's something to be proud of!";
    <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.SentimentVerySatisfied">@((MarkupString)mtdMsg)</MudAlert>
}
@{
    var ctdEntries = AllEntries.Count;
    int ctdMorning = 0, ctdAfternoon = 0, ctdEvening = 0;
    foreach (var ctdJ in AllEntries)
    {
        var ctdHour = DateTimeOffset.FromUnixTimeMilliseconds(ctdJ.EnteredDate).LocalDateTime.Hour;
        if (ctdHour < 12) ctdMorning++;
        else if (ctdHour < 17) ctdAfternoon++;
        else ctdEvening++;
    }
}
@if (ctdEntries >= 10)
{
    var ctdMax = Math.Max(ctdMorning, Math.Max(ctdAfternoon, ctdEvening));
    var ctdPct = (int)(ctdMax * 100.0 / ctdEntries);
    if (ctdPct >= 60)
    {
        var ctdLabel = ctdMorning == ctdMax ? "🌅 <strong>Morning journaler!</strong> Most of your entries are written in the morning — that's a powerful way to start the day!"
                     : ctdAfternoon == ctdMax ? "☀️ <strong>Afternoon reflector!</strong> You tend to journal in the afternoon — great way to process the day's events!"
                     : "🌙 <strong>Evening writer!</strong> You journal most in the evening — perfect for capturing the day before you rest!";
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.Schedule">@((MarkupString)ctdLabel)</MudAlert>
    }
}
@if (TotalWordsWritten >= 100)
{
    var wordsMsg = TotalWordsWritten >= 10000
        ? $"📚 You've written over {TotalWordsWritten:N0} words in your journal — that's a whole book! Your story is truly remarkable!"
        : TotalWordsWritten >= 5000
            ? $"📖 Over {TotalWordsWritten:N0} words written! Your journaling is building something amazing — keep telling your story!"
            : TotalWordsWritten >= 1000
                ? $"✍️ You've written {TotalWordsWritten:N0} words in your journal — incredible! Every word is part of your growth story!"
                : $"✍️ You've written {TotalWordsWritten:N0} words so far — you're building a wonderful reflection habit!";
    <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.Create">@wordsMsg</MudAlert>
    {
        var ewcEntries = AllEntries.Where(j => !string.IsNullOrWhiteSpace(j.Notes)).ToList();
        var ewcAvg = ewcEntries.Count > 0
            ? (int)Math.Round(ewcEntries.Average(j => j.Notes!.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length))
            : 0;
        if (ewcEntries.Count >= 5 && ewcAvg >= 20)
        {
            var ewcLabel = ewcAvg >= 100 ? $"✍️ Your entries average <strong>{ewcAvg} words</strong> — you're writing deeply and thoughtfully!"
                         : ewcAvg >= 50  ? $"✍️ Your entries average <strong>{ewcAvg} words</strong> — rich, detailed reflections. Keep going!"
                         :                 $"✍️ Your entries average <strong>{ewcAvg} words</strong> — solid depth of reflection!";
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">@((MarkupString)ewcLabel)</MudText>
        }
    }
}
@{
    var moodEmojis = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["happy"]      = "😊", ["excited"]  = "🤩", ["proud"]      = "🌟", ["great"]    = "😄",
        ["good"]       = "🙂", ["calm"]     = "😌", ["hopeful"]    = "🌈", ["motivated"] = "💪",
        ["curious"]    = "🤔", ["grateful"] = "🙏", ["love"]       = "❤️", ["amazing"]  = "🎉",
        ["sad"]        = "😢", ["tired"]    = "😴", ["bored"]      = "😐", ["frustrated"] = "😤",
        ["angry"]      = "😡", ["anxious"]  = "😟", ["nervous"]    = "😰", ["stressed"] = "😰",
        ["overwhelmed"] = "😩", ["confused"] = "😕", ["uncertain"] = "🤷", ["down"]    = "😔"
    };
    var recentMoods = AllEntries
        .Where(j => !string.IsNullOrWhiteSpace(j.Mood))
        .Take(10)
        .Select(j => moodEmojis.GetValueOrDefault(j.Mood!.Trim(), "💭"))
        .ToList();
}
@if (recentMoods.Count >= 3)
{
    <MudPaper Elevation="0" Class="pa-2 mb-3" Style="border-radius:10px;background:var(--mud-palette-background-grey);">
        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight:600;" Class="mb-1">Your recent emotion journey (newest → oldest):</MudText>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0" Wrap="Wrap.Wrap">
            @foreach (var emoji in recentMoods)
            {
                <MudText Style="font-size:1.4rem;line-height:1.6;margin-right:4px;">@emoji</MudText>
            }
        </MudStack>
    </MudPaper>
}
@* On this day — memories from past years *@
@if (OnThisDayEntries.Count > 0)
{
    <MudPaper Elevation="1" Class="pa-3 mb-3" Style="border-radius:12px;border-left:4px solid var(--mud-palette-info);">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.History" Color="Color.Info" Size="Size.Small" />
            <MudText Typo="Typo.body2" Style="font-weight:700;color:var(--mud-palette-info-darken);">📅 On this day…</MudText>
        </MudStack>
        @foreach (var (entry, yearsAgo) in OnThisDayEntries)
        {
            var otdLabel = yearsAgo == 1 ? "1 year ago" : $"{yearsAgo} years ago";
            var otdSnip = !string.IsNullOrWhiteSpace(entry.Notes)
                ? (entry.Notes.Length > 150 ? entry.Notes[..150] + "…" : entry.Notes)
                : null;
            var otdMood = !string.IsNullOrWhiteSpace(entry.Mood) ? entry.Mood : null;
            <MudPaper Elevation="0" Class="pa-2 mb-2" Style="border-radius:8px;background:var(--mud-palette-background-grey);">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@otdLabel</MudChip>
                    @if (otdMood is not null)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">@otdMood</MudChip>
                    }
                </MudStack>
                @if (otdSnip is not null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@otdSnip</MudText>
                }
            </MudPaper>
        }
    </MudPaper>
}
@* 5-week journal heatmap *@
@if (AllEntries.Count >= 3)
{
    var jhmToday = DateOnly.FromDateTime(DateTime.Today);
    var jhmStart = jhmToday.AddDays(-34);
    var jhmCounts = AllEntries
        .GroupBy(j => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(j.EnteredDate).LocalDateTime))
        .ToDictionary(g => g.Key, g => g.Count());
    var jhmDaysOfWeek = new[] { "M", "T", "W", "T", "F", "S", "S" };
    <MudPaper Elevation="0" Class="pa-2 mb-3" Style="border-radius:10px;background:var(--mud-palette-background-grey);">
        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight:600;" Class="mb-2">Writing activity — last 5 weeks</MudText>
        <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:3px;max-width:220px;">
            @for (int jhi = 0; jhi < 7; jhi++)
            {
                <div style="text-align:center;font-size:0.58rem;color:var(--mud-palette-text-secondary);padding-bottom:2px;">@jhmDaysOfWeek[jhi]</div>
            }
            @for (int jhi = 0; jhi < 35; jhi++)
            {
                var jhmDay = jhmStart.AddDays(jhi);
                jhmCounts.TryGetValue(jhmDay, out var jhmCount);
                var jhmIsToday = jhmDay == jhmToday;
                var jhmBg = jhmCount == 0 ? "var(--mud-palette-background-grey)"
                          : jhmCount == 1 ? "#a5d6a7"
                          : jhmCount == 2 ? "#66bb6a"
                          : "#2e7d32";
                var jhmBorder = jhmIsToday ? "2px solid var(--mud-palette-primary)" : "none";
                var jhmTitle = jhmCount == 0 ? jhmDay.ToString("MMM d")
                             : jhmCount == 1 ? $"{jhmDay:MMM d} — 1 entry ✓"
                             : $"{jhmDay:MMM d} — {jhmCount} entries ✓";
                <div title="@jhmTitle" style="width:100%;aspect-ratio:1;border-radius:3px;background:@jhmBg;border:@jhmBorder;cursor:default;opacity:@(jhmDay > jhmToday ? "0.3" : "1")"></div>
            }
        </div>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
            <MudText Typo="Typo.caption" Color="Color.Secondary">None</MudText>
            <div style="width:11px;height:11px;border-radius:2px;background:var(--mud-palette-background-grey);"></div>
            <div style="width:11px;height:11px;border-radius:2px;background:#a5d6a7;"></div>
            <div style="width:11px;height:11px;border-radius:2px;background:#66bb6a;"></div>
            <div style="width:11px;height:11px;border-radius:2px;background:#2e7d32;"></div>
            <MudText Typo="Typo.caption" Color="Color.Secondary">3+</MudText>
        </MudStack>
    </MudPaper>
}
@* Tag cloud — appears only when entries have tags *@
@if (AllTags.Count > 0)
{
    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mb-2" Spacing="1">
        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="margin-right:4px;">Filter by tag:</MudText>
        @foreach (var (tag, count) in AllTags)
        {
            var isSelected = TagFilter == tag;
            var isTopTag = AllTags.Count > 0 && tag == AllTags[0].Tag && count > 1;
            <MudChip T="string"
                     Variant="@(isSelected ? Variant.Filled : isTopTag ? Variant.Filled : Variant.Outlined)"
                     Color="@(isSelected ? Color.Primary : isTopTag ? Color.Warning : Color.Default)"
                     Size="@(isTopTag ? Size.Medium : Size.Small)"
                     OnClick="() => OnTagFilterChanged(tag)"
                     Style="@(isTopTag ? "cursor:pointer;font-weight:700;" : "cursor:pointer;")">
                @(isTopTag ? "⭐ " : "")@tag <span style="opacity:.6;margin-left:4px;">@count</span>
            </MudChip>
        }
        @if (TagFilter is not null)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text"
                     OnClick="() => OnTagFilterChanged(null)" Style="cursor:pointer;">
                ✕ Clear
            </MudChip>
        }
    </MudStack>
}

@* Mood distribution bar chart — only when 3+ entries with moods *@
@if (AllMoods.Count >= 2 && AllMoods.Sum(m => m.Count) >= 3)
{
    var moodChartEmojis = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase) {
        {"happy","😊"}, {"sad","😢"}, {"calm","😌"}, {"excited","🤩"}, {"tired","😴"},
        {"angry","😠"}, {"anxious","😟"}, {"grateful","🙏"}, {"proud","💪"}, {"focused","🎯"}
    };
    var moodColors = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase) {
        {"happy","#FDD835"}, {"excited","#FF7043"}, {"grateful","#AB47BC"}, {"calm","#42A5F5"},
        {"proud","#26A69A"}, {"focused","#5C6BC0"}, {"sad","#78909C"}, {"tired","#A1887F"},
        {"angry","#EF5350"}, {"anxious","#FF8A65"}
    };
    var mcdTotal = AllMoods.Sum(m => m.Count);
    var mcdMax = AllMoods.Max(m => m.Count);
    var mcdShow = AllMoods.Take(6).ToList();
    <MudPaper Elevation="0" Class="pa-3 mb-3" Style="border-radius:12px;background:var(--mud-palette-background-grey);">
        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight:700;letter-spacing:.5px;" Class="mb-2">
            MOOD BREAKDOWN — @mcdTotal ENTRIES
        </MudText>
        @foreach (var (mood, count) in mcdShow)
        {
            var moodPct = (int)(count * 100.0 / Math.Max(mcdTotal, 1));
            var barPct = (int)(count * 100.0 / Math.Max(mcdMax, 1));
            var moodEmoji = moodChartEmojis.GetValueOrDefault(mood, "💭");
            var barColor = moodColors.GetValueOrDefault(mood, "var(--mud-palette-primary)");
            <div style="margin-bottom:5px;">
                <div style="display:flex;align-items:center;gap:6px;margin-bottom:2px;">
                    <span style="font-size:0.85rem;min-width:20px;">@moodEmoji</span>
                    <span style="font-size:0.75rem;color:var(--mud-palette-text-primary);min-width:68px;font-weight:600;">@mood</span>
                    <div style="flex:1;background:var(--mud-palette-lines-default);border-radius:4px;height:10px;overflow:hidden;">
                        <div style="width:@(barPct)%;height:100%;background:@barColor;border-radius:4px;transition:width .4s ease;"></div>
                    </div>
                    <span style="font-size:0.7rem;color:var(--mud-palette-text-secondary);min-width:32px;text-align:right;">@moodPct%</span>
                </div>
            </div>
        }
    </MudPaper>
}

@* Mood cloud — appears only when entries have moods *@
@if (AllMoods.Count > 0)
{
    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mb-2" Spacing="1">
        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="margin-right:4px;">Filter by mood:</MudText>
        @foreach (var (mood, count) in AllMoods)
        {
            var isSelected = MoodFilter == mood;
            <MudChip T="string"
                     Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                     Color="@(isSelected ? Color.Tertiary : Color.Default)"
                     Size="Size.Small"
                     OnClick="() => OnMoodFilterChanged(mood)"
                     Style="cursor:pointer;">
                @mood <span style="opacity:.6;margin-left:4px;">@count</span>
            </MudChip>
        }
        @if (MoodFilter is not null)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text"
                     OnClick="() => OnMoodFilterChanged(null)" Style="cursor:pointer;">
                ✕ Clear
            </MudChip>
        }
    </MudStack>
}

@{
    var erMoodEntries = AllEntries.Where(j => !string.IsNullOrWhiteSpace(j.Mood)).ToList();
    var erWithReason = erMoodEntries.Count(j => !string.IsNullOrWhiteSpace(j.EmotionReason));
    var erPct = erMoodEntries.Count > 0 ? (int)(erWithReason * 100.0 / erMoodEntries.Count) : 0;
}
@if (erMoodEntries.Count >= 5 && erPct < 40)
{
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
        💡 <strong>Tip:</strong> Only @erPct% of your mood entries include a reason. Adding a "why" makes your journal much more insightful to look back on!
    </MudText>
}
else if (erMoodEntries.Count >= 5 && erPct >= 70)
{
    <MudText Typo="Typo.caption" Color="Color.Success" Class="mb-2">
        🌟 <strong>@erPct% of your mood entries have a reason</strong> — deep reflection habit! Your future self will thank you for this!
    </MudText>
}
@* Activity cloud — appears only when entries have activities *@
@if (AllActivities.Count > 0)
{
    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mb-4" Spacing="1">
        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="margin-right:4px;">Filter by activity:</MudText>
        @foreach (var (activity, count) in AllActivities)
        {
            var isSelected = ActivityFilter == activity;
            <MudChip T="string"
                     Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                     Color="@(isSelected ? Color.Success : Color.Default)"
                     Size="Size.Small"
                     OnClick="() => OnActivityFilterChanged(activity)"
                     Style="cursor:pointer;">
                @activity <span style="opacity:.6;margin-left:4px;">@count</span>
            </MudChip>
        }
        @if (ActivityFilter is not null)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text"
                     OnClick="() => OnActivityFilterChanged(null)" Style="cursor:pointer;">
                ✕ Clear
            </MudChip>
        }
    </MudStack>
}

@{
    var isFiltered = !string.IsNullOrWhiteSpace(FilterText) || DateFilter != "All" || TagFilter is not null || MoodFilter is not null || ActivityFilter is not null;
}
@if (isFiltered && AllEntries.Any())
{
    var filterParts = new List<string>();
    if (!string.IsNullOrWhiteSpace(FilterText)) filterParts.Add($"\"{FilterText}\"");
    if (TagFilter is not null) filterParts.Add($"#{TagFilter}");
    if (MoodFilter is not null) filterParts.Add($"mood:{MoodFilter}");
    if (ActivityFilter is not null) filterParts.Add($"activity:{ActivityFilter}");
    if (DateFilter != "All") filterParts.Add(DateFilter == "Week" ? "this week" : "this month");
    var filterDesc = filterParts.Count > 0 ? string.Join(", ", filterParts) : "filter";
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
        @_filteredEntries.Count of @AllEntries.Count entries matching @filterDesc
    </MudText>
}
@if (!AllEntries.Any())
{
    <MudText Typo="Typo.body2" Color="Color.Secondary">No journal entries yet. Write the first one!</MudText>
}
else if (!Entries.Any())
{
    @if (!string.IsNullOrWhiteSpace(FilterText) && DateFilter != "All")
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">No entries matching "@FilterText" in this date range.</MudText>
    }
    else if (!string.IsNullOrWhiteSpace(FilterText))
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">No entries matching "@FilterText".</MudText>
    }
    else
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">No entries in this date range.</MudText>
    }
}
else
{
    <MudGrid>
        @foreach (var j in Entries)
        {
            var enteredDate = DateTimeOffset.FromUnixTimeMilliseconds(j.EnteredDate).LocalDateTime;
            var jWc = string.IsNullOrWhiteSpace(j.Notes) ? 0 : j.Notes.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length;
            var jWcLabel = jWc >= 150 ? $"📖 Deep entry · {jWc} words" : jWc >= 50 ? $"📝 {jWc} words" : (string?)null;
            var jIsLong = (j.Notes?.Length ?? 0) > 200 || (j.EmotionReason?.Length ?? 0) > 100;
            var jExpanded = _expandedGuids.Contains(j.Guid);
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="2" Class="h-100">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@enteredDate.ToString("MMM d, yyyy")</MudText>
                            @if (!string.IsNullOrWhiteSpace(j.Activity))
                            {
                                <MudText Typo="Typo.body2" Class="mt-1"><strong>@j.Activity</strong></MudText>
                            }
                        </CardHeaderContent>
                        <CardHeaderActions>
                            @if (!string.IsNullOrWhiteSpace(j.Mood))
                            {
                                var jMoodEmoji2 = j.Mood switch {
                                    "happy" => "😊", "excited" => "🤩", "grateful" => "🙏", "proud" => "💪",
                                    "calm" => "😌", "focused" => "🎯", "sad" => "😢", "tired" => "😴",
                                    "anxious" => "😟", "angry" => "😠", _ => null
                                };
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary">@(jMoodEmoji2 is not null ? $"{jMoodEmoji2} " : "")@j.Mood</MudChip>
                            }
                        </CardHeaderActions>
                    </MudCardHeader>
                    @if (!string.IsNullOrWhiteSpace(j.Notes) || !string.IsNullOrWhiteSpace(j.EmotionReason))
                    {
                        <MudCardContent Class="pt-0">
                            @if (!string.IsNullOrWhiteSpace(j.Notes))
                            {
                                <MudText Typo="Typo.body2">@(jExpanded || j.Notes.Length <= 200 ? j.Notes : j.Notes[..200] + "…")</MudText>
                                @if (jWcLabel is not null)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">@jWcLabel</MudText>
                                }
                            }
                            @if (!string.IsNullOrWhiteSpace(j.EmotionReason))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                    <em>Why: @(jExpanded || j.EmotionReason.Length <= 100 ? j.EmotionReason : j.EmotionReason[..100] + "…")</em>
                                </MudText>
                            }
                            @if (jIsLong)
                            {
                                var capturedGuid = j.Guid;
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                           Class="mt-1 px-0"
                                           OnClick="() => { if (_expandedGuids.Contains(capturedGuid)) _expandedGuids.Remove(capturedGuid); else _expandedGuids.Add(capturedGuid); }">
                                    @(jExpanded ? "Show less" : "Read more")
                                </MudButton>
                            }
                        </MudCardContent>
                    }
                    <MudCardActions>
                        @if (!string.IsNullOrWhiteSpace(j.Tags))
                        {
                            @foreach (var tag in j.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                            {
                                var capturedTag = tag;
                                var isActiveTag = TagFilter?.Equals(capturedTag, StringComparison.OrdinalIgnoreCase) == true;
                                var isGoalTag = _activeGoalNameToGuid.TryGetValue(capturedTag, out var tagGoalGuid);
                                @if (isGoalTag && tagGoalGuid is not null)
                                {
                                    <MudChip T="string" Size="Size.Small"
                                             Variant="Variant.Outlined" Color="Color.Success"
                                             Icon="@Icons.Material.Filled.EmojiEvents"
                                             Href="@($"/goals/{tagGoalGuid}")"
                                             Style="cursor:pointer;">@capturedTag</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small"
                                             Variant="@(isActiveTag ? Variant.Filled : Variant.Outlined)"
                                             Color="@(isActiveTag ? Color.Primary : Color.Default)"
                                             Style="cursor:pointer;"
                                             OnClick="() => OnTagFilterChanged(capturedTag)">@capturedTag</MudChip>
                                }
                            }
                        }
                        <MudSpacer />
                        @if (!string.IsNullOrWhiteSpace(j.Notes))
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                           title="Copy entry text" aria-label="Copy journal entry"
                                           OnClick="() => CopyEntryText(j)" />
                        }
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       aria-label="Edit entry"
                                       OnClick="() => OpenEditEntry(j)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                       Color="Color.Error" aria-label="Delete entry"
                                       OnClick="() => _confirmDeleteGuid = j.Guid" />
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
    @if (_filteredEntries.Count > _displayCount)
    {
        <MudStack AlignItems="AlignItems.Center" Class="mt-4">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.ExpandMore"
                       OnClick="LoadMore">
                Load more (@(_filteredEntries.Count - _displayCount) remaining)
            </MudButton>
        </MudStack>
    }
    else if (_filteredEntries.Count > PageSize)
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-center mt-3 d-block">
            All @_filteredEntries.Count entries shown
        </MudText>
    }
}

@* Delete Entry Confirmation *@
