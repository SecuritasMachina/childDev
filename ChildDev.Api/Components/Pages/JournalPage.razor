<MudDialog @bind-Visible="ShowAddDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.EditNote" Class="mr-2" />
            New Journal Entry
        </MudText>
    </TitleContent>
    <DialogContent>
        @{
            var newWc = NewNotes.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length;
            var newWcHelper = newWc == 0 ? "Write freely — every word counts!" : $"{newWc} word{(newWc == 1 ? "" : "s")}";
        }
        <MudTextField @bind-Value="NewNotes" Label="What happened? What did you observe?" Variant="Variant.Outlined"
                      Lines="4" Class="mb-4" AutoFocus="true" Immediate="true"
                      HelperText="@newWcHelper" />
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Activity (tap to select or type below):</MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-2">
            @foreach (var act in new[] { "School", "Sports", "Reading", "Art", "Music", "Family time", "Social", "Homework", "Outdoor play", "Screen time" })
            {
                var capturedAct = act;
                <MudChip T="string" Size="Size.Small"
                         Variant="@(NewActivity == capturedAct ? Variant.Filled : Variant.Outlined)"
                         Color="@(NewActivity == capturedAct ? Color.Primary : Color.Default)"
                         Style="cursor:pointer;"
                         OnClick="() => NewActivity = (NewActivity == capturedAct ? string.Empty : capturedAct)">@act</MudChip>
            }
        </MudStack>
        <MudTextField @bind-Value="NewActivity" Label="Or type your own activity (optional)" Variant="Variant.Outlined" Class="mb-4" />
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">How did you feel? (tap to select or type below)</MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-2">
            @foreach (var (emoji, mood) in new[] { ("😊","happy"), ("🤩","excited"), ("🙏","grateful"), ("💪","proud"), ("😌","calm"), ("🎯","focused"), ("😢","sad"), ("😴","tired"), ("😟","anxious"), ("😠","angry") })
            {
                <MudChip T="string" Size="Size.Small" Variant="@(NewMood == mood ? Variant.Filled : Variant.Outlined)"
                         Color="@(NewMood == mood ? Color.Primary : Color.Default)"
                         Style="cursor:pointer;" OnClick="() => NewMood = (NewMood == mood ? string.Empty : mood)">@emoji @mood</MudChip>
            }
        </MudStack>
        <MudTextField @bind-Value="NewMood" Label="Or type your own mood (optional)" Variant="Variant.Outlined" Class="mb-4" />
        <MudTextField @bind-Value="NewEmotionReason" Label="Why did you feel that way? (optional)" Variant="Variant.Outlined"
                      Lines="2" Class="mb-4" />
        @if (AllTags.Count > 0)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Your tags (tap to add):</MudText>
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-2">
                @foreach (var (tag, _) in AllTags.Take(6))
                {
                    var ntCurrent = NewTags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                    var ntActive = ntCurrent.Any(t => t.Equals(tag, StringComparison.OrdinalIgnoreCase));
                    <MudChip T="string" Size="Size.Small"
                             Variant="@(ntActive ? Variant.Filled : Variant.Outlined)"
                             Color="@(ntActive ? Color.Primary : Color.Default)"
                             Style="cursor:pointer;"
                             OnClick="@(() => { var parts = NewTags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList(); if (parts.Any(t => t.Equals(tag, StringComparison.OrdinalIgnoreCase))) parts.RemoveAll(t => t.Equals(tag, StringComparison.OrdinalIgnoreCase)); else parts.Add(tag); NewTags = string.Join(", ", parts); })">@tag</MudChip>
                }
            </MudStack>
        }
        @if (ActiveGoalNames.Count > 0)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Tag a goal (optional):</MudText>
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-2">
                @foreach (var goalName in ActiveGoalNames)
                {
                    var gTag = goalName.Length > 30 ? goalName[..30] + "…" : goalName;
                    var capturedGoal = goalName;
                    var gCurrent = NewTags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                    var gActive = gCurrent.Any(t => t.Equals(capturedGoal, StringComparison.OrdinalIgnoreCase));
                    <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Flag"
                             Variant="@(gActive ? Variant.Filled : Variant.Outlined)"
                             Color="@(gActive ? Color.Success : Color.Default)"
                             Style="cursor:pointer;"
                             OnClick="@(() => { var parts = NewTags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList(); if (parts.Any(t => t.Equals(capturedGoal, StringComparison.OrdinalIgnoreCase))) parts.RemoveAll(t => t.Equals(capturedGoal, StringComparison.OrdinalIgnoreCase)); else parts.Add(capturedGoal); NewTags = string.Join(", ", parts); })">@gTag</MudChip>
                }
            </MudStack>
        }
        <MudTextField @bind-Value="NewTags" Label="Tags (optional, comma-separated)" Variant="Variant.Outlined" Class="mb-4" />
        <MudDatePicker @bind-Date="NewEnteredDate" Label="Entry date" Variant="Variant.Outlined" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => ShowAddDialog = false">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddEntry"
                   Disabled="@(string.IsNullOrWhiteSpace(NewNotes) && string.IsNullOrWhiteSpace(NewActivity))">Save Entry</MudButton>
    </DialogActions>
</MudDialog>

