@page "/journal"
@inject AppDbContext Db
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor
@inject ISnackbar Snackbar
@inject WebAnalyticsService Analytics

<PageTitle>Journal – ChildDev</PageTitle>

@if (AccountGuid is null)
{
    Nav.NavigateTo("/login");
    return;
}

<MudText Typo="Typo.h5" Class="mb-4">
    <MudIcon Icon="@Icons.Material.Filled.Book" Class="mr-2" />
    Journal
</MudText>

<MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-4" Spacing="2">
    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenAddDialog">New Entry</MudButton>
    @if (AllEntries.Any())
    {
        <MudChipSet T="string" SelectionMode="SelectionMode.SingleSelection"
                    SelectedValue="@DateFilter"
                    SelectedValueChanged="@((string v) => OnDateFilterChanged(v))">
            <MudChip T="string" Value="@("All")" Variant="Variant.Filled" Color="Color.Default">All</MudChip>
            <MudChip T="string" Value="@("Week")" Variant="Variant.Filled" Color="Color.Info">This Week</MudChip>
            <MudChip T="string" Value="@("Month")" Variant="Variant.Filled" Color="Color.Info">This Month</MudChip>
        </MudChipSet>
        <MudSpacer />
        <MudTextField Value="@FilterText" ValueChanged="@((string v) => OnFilterChanged(v))"
                      Placeholder="Search entries…" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true" Immediate="true" Style="min-width:220px"
                      AdornmentColor="Color.Secondary" />
    }
</MudStack>

@if (JournalStreak >= 2)
{
    var jsMsg = JournalStreak >= 14 ? $"🌟 {JournalStreak}-day journaling streak — absolutely legendary! You're a journaling champion!"
              : JournalStreak >= 7  ? $"🔥 {JournalStreak}-day journaling streak — incredible consistency! Keep it going!"
              : JournalStreak >= 4  ? $"💪 {JournalStreak}-day journaling streak — you're building a great habit!"
              :                       $"⭐ {JournalStreak}-day journaling streak — you're on a roll!";
    <MudAlert Severity="@(JournalStreak >= 7 ? Severity.Success : Severity.Info)" Dense="true" Class="mb-3">@jsMsg</MudAlert>
}

@* Tag cloud — appears only when entries have tags *@
@if (AllTags.Count > 0)
{
    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mb-2" Spacing="1">
        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="margin-right:4px;">Filter by tag:</MudText>
        @foreach (var (tag, count) in AllTags)
        {
            var isSelected = TagFilter == tag;
            <MudChip T="string"
                     Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                     Color="@(isSelected ? Color.Primary : Color.Default)"
                     Size="Size.Small"
                     OnClick="() => OnTagFilterChanged(tag)"
                     Style="cursor:pointer;">
                @tag <span style="opacity:.6;margin-left:4px;">@count</span>
            </MudChip>
        }
        @if (TagFilter is not null)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text"
                     OnClick="() => OnTagFilterChanged(null)" Style="cursor:pointer;">
                ✕ Clear
            </MudChip>
        }
    </MudStack>
}

@* Mood cloud — appears only when entries have moods *@
@if (AllMoods.Count > 0)
{
    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mb-2" Spacing="1">
        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="margin-right:4px;">Filter by mood:</MudText>
        @foreach (var (mood, count) in AllMoods)
        {
            var isSelected = MoodFilter == mood;
            <MudChip T="string"
                     Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                     Color="@(isSelected ? Color.Tertiary : Color.Default)"
                     Size="Size.Small"
                     OnClick="() => OnMoodFilterChanged(mood)"
                     Style="cursor:pointer;">
                @mood <span style="opacity:.6;margin-left:4px;">@count</span>
            </MudChip>
        }
        @if (MoodFilter is not null)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text"
                     OnClick="() => OnMoodFilterChanged(null)" Style="cursor:pointer;">
                ✕ Clear
            </MudChip>
        }
    </MudStack>
}

@* Activity cloud — appears only when entries have activities *@
@if (AllActivities.Count > 0)
{
    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mb-4" Spacing="1">
        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="margin-right:4px;">Filter by activity:</MudText>
        @foreach (var (activity, count) in AllActivities)
        {
            var isSelected = ActivityFilter == activity;
            <MudChip T="string"
                     Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                     Color="@(isSelected ? Color.Success : Color.Default)"
                     Size="Size.Small"
                     OnClick="() => OnActivityFilterChanged(activity)"
                     Style="cursor:pointer;">
                @activity <span style="opacity:.6;margin-left:4px;">@count</span>
            </MudChip>
        }
        @if (ActivityFilter is not null)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text"
                     OnClick="() => OnActivityFilterChanged(null)" Style="cursor:pointer;">
                ✕ Clear
            </MudChip>
        }
    </MudStack>
}

@if (!AllEntries.Any())
{
    <MudText Typo="Typo.body2" Color="Color.Secondary">No journal entries yet. Write the first one!</MudText>
}
else if (!Entries.Any())
{
    @if (!string.IsNullOrWhiteSpace(FilterText) && DateFilter != "All")
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">No entries matching "@FilterText" in this date range.</MudText>
    }
    else if (!string.IsNullOrWhiteSpace(FilterText))
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">No entries matching "@FilterText".</MudText>
    }
    else
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">No entries in this date range.</MudText>
    }
}
else
{
    <MudGrid>
        @foreach (var j in Entries)
        {
            var enteredDate = DateTimeOffset.FromUnixTimeMilliseconds(j.EnteredDate).LocalDateTime;
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="2" Class="h-100">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@enteredDate.ToString("MMM d, yyyy")</MudText>
                            @if (!string.IsNullOrWhiteSpace(j.Activity))
                            {
                                <MudText Typo="Typo.body2" Class="mt-1"><strong>@j.Activity</strong></MudText>
                            }
                        </CardHeaderContent>
                        <CardHeaderActions>
                            @if (!string.IsNullOrWhiteSpace(j.Mood))
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary">@j.Mood</MudChip>
                            }
                        </CardHeaderActions>
                    </MudCardHeader>
                    @if (!string.IsNullOrWhiteSpace(j.Notes))
                    {
                        <MudCardContent Class="pt-0">
                            <MudText Typo="Typo.body2">@(j.Notes.Length > 200 ? j.Notes[..200] + "…" : j.Notes)</MudText>
                        </MudCardContent>
                    }
                    <MudCardActions>
                        @if (!string.IsNullOrWhiteSpace(j.Tags))
                        {
                            @foreach (var tag in j.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@tag</MudChip>
                            }
                        }
                        <MudSpacer />
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       aria-label="Edit entry"
                                       OnClick="() => OpenEditEntry(j)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                       Color="Color.Error" aria-label="Delete entry"
                                       OnClick="() => _confirmDeleteGuid = j.Guid" />
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
    @if (_filteredEntries.Count > _displayCount)
    {
        <MudStack AlignItems="AlignItems.Center" Class="mt-4">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.ExpandMore"
                       OnClick="LoadMore">
                Load more (@(_filteredEntries.Count - _displayCount) remaining)
            </MudButton>
        </MudStack>
    }
    else if (_filteredEntries.Count > PageSize)
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-center mt-3 d-block">
            All @_filteredEntries.Count entries shown
        </MudText>
    }
}

@* Delete Entry Confirmation *@
<MudDialog Visible="@(_confirmDeleteGuid is not null)" VisibleChanged="@((bool v) => { if (!v) _confirmDeleteGuid = null; })">
    <TitleContent>
        <MudText Typo="Typo.h6" Color="Color.Error">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Class="mr-2" />
            Delete Entry?
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText>Remove this journal entry?</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _confirmDeleteGuid = null">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ConfirmDeleteEntry">Delete</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="ShowAddDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.EditNote" Class="mr-2" />
            New Journal Entry
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="NewNotes" Label="What happened? What did you observe?" Variant="Variant.Outlined"
                      Lines="4" Class="mb-4" AutoFocus="true" />
        <MudTextField @bind-Value="NewActivity" Label="Activity (optional)" Variant="Variant.Outlined" Class="mb-4" />
        <MudTextField @bind-Value="NewMood" Label="Mood (optional)" Variant="Variant.Outlined" Class="mb-4" />
        <MudTextField @bind-Value="NewTags" Label="Tags (optional, comma-separated)" Variant="Variant.Outlined" Class="mb-4" />
        <MudDatePicker @bind-Date="NewEnteredDate" Label="Entry date" Variant="Variant.Outlined" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => ShowAddDialog = false">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddEntry"
                   Disabled="@(string.IsNullOrWhiteSpace(NewNotes) && string.IsNullOrWhiteSpace(NewActivity))">Save Entry</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="ShowEditDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2" />
            Edit Entry
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="EditNotes" Label="Notes" Variant="Variant.Outlined"
                      Lines="4" Class="mb-4" AutoFocus="true" />
        <MudTextField @bind-Value="EditActivity" Label="Activity (optional)" Variant="Variant.Outlined" Class="mb-4" />
        <MudTextField @bind-Value="EditMood" Label="Mood (optional)" Variant="Variant.Outlined" Class="mb-4" />
        <MudTextField @bind-Value="EditTags" Label="Tags (optional, comma-separated)" Variant="Variant.Outlined" Class="mb-4" />
        <MudDatePicker @bind-Date="EditEnteredDate" Label="Entry date" Variant="Variant.Outlined" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => ShowEditDialog = false">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveEditEntry"
                   Disabled="@(string.IsNullOrWhiteSpace(EditNotes) && string.IsNullOrWhiteSpace(EditActivity))">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const int PageSize = 20;
    private string? AccountGuid;
    private List<Journal> AllEntries = [];
    private List<Journal> _filteredEntries = [];
    private List<Journal> Entries = [];
    private int _displayCount = PageSize;
    private string FilterText = string.Empty;
    private string DateFilter = "All";
    private string? TagFilter;
    private string? MoodFilter;
    private string? ActivityFilter;
    private List<(string Tag, int Count)> AllTags = [];
    private List<(string Mood, int Count)> AllMoods = [];
    private List<(string Activity, int Count)> AllActivities = [];
    private bool ShowAddDialog;
    private string NewNotes = string.Empty;
    private string NewActivity = string.Empty;
    private string NewMood = string.Empty;
    private string NewTags = string.Empty;
    private DateTime? NewEnteredDate = DateTime.Today;
    private bool ShowEditDialog;
    private string? EditingGuid;
    private string EditNotes = string.Empty;
    private string EditActivity = string.Empty;
    private string EditMood = string.Empty;
    private string EditTags = string.Empty;
    private DateTime? EditEnteredDate;
    private string? _confirmDeleteGuid;
    private int JournalStreak;

    protected override async Task OnInitializedAsync()
    {
        AccountGuid = HttpContextAccessor.HttpContext?.Session.GetString("AccountGuid");
        if (AccountGuid is null) return;
        await LoadEntries();
        await Analytics.TrackAsync("page_view", AccountGuid, "journal");
    }

    private async Task LoadEntries()
    {
        AllEntries = await Db.Journals
            .Where(j => j.AccountFk == AccountGuid && j.DeletedAt == null)
            .OrderByDescending(j => j.EnteredDate)
            .ToListAsync();
        var journalDates = AllEntries
            .Select(j => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(j.EnteredDate).LocalDateTime))
            .ToHashSet();
        JournalStreak = 0;
        var jsDay = DateOnly.FromDateTime(DateTime.Today);
        while (journalDates.Contains(jsDay))
        {
            JournalStreak++;
            jsDay = jsDay.AddDays(-1);
        }
        BuildTagCloud();
        BuildMoodCloud();
        BuildActivityCloud();
        ApplyFilter();
    }

    private void BuildTagCloud()
    {
        AllTags = AllEntries
            .Where(j => !string.IsNullOrWhiteSpace(j.Tags))
            .SelectMany(j => j.Tags!.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            .GroupBy(t => t, StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(g => g.Count())
            .ThenBy(g => g.Key)
            .Select(g => (g.Key, g.Count()))
            .ToList();
        // Clear tag filter if the selected tag no longer exists
        if (TagFilter is not null && !AllTags.Any(t => t.Tag.Equals(TagFilter, StringComparison.OrdinalIgnoreCase)))
            TagFilter = null;
    }

    private void OnTagFilterChanged(string? tag)
    {
        TagFilter = TagFilter == tag ? null : tag;
        ApplyFilter();
        if (tag is not null && AccountGuid is not null)
            _ = Analytics.TrackAsync("journal_tag_filter", AccountGuid, "journal", tag);
    }

    private void BuildMoodCloud()
    {
        AllMoods = AllEntries
            .Where(j => !string.IsNullOrWhiteSpace(j.Mood))
            .GroupBy(j => j.Mood!, StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(g => g.Count())
            .ThenBy(g => g.Key)
            .Select(g => (g.Key, g.Count()))
            .ToList();
        if (MoodFilter is not null && !AllMoods.Any(m => m.Mood.Equals(MoodFilter, StringComparison.OrdinalIgnoreCase)))
            MoodFilter = null;
    }

    private void OnMoodFilterChanged(string? mood)
    {
        MoodFilter = MoodFilter == mood ? null : mood;
        ApplyFilter();
        if (mood is not null && AccountGuid is not null)
            _ = Analytics.TrackAsync("journal_mood_filter", AccountGuid, "journal", mood);
    }

    private void BuildActivityCloud()
    {
        AllActivities = AllEntries
            .Where(j => !string.IsNullOrWhiteSpace(j.Activity))
            .GroupBy(j => j.Activity!, StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(g => g.Count())
            .ThenBy(g => g.Key)
            .Select(g => (g.Key, g.Count()))
            .ToList();
        if (ActivityFilter is not null && !AllActivities.Any(a => a.Activity.Equals(ActivityFilter, StringComparison.OrdinalIgnoreCase)))
            ActivityFilter = null;
    }

    private void OnActivityFilterChanged(string? activity)
    {
        ActivityFilter = ActivityFilter == activity ? null : activity;
        ApplyFilter();
        if (activity is not null && AccountGuid is not null)
            _ = Analytics.TrackAsync("journal_activity_filter", AccountGuid, "journal", activity);
    }

    private void OnFilterChanged(string value)
    {
        FilterText = value;
        ApplyFilter();
    }

    private void OnDateFilterChanged(string value)
    {
        DateFilter = value ?? "All";
        ApplyFilter();
        if (AccountGuid is not null && DateFilter != "All")
            _ = Analytics.TrackAsync("journal_filter", AccountGuid, "journal", DateFilter);
    }

    private void ApplyFilter()
    {
        var weekStartMs = DateTimeOffset.UtcNow.AddDays(-7).ToUnixTimeMilliseconds();
        var monthStartMs = DateTimeOffset.UtcNow.AddDays(-30).ToUnixTimeMilliseconds();

        IEnumerable<Journal> filtered = DateFilter switch
        {
            "Week" => AllEntries.Where(j => j.EnteredDate >= weekStartMs),
            "Month" => AllEntries.Where(j => j.EnteredDate >= monthStartMs),
            _ => AllEntries
        };

        if (!string.IsNullOrWhiteSpace(FilterText))
        {
            var q = FilterText.Trim();
            filtered = filtered.Where(j =>
                (j.Notes?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (j.Activity?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (j.Mood?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (j.Tags?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        if (TagFilter is not null)
        {
            filtered = filtered.Where(j =>
                j.Tags != null &&
                j.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .Any(t => t.Equals(TagFilter, StringComparison.OrdinalIgnoreCase)));
        }

        if (MoodFilter is not null)
            filtered = filtered.Where(j => j.Mood != null && j.Mood.Equals(MoodFilter, StringComparison.OrdinalIgnoreCase));

        if (ActivityFilter is not null)
            filtered = filtered.Where(j => j.Activity != null && j.Activity.Equals(ActivityFilter, StringComparison.OrdinalIgnoreCase));

        _filteredEntries = filtered.ToList();
        _displayCount = PageSize;
        Entries = _filteredEntries.Take(_displayCount).ToList();
    }

    private void LoadMore()
    {
        _displayCount += PageSize;
        Entries = _filteredEntries.Take(_displayCount).ToList();
    }

    private void OpenAddDialog()
    {
        NewNotes = string.Empty;
        NewActivity = string.Empty;
        NewMood = string.Empty;
        NewTags = string.Empty;
        NewEnteredDate = DateTime.Today;
        ShowAddDialog = true;
    }

    private async Task AddEntry()
    {
        if (string.IsNullOrWhiteSpace(NewNotes) && string.IsNullOrWhiteSpace(NewActivity)) return;

        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        var enteredMs = NewEnteredDate.HasValue
            ? new DateTimeOffset(DateTime.SpecifyKind(NewEnteredDate.Value, DateTimeKind.Local)).ToUnixTimeMilliseconds()
            : now;
        Db.Journals.Add(new Journal
        {
            Guid = System.Guid.NewGuid().ToString(),
            AccountFk = AccountGuid!,
            Notes = string.IsNullOrWhiteSpace(NewNotes) ? null : NewNotes.Trim(),
            Activity = string.IsNullOrWhiteSpace(NewActivity) ? null : NewActivity.Trim(),
            Mood = string.IsNullOrWhiteSpace(NewMood) ? null : NewMood.Trim(),
            Tags = string.IsNullOrWhiteSpace(NewTags) ? null : NewTags.Trim(),
            EnteredDate = enteredMs,
            UpdatedOn = now
        });
        await Db.SaveChangesAsync();
        await Analytics.TrackAsync("journal_add", AccountGuid, "journal");

        NewNotes = string.Empty;
        NewActivity = string.Empty;
        NewMood = string.Empty;
        NewTags = string.Empty;
        NewEnteredDate = DateTime.Today;
        ShowAddDialog = false;
        Snackbar.Add("Entry saved!", Severity.Success);
        await LoadEntries();
    }

    private void OpenEditEntry(Journal j)
    {
        EditingGuid = j.Guid;
        EditNotes = j.Notes ?? string.Empty;
        EditActivity = j.Activity ?? string.Empty;
        EditMood = j.Mood ?? string.Empty;
        EditTags = j.Tags ?? string.Empty;
        EditEnteredDate = DateTimeOffset.FromUnixTimeMilliseconds(j.EnteredDate).LocalDateTime.Date;
        ShowEditDialog = true;
    }

    private async Task SaveEditEntry()
    {
        if (string.IsNullOrWhiteSpace(EditNotes) && string.IsNullOrWhiteSpace(EditActivity)) return;
        if (EditingGuid is null) return;
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        var notes = string.IsNullOrWhiteSpace(EditNotes) ? null : EditNotes.Trim();
        var activity = string.IsNullOrWhiteSpace(EditActivity) ? null : EditActivity.Trim();
        var mood = string.IsNullOrWhiteSpace(EditMood) ? null : EditMood.Trim();
        var tags = string.IsNullOrWhiteSpace(EditTags) ? null : EditTags.Trim();
        var enteredMs = EditEnteredDate.HasValue
            ? new DateTimeOffset(DateTime.SpecifyKind(EditEnteredDate.Value, DateTimeKind.Local)).ToUnixTimeMilliseconds()
            : now;
        var rows = await Db.Journals
            .Where(j => j.Guid == EditingGuid && j.AccountFk == AccountGuid)
            .ExecuteUpdateAsync(s => s
                .SetProperty(j => j.Notes, notes)
                .SetProperty(j => j.Activity, activity)
                .SetProperty(j => j.Mood, mood)
                .SetProperty(j => j.Tags, tags)
                .SetProperty(j => j.EnteredDate, enteredMs)
                .SetProperty(j => j.UpdatedOn, now));
        if (rows == 0) return;
        await Analytics.TrackAsync("journal_edit", AccountGuid, "journal");
        ShowEditDialog = false;
        Snackbar.Add("Entry updated!", Severity.Success);
        await LoadEntries();
    }

    private async Task ConfirmDeleteEntry()
    {
        var guid = _confirmDeleteGuid;
        _confirmDeleteGuid = null;
        if (guid is null) return;
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        var rows = await Db.Journals
            .Where(j => j.Guid == guid && j.AccountFk == AccountGuid && j.DeletedAt == null)
            .ExecuteUpdateAsync(s => s
                .SetProperty(j => j.DeletedAt, now)
                .SetProperty(j => j.UpdatedOn, now));
        if (rows == 0) return;
        await Analytics.TrackAsync("journal_delete", AccountGuid, "journal");
        Snackbar.Add("Entry deleted.", Severity.Info);
        await LoadEntries();
    }
}
