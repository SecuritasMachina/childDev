@page "/register"
@inject AppDbContext Db
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor
@inject WebAnalyticsService Analytics
@inject WebAuthTokenService WebAuthTokens

<PageTitle>Register – ChildDev</PageTitle>

<MudGrid Justify="Justify.Center" Class="mt-8">
    <MudItem xs="12" sm="8" md="5">
        <MudCard Class="@(_blazorReady ? "blazor-ready" : "")">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5" Align="Align.Center">
                        <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Class="mr-2" />
                        Start Achieving Goals
                    </MudText>
                    <MudStack Row="true" Justify="Justify.Center" Spacing="2" Class="mt-2">
                        <MudChip T="string" Icon="@Icons.Material.Filled.MoneyOff" Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined">100% Free</MudChip>
                        <MudChip T="string" Icon="@Icons.Material.Filled.Lock" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined">Private &amp; Secure</MudChip>
                        <MudChip T="string" Icon="@Icons.Material.Filled.NoAccounts" Color="Color.Secondary" Size="Size.Small" Variant="Variant.Outlined">No Ads</MudChip>
                    </MudStack>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                @if (Error is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4">@Error</MudAlert>
                }
                <MudTextField @bind-Value="NickName" Label="Nickname" Variant="Variant.Outlined"
                              Immediate="true"
                              Class="mb-4" HelperText="Choose a name (1–50 characters)" />
                <MudTextField @bind-Value="Pin" Label="PIN" Variant="Variant.Outlined"
                              Immediate="true"
                              InputType="@PinInputType"
                              Adornment="Adornment.End" AdornmentIcon="@PinEyeIcon"
                              OnAdornmentClick="TogglePinVisibility"
                              Class="mb-4"
                              HelperText="At least 4 characters — remember this to log back in" />
                <MudTextField @bind-Value="ConfirmPin" Label="Confirm PIN" Variant="Variant.Outlined"
                              Immediate="true"
                              InputType="@ConfirmPinInputType"
                              Adornment="Adornment.End" AdornmentIcon="@ConfirmPinEyeIcon"
                              OnAdornmentClick="ToggleConfirmPinVisibility"
                              Class="mb-4"
                              Error="@PinMismatch" ErrorText="PINs do not match" />
                <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center" Class="mt-1">
                    <MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Small" Class="mr-1" />
                    Your data stays on your device and our private servers — never sold, never shared.
                </MudText>
            </MudCardContent>
            <MudCardActions Class="px-4 pb-4 flex-column">
                <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true"
                           OnClick="DoRegister"
                           Disabled="@(string.IsNullOrWhiteSpace(NickName) || Pin.Length < 4 || Pin != ConfirmPin)">Create Account — Free</MudButton>
                <MudText Typo="Typo.body2" Class="mt-3" Align="Align.Center">
                    Already have an account? <MudLink Href="/login">Login</MudLink>
                </MudText>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-2">
                    <MudIcon Icon="@Icons.Material.Filled.Android" Size="Size.Small" Style="color:#3DDC84;" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        After signing up, grab your Account ID from Settings to connect the Android app.
                    </MudText>
                </MudStack>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private string NickName = string.Empty;
    private string Pin = string.Empty;
    private string ConfirmPin = string.Empty;
    private bool PinMismatch => ConfirmPin.Length > 0 && Pin != ConfirmPin;
    private string? Error;
    private bool _blazorReady;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _blazorReady = true;
            await Analytics.TrackAsync("page_view", null, "register");
            StateHasChanged();
        }
    }

    private bool ShowPin;
    private bool ShowConfirmPin;
    private InputType PinInputType => ShowPin ? InputType.Text : InputType.Password;
    private InputType ConfirmPinInputType => ShowConfirmPin ? InputType.Text : InputType.Password;
    private string PinEyeIcon => ShowPin ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility;
    private string ConfirmPinEyeIcon => ShowConfirmPin ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility;

    private void TogglePinVisibility() => ShowPin = !ShowPin;
    private void ToggleConfirmPinVisibility() => ShowConfirmPin = !ShowConfirmPin;

    protected override void OnInitialized()
    {
        if (HttpContextAccessor.HttpContext?.Session.GetString("AccountGuid") is not null)
            Nav.NavigateTo("/");
    }

    private async Task DoRegister()
    {
        var nick = NickName.Trim();
        if (string.IsNullOrWhiteSpace(nick) || nick.Length > 50)
        {
            Error = "Nickname must be 1–50 characters.";
            return;
        }
        if (Pin.Length < 4)
        {
            Error = "PIN must be at least 4 characters.";
            return;
        }
        if (PinMismatch) return;
        if (await Db.Accounts.AnyAsync(a => a.NickName == nick))
        {
            Error = "Nickname already taken.";
            return;
        }

        var account = new Account
        {
            Guid = System.Guid.NewGuid().ToString(),
            NickName = nick,
            PinHash = BCrypt.Net.BCrypt.HashPassword(Pin),
            CreatedOn = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()
        };
        Db.Accounts.Add(account);
        await Db.SaveChangesAsync();

        await Analytics.TrackAsync("register", account.Guid, "register");
        var token = WebAuthTokens.GenerateToken(account.Guid, account.NickName);
        Nav.NavigateTo($"/api/web/auth/complete?token={token}", forceLoad: true);
    }
}
