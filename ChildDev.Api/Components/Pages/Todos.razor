@page "/todos"
@inject AppDbContext Db
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor
@inject ISnackbar Snackbar
@inject WebAnalyticsService Analytics

<PageTitle>Todos – ChildDev</PageTitle>

@if (AccountGuid is null)
{
    Nav.NavigateTo("/login");
    return;
}

<MudText Typo="Typo.h5" Class="mb-4">
    <MudIcon Icon="@Icons.Material.Filled.CheckBox" Class="mr-2" />
    Todos
</MudText>

@if (OverdueCount > 0)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        @OverdueCount overdue todo@(OverdueCount == 1 ? "" : "s") — get caught up!
    </MudAlert>
}

@if (!AllPendingTodos.Any() && !CompletedTodos.Any())
{
    <MudAlert Severity="Severity.Info" Class="mb-4" Icon="@Icons.Material.Filled.CheckCircle">
        No todos yet — add one below to get started!
    </MudAlert>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-3" Spacing="2">
        <MudChipSet T="string" SelectionMode="SelectionMode.SingleSelection"
                    SelectedValue="@StatusFilter"
                    SelectedValueChanged="@((string v) => OnStatusFilterChanged(v))">
            <MudChip T="string" Value="@("All")" Variant="Variant.Filled" Color="Color.Default">All</MudChip>
            @if (OverdueCount > 0)
            {
                <MudChip T="string" Value="@("Overdue")" Variant="Variant.Filled" Color="Color.Error">Overdue (@OverdueCount)</MudChip>
            }
            <MudChip T="string" Value="@("Today")" Variant="Variant.Filled" Color="Color.Warning">Due Today</MudChip>
            <MudChip T="string" Value="@("NoDate")" Variant="Variant.Filled" Color="Color.Info">No Date</MudChip>
        </MudChipSet>
        <MudSpacer />
        <MudTextField Value="@FilterText" ValueChanged="@((string v) => OnFilterChanged(v))"
                      Placeholder="Search tasks…" Variant="Variant.Outlined"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true" Immediate="true" Margin="Margin.Dense"
                      AdornmentColor="Color.Secondary" Style="max-width:240px;" />
    </MudStack>
    @if (AllPendingTodos.Any())
    {
        <MudText Typo="Typo.subtitle1" Class="mb-2" Color="Color.Secondary">
            @PendingTodos.Count @(!string.IsNullOrWhiteSpace(FilterText) || StatusFilter != "All" ? "matching" : "pending")
        </MudText>
    }
}

@if (!PendingTodos.Any() && AllPendingTodos.Any())
{
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">No todos matching the current filter.</MudText>
}

<MudList T="Todo" Dense="false">
    @foreach (var t in PendingTodos)
    {
        var isOverdue = t.DueDate.HasValue && t.DueDate.Value < TodayStartMs;
        <MudListItem>
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudIconButton Icon="@Icons.Material.Filled.RadioButtonUnchecked"
                               Color="Color.Primary" Size="Size.Small"
                               OnClick="() => CompleteTodo(t.Guid)" />
                <MudStack Spacing="0" Style="flex:1">
                    <MudText Typo="Typo.body1" Color="@(isOverdue ? Color.Error : Color.Default)">@t.Title</MudText>
                    @if (t.DueDate.HasValue)
                    {
                        var due = DateTimeOffset.FromUnixTimeMilliseconds(t.DueDate.Value).LocalDateTime;
                        <MudText Typo="Typo.caption" Color="@(isOverdue ? Color.Error : Color.Secondary)">
                            Due @due.ToString("MMM d")@(isOverdue ? " — overdue" : "")
                        </MudText>
                    }
                    @if (!string.IsNullOrWhiteSpace(t.Notes))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@t.Notes</MudText>
                    }
                </MudStack>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               OnClick="() => OpenEditTodo(t)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                               Color="Color.Error" OnClick="() => DeleteTodo(t.Guid)" />
            </MudStack>
        </MudListItem>
    }
</MudList>

<MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-2"
           StartIcon="@Icons.Material.Filled.Add"
           OnClick="OpenAddDialog">Add Todo</MudButton>

@if (CompletedTodos.Any())
{
    <MudExpansionPanels Class="mt-6">
        <MudExpansionPanel Text="@($"Completed ({CompletedTodos.Count})")">
            <MudList T="Todo" Dense="true">
                @foreach (var t in CompletedTodos)
                {
                    var completedOn = DateTimeOffset.FromUnixTimeMilliseconds(t.CompletedAt!.Value).LocalDateTime;
                    <MudListItem>
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                            <MudStack Spacing="0" Style="flex:1">
                                <MudText Typo="Typo.body2" Class="text-decoration-line-through">@t.Title</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Done @completedOn.ToString("MMM d")</MudText>
                            </MudStack>
                            <MudIconButton Icon="@Icons.Material.Filled.Undo" Size="Size.Small"
                                           Color="Color.Default" OnClick="() => UncompleteTodo(t.Guid)" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                           Color="Color.Error" OnClick="() => DeleteTodo(t.Guid)" />
                        </MudStack>
                    </MudListItem>
                }
            </MudList>
        </MudExpansionPanel>
    </MudExpansionPanels>
}

<MudDialog @bind-Visible="ShowAddDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.AddTask" Class="mr-2" />
            New Todo
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="NewTitle" Label="What needs to be done?" Variant="Variant.Outlined"
                      Class="mb-4" AutoFocus="true" />
        <MudTextField @bind-Value="NewNotes" Label="Notes (optional)" Variant="Variant.Outlined"
                      Lines="2" Class="mb-4" />
        <MudDatePicker @bind-Date="NewDueDate" Label="Due date (optional)" Variant="Variant.Outlined" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => ShowAddDialog = false">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddTodo">Add Todo</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="ShowEditDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2" />
            Edit Todo
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="EditTitle" Label="Task" Variant="Variant.Outlined"
                      Class="mb-4" AutoFocus="true" />
        <MudTextField @bind-Value="EditNotes" Label="Notes (optional)" Variant="Variant.Outlined"
                      Lines="2" Class="mb-4" />
        <MudDatePicker @bind-Date="EditDueDate" Label="Due date (optional)" Variant="Variant.Outlined" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => ShowEditDialog = false">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveTodoEdit">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private string? AccountGuid;
    private List<Todo> AllPendingTodos = [];
    private List<Todo> CompletedTodos = [];
    private int OverdueCount;
    private long NowMs;
    private long TodayStartMs;
    private string FilterText = string.Empty;
    private string StatusFilter = "All";
    private List<Todo> PendingTodos = [];
    private bool ShowAddDialog;
    private string NewTitle = string.Empty;
    private string? NewNotes;
    private DateTime? NewDueDate;
    private bool ShowEditDialog;
    private string? EditingGuid;
    private string EditTitle = string.Empty;
    private string? EditNotes;
    private DateTime? EditDueDate;

    protected override async Task OnInitializedAsync()
    {
        AccountGuid = HttpContextAccessor.HttpContext?.Session.GetString("AccountGuid");
        if (AccountGuid is null) return;
        NowMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        await LoadTodos();
        await Analytics.TrackAsync("page_view", AccountGuid, "todos");
    }

    private async Task LoadTodos()
    {
        NowMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        TodayStartMs = new DateTimeOffset(DateTime.SpecifyKind(DateTime.Today, DateTimeKind.Local)).ToUnixTimeMilliseconds();
        var todos = await Db.Todos
            .Where(t => t.AccountFk == AccountGuid && t.DeletedAt == null)
            .OrderBy(t => t.DueDate ?? long.MaxValue)
            .ThenByDescending(t => t.UpdatedOn)
            .ToListAsync();

        AllPendingTodos = todos.Where(t => t.CompletedAt == null).ToList();
        CompletedTodos = todos.Where(t => t.CompletedAt != null).ToList();
        OverdueCount = AllPendingTodos.Count(t => t.DueDate.HasValue && t.DueDate.Value < TodayStartMs);
        ApplyFilter();
    }

    private void OnFilterChanged(string value)
    {
        FilterText = value;
        ApplyFilter();
    }

    private void OnStatusFilterChanged(string value)
    {
        StatusFilter = value ?? "All";
        ApplyFilter();
        if (AccountGuid is not null && StatusFilter != "All")
            _ = Analytics.TrackAsync("todo_filter", AccountGuid, "todos", StatusFilter);
    }

    private void ApplyFilter()
    {
        var todayStartMs = new DateTimeOffset(DateTime.SpecifyKind(DateTime.Today, DateTimeKind.Local)).ToUnixTimeMilliseconds();
        var todayEndMs = todayStartMs + 86_400_000L;

        IEnumerable<Todo> filtered = AllPendingTodos;

        filtered = StatusFilter switch
        {
            "Overdue" => filtered.Where(t => t.DueDate.HasValue && t.DueDate.Value < TodayStartMs),
            "Today" => filtered.Where(t => t.DueDate.HasValue && t.DueDate.Value >= todayStartMs && t.DueDate.Value < todayEndMs),
            "NoDate" => filtered.Where(t => !t.DueDate.HasValue),
            _ => filtered
        };

        if (!string.IsNullOrWhiteSpace(FilterText))
        {
            var q = FilterText.Trim();
            filtered = filtered.Where(t => (t.Title?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                                           (t.Notes?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        PendingTodos = filtered.ToList();
    }

    private void OpenAddDialog()
    {
        NewTitle = string.Empty;
        NewNotes = null;
        NewDueDate = null;
        ShowAddDialog = true;
    }

    private async Task AddTodo()
    {
        var title = NewTitle.Trim();
        if (string.IsNullOrWhiteSpace(title)) return;

        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        Db.Todos.Add(new Todo
        {
            Guid = System.Guid.NewGuid().ToString(),
            AccountFk = AccountGuid!,
            Title = title,
            Notes = string.IsNullOrWhiteSpace(NewNotes) ? null : NewNotes.Trim(),
            DueDate = NewDueDate.HasValue
                ? new DateTimeOffset(DateTime.SpecifyKind(NewDueDate.Value, DateTimeKind.Local)).ToUnixTimeMilliseconds()
                : null,
            UpdatedOn = now
        });
        await Db.SaveChangesAsync();

        await Analytics.TrackAsync("todo_add", AccountGuid, "todos", title.Length > 50 ? title[..50] : title);

        NewTitle = string.Empty;
        NewNotes = null;
        NewDueDate = null;
        ShowAddDialog = false;
        Snackbar.Add("Todo added!", Severity.Success);
        await LoadTodos();
    }

    private async Task CompleteTodo(string guid)
    {
        var todo = await Db.Todos.FirstOrDefaultAsync(t => t.Guid == guid && t.AccountFk == AccountGuid);
        if (todo is null) return;
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        todo.CompletedAt = now;
        todo.UpdatedOn = now;
        await Db.SaveChangesAsync();
        await Analytics.TrackAsync("todo_complete", AccountGuid, "todos");
        Snackbar.Add("Todo completed!", Severity.Success);
        await LoadTodos();
    }

    private async Task UncompleteTodo(string guid)
    {
        var todo = await Db.Todos.FirstOrDefaultAsync(t => t.Guid == guid && t.AccountFk == AccountGuid);
        if (todo is null) return;
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        todo.CompletedAt = null;
        todo.UpdatedOn = now;
        await Db.SaveChangesAsync();
        await Analytics.TrackAsync("todo_uncomplete", AccountGuid, "todos");
        Snackbar.Add("Todo moved back to pending.", Severity.Info);
        await LoadTodos();
    }

    private async Task DeleteTodo(string guid)
    {
        var todo = await Db.Todos.FirstOrDefaultAsync(t => t.Guid == guid && t.AccountFk == AccountGuid);
        if (todo is null) return;
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        todo.DeletedAt = now;
        todo.UpdatedOn = now;
        await Db.SaveChangesAsync();
        await Analytics.TrackAsync("todo_delete", AccountGuid, "todos");
        Snackbar.Add("Todo deleted.", Severity.Info);
        await LoadTodos();
    }

    private void OpenEditTodo(Todo todo)
    {
        EditingGuid = todo.Guid;
        EditTitle = todo.Title ?? string.Empty;
        EditNotes = todo.Notes;
        EditDueDate = todo.DueDate.HasValue
            ? DateTimeOffset.FromUnixTimeMilliseconds(todo.DueDate.Value).LocalDateTime
            : null;
        ShowEditDialog = true;
    }

    private async Task SaveTodoEdit()
    {
        var title = EditTitle.Trim();
        if (string.IsNullOrWhiteSpace(title) || EditingGuid is null) return;
        var todo = await Db.Todos.FirstOrDefaultAsync(t => t.Guid == EditingGuid && t.AccountFk == AccountGuid);
        if (todo is null) return;
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        todo.Title = title;
        todo.Notes = string.IsNullOrWhiteSpace(EditNotes) ? null : EditNotes.Trim();
        todo.DueDate = EditDueDate.HasValue
            ? new DateTimeOffset(DateTime.SpecifyKind(EditDueDate.Value, DateTimeKind.Local)).ToUnixTimeMilliseconds()
            : null;
        todo.UpdatedOn = now;
        await Db.SaveChangesAsync();
        await Analytics.TrackAsync("todo_edit", AccountGuid, "todos");
        ShowEditDialog = false;
        Snackbar.Add("Todo updated!", Severity.Success);
        await LoadTodos();
    }
}
