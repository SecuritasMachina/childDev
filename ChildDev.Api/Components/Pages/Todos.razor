@page "/todos"
@inject AppDbContext Db
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor
@inject ISnackbar Snackbar
@inject WebAnalyticsService Analytics

<PageTitle>Todos – ChildDev</PageTitle>

@if (AccountGuid is null)
{
    Nav.NavigateTo("/login");
    return;
}

<MudText Typo="Typo.h5" Class="mb-4">
    <MudIcon Icon="@Icons.Material.Filled.CheckBox" Class="mr-2" />
    Todos
</MudText>

@if (OverdueCount > 0)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        @OverdueCount overdue todo@(OverdueCount == 1 ? "" : "s") — get caught up!
    </MudAlert>
}

@if (WeekCompletedCount > 0)
{
    var total = Math.Max(WeekDueCount, WeekCompletedCount);
    var pct = total == 0 ? 100 : (int)(WeekCompletedCount * 100.0 / total);
    var weekLabel = WeekCompletedCount == 1
        ? "1 todo completed this week"
        : $"{WeekCompletedCount} todos completed this week";
    var emoji = pct >= 100 ? "🏆" : pct >= 75 ? "🌟" : pct >= 50 ? "💪" : "👍";
    <MudPaper Elevation="1" Class="pa-3 mb-4" Style="border-radius:12px;border-left:4px solid #43A047;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
            <MudText Typo="Typo.body2" Style="flex:1">@emoji @weekLabel</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@WeekCompletedCount / @total</MudText>
        </MudStack>
        <MudProgressLinear Value="@pct" Color="Color.Success" Rounded="true" Size="Size.Medium" />
    </MudPaper>
}

@if (ProductivityStreak >= 2)
{
    var streakMsg = ProductivityStreak >= 12 ? $"🌟 {ProductivityStreak}-week productivity streak — legendary dedication!"
                  : ProductivityStreak >= 6  ? $"🏆 {ProductivityStreak}-week productivity streak — you're a champion!"
                  : ProductivityStreak >= 3  ? $"🔥 {ProductivityStreak}-week productivity streak — incredible consistency!"
                  :                            $"⭐ {ProductivityStreak}-week productivity streak — keep it going!";
    <MudAlert Severity="@(ProductivityStreak >= 6 ? Severity.Success : Severity.Info)" Dense="true" Class="mb-4">@streakMsg</MudAlert>
}

@if (CompletedTodayCount >= 3)
{
    var fireMsg = CompletedTodayCount >= 7 ? $"🔥🔥 LEGENDARY! {CompletedTodayCount} todos completed today — absolutely unstoppable!"
                : CompletedTodayCount >= 5 ? $"🔥 On fire! {CompletedTodayCount} todos crushed today — what a productive day!"
                :                            $"🔥 On fire! You've completed {CompletedTodayCount} todos today — incredible momentum!";
    <MudAlert Severity="Severity.Success" Icon="@Icons.Material.Filled.LocalFireDepartment" Dense="true" Class="mb-4">
        @fireMsg
    </MudAlert>
}

@{
    var oldestPending = AllPendingTodos.Count >= 2
        ? AllPendingTodos.MinBy(t => t.UpdatedOn)
        : null;
    var oldestPendingDays = oldestPending is not null
        ? (int)((DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - oldestPending.UpdatedOn) / 86_400_000L)
        : 0;
}
@if (oldestPending is not null && oldestPendingDays >= 7)
{
    var oldestTitle = oldestPending.Title?.Length > 50 ? oldestPending.Title[..50] + "…" : oldestPending.Title;
    var oldestDaysLabel = oldestPendingDays >= 30
        ? $"{oldestPendingDays / 30} month{(oldestPendingDays / 30 == 1 ? "" : "s")}"
        : $"{oldestPendingDays} days";
    <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.AccessTime" Dense="true" Class="mb-4">
        ⏳ Oldest waiting: <strong>"@oldestTitle"</strong> — @oldestDaysLabel in your queue. Could today be the day?
    </MudAlert>
}

@if (!AllPendingTodos.Any() && !CompletedTodos.Any())
{
    <MudAlert Severity="Severity.Info" Class="mb-4" Icon="@Icons.Material.Filled.CheckCircle">
        No todos yet — add one below to get started!
    </MudAlert>
}
@if (!AllPendingTodos.Any() && CompletedTodos.Any())
{
    var izMsg = CompletedTodos.Count >= 20 ? $"🏆 Inbox zero! You've powered through {CompletedTodos.Count} tasks — truly legendary! Add something new to keep the momentum!"
              : CompletedTodos.Count >= 5  ? $"🌟 Inbox zero! All {CompletedTodos.Count} tasks done — you're amazing! What's next on your list?"
              :                              "🎉 Inbox zero! All caught up — add new todos to keep growing!";
    <MudAlert Severity="Severity.Success" Icon="@Icons.Material.Filled.EmojiEvents" Class="mb-4">
        @izMsg
    </MudAlert>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-3" Spacing="2">
        <MudChipSet T="string" SelectionMode="SelectionMode.SingleSelection"
                    SelectedValue="@StatusFilter"
                    SelectedValueChanged="@((string v) => OnStatusFilterChanged(v))">
            <MudChip T="string" Value="@("All")" Variant="Variant.Filled" Color="Color.Default">All</MudChip>
            @if (FocusCount > 0)
            {
                <MudChip T="string" Value="@("Focus")" Variant="Variant.Filled" Color="Color.Primary">
                    🎯 Today's Focus (@FocusCount)
                </MudChip>
            }
            @if (OverdueCount > 0)
            {
                <MudChip T="string" Value="@("Overdue")" Variant="Variant.Filled" Color="Color.Error">Overdue (@OverdueCount)</MudChip>
            }
            <MudChip T="string" Value="@("Today")" Variant="Variant.Filled" Color="Color.Warning">Due Today</MudChip>
            <MudChip T="string" Value="@("NoDate")" Variant="Variant.Filled" Color="Color.Info">No Date</MudChip>
        </MudChipSet>
        <MudSpacer />
        <MudTextField Value="@FilterText" ValueChanged="@((string v) => OnFilterChanged(v))"
                      Placeholder="Search tasks…" Variant="Variant.Outlined"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true" Immediate="true" Margin="Margin.Dense"
                      AdornmentColor="Color.Secondary" Style="max-width:240px;" />
    </MudStack>
    @if (AllPendingTodos.Any())
    {
        <MudText Typo="Typo.subtitle1" Class="mb-2" Color="Color.Secondary">
            @PendingTodos.Count @(!string.IsNullOrWhiteSpace(FilterText) || StatusFilter != "All" ? "matching" : "pending")
        </MudText>
    }
}

@if (!PendingTodos.Any() && AllPendingTodos.Any())
{
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">No todos matching the current filter.</MudText>
}

@if (StatusFilter == "All" && string.IsNullOrWhiteSpace(FilterText) && PendingTodos.Any())
{
    var todayEndMs = TodayStartMs + 86_400_000L;
    var overdueTodos  = PendingTodos.Where(t => t.DueDate.HasValue && t.DueDate.Value < TodayStartMs).ToList();
    var todayTodos    = PendingTodos.Where(t => t.DueDate.HasValue && t.DueDate.Value >= TodayStartMs && t.DueDate.Value < todayEndMs).ToList();
    var upcomingTodos = PendingTodos.Where(t => t.DueDate.HasValue && t.DueDate.Value >= todayEndMs).ToList();
    var noDateTodos   = PendingTodos.Where(t => !t.DueDate.HasValue).ToList();

    @if (overdueTodos.Any())
    {
        <MudText Typo="Typo.subtitle2" Color="Color.Error" Class="mt-2 mb-1">⚠ Overdue</MudText>
        <MudList T="Todo" Dense="false">
            @foreach (var t in overdueTodos)
            {
                <MudListItem>
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudIconButton Icon="@Icons.Material.Filled.RadioButtonUnchecked" Color="Color.Primary" Size="Size.Small" OnClick="() => CompleteTodo(t.Guid)" aria-label="Complete todo" />
                        <MudStack Spacing="0" Style="flex:1">
                            <MudText Typo="Typo.body1" Color="Color.Error">@t.Title</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Error">Due @DateTimeOffset.FromUnixTimeMilliseconds(t.DueDate!.Value).LocalDateTime.ToString("MMM d") — overdue</MudText>
                            @if (!string.IsNullOrWhiteSpace(t.Notes)) { <MudText Typo="Typo.caption" Color="Color.Secondary">@t.Notes</MudText> }
                        </MudStack>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => OpenEditTodo(t)" aria-label="Edit todo" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => _confirmDeleteGuid = t.Guid" aria-label="Delete todo" />
                    </MudStack>
                </MudListItem>
            }
        </MudList>
    }
    @if (todayTodos.Any())
    {
        <MudText Typo="Typo.subtitle2" Color="Color.Warning" Class="mt-3 mb-1">📅 Due Today</MudText>
        <MudList T="Todo" Dense="false">
            @foreach (var t in todayTodos)
            {
                <MudListItem>
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudIconButton Icon="@Icons.Material.Filled.RadioButtonUnchecked" Color="Color.Primary" Size="Size.Small" OnClick="() => CompleteTodo(t.Guid)" aria-label="Complete todo" />
                        <MudStack Spacing="0" Style="flex:1">
                            <MudText Typo="Typo.body1">@t.Title</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Warning">Due today</MudText>
                            @if (!string.IsNullOrWhiteSpace(t.Notes)) { <MudText Typo="Typo.caption" Color="Color.Secondary">@t.Notes</MudText> }
                        </MudStack>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => OpenEditTodo(t)" aria-label="Edit todo" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => _confirmDeleteGuid = t.Guid" aria-label="Delete todo" />
                    </MudStack>
                </MudListItem>
            }
        </MudList>
    }
    @if (upcomingTodos.Any())
    {
        <MudText Typo="Typo.subtitle2" Color="Color.Default" Class="mt-3 mb-1">📌 Upcoming</MudText>
        <MudList T="Todo" Dense="false">
            @foreach (var t in upcomingTodos)
            {
                var due = DateTimeOffset.FromUnixTimeMilliseconds(t.DueDate!.Value).LocalDateTime;
                <MudListItem>
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudIconButton Icon="@Icons.Material.Filled.RadioButtonUnchecked" Color="Color.Primary" Size="Size.Small" OnClick="() => CompleteTodo(t.Guid)" aria-label="Complete todo" />
                        <MudStack Spacing="0" Style="flex:1">
                            <MudText Typo="Typo.body1">@t.Title</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Due @due.ToString("MMM d")</MudText>
                            @if (!string.IsNullOrWhiteSpace(t.Notes)) { <MudText Typo="Typo.caption" Color="Color.Secondary">@t.Notes</MudText> }
                        </MudStack>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => OpenEditTodo(t)" aria-label="Edit todo" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => _confirmDeleteGuid = t.Guid" aria-label="Delete todo" />
                    </MudStack>
                </MudListItem>
            }
        </MudList>
    }
    @if (noDateTodos.Any())
    {
        <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mt-3 mb-1">🗒 No Date</MudText>
        <MudList T="Todo" Dense="false">
            @foreach (var t in noDateTodos)
            {
                <MudListItem>
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudIconButton Icon="@Icons.Material.Filled.RadioButtonUnchecked" Color="Color.Primary" Size="Size.Small" OnClick="() => CompleteTodo(t.Guid)" aria-label="Complete todo" />
                        <MudStack Spacing="0" Style="flex:1">
                            <MudText Typo="Typo.body1">@t.Title</MudText>
                            @if (!string.IsNullOrWhiteSpace(t.Notes)) { <MudText Typo="Typo.caption" Color="Color.Secondary">@t.Notes</MudText> }
                        </MudStack>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => OpenEditTodo(t)" aria-label="Edit todo" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => _confirmDeleteGuid = t.Guid" aria-label="Delete todo" />
                    </MudStack>
                </MudListItem>
            }
        </MudList>
    }
}
else
{
    <MudList T="Todo" Dense="false">
        @foreach (var t in PendingTodos)
        {
            var isOverdue = t.DueDate.HasValue && t.DueDate.Value < TodayStartMs;
            <MudListItem>
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudIconButton Icon="@Icons.Material.Filled.RadioButtonUnchecked"
                                   Color="Color.Primary" Size="Size.Small"
                                   OnClick="() => CompleteTodo(t.Guid)" aria-label="Complete todo" />
                    <MudStack Spacing="0" Style="flex:1">
                        <MudText Typo="Typo.body1" Color="@(isOverdue ? Color.Error : Color.Default)">@t.Title</MudText>
                        @if (t.DueDate.HasValue)
                        {
                            var due = DateTimeOffset.FromUnixTimeMilliseconds(t.DueDate.Value).LocalDateTime;
                            <MudText Typo="Typo.caption" Color="@(isOverdue ? Color.Error : Color.Secondary)">
                                Due @due.ToString("MMM d")@(isOverdue ? " — overdue" : "")
                            </MudText>
                        }
                        @if (!string.IsNullOrWhiteSpace(t.Notes))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@t.Notes</MudText>
                        }
                    </MudStack>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   OnClick="() => OpenEditTodo(t)" aria-label="Edit todo" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                   Color="Color.Error" OnClick="() => _confirmDeleteGuid = t.Guid" aria-label="Delete todo" />
                </MudStack>
            </MudListItem>
        }
    </MudList>
}

<MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-2"
           StartIcon="@Icons.Material.Filled.Add"
           OnClick="OpenAddDialog">Add Todo</MudButton>

@if (CompletedTodos.Any())
{
    <MudExpansionPanels Class="mt-6">
        <MudExpansionPanel>
            <TitleContent>
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudText Style="flex:1">Completed (@CompletedTodos.Count)</MudText>
                    <div @onclick:stopPropagation="true">
                        <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text"
                                   StartIcon="@Icons.Material.Filled.DeleteSweep"
                                   OnClick="() => _confirmClearCompleted = true">Delete All</MudButton>
                    </div>
                </MudStack>
            </TitleContent>
            <ChildContent>
                <MudList T="Todo" Dense="true">
                    @foreach (var t in CompletedTodos)
                    {
                        var completedOn = DateTimeOffset.FromUnixTimeMilliseconds(t.CompletedAt!.Value).LocalDateTime;
                        <MudListItem>
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                <MudStack Spacing="0" Style="flex:1">
                                    <MudText Typo="Typo.body2" Class="text-decoration-line-through">@t.Title</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Done @completedOn.ToString("MMM d")</MudText>
                                </MudStack>
                                <MudIconButton Icon="@Icons.Material.Filled.Undo" Size="Size.Small"
                                               Color="Color.Default" OnClick="() => UncompleteTodo(t.Guid)"
                                               aria-label="Undo completion" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                               Color="Color.Error" OnClick="() => _confirmDeleteGuid = t.Guid"
                                               aria-label="Delete todo" />
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            </ChildContent>
        </MudExpansionPanel>
    </MudExpansionPanels>
}

@* Clear All Completed Confirmation *@
<MudDialog @bind-Visible="_confirmClearCompleted">
    <TitleContent>
        <MudText Typo="Typo.h6" Color="Color.Error">
            <MudIcon Icon="@Icons.Material.Filled.DeleteSweep" Class="mr-2" />
            Delete All Completed?
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText>This will permanently remove all @CompletedTodos.Count completed todo@(CompletedTodos.Count == 1 ? "" : "s"). This cannot be undone.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _confirmClearCompleted = false">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ClearAllCompleted">Delete All</MudButton>
    </DialogActions>
</MudDialog>

@* Delete Todo Confirmation *@
<MudDialog Visible="@(_confirmDeleteGuid is not null)" VisibleChanged="@((bool v) => { if (!v) _confirmDeleteGuid = null; })">
    <TitleContent>
        <MudText Typo="Typo.h6" Color="Color.Error">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Class="mr-2" />
            Delete Todo?
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText>Remove this todo?</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _confirmDeleteGuid = null">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ConfirmDeleteTodo">Delete</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="ShowAddDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.AddTask" Class="mr-2" />
            New Todo
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="NewTitle" Label="What needs to be done?" Variant="Variant.Outlined"
                      Class="mb-4" AutoFocus="true" />
        <MudTextField @bind-Value="NewNotes" Label="Notes (optional)" Variant="Variant.Outlined"
                      Lines="2" Class="mb-4" />
        <MudDatePicker @bind-Date="NewDueDate" Label="Due date (optional)" Variant="Variant.Outlined" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => ShowAddDialog = false">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddTodo"
                   Disabled="@string.IsNullOrWhiteSpace(NewTitle)">Add Todo</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="ShowEditDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2" />
            Edit Todo
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="EditTitle" Label="Task" Variant="Variant.Outlined"
                      Class="mb-4" AutoFocus="true" />
        <MudTextField @bind-Value="EditNotes" Label="Notes (optional)" Variant="Variant.Outlined"
                      Lines="2" Class="mb-4" />
        <MudDatePicker @bind-Date="EditDueDate" Label="Due date (optional)" Variant="Variant.Outlined" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => ShowEditDialog = false">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveTodoEdit"
                   Disabled="@string.IsNullOrWhiteSpace(EditTitle)">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private string? AccountGuid;
    private List<Todo> AllPendingTodos = [];
    private List<Todo> CompletedTodos = [];
    private int OverdueCount;
    private int WeekCompletedCount;
    private int WeekDueCount;
    private long NowMs;
    private long TodayStartMs;
    private int FocusCount;
    private int CompletedTodayCount;
    private int ProductivityStreak;
    private string FilterText = string.Empty;
    private string StatusFilter = "All";
    private List<Todo> PendingTodos = [];
    private bool ShowAddDialog;
    private string NewTitle = string.Empty;
    private string? NewNotes;
    private DateTime? NewDueDate;
    private bool ShowEditDialog;
    private string? EditingGuid;
    private string EditTitle = string.Empty;
    private string? EditNotes;
    private DateTime? EditDueDate;
    private string? _confirmDeleteGuid;
    private bool _confirmClearCompleted;

    protected override async Task OnInitializedAsync()
    {
        AccountGuid = HttpContextAccessor.HttpContext?.Session.GetString("AccountGuid");
        if (AccountGuid is null) return;
        NowMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        await LoadTodos();
        await Analytics.TrackAsync("page_view", AccountGuid, "todos");
    }

    private async Task LoadTodos()
    {
        NowMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        TodayStartMs = new DateTimeOffset(DateTime.SpecifyKind(DateTime.Today, DateTimeKind.Local)).ToUnixTimeMilliseconds();
        var todos = await Db.Todos
            .Where(t => t.AccountFk == AccountGuid && t.DeletedAt == null)
            .OrderBy(t => t.DueDate ?? long.MaxValue)
            .ThenByDescending(t => t.UpdatedOn)
            .ToListAsync();

        var weekStartMs = TodayStartMs - 7L * 86_400_000L;
        AllPendingTodos = todos.Where(t => t.CompletedAt == null).ToList();
        CompletedTodos = todos.Where(t => t.CompletedAt != null).ToList();
        OverdueCount = AllPendingTodos.Count(t => t.DueDate.HasValue && t.DueDate.Value < TodayStartMs);
        var todayEndForFocus = TodayStartMs + 86_400_000L;
        FocusCount = AllPendingTodos.Count(t => t.DueDate.HasValue && t.DueDate.Value < todayEndForFocus);
        WeekCompletedCount = CompletedTodos.Count(t => t.CompletedAt >= weekStartMs);
        CompletedTodayCount = CompletedTodos.Count(t => t.CompletedAt >= TodayStartMs);
        // Productivity streak: consecutive 7-day windows ending now with at least 1 completed todo
        ProductivityStreak = 0;
        for (int w = 0; w < 52; w++)
        {
            var wEnd = NowMs - (long)w * 7 * 86_400_000L;
            var wStart = wEnd - 7 * 86_400_000L;
            if (CompletedTodos.Any(t => t.CompletedAt >= wStart && t.CompletedAt < wEnd)) ProductivityStreak++;
            else break;
        }
        WeekDueCount = todos.Count(t =>
            t.DueDate.HasValue && t.DueDate.Value >= weekStartMs && t.DueDate.Value < TodayStartMs + 86_400_000L);
        ApplyFilter();
    }

    private void OnFilterChanged(string value)
    {
        FilterText = value;
        ApplyFilter();
    }

    private void OnStatusFilterChanged(string value)
    {
        StatusFilter = value ?? "All";
        ApplyFilter();
        if (AccountGuid is not null && StatusFilter != "All")
            _ = Analytics.TrackAsync("todo_filter", AccountGuid, "todos", StatusFilter);
    }

    private void ApplyFilter()
    {
        var todayEndMs = TodayStartMs + 86_400_000L;

        IEnumerable<Todo> filtered = AllPendingTodos;

        filtered = StatusFilter switch
        {
            "Focus" => filtered.Where(t => t.DueDate.HasValue && t.DueDate.Value < todayEndMs),
            "Overdue" => filtered.Where(t => t.DueDate.HasValue && t.DueDate.Value < TodayStartMs),
            "Today" => filtered.Where(t => t.DueDate.HasValue && t.DueDate.Value >= TodayStartMs && t.DueDate.Value < todayEndMs),
            "NoDate" => filtered.Where(t => !t.DueDate.HasValue),
            _ => filtered
        };

        if (!string.IsNullOrWhiteSpace(FilterText))
        {
            var q = FilterText.Trim();
            filtered = filtered.Where(t => (t.Title?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                                           (t.Notes?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        PendingTodos = filtered.ToList();
    }

    private void OpenAddDialog()
    {
        NewTitle = string.Empty;
        NewNotes = null;
        NewDueDate = null;
        ShowAddDialog = true;
    }

    private async Task AddTodo()
    {
        var title = NewTitle.Trim();
        if (string.IsNullOrWhiteSpace(title)) return;

        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        Db.Todos.Add(new Todo
        {
            Guid = System.Guid.NewGuid().ToString(),
            AccountFk = AccountGuid!,
            Title = title,
            Notes = string.IsNullOrWhiteSpace(NewNotes) ? null : NewNotes.Trim(),
            DueDate = NewDueDate.HasValue
                ? new DateTimeOffset(DateTime.SpecifyKind(NewDueDate.Value, DateTimeKind.Local)).ToUnixTimeMilliseconds()
                : null,
            UpdatedOn = now
        });
        await Db.SaveChangesAsync();

        await Analytics.TrackAsync("todo_add", AccountGuid, "todos", title.Length > 50 ? title[..50] : title);

        NewTitle = string.Empty;
        NewNotes = null;
        NewDueDate = null;
        ShowAddDialog = false;
        Snackbar.Add("Todo added!", Severity.Success);
        await LoadTodos();
    }

    private async Task CompleteTodo(string guid)
    {
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        var rows = await Db.Todos
            .Where(t => t.Guid == guid && t.AccountFk == AccountGuid && t.CompletedAt == null)
            .ExecuteUpdateAsync(s => s
                .SetProperty(t => t.CompletedAt, now)
                .SetProperty(t => t.UpdatedOn, now));
        if (rows == 0) return;
        await Analytics.TrackAsync("todo_complete", AccountGuid, "todos");
        Snackbar.Add("Todo completed!", Severity.Success);
        await LoadTodos();
    }

    private async Task UncompleteTodo(string guid)
    {
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        var rows = await Db.Todos
            .Where(t => t.Guid == guid && t.AccountFk == AccountGuid && t.CompletedAt != null)
            .ExecuteUpdateAsync(s => s
                .SetProperty(t => t.CompletedAt, (long?)null)
                .SetProperty(t => t.UpdatedOn, now));
        if (rows == 0) return;
        await Analytics.TrackAsync("todo_uncomplete", AccountGuid, "todos");
        Snackbar.Add("Todo moved back to pending.", Severity.Info);
        await LoadTodos();
    }

    private async Task ClearAllCompleted()
    {
        _confirmClearCompleted = false;
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        var guids = CompletedTodos.Select(t => t.Guid).ToList();
        await Db.Todos
            .Where(t => guids.Contains(t.Guid) && t.AccountFk == AccountGuid && t.DeletedAt == null)
            .ExecuteUpdateAsync(s => s
                .SetProperty(t => t.DeletedAt, now)
                .SetProperty(t => t.UpdatedOn, now));
        await Analytics.TrackAsync("todo_clear_completed", AccountGuid, "todos", guids.Count.ToString());
        Snackbar.Add($"{guids.Count} completed todo{(guids.Count == 1 ? "" : "s")} deleted.", Severity.Info);
        await LoadTodos();
    }

    private async Task ConfirmDeleteTodo()
    {
        var guid = _confirmDeleteGuid;
        _confirmDeleteGuid = null;
        if (guid is null) return;
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        var rows = await Db.Todos
            .Where(t => t.Guid == guid && t.AccountFk == AccountGuid && t.DeletedAt == null)
            .ExecuteUpdateAsync(s => s
                .SetProperty(t => t.DeletedAt, now)
                .SetProperty(t => t.UpdatedOn, now));
        if (rows == 0) return;
        await Analytics.TrackAsync("todo_delete", AccountGuid, "todos");
        Snackbar.Add("Todo deleted.", Severity.Info);
        await LoadTodos();
    }

    private void OpenEditTodo(Todo todo)
    {
        EditingGuid = todo.Guid;
        EditTitle = todo.Title ?? string.Empty;
        EditNotes = todo.Notes;
        EditDueDate = todo.DueDate.HasValue
            ? DateTimeOffset.FromUnixTimeMilliseconds(todo.DueDate.Value).LocalDateTime
            : null;
        ShowEditDialog = true;
    }

    private async Task SaveTodoEdit()
    {
        var title = EditTitle.Trim();
        if (string.IsNullOrWhiteSpace(title) || EditingGuid is null) return;
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        var notes = string.IsNullOrWhiteSpace(EditNotes) ? null : EditNotes.Trim();
        long? dueDate = EditDueDate.HasValue
            ? new DateTimeOffset(DateTime.SpecifyKind(EditDueDate.Value, DateTimeKind.Local)).ToUnixTimeMilliseconds()
            : null;
        var rows = await Db.Todos
            .Where(t => t.Guid == EditingGuid && t.AccountFk == AccountGuid)
            .ExecuteUpdateAsync(s => s
                .SetProperty(t => t.Title, title)
                .SetProperty(t => t.Notes, notes)
                .SetProperty(t => t.DueDate, dueDate)
                .SetProperty(t => t.UpdatedOn, now));
        if (rows == 0) return;
        await Analytics.TrackAsync("todo_edit", AccountGuid, "todos");
        ShowEditDialog = false;
        Snackbar.Add("Todo updated!", Severity.Success);
        await LoadTodos();
    }
}
