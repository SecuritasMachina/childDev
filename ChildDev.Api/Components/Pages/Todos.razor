@code {
    [SupplyParameterFromQuery(Name = "search")]
    private string? SearchParam { get; set; }

    private string? AccountGuid;

    private static readonly string[] _quickIdeaChips =
    [
        "Read 20 minutes 📚", "Do homework ✏️", "Practice instrument 🎵",
        "Exercise 🏃", "Study for test 📝", "Clean room 🧹",
        "Write in journal ✍️", "Review goal progress 🎯", "Practice math ➕",
        "Work on science project 🔬", "Go for a walk 🚶", "Drink more water 💧",
        "Draw something 🎨", "Help with chores 🏠", "Practice a skill 💪",
        "Memorize something new 🧠", "Reach out to a friend 👋", "Prepare for class 📋"
    ];

    private List<Todo> AllPendingTodos = [];
    private List<Todo> CompletedTodos = [];
    private int OverdueCount;
    private int WeekCompletedCount;
    private int WeekDueCount;
    private int MonthCompletedCount;
    private long NowMs;
    private long TodayStartMs;
    private int FocusCount;
    private int DueThisWeekCount;
    private int DueTodayCount;
    private int NoDateCount;
    private int CompletedTodayCount;
    private int ProductivityStreak;
    private int LastWeekCompletedCount;
    private int OldestPendingDays;
    private string FilterText = string.Empty;
    private string StatusFilter = "All";
    private string SortBy = "DueDate";
    private string _quickAddTitle = string.Empty;
    private MudTextField<string>? _quickAddRef;
    private DotNetObjectReference<Todos>? _selfRef;
    private List<Todo> PendingTodos = [];
    private bool ShowAddDialog;
    private string NewTitle = string.Empty;
    private string? NewNotes;
    private DateTime? NewDueDate;
    private bool ShowEditDialog;
    private string? EditingGuid;
    private string EditTitle = string.Empty;
    private string? EditNotes;
    private DateTime? EditDueDate;
    private string _editGoalLink = string.Empty;
    private string? _confirmDeleteGuid;
    private bool _confirmClearCompleted;
    private Dictionary<string, string> _goalGuidByName = [];
    private List<(string Guid, string GoalText)> _activeGoals = [];
    private string _newGoalLink = string.Empty;
    private bool _groupByGoal = false;
    private bool _confirmCompleteAllToday;
    private bool _confirmRescheduleAllOverdue;
    private List<ChartSeries> WeeklyChartSeries = [];
    private string[] WeeklyChartLabels = [];

    protected override async Task OnInitializedAsync()
    {
        AccountGuid = HttpContextAccessor.HttpContext?.Session.GetString("AccountGuid");
        if (AccountGuid is null) return;
        NowMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        if (!string.IsNullOrWhiteSpace(SearchParam))
            FilterText = SearchParam;
        await LoadTodos();
        await Analytics.TrackAsync("page_view", AccountGuid, "todos");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && AccountGuid is not null)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("childdev.registerPageShortcut", "n", _selfRef, "FocusQuickAdd");
        }
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("childdev.unregisterPageShortcut"); } catch { }
        _selfRef?.Dispose();
    }

    [JSInvokable]
    public async Task FocusQuickAdd()
    {
        if (_quickAddRef is not null)
            await _quickAddRef.FocusAsync();
    }

    private async Task LoadTodos()
    {
        NowMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        TodayStartMs = new DateTimeOffset(DateTime.SpecifyKind(DateTime.Today, DateTimeKind.Local)).ToUnixTimeMilliseconds();
        var todos = await Db.Todos
            .Where(t => t.AccountFk == AccountGuid && t.DeletedAt == null)
            .OrderBy(t => t.DueDate ?? long.MaxValue)
            .ThenByDescending(t => t.UpdatedOn)
            .ToListAsync();

        var weekStartMs = TodayStartMs - 7L * 86_400_000L;
        AllPendingTodos = todos.Where(t => t.CompletedAt == null).ToList();
        CompletedTodos = todos.Where(t => t.CompletedAt != null).OrderByDescending(t => t.CompletedAt).ToList();
        OverdueCount = AllPendingTodos.Count(t => t.DueDate.HasValue && t.DueDate.Value < TodayStartMs);
        var todayEndForFocus = TodayStartMs + 86_400_000L;
        FocusCount = AllPendingTodos.Count(t => t.DueDate.HasValue && t.DueDate.Value < todayEndForFocus);
        var thisWeekEndMs = TodayStartMs + 7L * 86_400_000L;
        DueThisWeekCount = AllPendingTodos.Count(t => t.DueDate.HasValue && t.DueDate.Value >= todayEndForFocus && t.DueDate.Value < thisWeekEndMs);
        DueTodayCount = AllPendingTodos.Count(t => t.DueDate.HasValue && t.DueDate.Value >= TodayStartMs && t.DueDate.Value < todayEndForFocus);
        NoDateCount = AllPendingTodos.Count(t => !t.DueDate.HasValue);
        WeekCompletedCount = CompletedTodos.Count(t => t.CompletedAt >= weekStartMs);
        var prevWeekStartMs = weekStartMs - 7L * 86_400_000L;
        LastWeekCompletedCount = CompletedTodos.Count(t => t.CompletedAt >= prevWeekStartMs && t.CompletedAt < weekStartMs);
        var monthStartMs = new DateTimeOffset(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1), TimeZoneInfo.Local.GetUtcOffset(DateTime.Now)).ToUnixTimeMilliseconds();
        MonthCompletedCount = CompletedTodos.Count(t => t.CompletedAt >= monthStartMs);
        CompletedTodayCount = CompletedTodos.Count(t => t.CompletedAt >= TodayStartMs);
        var oldestPending = AllPendingTodos.Where(t => t.CompletedAt == null).Select(t => t.UpdatedOn).DefaultIfEmpty(0).Min();
        OldestPendingDays = oldestPending > 0 ? (int)((NowMs - oldestPending) / 86_400_000L) : 0;
        // Productivity streak: consecutive 7-day windows ending now with at least 1 completed todo
        ProductivityStreak = 0;
        for (int w = 0; w < 52; w++)
        {
            var wEnd = NowMs - (long)w * 7 * 86_400_000L;
            var wStart = wEnd - 7 * 86_400_000L;
            if (CompletedTodos.Any(t => t.CompletedAt >= wStart && t.CompletedAt < wEnd)) ProductivityStreak++;
            else break;
        }
        WeekDueCount = todos.Count(t =>
            t.DueDate.HasValue && t.DueDate.Value >= weekStartMs && t.DueDate.Value < TodayStartMs + 86_400_000L);

        // Load active goals for picker and for "Goal: " prefix display
        var goals = await Db.Goals
            .Where(g => g.AccountFk == AccountGuid && g.DeletedAt == null && g.CompletionDate == null)
            .Select(g => new { g.Guid, g.GoalText })
            .ToListAsync();
        _activeGoals = goals.Where(g => !string.IsNullOrWhiteSpace(g.GoalText))
            .Select(g => (g.Guid, g.GoalText!))
            .ToList();
        _goalGuidByName = _activeGoals.ToDictionary(g => g.GoalText, g => g.Guid, StringComparer.OrdinalIgnoreCase);

        // Build 8-week completion chart
        const int chartWeeks = 8;
        var chartCounts = new double[chartWeeks];
        var chartLabels = new string[chartWeeks];
        var chartNow = DateTime.Now;
        for (var i = 0; i < chartWeeks; i++)
        {
            var wkStart = chartNow.AddDays(-(chartWeeks - 1 - i) * 7).Date;
            wkStart = wkStart.AddDays(-(int)wkStart.DayOfWeek);
            var wkStartMs = new DateTimeOffset(DateTime.SpecifyKind(wkStart, DateTimeKind.Local)).ToUnixTimeMilliseconds();
            var wkEndMs = wkStartMs + 7L * 24 * 60 * 60 * 1000;
            chartCounts[i] = CompletedTodos.Count(t => t.CompletedAt >= wkStartMs && t.CompletedAt < wkEndMs);
            chartLabels[i] = wkStart.ToString("MMM d");
        }
        WeeklyChartSeries = [new ChartSeries { Name = "Done", Data = chartCounts }];
        WeeklyChartLabels = chartLabels;

        ApplyFilter();
    }

    private void OnFilterChanged(string value)
    {
        FilterText = value;
        ApplyFilter();
    }

    private void OnStatusFilterChanged(string value)
    {
        StatusFilter = value ?? "All";
        ApplyFilter();
        if (AccountGuid is not null && StatusFilter != "All")
            _ = Analytics.TrackAsync("todo_filter", AccountGuid, "todos", StatusFilter);
    }

    private void ApplyFilter()
    {
        var todayEndMs = TodayStartMs + 86_400_000L;

        IEnumerable<Todo> filtered = AllPendingTodos;

        var weekEndMs = TodayStartMs + 7L * 86_400_000L;
        filtered = StatusFilter switch
        {
            "Focus" => filtered.Where(t => t.DueDate.HasValue && t.DueDate.Value < todayEndMs),
            "Overdue" => filtered.Where(t => t.DueDate.HasValue && t.DueDate.Value < TodayStartMs),
            "Today" => filtered.Where(t => t.DueDate.HasValue && t.DueDate.Value >= TodayStartMs && t.DueDate.Value < todayEndMs),
            "Week" => filtered.Where(t => t.DueDate.HasValue && t.DueDate.Value >= todayEndMs && t.DueDate.Value < weekEndMs),
            "NoDate" => filtered.Where(t => !t.DueDate.HasValue),
            _ => filtered
        };

        if (!string.IsNullOrWhiteSpace(FilterText))
        {
            var q = FilterText.Trim();
            filtered = filtered.Where(t => (t.Title?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                                           (t.Notes?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        PendingTodos = (SortBy switch
        {
            "Title" => filtered.OrderBy(t => t.Title ?? ""),
            "Added" => filtered.OrderByDescending(t => t.UpdatedOn),
            _ => filtered.OrderBy(t => t.DueDate ?? long.MaxValue)
        }).ToList();
    }

    private void OnSortChanged(string value)
    {
        SortBy = value;
        ApplyFilter();
        if (AccountGuid is not null)
            _ = Analytics.TrackAsync("todo_sort", AccountGuid, "todos", value);
    }

    private void OpenAddDialogForGoal(string goalText)
    {
        NewTitle = string.Empty;
        NewNotes = null;
        NewDueDate = null;
        _newGoalLink = goalText;
        ShowAddDialog = true;
    }

    private void OpenAddDialog()
    {
        NewTitle = string.Empty;
        NewNotes = null;
        NewDueDate = null;
        _newGoalLink = string.Empty;
        ShowAddDialog = true;
    }

    private async Task QuickAddTodo()
    {
        var title = _quickAddTitle.Trim();
        if (string.IsNullOrWhiteSpace(title)) return;
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        Db.Todos.Add(new Todo
        {
            Guid = System.Guid.NewGuid().ToString(),
            AccountFk = AccountGuid!,
            Title = title,
            UpdatedOn = now
        });
        await Db.SaveChangesAsync();
        await Analytics.TrackAsync("todo_quickadd", AccountGuid, "todos", title.Length > 50 ? title[..50] : title);
        _quickAddTitle = string.Empty;
        Snackbar.Add("Todo added!", Severity.Success);
        await LoadTodos();
    }

    private async Task AddTodo()
    {
        var title = NewTitle.Trim();
        if (string.IsNullOrWhiteSpace(title)) return;

        var goalNotes = !string.IsNullOrWhiteSpace(_newGoalLink) ? $"Goal: {_newGoalLink}" : null;
        var combinedNotes = goalNotes is not null && !string.IsNullOrWhiteSpace(NewNotes)
            ? $"{goalNotes}\n{NewNotes.Trim()}"
            : goalNotes ?? (string.IsNullOrWhiteSpace(NewNotes) ? null : NewNotes.Trim());

        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        Db.Todos.Add(new Todo
        {
            Guid = System.Guid.NewGuid().ToString(),
            AccountFk = AccountGuid!,
            Title = title,
            Notes = combinedNotes,
            DueDate = NewDueDate.HasValue
                ? new DateTimeOffset(DateTime.SpecifyKind(NewDueDate.Value, DateTimeKind.Local)).ToUnixTimeMilliseconds()
                : null,
            UpdatedOn = now
        });
        await Db.SaveChangesAsync();

        await Analytics.TrackAsync("todo_add", AccountGuid, "todos", title.Length > 50 ? title[..50] : title);

        NewTitle = string.Empty;
        NewNotes = null;
        NewDueDate = null;
        ShowAddDialog = false;
        Snackbar.Add("Todo added!", Severity.Success);
        await LoadTodos();
    }

    private static string? TodoAllTimeMilestone(int count) => count switch
    {
        10  => "🎉 10 todos completed all-time — you're building real momentum!",
        25  => "🌟 25 todos completed! You're a getting-things-done champion!",
        50  => "🏆 50 todos done! Half-century milestone — you're incredibly productive!",
        100 => "🌟🌟 100 todos completed! LEGENDARY action-taker status achieved!",
        _   => count % 100 == 0 ? $"🎊 {count} todos completed — absolutely unstoppable!" : null
    };

    private async Task CompleteTodo(string guid)
    {
        var linkedTodo = AllPendingTodos.FirstOrDefault(t => t.Guid == guid);
        var (linkedGoalText, linkedGoalGuid, _) = ParseGoalNotes(linkedTodo?.Notes);
        var prevCompletedCount = CompletedTodos.Count;

        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        var rows = await Db.Todos
            .Where(t => t.Guid == guid && t.AccountFk == AccountGuid && t.CompletedAt == null)
            .ExecuteUpdateAsync(s => s
                .SetProperty(t => t.CompletedAt, now)
                .SetProperty(t => t.UpdatedOn, now));
        if (rows == 0) return;
        await Analytics.TrackAsync("todo_complete", AccountGuid, "todos");
        await LoadTodos();
        var todayDoneCount = CompletedTodos.Count(t => t.CompletedAt >= TodayStartMs);
        var allTimeMilestone = TodoAllTimeMilestone(prevCompletedCount + 1);
        var completedGuid = guid;

        if (allTimeMilestone is not null)
        {
            await Analytics.TrackAsync("todo_milestone", AccountGuid, "todos", (prevCompletedCount + 1).ToString());
            Snackbar.Add(allTimeMilestone, Severity.Success, opts =>
            {
                opts.Action = "Undo";
                opts.ActionColor = Color.Default;
                opts.Onclick = async _ => await UncompleteTodo(completedGuid);
                opts.VisibleStateDuration = 7000;
            });
        }
        else
        {
            var doneMsg = todayDoneCount >= 10 ? "🔥🔥 LEGENDARY! 10+ todos done today!" :
                          todayDoneCount >= 7 ? $"🔥 On fire! {todayDoneCount} todos today!" :
                          todayDoneCount >= 5 ? $"🚀 {todayDoneCount} todos crushed today!" :
                          todayDoneCount >= 3 ? $"⚡ {todayDoneCount} done today — building momentum!" :
                          todayDoneCount == 1 ? "✅ First one done — keep going!" :
                          "✅ Todo completed!";
            Snackbar.Add(doneMsg, Severity.Success, opts =>
            {
                opts.Action = "Undo";
                opts.ActionColor = Color.Default;
                opts.Onclick = async _ => await UncompleteTodo(completedGuid);
                opts.VisibleStateDuration = 4000;
            });
        }

        if (linkedGoalGuid is not null && linkedGoalText is not null)
        {
            var shortGoal = linkedGoalText.Length > 40 ? linkedGoalText[..40] + "…" : linkedGoalText;
            Snackbar.Add($"🎯 \"{shortGoal}\" — log your progress?", Severity.Info, opts =>
            {
                opts.Action = "Add Note";
                opts.ActionColor = Color.Primary;
                opts.Onclick = _ => { Nav.NavigateTo($"/goals/{linkedGoalGuid}"); return Task.CompletedTask; };
            });
        }
    }

