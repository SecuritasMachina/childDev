@page "/todos"
@inject AppDbContext Db
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor
@inject ISnackbar Snackbar
@inject WebAnalyticsService Analytics
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Todos – ChildDev</PageTitle>

@if (AccountGuid is null)
{
    Nav.NavigateTo("/login");
    return;
}

<MudText Typo="Typo.h5" Class="mb-4">
    <MudIcon Icon="@Icons.Material.Filled.CheckBox" Class="mr-2" />
    Todos
</MudText>

@if (OverdueCount > 0)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="1">
            <MudText Style="flex:1;">@OverdueCount overdue todo@(OverdueCount == 1 ? "" : "s") — get caught up!</MudText>
            @if (OverdueCount >= 2)
            {
                <MudButton Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Today"
                           OnClick="() => _confirmRescheduleAllOverdue = true">
                    📅 Reschedule All
                </MudButton>
            }
        </MudStack>
    </MudAlert>
}

@if (WeekCompletedCount > 0)
{
    var total = Math.Max(WeekDueCount, WeekCompletedCount);
    var pct = total == 0 ? 100 : (int)(WeekCompletedCount * 100.0 / total);
    var weekLabel = WeekCompletedCount == 1
        ? "1 todo completed this week"
        : $"{WeekCompletedCount} todos completed this week";
    var emoji = pct >= 100 ? "🏆" : pct >= 75 ? "🌟" : pct >= 50 ? "💪" : "👍";
    <MudPaper Elevation="1" Class="pa-3 mb-4" Style="border-radius:12px;border-left:4px solid #43A047;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
            <MudText Typo="Typo.body2" Style="flex:1">@emoji @weekLabel</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@WeekCompletedCount / @total</MudText>
        </MudStack>
        <MudProgressLinear Value="@pct" Color="Color.Success" Rounded="true" Size="Size.Medium" />
    </MudPaper>
}

@if (WeekCompletedCount > 0 && LastWeekCompletedCount > 0)
{
    var wowDiff = WeekCompletedCount - LastWeekCompletedCount;
    var wowMsg = wowDiff > 0 ? $"📈 +{wowDiff} vs last week ({LastWeekCompletedCount}) — you're getting more done each week!"
               : wowDiff < 0 ? $"📉 {LastWeekCompletedCount} done last week — can you match or beat it this week?"
               :                $"📊 Same pace as last week ({LastWeekCompletedCount}) — nice consistency!";
    <MudText Typo="Typo.caption" Color="@(wowDiff >= 0 ? Color.Success : Color.Warning)" Class="mb-3">@wowMsg</MudText>
}
@if (WeeklyChartSeries.Count > 0 && WeeklyChartSeries[0].Data.Any(d => d > 0))
{
    <MudChart ChartType="ChartType.Bar"
              ChartSeries="@WeeklyChartSeries"
              XAxisLabels="@WeeklyChartLabels"
              Width="100%" Height="130px"
              ChartOptions="@(new ChartOptions { YAxisTicks = 1 })"
              Class="mb-4" />
}
@if (MonthCompletedCount >= 5 && WeekCompletedCount < MonthCompletedCount)
{
    var monthName = DateTime.Today.ToString("MMMM");
    var mcMsg = MonthCompletedCount >= 25 ? $"🌟 {MonthCompletedCount} todos completed in {monthName} — legendary productivity!"
              : MonthCompletedCount >= 15 ? $"🏆 {MonthCompletedCount} todos done in {monthName} — champion pace!"
              : MonthCompletedCount >= 10 ? $"💪 {MonthCompletedCount} todos knocked out in {monthName} — double digits!"
              :                             $"✅ {MonthCompletedCount} todos completed in {monthName} — solid progress!";
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4" Icon="@Icons.Material.Filled.CalendarMonth">@mcMsg</MudAlert>
}
@if (ProductivityStreak >= 2)
{
    var streakMsg = ProductivityStreak >= 12 ? $"🌟 {ProductivityStreak}-week productivity streak — legendary dedication!"
                  : ProductivityStreak >= 6  ? $"🏆 {ProductivityStreak}-week productivity streak — you're a champion!"
                  : ProductivityStreak >= 3  ? $"🔥 {ProductivityStreak}-week productivity streak — incredible consistency!"
                  :                            $"⭐ {ProductivityStreak}-week productivity streak — keep it going!";
    <MudAlert Severity="@(ProductivityStreak >= 6 ? Severity.Success : Severity.Info)" Dense="true" Class="mb-4">@streakMsg</MudAlert>
}

@if (CompletedTodayCount >= 3)
{
    var fireMsg = CompletedTodayCount >= 7 ? $"🔥🔥 LEGENDARY! {CompletedTodayCount} todos completed today — absolutely unstoppable!"
                : CompletedTodayCount >= 5 ? $"🔥 On fire! {CompletedTodayCount} todos crushed today — what a productive day!"
                :                            $"🔥 On fire! You've completed {CompletedTodayCount} todos today — incredible momentum!";
    <MudAlert Severity="Severity.Success" Icon="@Icons.Material.Filled.LocalFireDepartment" Dense="true" Class="mb-4">
        @fireMsg
    </MudAlert>
}

@{
    var oldestPending = AllPendingTodos.Count >= 2
        ? AllPendingTodos.MinBy(t => t.UpdatedOn)
        : null;
    var oldestPendingDays = oldestPending is not null
        ? (int)((DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - oldestPending.UpdatedOn) / 86_400_000L)
        : 0;
}
@if (oldestPending is not null && oldestPendingDays >= 7)
{
    var oldestTitle = oldestPending.Title?.Length > 50 ? oldestPending.Title[..50] + "…" : oldestPending.Title;
    var oldestDaysLabel = oldestPendingDays >= 30
        ? $"{oldestPendingDays / 30} month{(oldestPendingDays / 30 == 1 ? "" : "s")}"
        : $"{oldestPendingDays} days";
    <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.AccessTime" Dense="true" Class="mb-4">
        ⏳ Oldest waiting: <strong>"@oldestTitle"</strong> — @oldestDaysLabel in your queue. Could today be the day?
    </MudAlert>
}

@if (!AllPendingTodos.Any() && !CompletedTodos.Any())
{
    <MudAlert Severity="Severity.Info" Class="mb-4" Icon="@Icons.Material.Filled.CheckCircle">
        No todos yet — add one below to get started!
    </MudAlert>
}
@if (!AllPendingTodos.Any() && CompletedTodos.Any())
{
    var izMsg = CompletedTodos.Count >= 20 ? $"🏆 Inbox zero! You've powered through {CompletedTodos.Count} tasks — truly legendary! Add something new to keep the momentum!"
              : CompletedTodos.Count >= 5  ? $"🌟 Inbox zero! All {CompletedTodos.Count} tasks done — you're amazing! What's next on your list?"
              :                              "🎉 Inbox zero! All caught up — add new todos to keep growing!";
    <MudAlert Severity="Severity.Success" Icon="@Icons.Material.Filled.EmojiEvents" Class="mb-4">
        @izMsg
    </MudAlert>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-3" Spacing="2">
        <MudChipSet T="string" SelectionMode="SelectionMode.SingleSelection"
                    SelectedValue="@StatusFilter"
                    SelectedValueChanged="@((string v) => OnStatusFilterChanged(v))">
            <MudChip T="string" Value="@("All")" Variant="Variant.Filled" Color="Color.Default">All</MudChip>
            @if (FocusCount > 0)
            {
                <MudChip T="string" Value="@("Focus")" Variant="Variant.Filled" Color="Color.Primary">
                    🎯 Today's Focus (@FocusCount)
                </MudChip>
            }
            @if (OverdueCount > 0)
            {
                <MudChip T="string" Value="@("Overdue")" Variant="Variant.Filled" Color="Color.Error">Overdue (@OverdueCount)</MudChip>
            }
            <MudChip T="string" Value="@("Today")" Variant="Variant.Filled" Color="Color.Warning">Due Today @(DueTodayCount > 0 ? $"({DueTodayCount})" : "")</MudChip>
            @if (DueThisWeekCount > 0)
            {
                <MudChip T="string" Value="@("Week")" Variant="Variant.Filled" Color="Color.Secondary">This Week (@DueThisWeekCount)</MudChip>
            }
            <MudChip T="string" Value="@("NoDate")" Variant="Variant.Filled" Color="Color.Info">No Date @(NoDateCount > 0 ? $"({NoDateCount})" : "")</MudChip>
        </MudChipSet>
        <MudSpacer />
        <MudSelect T="string" Value="@SortBy" ValueChanged="OnSortChanged"
                   Variant="Variant.Outlined" Margin="Margin.Dense"
                   Style="max-width:130px;" Label="Sort"
                   Dense="true">
            <MudSelectItem Value="@("DueDate")">Due Date</MudSelectItem>
            <MudSelectItem Value="@("Added")">Newest</MudSelectItem>
            <MudSelectItem Value="@("Title")">Title A–Z</MudSelectItem>
        </MudSelect>
        <MudTooltip Text="@(_groupByGoal ? "Switch to date view" : "Group by goal")">
            <MudIconButton Icon="@(_groupByGoal ? Icons.Material.Filled.ViewList : Icons.Material.Filled.AccountTree)"
                           Color="@(_groupByGoal ? Color.Warning : Color.Default)"
                           Size="Size.Small"
                           OnClick="ToggleGroupByGoal"
                           aria-label="Toggle group by goal" />
        </MudTooltip>
        <MudTextField Value="@FilterText" ValueChanged="@((string v) => OnFilterChanged(v))"
                      Placeholder="Search tasks…" Variant="Variant.Outlined"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true" Immediate="true" Margin="Margin.Dense"
                      AdornmentColor="Color.Secondary" Style="max-width:240px;" />
    </MudStack>
    @if (AllPendingTodos.Any())
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
            <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Style="flex:1;">
                @PendingTodos.Count @(!string.IsNullOrWhiteSpace(FilterText) || StatusFilter != "All" ? "matching" : "pending")
            </MudText>
            @if (DueTodayCount > 0 && StatusFilter == "All" && string.IsNullOrWhiteSpace(FilterText))
            {
                <MudButton Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.DoneAll"
                           OnClick="() => _confirmCompleteAllToday = true">
                    ✅ All Done Today
                </MudButton>
            }
        </MudStack>
    }
}

@if (!PendingTodos.Any() && AllPendingTodos.Any())
{
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">No todos matching the current filter.</MudText>
}

@if (_groupByGoal && StatusFilter == "All" && string.IsNullOrWhiteSpace(FilterText) && PendingTodos.Any())
{
    var gbgGroups = PendingTodos
        .Select(t => { var (gText, gGuid, _) = ParseGoalNotes(t.Notes); return (Todo: t, GoalText: gText, GoalGuid: gGuid); })
        .GroupBy(x => x.GoalText ?? "")
        .OrderBy(g => string.IsNullOrEmpty(g.Key) ? 1 : 0)
        .ThenBy(g => g.Key)
        .ToList();
    foreach (var group in gbgGroups)
    {
        var gbgGoalText = group.Key;
        var gbgGoalGuid = group.First().GoalGuid;
        var gbgTodos = group.Select(x => x.Todo).ToList();
        @if (!string.IsNullOrEmpty(gbgGoalText))
        {
            var capturedGbgGoal = gbgGoalText;
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-3 mb-1">
                <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Warning" Size="Size.Small" />
                @if (gbgGoalGuid is not null)
                {
                    <MudLink Href="@($"/goals/{gbgGoalGuid}")" Typo="Typo.subtitle2" Color="Color.Warning"
                             Style="font-weight:700;">@gbgGoalText</MudLink>
                }
                else
                {
                    <MudText Typo="Typo.subtitle2" Color="Color.Warning" Style="font-weight:700;">@gbgGoalText</MudText>
                }
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined"
                         Style="height:18px;font-size:0.68rem;">@gbgTodos.Count</MudChip>
                <MudSpacer />
                <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Warning"
                               title="Add todo for this goal"
                               OnClick="@(() => OpenAddDialogForGoal(capturedGbgGoal))"
                               aria-label="Add todo for this goal" />
            </MudStack>
        }
        else
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-3 mb-1">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">No goal linked</MudText>
                <MudSpacer />
                <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Default"
                               title="Add todo" OnClick="OpenAddDialog" aria-label="Add todo" />
            </MudStack>
        }
        <MudList T="Todo" Dense="false" Class="mb-0">
            @foreach (var t in gbgTodos)
            {
                var (_, _, gbgRemaining) = ParseGoalNotes(t.Notes);
                var gbgIsOverdue = t.DueDate.HasValue && t.DueDate.Value < TodayStartMs;
                <MudListItem>
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudIconButton Icon="@Icons.Material.Filled.RadioButtonUnchecked"
                                       Color="Color.Primary" Size="Size.Small"
                                       OnClick="() => CompleteTodo(t.Guid)" aria-label="Complete todo" />
                        <MudStack Spacing="0" Style="flex:1">
                            <MudText Typo="Typo.body1" Color="@(gbgIsOverdue ? Color.Error : Color.Default)">@t.Title</MudText>
                            @if (t.DueDate.HasValue)
                            {
                                var gbgDue = DateTimeOffset.FromUnixTimeMilliseconds(t.DueDate.Value).LocalDateTime;
                                <MudText Typo="Typo.caption" Color="@(gbgIsOverdue ? Color.Error : Color.Secondary)">
                                    Due @gbgDue.ToString("MMM d")@(gbgIsOverdue ? " — overdue" : "")
                                </MudText>
                            }
                            @if (!string.IsNullOrWhiteSpace(gbgRemaining))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@gbgRemaining</MudText>
                            }
                        </MudStack>
                        @if (gbgIsOverdue)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Today" Size="Size.Small"
                                           Color="Color.Info" title="Reschedule to today"
                                           OnClick="() => RescheduleToday(t.Guid)" aria-label="Reschedule to today" />
                        }
                        @if (!t.DueDate.HasValue)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Today" Size="Size.Small"
                                           Color="Color.Info" title="Set due today"
                                           OnClick="() => SetDueToday(t.Guid)" aria-label="Set due today" />
                        }
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="() => OpenEditTodo(t)" aria-label="Edit todo" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                       Color="Color.Error" OnClick="() => _confirmDeleteGuid = t.Guid" aria-label="Delete todo" />
                    </MudStack>
                </MudListItem>
            }
        </MudList>
        <MudDivider Class="mb-1" />
    }
}
else @if (StatusFilter == "All" && string.IsNullOrWhiteSpace(FilterText) && PendingTodos.Any())
{
    var todayEndMs = TodayStartMs + 86_400_000L;
    var overdueTodos  = PendingTodos.Where(t => t.DueDate.HasValue && t.DueDate.Value < TodayStartMs).ToList();
    var todayTodos    = PendingTodos.Where(t => t.DueDate.HasValue && t.DueDate.Value >= TodayStartMs && t.DueDate.Value < todayEndMs).ToList();
    var upcomingTodos = PendingTodos.Where(t => t.DueDate.HasValue && t.DueDate.Value >= todayEndMs).ToList();
    var noDateTodos   = PendingTodos.Where(t => !t.DueDate.HasValue).ToList();

    @if (overdueTodos.Any())
    {
        <MudText Typo="Typo.subtitle2" Color="Color.Error" Class="mt-2 mb-1">⚠ Overdue</MudText>
        <MudList T="Todo" Dense="false">
            @foreach (var t in overdueTodos)
            {
                <MudListItem>
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudIconButton Icon="@Icons.Material.Filled.RadioButtonUnchecked" Color="Color.Primary" Size="Size.Small" OnClick="() => CompleteTodo(t.Guid)" aria-label="Complete todo" />
                        <MudStack Spacing="0" Style="flex:1">
                            <MudText Typo="Typo.body1" Color="Color.Error">@t.Title</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Error">Due @DateTimeOffset.FromUnixTimeMilliseconds(t.DueDate!.Value).LocalDateTime.ToString("MMM d") — overdue</MudText>
                            @{var (tGoalText, tGoalGuid, tRemainingNotes) = ParseGoalNotes(t.Notes);}
                            @if (tGoalText is not null)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                                         Icon="@Icons.Material.Filled.EmojiEvents"
                                         Href="@(tGoalGuid is not null ? $"/goals/{tGoalGuid}" : null)"
                                         Style="height:20px;font-size:0.7rem;margin:0;">@tGoalText</MudChip>
                            }
                            @if (!string.IsNullOrWhiteSpace(tRemainingNotes)) { <MudText Typo="Typo.caption" Color="Color.Secondary">@tRemainingNotes</MudText> }
                        </MudStack>
                        <MudIconButton Icon="@Icons.Material.Filled.Today" Size="Size.Small"
                                       Color="Color.Info" title="Reschedule to today"
                                       OnClick="() => RescheduleToday(t.Guid)" aria-label="Reschedule to today" />
                        <MudIconButton Icon="@Icons.Material.Filled.Snooze" Size="Size.Small"
                                       Color="Color.Warning" title="Snooze to tomorrow"
                                       OnClick="() => SnoozeTodo(t.Guid)" aria-label="Snooze to tomorrow" />
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => OpenEditTodo(t)" aria-label="Edit todo" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => _confirmDeleteGuid = t.Guid" aria-label="Delete todo" />
                    </MudStack>
                </MudListItem>
            }
        </MudList>
    }
    @if (todayTodos.Any())
    {
        <MudText Typo="Typo.subtitle2" Color="Color.Warning" Class="mt-3 mb-1">📅 Due Today</MudText>
        <MudList T="Todo" Dense="false">
            @foreach (var t in todayTodos)
            {
                <MudListItem>
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudIconButton Icon="@Icons.Material.Filled.RadioButtonUnchecked" Color="Color.Primary" Size="Size.Small" OnClick="() => CompleteTodo(t.Guid)" aria-label="Complete todo" />
                        <MudStack Spacing="0" Style="flex:1">
                            <MudText Typo="Typo.body1">@t.Title</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Warning">Due today</MudText>
                            @{var (tGoalText, tGoalGuid, tRemainingNotes) = ParseGoalNotes(t.Notes);}
                            @if (tGoalText is not null)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                                         Icon="@Icons.Material.Filled.EmojiEvents"
                                         Href="@(tGoalGuid is not null ? $"/goals/{tGoalGuid}" : null)"
                                         Style="height:20px;font-size:0.7rem;margin:0;">@tGoalText</MudChip>
                            }
                            @if (!string.IsNullOrWhiteSpace(tRemainingNotes)) { <MudText Typo="Typo.caption" Color="Color.Secondary">@tRemainingNotes</MudText> }
                        </MudStack>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => OpenEditTodo(t)" aria-label="Edit todo" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => _confirmDeleteGuid = t.Guid" aria-label="Delete todo" />
                    </MudStack>
                </MudListItem>
            }
        </MudList>
    }
    @if (upcomingTodos.Any())
    {
        <MudText Typo="Typo.subtitle2" Color="Color.Default" Class="mt-3 mb-1">📌 Upcoming</MudText>
        <MudList T="Todo" Dense="false">
            @foreach (var t in upcomingTodos)
            {
                var due = DateTimeOffset.FromUnixTimeMilliseconds(t.DueDate!.Value).LocalDateTime;
                <MudListItem>
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudIconButton Icon="@Icons.Material.Filled.RadioButtonUnchecked" Color="Color.Primary" Size="Size.Small" OnClick="() => CompleteTodo(t.Guid)" aria-label="Complete todo" />
                        <MudStack Spacing="0" Style="flex:1">
                            <MudText Typo="Typo.body1">@t.Title</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Due @due.ToString("MMM d")</MudText>
                            @{var (tGoalText, tGoalGuid, tRemainingNotes) = ParseGoalNotes(t.Notes);}
                            @if (tGoalText is not null)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                                         Icon="@Icons.Material.Filled.EmojiEvents"
                                         Href="@(tGoalGuid is not null ? $"/goals/{tGoalGuid}" : null)"
                                         Style="height:20px;font-size:0.7rem;margin:0;">@tGoalText</MudChip>
                            }
                            @if (!string.IsNullOrWhiteSpace(tRemainingNotes)) { <MudText Typo="Typo.caption" Color="Color.Secondary">@tRemainingNotes</MudText> }
                        </MudStack>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => OpenEditTodo(t)" aria-label="Edit todo" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => _confirmDeleteGuid = t.Guid" aria-label="Delete todo" />
                    </MudStack>
                </MudListItem>
            }
        </MudList>
    }
    @if (noDateTodos.Any())
    {
        <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mt-3 mb-1">🗒 No Date</MudText>
        <MudList T="Todo" Dense="false">
            @foreach (var t in noDateTodos)
            {
                <MudListItem>
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudIconButton Icon="@Icons.Material.Filled.RadioButtonUnchecked" Color="Color.Primary" Size="Size.Small" OnClick="() => CompleteTodo(t.Guid)" aria-label="Complete todo" />
                        <MudStack Spacing="0" Style="flex:1">
                            <MudText Typo="Typo.body1">@t.Title</MudText>
                            @{var (tGoalText, tGoalGuid, tRemainingNotes) = ParseGoalNotes(t.Notes);}
                            @if (tGoalText is not null)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                                         Icon="@Icons.Material.Filled.EmojiEvents"
                                         Href="@(tGoalGuid is not null ? $"/goals/{tGoalGuid}" : null)"
                                         Style="height:20px;font-size:0.7rem;margin:0;">@tGoalText</MudChip>
                            }
                            @if (!string.IsNullOrWhiteSpace(tRemainingNotes)) { <MudText Typo="Typo.caption" Color="Color.Secondary">@tRemainingNotes</MudText> }
                        </MudStack>
                        <MudIconButton Icon="@Icons.Material.Filled.Today" Size="Size.Small"
                                       Color="Color.Info" title="Set due today"
                                       OnClick="() => SetDueToday(t.Guid)" aria-label="Set due today" />
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => OpenEditTodo(t)" aria-label="Edit todo" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => _confirmDeleteGuid = t.Guid" aria-label="Delete todo" />
                    </MudStack>
                </MudListItem>
            }
        </MudList>
    }
}
else
{
    <MudList T="Todo" Dense="false">
        @foreach (var t in PendingTodos)
        {
            var isOverdue = t.DueDate.HasValue && t.DueDate.Value < TodayStartMs;
            <MudListItem>
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudIconButton Icon="@Icons.Material.Filled.RadioButtonUnchecked"
                                   Color="Color.Primary" Size="Size.Small"
                                   OnClick="() => CompleteTodo(t.Guid)" aria-label="Complete todo" />
                    <MudStack Spacing="0" Style="flex:1">
                        <MudText Typo="Typo.body1" Color="@(isOverdue ? Color.Error : Color.Default)">@((MarkupString)HighlightMatch(t.Title ?? "", FilterText.Trim()))</MudText>
                        @if (t.DueDate.HasValue)
                        {
                            var due = DateTimeOffset.FromUnixTimeMilliseconds(t.DueDate.Value).LocalDateTime;
                            <MudText Typo="Typo.caption" Color="@(isOverdue ? Color.Error : Color.Secondary)">
                                Due @due.ToString("MMM d")@(isOverdue ? " — overdue" : "")
                            </MudText>
                        }
                        @{var (tGoalText2, tGoalGuid2, tRemainingNotes2) = ParseGoalNotes(t.Notes);}
                        @if (tGoalText2 is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                                     Icon="@Icons.Material.Filled.EmojiEvents"
                                     Href="@(tGoalGuid2 is not null ? $"/goals/{tGoalGuid2}" : null)"
                                     Style="height:20px;font-size:0.7rem;margin:0;">@tGoalText2</MudChip>
                        }
                        @if (!string.IsNullOrWhiteSpace(tRemainingNotes2)) { <MudText Typo="Typo.caption" Color="Color.Secondary">@tRemainingNotes2</MudText> }
                    </MudStack>
                    @if (isOverdue)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Today" Size="Size.Small"
                                       Color="Color.Info" title="Reschedule to today"
                                       OnClick="() => RescheduleToday(t.Guid)" aria-label="Reschedule to today" />
                        <MudIconButton Icon="@Icons.Material.Filled.Snooze" Size="Size.Small"
                                       Color="Color.Warning" title="Snooze to tomorrow"
                                       OnClick="() => SnoozeTodo(t.Guid)" aria-label="Snooze to tomorrow" />
                    }
                    @if (!t.DueDate.HasValue)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Today" Size="Size.Small"
                                       Color="Color.Info" title="Set due today"
                                       OnClick="() => SetDueToday(t.Guid)" aria-label="Set due today" />
                    }
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   OnClick="() => OpenEditTodo(t)" aria-label="Edit todo" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                   Color="Color.Error" OnClick="() => _confirmDeleteGuid = t.Guid" aria-label="Delete todo" />
                </MudStack>
            </MudListItem>
        }
    </MudList>
}

