@page "/achievements"
@inject AppDbContext Db
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor
@inject WebAnalyticsService Analytics
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@using Microsoft.EntityFrameworkCore

<PageTitle>Achievements – ChildDev</PageTitle>

@if (AccountGuid is null)
{
    Nav.NavigateTo("/login");
    return;
}

<MudText Typo="Typo.h5" Class="mb-1">
    <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Class="mr-2" />
    Achievements
</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    @EarnedCount of @TotalBadgeCount badges earned 🏆
</MudText>

@if (EarnedCount > 0)
{
    var overallPct = (int)(EarnedCount * 100.0 / TotalBadgeCount);
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
        <MudProgressLinear Value="@overallPct" Color="Color.Warning" Rounded="true" Size="Size.Medium" Style="flex:1;" />
        <MudTooltip Text="Share your achievement progress">
            <MudIconButton Icon="@Icons.Material.Filled.Share" Size="Size.Small" Color="Color.Warning"
                           OnClick="ShareAchievements" aria-label="Share achievements" />
        </MudTooltip>
    </MudStack>
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">@overallPct% complete</MudText>
}

@{
    var recentlyEarned = BadgeCategories
        .SelectMany(c => c.Badges.Where(b => b.Earned && b.EarnedOn.HasValue).Select(b => (b, c)))
        .OrderByDescending(x => x.b.EarnedOn)
        .Take(3)
        .ToList();
}
@if (recentlyEarned.Count > 0)
{
    <MudPaper Elevation="2" Class="pa-3 mb-5" Style="border-radius:14px;background:linear-gradient(135deg,rgba(255,193,7,.10) 0%,rgba(255,255,255,0) 100%);border:1.5px solid var(--mud-palette-warning);">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" Size="Size.Small" />
            <MudText Typo="Typo.overline" Color="Color.Warning" Style="font-weight:700;letter-spacing:1px;">Recently Earned</MudText>
        </MudStack>
        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
            @foreach (var (badge, cat) in recentlyEarned)
            {
                <MudPaper Elevation="0" Class="pa-2" Style="@($"border-radius:12px;background:linear-gradient(135deg,{cat.GradientFrom} 0%,{cat.GradientTo} 100%);min-width:100px;text-align:center;")">
                    <MudText Style="font-size:1.6rem;line-height:1.3;">@badge.Emoji</MudText>
                    <MudText Typo="Typo.caption" Style="color:white;font-weight:700;display:block;">@badge.Name</MudText>
                    @if (badge.EarnedOn.HasValue)
                    {
                        <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,.75);font-size:0.6rem;">@badge.EarnedOn.Value.ToString("MMM d")</MudText>
                    }
                </MudPaper>
            }
        </MudStack>
    </MudPaper>
}

@{
    var nextUpBadges = BadgeCategories
        .Select(c => (Cat: c, Next: c.Badges.FirstOrDefault(b => !b.Earned)))
        .Where(x => x.Next is not null)
        .ToList();
}
@if (nextUpBadges.Count > 0)
{
    <MudPaper Elevation="1" Class="pa-3 mb-5" Style="border-radius:14px;border:1.5px solid var(--mud-palette-primary);">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Primary" Size="Size.Small" />
            <MudText Typo="Typo.overline" Color="Color.Primary" Style="font-weight:700;letter-spacing:1px;">Next to Unlock</MudText>
        </MudStack>
        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
            @foreach (var (cat, next) in nextUpBadges)
            {
                <MudPaper Elevation="0" Class="pa-2" Style="border-radius:12px;background:var(--mud-palette-background-grey);min-width:100px;text-align:center;opacity:0.85;">
                    <MudText Style="font-size:1.5rem;line-height:1.3;">@next!.Emoji</MudText>
                    <MudText Typo="Typo.caption" Style="font-weight:700;display:block;">@next!.Name</MudText>
                    <MudText Typo="Typo.caption" Style="font-size:0.6rem;color:var(--mud-palette-text-secondary);">@cat.Icon @cat.Name</MudText>
                    @if (!string.IsNullOrEmpty(next!.ProgressHint))
                    {
                        <MudText Typo="Typo.caption" Style="font-size:0.6rem;color:var(--mud-palette-primary);font-weight:600;">@next.ProgressHint</MudText>
                    }
                </MudPaper>
            }
        </MudStack>
    </MudPaper>
}

@foreach (var cat in BadgeCategories)
{
    var earned = cat.Badges.Count(b => b.Earned);
    var catPct = cat.Badges.Count > 0 ? (int)(earned * 100.0 / cat.Badges.Count) : 0;
    var catBarColor = catPct == 100 ? "var(--mud-palette-success)" : catPct >= 50 ? "var(--mud-palette-primary)" : "var(--mud-palette-secondary)";
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-1 mt-4">
        <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Style="text-transform:uppercase;letter-spacing:1px;flex:1;">
            @cat.Icon @cat.Name
        </MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">@earned / @cat.Badges.Count</MudText>
        @if (catPct == 100) { <MudText Style="font-size:0.9rem;">🏆</MudText> }
    </MudStack>
    <div style="background:var(--mud-palette-lines-default);border-radius:4px;height:5px;margin-bottom:12px;overflow:hidden;">
        <div style="@($"width:{catPct}%;background:{catBarColor};height:100%;border-radius:4px;transition:width .4s ease;")"></div>
    </div>
    <MudGrid Spacing="3" Class="mb-2">
        @foreach (var badge in cat.Badges)
        {
            var opacity = badge.Earned ? "1" : "0.38";
            var bg = badge.Earned
                ? $"background:linear-gradient(135deg,{cat.GradientFrom} 0%,{cat.GradientTo} 100%);"
                : "background:var(--mud-palette-background-grey);";
            var nameStyle = $"font-weight:700;margin-top:6px;{(badge.Earned ? "color:white;" : "")}";
            var descStyle = badge.Earned ? "color:rgba(255,255,255,.8);" : "color:var(--mud-palette-text-secondary);";
            <MudItem xs="6" sm="4" md="3">
                <MudPaper Elevation="@(badge.Earned ? 3 : 1)" Class="pa-3 text-center" Style="@($"border-radius:16px;{bg}opacity:{opacity};min-height:120px;display:flex;flex-direction:column;align-items:center;justify-content:center;")">
                    <MudText Style="font-size:2rem;line-height:1.2;">@badge.Emoji</MudText>
                    <MudText Typo="Typo.body2" Style="@nameStyle">@badge.Name</MudText>
                    <MudText Typo="Typo.caption" Style="@descStyle">@badge.Description</MudText>
                    @if (badge.Earned && badge.EarnedOn.HasValue)
                    {
                        <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,.7);margin-top:2px;font-size:0.65rem;">
                            @badge.EarnedOn.Value.ToString("MMM d, yyyy")
                        </MudText>
                    }
                    @if (!badge.Earned)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Secondary" Style="margin-top:4px;" />
                        @if (!string.IsNullOrEmpty(badge.ProgressHint))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Primary" Style="font-size:0.6rem;font-weight:600;margin-top:2px;">@badge.ProgressHint</MudText>
                        }
                    }
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private string? AccountGuid;
    private int EarnedCount;
    private int TotalBadgeCount;
    private List<BadgeCategory> BadgeCategories = [];

    private record Badge(string Emoji, string Name, string Description, bool Earned, DateTime? EarnedOn = null, string? ProgressHint = null);
    private record BadgeCategory(string Icon, string Name, string GradientFrom, string GradientTo, List<Badge> Badges);

    protected override async Task OnInitializedAsync()
    {
        AccountGuid = HttpContextAccessor.HttpContext?.Session.GetString("AccountGuid");
        if (AccountGuid is null) return;

        await Analytics.TrackAsync("page_view", AccountGuid, "achievements");

        // Load aggregate data
        var account = await Db.Accounts
            .Where(a => a.Guid == AccountGuid)
            .Select(a => new { a.CreatedOn })
            .FirstOrDefaultAsync();
        var accountAgeDays = account is not null ? (int)((DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - account.CreatedOn) / 86_400_000L) : 0;

        var goals = await Db.Goals
            .Where(g => g.AccountFk == AccountGuid && g.DeletedAt == null)
            .Select(g => new { g.EnteredDate, g.CompletionDate, g.MeasurableOutcome, g.ExpirationDate })
            .ToListAsync();
        var completedGoals = goals.Where(g => g.CompletionDate.HasValue).OrderBy(g => g.CompletionDate).ToList();
        var completedOnTime = completedGoals.Any(g => g.ExpirationDate.HasValue && g.CompletionDate!.Value <= g.ExpirationDate.Value);
        var firstGoalDate = goals.Count > 0 ? DateTimeOffset.FromUnixTimeMilliseconds(goals.Min(g => g.EnteredDate)).LocalDateTime : (DateTime?)null;
        var firstCompleteDate = completedGoals.Count > 0 ? DateTimeOffset.FromUnixTimeMilliseconds(completedGoals[0].CompletionDate!.Value).LocalDateTime : (DateTime?)null;
        var goalsWithOutcome = goals.Count(g => !string.IsNullOrWhiteSpace(g.MeasurableOutcome));

        var progressNotesFull = await Db.GoalProgresses
            .Where(p => p.AccountFk == AccountGuid && p.DeletedAt == null)
            .Select(p => new { p.UpdatedOn, p.NextStepItems })
            .OrderBy(p => p.UpdatedOn)
            .ToListAsync();
        var progressNotes = progressNotesFull.Select(p => p.UpdatedOn).ToList();
        var maxNotesPerGoal = await Db.GoalProgresses
            .Where(p => p.AccountFk == AccountGuid && p.DeletedAt == null)
            .GroupBy(p => p.GoalFk)
            .Select(g => g.Count())
            .DefaultIfEmpty(0)
            .MaxAsync();
        var progressNoteDayCount = progressNotes
            .Select(ms => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime))
            .ToHashSet().Count;
        var firstNoteDate = progressNotes.Count > 0 ? DateTimeOffset.FromUnixTimeMilliseconds(progressNotes[0]).LocalDateTime : (DateTime?)null;
        var maxNoteWordCount = progressNotesFull
            .Where(p => !string.IsNullOrWhiteSpace(p.NextStepItems))
            .Select(p => p.NextStepItems!.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length)
            .DefaultIfEmpty(0).Max();

        var todosFull = await Db.Todos
            .Where(t => t.AccountFk == AccountGuid && t.DeletedAt == null && t.CompletedAt.HasValue)
            .Select(t => new { t.CompletedAt, t.DueDate })
            .OrderBy(t => t.CompletedAt)
            .ToListAsync();
        var todos = todosFull.Select(t => t.CompletedAt!.Value).ToList();
        var firstTodoDate = todos.Count > 0 ? DateTimeOffset.FromUnixTimeMilliseconds(todos[0]).LocalDateTime : (DateTime?)null;
        var onTimeCount = todosFull.Count(t => t.DueDate.HasValue && t.CompletedAt!.Value <= t.DueDate.Value);

        var journalsFull = await Db.Journals
            .Where(j => j.AccountFk == AccountGuid && j.DeletedAt == null)
            .Select(j => new { j.EnteredDate, j.Mood, j.Notes })
            .OrderBy(j => j.EnteredDate)
            .ToListAsync();
        var journals = journalsFull.Select(j => j.EnteredDate).ToList();
        var firstJournalDate = journals.Count > 0 ? DateTimeOffset.FromUnixTimeMilliseconds(journals[0]).LocalDateTime : (DateTime?)null;
        var journalWithMoodCount = journalsFull.Count(j => !string.IsNullOrWhiteSpace(j.Mood));
        var maxJournalWordCount = journalsFull
            .Where(j => !string.IsNullOrWhiteSpace(j.Notes))
            .Select(j => j.Notes!.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length)
            .DefaultIfEmpty(0).Max();

        // Streak computation (progress notes + journals + todos combined)
        var allActivityMs = progressNotes.Concat(todos).Concat(journals).ToList();
        var activeDates = allActivityMs
            .Select(ms => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime))
            .ToHashSet();
        var maxStreak = 0;
        var curStreak = 0;
        var streakDay = DateOnly.FromDateTime(DateTime.Today);
        var checkedDay = DateOnly.FromDateTime(DateTime.Today);
        // Walk back to find best streak ever
        var sortedDates = activeDates.OrderByDescending(d => d).ToList();
        if (sortedDates.Count > 0)
        {
            var runDay = sortedDates[0];
            curStreak = 1;
            for (int si = 1; si < sortedDates.Count; si++)
            {
                if (sortedDates[si - 1].DayNumber - sortedDates[si].DayNumber == 1)
                {
                    curStreak++;
                    if (curStreak > maxStreak) maxStreak = curStreak;
                }
                else
                {
                    curStreak = 1;
                }
            }
            if (curStreak > maxStreak) maxStreak = curStreak;
        }

        // Habit badge computations
        var noteWeekNums = progressNotes
            .Select(ms => DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime)
            .Select(dt => dt.Year * 100 + System.Globalization.ISOWeek.GetWeekOfYear(dt))
            .ToHashSet().OrderBy(w => w).ToList();
        var distinctNoteWeeks = noteWeekNums.Count;
        var maxConsecNoteWeeks = 0;
        var curNoteWks = 0;
        for (int wi = 0; wi < noteWeekNums.Count; wi++)
        {
            if (wi == 0) { curNoteWks = 1; }
            else
            {
                var pv = noteWeekNums[wi - 1]; var cv = noteWeekNums[wi];
                var py = pv / 100; var pw = pv % 100; var cy = cv / 100; var cw = cv % 100;
                curNoteWks = (cy == py && cw == pw + 1) || (cy == py + 1 && pw >= 51 && cw == 1) ? curNoteWks + 1 : 1;
            }
            if (curNoteWks > maxConsecNoteWeeks) maxConsecNoteWeeks = curNoteWks;
        }

        var journalDates = journals
            .Select(ms => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime))
            .ToHashSet().OrderBy(d => d).ToList();
        var maxJournalDayStreak = 0;
        var curJournalRun = 0;
        for (int ji = 0; ji < journalDates.Count; ji++)
        {
            curJournalRun = (ji == 0 || journalDates[ji] != journalDates[ji - 1].AddDays(1)) ? 1 : curJournalRun + 1;
            if (curJournalRun > maxJournalDayStreak) maxJournalDayStreak = curJournalRun;
        }

        var todoDates = todos
            .Select(ms => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime))
            .ToHashSet().OrderBy(d => d).ToList();
        var maxTodoDayStreak = 0;
        var curTodoRun = 0;
        for (int ti = 0; ti < todoDates.Count; ti++)
        {
            curTodoRun = (ti == 0 || todoDates[ti] != todoDates[ti - 1].AddDays(1)) ? 1 : curTodoRun + 1;
            if (curTodoRun > maxTodoDayStreak) maxTodoDayStreak = curTodoRun;
        }

        var weekendWeekCount = allActivityMs
            .Select(ms => DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime)
            .Where(dt => dt.DayOfWeek == DayOfWeek.Saturday || dt.DayOfWeek == DayOfWeek.Sunday)
            .Select(dt => dt.Year * 100 + System.Globalization.ISOWeek.GetWeekOfYear(dt))
            .Distinct().Count();

        BadgeCategories =
        [
            new BadgeCategory("🎯", "Goals", "rgba(57,73,171,.85)", "rgba(40,53,147,.9)",
            [
                MakeBadge("🌱", "First Goal", "Set your very first goal", goals.Count >= 1, firstGoalDate),
                MakeBadge("⭐", "Achiever", "Complete your first goal", completedGoals.Count >= 1, firstCompleteDate, completedGoals.Count == 0 ? "0/1 completed" : null),
                MakeBadge("🏆", "Champion", "Complete 5 goals", completedGoals.Count >= 5, completedGoals.Count >= 5 ? DateTimeOffset.FromUnixTimeMilliseconds(completedGoals[4].CompletionDate!.Value).LocalDateTime : null, completedGoals.Count < 5 ? $"{completedGoals.Count}/5 completed" : null),
                MakeBadge("🌟", "Goal Legend", "Complete 25 goals", completedGoals.Count >= 25, completedGoals.Count >= 25 ? DateTimeOffset.FromUnixTimeMilliseconds(completedGoals[24].CompletionDate!.Value).LocalDateTime : null, completedGoals.Count < 25 ? $"{completedGoals.Count}/25 completed" : null),
                MakeBadge("🚀", "Ambitious", "Set 5 goals", goals.Count >= 5, null, goals.Count < 5 ? $"{goals.Count}/5 goals" : null),
                MakeBadge("💫", "Dream Big", "Set 20 goals", goals.Count >= 20, null, goals.Count < 20 ? $"{goals.Count}/20 goals" : null),
                MakeBadge("📏", "Measurable", "Add success criteria to 3 goals", goalsWithOutcome >= 3, null, goalsWithOutcome < 3 ? $"{goalsWithOutcome}/3 goals with criteria" : null),
                MakeBadge("⏱️", "Goal On Time", "Complete a goal before its deadline", completedOnTime, null, completedOnTime ? null : "Complete a goal with a due date set"),
            ]),
            new BadgeCategory("📝", "Progress Notes", "rgba(67,160,71,.85)", "rgba(27,94,32,.9)",
            [
                MakeBadge("✏️", "First Step", "Add your first progress note", progressNotes.Count >= 1, firstNoteDate),
                MakeBadge("📋", "Note Taker", "Write 10 progress notes", progressNotes.Count >= 10, progressNotes.Count >= 10 ? DateTimeOffset.FromUnixTimeMilliseconds(progressNotes[9]).LocalDateTime : null, progressNotes.Count < 10 ? $"{progressNotes.Count}/10 notes" : null),
                MakeBadge("🗒️", "Dedicated", "Write 50 progress notes", progressNotes.Count >= 50, progressNotes.Count >= 50 ? DateTimeOffset.FromUnixTimeMilliseconds(progressNotes[49]).LocalDateTime : null, progressNotes.Count < 50 ? $"{progressNotes.Count}/50 notes" : null),
                MakeBadge("📚", "Master Tracker", "Write 200 progress notes", progressNotes.Count >= 200, progressNotes.Count >= 200 ? DateTimeOffset.FromUnixTimeMilliseconds(progressNotes[199]).LocalDateTime : null, progressNotes.Count < 200 ? $"{progressNotes.Count}/200 notes" : null),
                MakeBadge("🖊️", "Word Wizard", "Write a note with 100+ words", maxNoteWordCount >= 100, null, maxNoteWordCount < 100 ? $"Best: {maxNoteWordCount} words" : null),
                MakeBadge("🤿", "Deep Diver", "Write 20+ notes for a single goal", maxNotesPerGoal >= 20, null, maxNotesPerGoal < 20 ? $"Best: {maxNotesPerGoal} notes for one goal" : null),
                MakeBadge("📅", "Consistent", "Write progress notes on 5 different days", progressNoteDayCount >= 5, null, progressNoteDayCount < 5 ? $"{progressNoteDayCount}/5 active days" : null),
            ]),
            new BadgeCategory("✅", "Todos", "rgba(229,57,53,.85)", "rgba(183,28,28,.9)",
            [
                MakeBadge("✔️", "Action Taker", "Complete your first todo", todos.Count >= 1, firstTodoDate),
                MakeBadge("💪", "Getting Things Done", "Complete 25 todos", todos.Count >= 25, todos.Count >= 25 ? DateTimeOffset.FromUnixTimeMilliseconds(todos[24]).LocalDateTime : null, todos.Count < 25 ? $"{todos.Count}/25 todos" : null),
                MakeBadge("⚡", "Productivity Pro", "Complete 100 todos", todos.Count >= 100, todos.Count >= 100 ? DateTimeOffset.FromUnixTimeMilliseconds(todos[99]).LocalDateTime : null, todos.Count < 100 ? $"{todos.Count}/100 todos" : null),
                MakeBadge("🔥", "Machine", "Complete 500 todos", todos.Count >= 500, todos.Count >= 500 ? DateTimeOffset.FromUnixTimeMilliseconds(todos[499]).LocalDateTime : null, todos.Count < 500 ? $"{todos.Count}/500 todos" : null),
                MakeBadge("⏰", "On Time", "Complete 5 todos by their due date", onTimeCount >= 5, null, onTimeCount < 5 ? $"{onTimeCount}/5 on-time completions" : null),
            ]),
            new BadgeCategory("📓", "Journal", "rgba(2,136,209,.85)", "rgba(1,87,155,.9)",
            [
                MakeBadge("📖", "First Entry", "Write your first journal entry", journals.Count >= 1, firstJournalDate),
                MakeBadge("✍️", "Reflection Builder", "Write 10 journal entries", journals.Count >= 10, journals.Count >= 10 ? DateTimeOffset.FromUnixTimeMilliseconds(journals[9]).LocalDateTime : null, journals.Count < 10 ? $"{journals.Count}/10 entries" : null),
                MakeBadge("🖋️", "Storyteller", "Write 50 journal entries", journals.Count >= 50, journals.Count >= 50 ? DateTimeOffset.FromUnixTimeMilliseconds(journals[49]).LocalDateTime : null, journals.Count < 50 ? $"{journals.Count}/50 entries" : null),
                MakeBadge("🏅", "Author", "Write 200 journal entries", journals.Count >= 200, journals.Count >= 200 ? DateTimeOffset.FromUnixTimeMilliseconds(journals[199]).LocalDateTime : null, journals.Count < 200 ? $"{journals.Count}/200 entries" : null),
                MakeBadge("😊", "Mood Tracker", "Record your mood in 10 entries", journalWithMoodCount >= 10, null, journalWithMoodCount < 10 ? $"{journalWithMoodCount}/10 mood entries" : null),
                MakeBadge("📜", "Deep Thinker", "Write a journal entry with 200+ words", maxJournalWordCount >= 200, null, maxJournalWordCount < 200 ? $"Best: {maxJournalWordCount} words" : null),
            ]),
            new BadgeCategory("🔥", "Streaks", "rgba(249,168,37,.9)", "rgba(230,81,0,.9)",
            [
                MakeBadge("⚡", "3-Day Streak", "Be active 3 days in a row", maxStreak >= 3, null, maxStreak < 3 ? $"Best: {maxStreak} days" : null),
                MakeBadge("🔥", "Week Warrior", "Be active 7 days in a row", maxStreak >= 7, null, maxStreak < 7 ? $"Best: {maxStreak} days" : null),
                MakeBadge("💎", "Two-Week Strong", "Be active 14 days in a row", maxStreak >= 14, null, maxStreak < 14 ? $"Best: {maxStreak} days" : null),
                MakeBadge("🌟", "Month Master", "Be active 30 days in a row", maxStreak >= 30, null, maxStreak < 30 ? $"Best: {maxStreak} days" : null),
                MakeBadge("🏆", "Unstoppable", "Be active 100 days in a row", maxStreak >= 100, null, maxStreak < 100 ? $"Best: {maxStreak} days" : null),
            ]),
            new BadgeCategory("🌱", "Milestones", "rgba(0,150,136,.85)", "rgba(0,105,92,.9)",
            [
                MakeBadge("🌱", "Seedling", "Use the app for 7 days", accountAgeDays >= 7, null, accountAgeDays < 7 ? $"Day {accountAgeDays}/7" : null),
                MakeBadge("🌿", "Growing", "Use the app for 30 days", accountAgeDays >= 30, null, accountAgeDays < 30 ? $"Day {accountAgeDays}/30" : null),
                MakeBadge("🌳", "Rooted", "Use the app for 90 days", accountAgeDays >= 90, null, accountAgeDays < 90 ? $"Day {accountAgeDays}/90" : null),
                MakeBadge("🏅", "Year Strong", "Use the app for 365 days", accountAgeDays >= 365, null, accountAgeDays < 365 ? $"Day {accountAgeDays}/365" : null),
                MakeBadge("🌈", "Well-Rounded", "Use goals, notes, todos, and journal", goals.Count >= 1 && progressNotes.Count >= 1 && todos.Count >= 1 && journals.Count >= 1, null,
                    goals.Count == 0 ? "Need: set a goal" : progressNotes.Count == 0 ? "Need: write a progress note" : todos.Count == 0 ? "Need: complete a todo" : journals.Count == 0 ? "Need: write a journal entry" : null),
                MakeBadge("🎨", "Explorer", "Try all 4 features in one week",
                    (from ms in progressNotes.Concat(todos).Concat(journals).Concat(goals.Select(g => g.EnteredDate))
                     let day = DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime)
                     group day by (day.DayNumber / 7)
                     into wk
                     let hasGoal = wk.Any(d => goals.Any(g => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(g.EnteredDate).LocalDateTime) == d))
                     let hasNote = wk.Any(d => progressNotes.Any(ms2 => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(ms2).LocalDateTime) == d))
                     let hasTodo = wk.Any(d => todos.Any(ms2 => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(ms2).LocalDateTime) == d))
                     let hasJournal = wk.Any(d => journals.Any(ms2 => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(ms2).LocalDateTime) == d))
                     select hasNote && hasTodo && hasJournal).Any(x => x),
                    null, goals.Count == 0 || progressNotes.Count == 0 || todos.Count == 0 || journals.Count == 0 ? "Use all 4 features in the same week" : null),
            ]),
        new BadgeCategory("💪", "Habits", "rgba(103,58,183,.85)", "rgba(69,39,160,.9)",
        [
            MakeBadge("📆", "Weekly Writer", "Log progress notes in 4 different weeks", distinctNoteWeeks >= 4, null, distinctNoteWeeks < 4 ? $"{distinctNoteWeeks}/4 active weeks" : null),
            MakeBadge("📓", "Journal Week", "Journal on 7 consecutive days", maxJournalDayStreak >= 7, null, maxJournalDayStreak < 7 ? $"Best: {maxJournalDayStreak} consecutive days" : null),
            MakeBadge("🎯", "Goal Guardian", "Log progress notes every week for 4 weeks in a row", maxConsecNoteWeeks >= 4, null, maxConsecNoteWeeks < 4 ? $"Best: {maxConsecNoteWeeks} consecutive weeks" : null),
            MakeBadge("✅", "Daily Doer", "Complete a todo every day for 7 days in a row", maxTodoDayStreak >= 7, null, maxTodoDayStreak < 7 ? $"Best: {maxTodoDayStreak} consecutive days" : null),
            MakeBadge("🌅", "Weekend Warrior", "Be active on 4 different weekends", weekendWeekCount >= 4, null, weekendWeekCount < 4 ? $"{weekendWeekCount}/4 weekends" : null),
        ]),
        ];

        TotalBadgeCount = BadgeCategories.Sum(c => c.Badges.Count);
        EarnedCount = BadgeCategories.Sum(c => c.Badges.Count(b => b.Earned));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || AccountGuid is null || EarnedCount == 0) return;

        var storageKey = $"childdev_badges_seen_{AccountGuid}";
        var currentEarned = BadgeCategories
            .SelectMany(c => c.Badges.Where(b => b.Earned).Select(b => b.Name))
            .OrderBy(n => n)
            .ToList();

        try
        {
            var seen = await JS.InvokeAsync<string?>("localStorage.getItem", storageKey);
            var seenSet = string.IsNullOrWhiteSpace(seen)
                ? new HashSet<string>()
                : new HashSet<string>(seen.Split('|', StringSplitOptions.RemoveEmptyEntries));

            var newlyEarned = currentEarned.Where(n => !seenSet.Contains(n)).ToList();
            foreach (var name in newlyEarned)
            {
                var badge = BadgeCategories.SelectMany(c => c.Badges).FirstOrDefault(b => b.Name == name);
                if (badge is not null)
                {
                    Snackbar.Add($"{badge.Emoji} You just earned the <strong>{badge.Name}</strong> badge! {badge.Description}", Severity.Success,
                        config => { config.VisibleStateDuration = 6000; config.HideTransitionDuration = 500; });
                    await Analytics.TrackAsync("badge_earned_notify", AccountGuid, "achievements", name);
                }
            }

            await JS.InvokeVoidAsync("localStorage.setItem", storageKey, string.Join("|", currentEarned));
        }
        catch { }
    }

    private static Badge MakeBadge(string emoji, string name, string desc, bool earned, DateTime? earnedOn, string? progressHint = null) =>
        new(emoji, name, desc, earned, earned ? earnedOn : null, earned ? null : progressHint);

    private async Task ShareAchievements()
    {
        if (AccountGuid is null) return;
        var earnedBadges = BadgeCategories
            .SelectMany(c => c.Badges.Where(b => b.Earned).Select(b => $"{b.Emoji} {b.Name}"))
            .ToList();
        var overallPct = TotalBadgeCount > 0 ? (int)(EarnedCount * 100.0 / TotalBadgeCount) : 0;
        var categoryLines = string.Join("\n", BadgeCategories.Select(c =>
        {
            var earned = c.Badges.Count(b => b.Earned);
            var badges = string.Join(" ", c.Badges.Where(b => b.Earned).Select(b => b.Emoji));
            return earned == 0 ? null : $"{c.Icon} {c.Name}: {badges} ({earned}/{c.Badges.Count})";
        }).Where(l => l is not null));
        var text = $"🏆 My ChildDev Achievements\n\n{EarnedCount} of {TotalBadgeCount} badges earned ({overallPct}%)\n\n{categoryLines}\n\n\"Keep setting goals and seeing them through!\" 🌟";
        var result = await JS.InvokeAsync<string>("childdev.shareOrCopy", "My Achievements 🏆", text);
        Snackbar.Add(result == "shared" ? "Achievements shared! 🎉" : "Achievements copied to clipboard! 📋", Severity.Success);
        await Analytics.TrackAsync("badge_earned_notify", AccountGuid, "achievements", "share_all");
    }
}
