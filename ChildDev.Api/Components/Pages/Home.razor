@page "/"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor
@inject ISnackbar Snackbar
@inject WebAnalyticsService Analytics
@inject IWebHostEnvironment HostEnv
@inject IJSRuntime JS
@inject EmailService EmailService
@implements IAsyncDisposable

<PageTitle>Goals – LevelUp</PageTitle>

@if (AccountGuid is null)
{
    <div class="hero-section" style="min-height:72vh;display:flex;align-items:center;position:relative;overflow:hidden;">
        <div class="hero-shimmer"></div>
        <div class="hero-stars" aria-hidden="true">
            <span>⭐</span><span>✨</span><span>🌟</span><span>⭐</span><span>✦</span><span>✨</span>
        </div>
        <MudGrid Spacing="6" Justify="Justify.Center" Style="align-items:center;width:100%;">
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.overline" Color="Color.Primary" Style="font-weight:700;letter-spacing:2.5px;">
                    🚀 Goal Achievement for Kids
                </MudText>
                <MudText Typo="Typo.h3" Class="mt-2 mb-4" Style="line-height:1.15;font-weight:800;">
                    Set Goals.<br />
                    Track Progress.<br />
                    <span style="color:#F57C00;">Celebrate Wins! 🎉</span>
                </MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6"
                         Style="max-width:480px;line-height:1.8;font-size:1.05rem;">
                    LevelUp helps kids and caregivers set meaningful goals, track every step forward, and
                    celebrate achievements along the way.
                </MudText>
                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/login"
                               Size="Size.Large" Style="font-weight:700;min-width:130px;border-radius:12px;">
                        Log In
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Href="/register" Size="Size.Large"
                               Style="background:#F57C00;color:#fff;font-weight:700;min-width:160px;border-radius:12px;">
                        Get Started Free ✨
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Default" Href="/about" Size="Size.Small"
                               Style="align-self:center;opacity:0.8;">
                        Learn More
                    </MudButton>
                </MudStack>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-3">
                    <MudIcon Icon="@Icons.Material.Filled.PhoneAndroid" Color="Color.Success" Size="Size.Small" />
                    <MudLink Href="https://downloads.securitasmachina.org/" Target="_blank"
                             Style="font-size:0.9rem;font-weight:600;color:#388E3C;">
                        Download Android App (.apk)
                    </MudLink>
                </MudStack>
            </MudItem>
            <MudItem xs="12" md="6">
                <div class="growth-graphic">
                    <!-- Inline SVG: child growth journey illustration (enhanced) -->
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 380 310" width="380" height="310" aria-label="Child growth journey illustration" style="filter:drop-shadow(0 8px 28px rgba(57,73,171,.18));">
                        <defs>
                            <linearGradient id="skyGrad" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#E8EAF6"/>
                                <stop offset="100%" stop-color="#C5CAE9"/>
                            </linearGradient>
                            <linearGradient id="groundGrad" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#9FA8DA"/>
                                <stop offset="100%" stop-color="#7986CB"/>
                            </linearGradient>
                            <linearGradient id="step1" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#B39DDB"/>
                                <stop offset="100%" stop-color="#9575CD"/>
                            </linearGradient>
                            <linearGradient id="step2" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#7E57C2"/>
                                <stop offset="100%" stop-color="#5E35B1"/>
                            </linearGradient>
                            <linearGradient id="step3" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#5C6BC0"/>
                                <stop offset="100%" stop-color="#3949AB"/>
                            </linearGradient>
                            <linearGradient id="step4" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#3949AB"/>
                                <stop offset="100%" stop-color="#283593"/>
                            </linearGradient>
                            <filter id="starGlow" x="-40%" y="-40%" width="180%" height="180%">
                                <feGaussianBlur stdDeviation="3" result="blur"/>
                                <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
                            </filter>
                            <!-- Rainbow confetti dots for the celebration -->
                        </defs>

                        <!-- Sky background -->
                        <rect x="0" y="0" width="380" height="270" rx="16" fill="url(#skyGrad)" opacity=".4"/>

                        <!-- Ground -->
                        <rect x="0" y="268" width="380" height="42" rx="6" fill="url(#groundGrad)" opacity=".6"/>

                        <!-- Steps (staircase) with gradient fills -->
                        <rect x="28"  y="248" width="55" height="22"  rx="6" fill="url(#step1)"/>
                        <rect x="103" y="215" width="55" height="55"  rx="6" fill="url(#step2)"/>
                        <rect x="178" y="178" width="55" height="92"  rx="6" fill="url(#step3)"/>
                        <rect x="253" y="140" width="55" height="130" rx="6" fill="url(#step4)"/>

                        <!-- Step labels -->
                        <text x="55"  y="264" text-anchor="middle" font-size="9"  fill="rgba(255,255,255,0.8)" font-weight="700">Start</text>
                        <text x="130" y="264" text-anchor="middle" font-size="9"  fill="rgba(255,255,255,0.85)" font-weight="700">Learn</text>
                        <text x="205" y="264" text-anchor="middle" font-size="9"  fill="rgba(255,255,255,0.85)" font-weight="700">Grow</text>
                        <text x="280" y="264" text-anchor="middle" font-size="9"  fill="#FFD740" font-weight="700">WIN!</text>

                        <!-- Shiny star above each step -->
                        <text x="55"  y="235" text-anchor="middle" font-size="18" class="star-pop sparkle-twinkle"  filter="url(#starGlow)">⭐</text>
                        <text x="130" y="202" text-anchor="middle" font-size="20" class="star-pop sparkle-twinkle" filter="url(#starGlow)">⭐</text>
                        <text x="205" y="166" text-anchor="middle" font-size="22" class="star-pop sparkle-twinkle" filter="url(#starGlow)">⭐</text>

                        <!-- Glowing trophy at top -->
                        <text x="280" y="125" text-anchor="middle" font-size="34" class="star-pop celeb-emoji" filter="url(#starGlow)">🏆</text>

                        <!-- Kid figure (celebrating at the top) -->
                        <circle cx="280" cy="96" r="15" fill="#FFB74D" stroke="#F57C00" stroke-width="2"/>
                        <circle cx="275" cy="94" r="2.2" fill="#4E342E"/>
                        <circle cx="285" cy="94" r="2.2" fill="#4E342E"/>
                        <circle cx="276" cy="93" r="0.8" fill="white"/>
                        <circle cx="286" cy="93" r="0.8" fill="white"/>
                        <path d="M273 99 Q280 106 287 99" stroke="#E65100" stroke-width="2" fill="none" stroke-linecap="round"/>
                        <circle cx="272" cy="99" r="3.5" fill="#FFCCBC" opacity=".6"/>
                        <circle cx="288" cy="99" r="3.5" fill="#FFCCBC" opacity=".6"/>
                        <rect x="268" y="111" width="24" height="24" rx="5" fill="#5C6BC0"/>
                        <line x1="268" y1="116" x2="254" y2="102" stroke="#F57C00" stroke-width="3.5" stroke-linecap="round"/>
                        <line x1="292" y1="116" x2="306" y2="102" stroke="#F57C00" stroke-width="3.5" stroke-linecap="round"/>
                        <line x1="274" y1="135" x2="270" y2="155" stroke="#3949AB" stroke-width="4.5" stroke-linecap="round"/>
                        <line x1="286" y1="135" x2="290" y2="155" stroke="#3949AB" stroke-width="4.5" stroke-linecap="round"/>
                        <ellipse cx="268" cy="157" rx="5" ry="3" fill="#283593"/>
                        <ellipse cx="292" cy="157" rx="5" ry="3" fill="#283593"/>

                        <!-- Celebration confetti dots (float animation via CSS) -->
                        <circle cx="235" cy="68" r="4" fill="#FF5252" class="sparkle-float" opacity=".8"/>
                        <circle cx="248" cy="58" r="3" fill="#FFD740" class="sparkle-float" opacity=".8"/>
                        <circle cx="310" cy="62" r="3.5" fill="#69F0AE" class="sparkle-float" opacity=".8"/>
                        <circle cx="323" cy="75" r="2.5" fill="#40C4FF" class="sparkle-float" opacity=".8"/>
                        <circle cx="260" cy="72" r="2" fill="#FF80AB" class="sparkle-float" opacity=".7"/>
                        <circle cx="298" cy="54" r="4" fill="#FFAB40" class="sparkle-float" opacity=".75"/>

                        <!-- Ambient sparkles -->
                        <text x="18"  y="185" font-size="13" opacity=".45" class="sparkle-float">✨</text>
                        <text x="348" y="195" font-size="11" opacity=".4"  class="sparkle-float">✨</text>
                        <text x="145" y="52"  font-size="10" opacity=".35" class="sparkle-float">⭐</text>
                        <text x="328" y="72"  font-size="16" opacity=".4"  class="sparkle-twinkle">🌟</text>
                        <text x="22"  y="105" font-size="12" opacity=".3"  class="sparkle-twinkle">✦</text>
                        <text x="355" y="135" font-size="11" opacity=".35" class="sparkle-twinkle">✦</text>
                    </svg>
                </div>
                <MudGrid Spacing="2" Class="mt-3">
                    <MudItem xs="6">
                        <MudPaper Elevation="3" Class="pa-3 text-center feature-card">
                            <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Primary" Style="font-size:2rem;" />
                            <MudText Typo="Typo.subtitle2" Class="mt-1">Track Goals</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Meaningful milestones</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="6">
                        <MudPaper Elevation="3" Class="pa-3 text-center feature-card">
                            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Success" Style="font-size:2rem;" />
                            <MudText Typo="Typo.subtitle2" Class="mt-1">See Progress</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Celebrate each step</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="6">
                        <MudPaper Elevation="3" Class="pa-3 text-center feature-card">
                            <MudIcon Icon="@Icons.Material.Filled.Book" Color="Color.Info" Style="font-size:2rem;" />
                            <MudText Typo="Typo.subtitle2" Class="mt-1">Journal</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Record growth moments</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="6">
                        <MudPaper Elevation="3" Class="pa-3 text-center feature-card">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Warning" Style="font-size:2rem;" />
                            <MudText Typo="Typo.subtitle2" Class="mt-1">Manage Tasks</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Goals into action</MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudItem>
        </MudGrid>
    </div>
    return;
}

<MudPaper Elevation="2" Class="pa-4 mb-4 stat-card-goals" Style="border-radius:12px;">
    <MudGrid Spacing="3" AlignItems="AlignItems.Stretch">
        <MudItem xs="12" sm="5">
            <MudStack Spacing="1">
                <MudStack Row="true" AlignItems="AlignItems.Baseline" Spacing="1" Wrap="Wrap.Wrap">
                    <MudText Typo="Typo.h3" Color="Color.Primary" Style="font-weight:800;line-height:1;">@AllActiveGoals.Count</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Active Goal@(AllActiveGoals.Count == 1 ? "" : "s")</MudText>
                </MudStack>
                <MudText Typo="Typo.overline" Color="Color.Secondary" Style="letter-spacing:1px;">This Week</MudText>
                <MudStack Row="true" Spacing="3" Wrap="Wrap.Wrap">
                    <MudStack AlignItems="AlignItems.Center" Spacing="0">
                        <MudText Typo="Typo.h5" Color="Color.Primary" Style="font-weight:700;">@ProgressThisWeek</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">📝 Notes</MudText>
                    </MudStack>
                    <MudStack AlignItems="AlignItems.Center" Spacing="0">
                        <MudText Typo="Typo.h5" Color="Color.Info" Style="font-weight:700;">@JournalThisWeek</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">📓 Journal</MudText>
                    </MudStack>
                    <MudStack AlignItems="AlignItems.Center" Spacing="0">
                        <MudText Typo="Typo.h5" Color="Color.Success" Style="font-weight:700;">@TodosCompletedThisWeek</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">✅ Todos done</MudText>
                    </MudStack>
                </MudStack>
                <MudDivider Class="my-1" />
            @if (CompletedGoals.Count > 0)
            {
                var yearStartMs = new DateTimeOffset(new DateTime(DateTime.Today.Year, 1, 1), TimeZoneInfo.Local.GetUtcOffset(DateTime.Now)).ToUnixTimeMilliseconds();
                var weekAgoForGoalsMs = DateTimeOffset.UtcNow.AddDays(-7).ToUnixTimeMilliseconds();
                var completedThisYear = CompletedGoals.Count(g => g.CompletionDate.HasValue && g.CompletionDate.Value >= yearStartMs);
                var completedThisWeekGoals = CompletedGoals.Count(g => g.CompletionDate.HasValue && g.CompletionDate.Value >= weekAgoForGoalsMs);
                if (completedThisWeekGoals > 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Success">🎉 @completedThisWeekGoals goal@(completedThisWeekGoals == 1 ? "" : "s") completed this week!</MudText>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Success">✅ @CompletedGoals.Count completed</MudText>
                }
                if (completedThisYear > 0 && completedThisWeekGoals == 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Success">🏆 @completedThisYear completed this year!</MudText>
                }
                var totalGoalsEver = AllActiveGoals.Count + CompletedGoals.Count;
                if (totalGoalsEver >= 10)
                {
                    <MudText Typo="Typo.caption" Color="Color.Info">📚 @totalGoalsEver goals set on your journey!</MudText>
                }
            }
            @if (AllActiveGoals.Count >= 5)
            {
                var acLabel = AllActiveGoals.Count >= 10 ? "🌟 Seriously ambitious!" : AllActiveGoals.Count >= 7 ? "🚀 Very ambitious!" : "💪 Ambitious!";
                <MudText Typo="Typo.caption" Color="Color.Primary">@acLabel</MudText>
            }
            @if (GoalStreaks.Count > 0)
            {
                <MudText Typo="Typo.caption" Color="Color.Warning">🔥 @GoalStreaks.Count on a streak</MudText>
            }
            @if (TotalProgressNotes > 0)
            {
                var estHours = TotalProgressNotes * 5 / 60;
                var estMins = TotalProgressNotes * 5 % 60;
                <MudText Typo="Typo.caption" Color="Color.Primary">📝 @TotalProgressNotes total progress note@(TotalProgressNotes == 1 ? "" : "s")</MudText>
                var oTierEmoji = TotalProgressNotes >= 500 ? "🌟" : TotalProgressNotes >= 200 ? "🏆" : TotalProgressNotes >= 100 ? "💎" : TotalProgressNotes >= 50 ? "⭐" : TotalProgressNotes >= 20 ? "🚀" : TotalProgressNotes >= 5 ? "🌱" : null;
                var oTierLabel = TotalProgressNotes >= 500 ? "Legend" : TotalProgressNotes >= 200 ? "Master" : TotalProgressNotes >= 100 ? "Expert" : TotalProgressNotes >= 50 ? "Skilled" : TotalProgressNotes >= 20 ? "Apprentice" : TotalProgressNotes >= 5 ? "Beginner" : null;
                var oTierColor = TotalProgressNotes >= 200 ? Color.Warning : TotalProgressNotes >= 50 ? Color.Success : Color.Primary;
                if (oTierEmoji is not null)
                {
                    <MudChip T="string" Color="@oTierColor" Size="Size.Small" Style="font-size:0.72rem;height:22px;">@oTierEmoji @oTierLabel</MudChip>
                }
                if (estHours >= 1)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">⏱️ ~@estHours hr@(estHours == 1 ? "" : "s") invested in your goals</MudText>
                }
                else if (TotalProgressNotes >= 3)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">⏱️ ~@estMins min invested so far — keep going!</MudText>
                }
            }
            @if (AllActiveGoals.Count >= 2)
            {
                var totalNotesAll = AllActiveGoals.Sum(g => ProgressCounts.GetValueOrDefault(g.Guid));
                var avgNotesPerGoal = (double)totalNotesAll / AllActiveGoals.Count;
                <MudText Typo="Typo.caption" Color="Color.Secondary">avg @avgNotesPerGoal.ToString("F1") notes/goal</MudText>
                var deepestCount = ProgressCounts.Count > 0 ? ProgressCounts.Values.Max() : 0;
                if (deepestCount >= 10)
                {
                    <MudText Typo="Typo.caption" Color="Color.Info">⭐ Deepest goal: @deepestCount notes!</MudText>
                }
            }
            @{
                var stale14Ms = DateTimeOffset.UtcNow.AddDays(-14).ToUnixTimeMilliseconds();
                var staleCount = AllActiveGoals.Count(g => !LastProgressAt.TryGetValue(g.Guid, out var lp) || lp < stale14Ms);
            }
            @if (staleCount > 0)
            {
                <MudText Typo="Typo.caption" Color="Color.Warning">⏰ @staleCount awaiting your visit</MudText>
            }
            @if (AllActiveGoals.Count >= 2 && GoalsProgressedThisWeek > 0)
            {
                <MudText Typo="Typo.caption" Color="@(GoalsProgressedThisWeek >= AllActiveGoals.Count ? Color.Success : Color.Info)">
                    📊 @GoalsProgressedThisWeek of @AllActiveGoals.Count goals worked this week
                </MudText>
            }
            @{
                var nowMsMtgs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
                var mtgsThisWeek = AllActiveGoals.Count(g => g.NextMeetingDate.HasValue
                    && g.NextMeetingDate.Value > nowMsMtgs
                    && (DateTimeOffset.FromUnixTimeMilliseconds(g.NextMeetingDate.Value).LocalDateTime.Date - DateTime.Today).Days <= 7);
            }
            @if (mtgsThisWeek > 0)
            {
                <MudText Typo="Typo.caption" Color="Color.Info">
                    📅 @mtgsThisWeek meeting@(mtgsThisWeek == 1 ? "" : "s") this week
                </MudText>
            }
            @if (ProgressNotesToday > 0)
            {
                <MudText Typo="Typo.caption" Color="@(ProgressNotesToday >= 3 ? Color.Warning : Color.Success)">
                    🔥 @ProgressNotesToday note@(ProgressNotesToday == 1 ? "" : "s") logged today!
                </MudText>
            }
            @if (DailyProgressStreak >= 2)
            {
                var dsLabel = DailyProgressStreak >= 14 ? $"🌟 {DailyProgressStreak}-day daily streak!"
                            : DailyProgressStreak >= 7  ? $"🔥 {DailyProgressStreak}-day daily streak!"
                            :                              $"⭐ {DailyProgressStreak}-day daily streak!";
                <MudText Typo="Typo.caption" Color="@(DailyProgressStreak >= 7 ? Color.Warning : Color.Success)">@dsLabel</MudText>
            }
            @if (BiggestDayDate is not null)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">🏅 Best day: @BiggestDayCount notes on @BiggestDayDate</MudText>
            }
            @{
                var gcmLocalNow = DateTimeOffset.Now.LocalDateTime;
                var gcmMonthStartMs = new DateTimeOffset(new DateTime(gcmLocalNow.Year, gcmLocalNow.Month, 1), TimeZoneInfo.Local.GetUtcOffset(DateTime.Now)).ToUnixTimeMilliseconds();
                var goalsThisMonth = AllActiveGoals.Count(g => g.EnteredDate >= gcmMonthStartMs)
                    + CompletedGoals.Count(g => g.EnteredDate >= gcmMonthStartMs);
            }
            @if (goalsThisMonth > 0)
            {
                <MudText Typo="Typo.caption" Color="Color.Success">
                    🆕 @goalsThisMonth new goal@(goalsThisMonth == 1 ? "" : "s") this month
                </MudText>
            }
            @if (AllActiveGoals.Count >= 3)
            {
                var portNowMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
                var portHot   = AllActiveGoals.Count(g => LastProgressAt.TryGetValue(g.Guid, out var pa) && pa >= portNowMs - 86_400_000L);
                var portCold  = AllActiveGoals.Count(g => !LastProgressAt.TryGetValue(g.Guid, out var pa2) || pa2 < portNowMs - 13L * 86_400_000L);
                var portWarm  = AllActiveGoals.Count - portHot - portCold;
                @if (portHot > 0 || portCold > 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @(portHot > 0 ? $"🔥{portHot} hot " : "")@(portWarm > 0 ? $"🟡{portWarm} warm " : "")@(portCold > 0 ? $"❄️{portCold} cold" : "")
                    </MudText>
                }
            }
            @{
                var goalsWithNextStep = AllActiveGoals.Count(g => LatestNextStep.ContainsKey(g.Guid));
            }
            @if (goalsWithNextStep > 0)
            {
                <MudText Typo="Typo.caption" Color="Color.Primary">
                    📌 @goalsWithNextStep goal@(goalsWithNextStep == 1 ? "" : "s") with a next step ready
                </MudText>
            }
            @if (TotalProgressNotes >= 5 || CompletedGoals.Count >= 1)
            {
                <MudLink Href="/insights" Typo="Typo.caption" Color="Color.Primary" Class="mt-1">
                    <MudIcon Icon="@Icons.Material.Filled.BarChart" Size="Size.Small" Style="vertical-align:middle;margin-right:2px;"/>View full insights →
                </MudLink>
            }
            </MudStack>
        </MudItem>
        <MudItem xs="12" sm="7">
            @if (WeeklyProgressSeries.Count > 0)
            {
                <MudText Typo="Typo.overline" Color="Color.Secondary" Style="letter-spacing:1px;" Class="mb-1">8-Week Activity</MudText>
                <MudChart ChartType="ChartType.Bar"
                          ChartSeries="@WeeklyProgressSeries"
                          XAxisLabels="@WeeklyProgressLabels"
                          Width="100%" Height="130px"
                          ChartOptions="@(new ChartOptions { YAxisTicks = 1, ShowLegend = true })" />
            }
            @{
                var dueChipNowMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
                var dueByDay = AllActiveGoals
                    .Where(g => g.ExpirationDate.HasValue && g.CompletionDate == null)
                    .Select(g => new { Goal = g, DaysLeft = (int)Math.Ceiling((g.ExpirationDate!.Value - dueChipNowMs) / 86_400_000.0) })
                    .Where(x => x.DaysLeft >= 0 && x.DaysLeft <= 7)
                    .GroupBy(x => x.DaysLeft)
                    .OrderBy(g => g.Key)
                    .ToList();
            }
            @if (dueByDay.Count > 0)
            {
                <MudText Typo="Typo.overline" Color="Color.Warning" Style="letter-spacing:1px;" Class="mt-2 mb-1">
                    Due Within 7 Days (@dueByDay.Sum(g => g.Count()))
                </MudText>
                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                    @foreach (var dg in dueByDay)
                    {
                        var dayLabel = dg.Key == 0 ? "today" : dg.Key == 1 ? "tomorrow" : $"in {dg.Key}d";
                        var chipNames = string.Join(", ", dg.Select(x => x.Goal.GoalText?.Length > 25 ? x.Goal.GoalText[..25] + "…" : x.Goal.GoalText));
                        var firstGuid = dg.First().Goal.Guid;
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined"
                                 Href="@($"/goals/{firstGuid}")" Style="font-size:0.7rem;height:26px;">
                            ⏰ @dayLabel — @chipNames
                        </MudChip>
                    }
                </MudStack>
            }
            @{
                var naStaleMs2 = DateTimeOffset.UtcNow.AddDays(-14).ToUnixTimeMilliseconds();
                var staleGoalsCard = AllActiveGoals
                    .Where(g => ProgressCounts.GetValueOrDefault(g.Guid) >= 1
                             && (!LastProgressAt.TryGetValue(g.Guid, out var sgLp) || sgLp < naStaleMs2))
                    .Select(g => new {
                        Goal = g,
                        DaysSince = (int)((DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()
                            - (LastProgressAt.TryGetValue(g.Guid, out var sgLp2) ? sgLp2 : g.EnteredDate)) / 86_400_000L)
                    })
                    .OrderByDescending(x => x.DaysSince)
                    .Take(5)
                    .ToList();
            }
            @if (staleGoalsCard.Count > 0)
            {
                <MudExpansionPanels Class="mt-2" Elevation="0">
                    <MudExpansionPanel>
                        <TitleContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.NotificationImportant" Color="Color.Warning" Size="Size.Small" />
                                <MudText Typo="Typo.body2" Color="Color.Warning" Style="font-weight:600;">
                                    Goals needing attention (@staleGoalsCard.Count)
                                </MudText>
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            @foreach (var na in staleGoalsCard)
                            {
                                var naName2 = na.Goal.GoalText?.Length > 50 ? na.Goal.GoalText[..50] + "…" : na.Goal.GoalText;
                                LatestNextStep.TryGetValue(na.Goal.Guid, out var naNextStep2);
                                var naNext2 = naNextStep2?.Length > 60 ? naNextStep2[..60] + "…" : naNextStep2;
                                <MudStack Spacing="0" Class="mb-2">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudText Typo="Typo.body2" Style="flex:1;font-weight:500;">@naName2</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@na.DaysSince d ago</MudText>
                                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning"
                                                   Href="@($"/goals/{na.Goal.Guid}")">Note</MudButton>
                                    </MudStack>
                                    @if (!string.IsNullOrWhiteSpace(naNext2))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-style:italic;">→ @naNext2</MudText>
                                    }
                                </MudStack>
                            }
                        </ChildContent>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
        </MudItem>
    </MudGrid>
</MudPaper>

<MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="mb-4" AlignItems="AlignItems.Center">
    <MudButton Href="/todos" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.CheckBox"
               Color="@(OverdueTodoCount > 0 ? Color.Error : Color.Default)" Size="Size.Small" Style="border-radius:20px;">
        @if (OverdueTodoCount > 0)
        {
            @($"{PendingTodoCount} todos · {OverdueTodoCount} overdue")
        }
        else
        {
            @($"{PendingTodoCount} todo{(PendingTodoCount == 1 ? "" : "s")} pending")
        }
    </MudButton>
    <MudButton Href="/journal" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Book"
               Color="Color.Default" Size="Size.Small" Style="border-radius:20px;">
        @if (JournalThisWeek > 0)
        {
            @($"{JournalThisWeek} journal entr{(JournalThisWeek == 1 ? "y" : "ies")} this week")
        }
        else
        {
            <span>Write a journal entry</span>
        }
    </MudButton>
</MudStack>


@{
    var wcWeek = System.Globalization.ISOWeek.GetWeekOfYear(DateTime.Today);
    var (wcEmoji, wcTitle, wcDesc, wcTarget, wcCurrent) = (wcWeek % 4) switch
    {
        0 => ("📝", "Note Sprint", "Add 5 progress notes across any goals", 5, ProgressThisWeek),
        1 => ("📓", "Journal Week", "Write 3 journal entries this week", 3, JournalThisWeek),
        2 => ("✅", "Todo Blitz", "Complete 5 todos this week", 5, TodosCompletedThisWeek),
        _ => ("🎯", "Goal Explorer", "Work on 3 different goals this week", 3, GoalsProgressedThisWeek),
    };
    var wcPct = Math.Min((int)(wcCurrent * 100.0 / wcTarget), 100);
    var wcDone = wcCurrent >= wcTarget;
    var wcActionHref = (wcWeek % 4) switch { 1 => "/journal", 2 => "/todos", _ => "/" };
    var wcActionLabel = (wcWeek % 4) switch { 1 => "Write journal entry", 2 => "View todos", _ => "Add a progress note" };
}
@if (AllActiveGoals.Count > 0 && string.IsNullOrWhiteSpace(FilterText))
{
    <MudPaper Elevation="2" Class="pa-3 mb-4" Style="border-radius:14px;background:linear-gradient(135deg,rgba(57,73,171,.08) 0%,rgba(255,193,7,.06) 100%);border:1.5px solid var(--mud-palette-primary);">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2">
            <MudText Style="font-size:1.2rem;line-height:1;">@wcEmoji</MudText>
            <MudText Typo="Typo.overline" Color="Color.Primary" Style="font-weight:700;letter-spacing:1px;flex:1;">Weekly Challenge</MudText>
            @if (wcDone)
            {
                <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle">Complete! 🎉</MudChip>
            }
            else
            {
                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined">@wcCurrent / @wcTarget</MudChip>
            }
        </MudStack>
        <MudText Typo="Typo.subtitle2" Color="Color.Primary" Style="font-weight:700;" Class="mb-1">@wcTitle</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">@wcDesc</MudText>
        <MudProgressLinear Value="@wcPct" Color="@(wcDone ? Color.Success : Color.Primary)" Rounded="true" Size="Size.Medium" />
        @if (wcDone)
        {
            <MudText Typo="Typo.caption" Color="Color.Success" Class="mt-1">🌟 Challenge complete — you crushed it this week!</MudText>
        }
        else
        {
            var wcLeft = wcTarget - wcCurrent;
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-2">
                @if (wcCurrent > 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Primary" Style="flex:1;">@wcLeft more to go — you can do this! 💪</MudText>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="flex:1;">Start now and build momentum!</MudText>
                }
                <MudButton Href="@wcActionHref" Variant="Variant.Filled" Color="Color.Primary"
                           Size="Size.Small" Style="border-radius:20px;white-space:nowrap;">@wcActionLabel →</MudButton>
            </MudStack>
        }
    </MudPaper>
}

@if ((CompletedGoals.Count >= 1 || TotalProgressNotes >= 5) && string.IsNullOrWhiteSpace(FilterText))
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Class="mb-2">
