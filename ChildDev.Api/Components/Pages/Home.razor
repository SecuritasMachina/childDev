@{
    var mcNowMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
    Goal? mcBestGoal = null;
    double mcBestRate = 0;
    if (AllActiveGoals.Count >= 2 && string.IsNullOrWhiteSpace(FilterText))
    {
        foreach (var mcG in AllActiveGoals)
        {
            var mcCount = ProgressCounts.GetValueOrDefault(mcG.Guid);
            var mcWeeks = Math.Max((mcNowMs - mcG.EnteredDate) / (7.0 * 86_400_000.0), 1.0);
            var mcRate = mcCount / mcWeeks;
            if (mcRate > mcBestRate) { mcBestRate = mcRate; mcBestGoal = mcG; }
        }
        if (mcBestRate < 1.0) mcBestGoal = null;
    }
}
@if (mcBestGoal is not null)
