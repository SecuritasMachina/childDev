                       Href="@($"/goals/{NextMeetingGoalGuid}")" Class="ml-1">View goal</MudButton>
        }
    </MudAlert>
}
@{
    var burstTodayMs = new DateTimeOffset(DateTime.SpecifyKind(DateTime.Today, DateTimeKind.Local)).ToUnixTimeMilliseconds();
    var allGoalsActiveToday = AllActiveGoals.Count >= 2 &&
        AllActiveGoals.All(g => LastProgressAt.TryGetValue(g.Guid, out var lat) && lat >= burstTodayMs);
}
@if (allGoalsActiveToday && string.IsNullOrWhiteSpace(FilterText))
{
    <MudPaper Elevation="3" Class="pa-4 mb-4" Style="border-radius:16px;background:linear-gradient(135deg,#FF8F00,#F57C00);color:#fff;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h5" Style="line-height:1;">🎊</MudText>
            <MudStack Spacing="0">
                <MudText Typo="Typo.subtitle1" Style="font-weight:700;color:#fff;">ALL GOALS ACTIVE TODAY!</MudText>
                <MudText Typo="Typo.body2" Style="color:rgba(255,255,255,.9);">
                    You logged progress on every single goal today — that is LEGENDARY dedication! 🌟
                </MudText>
            </MudStack>
        </MudStack>
    </MudPaper>
}

@{
    // Single "Today's Focus" card — one goal, one message, one action
    var focusTodayMs = new DateTimeOffset(DateTime.SpecifyKind(DateTime.Today, DateTimeKind.Local)).ToUnixTimeMilliseconds();
    Goal? focusCardGoal = null;
    string? focusCardMsg = null;
    string? focusCardBtn = null;
    if (!allGoalsActiveToday && string.IsNullOrWhiteSpace(FilterText) && AllActiveGoals.Count >= 1)
    {
        var fcNowMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        // Priority 1: goal with no notes at all
        var zng = AllActiveGoals.FirstOrDefault(g => ProgressCounts.GetValueOrDefault(g.Guid) == 0);
        if (zng is not null)
        {
            focusCardGoal = zng;
            var znDays = (int)((fcNowMs - zng.EnteredDate) / 86_400_000L);
            focusCardMsg = znDays == 0 ? "New today — your first note starts the momentum."
                         : znDays == 1 ? "Added yesterday — ready for your first progress note?"
                         : "No notes yet — one note changes everything.";
            focusCardBtn = "Add first note →";
        }
        else
        {
            // Priority 2: goal not touched today, rotating daily tip
            var ug = AllActiveGoals.FirstOrDefault(g => !LastProgressAt.TryGetValue(g.Guid, out var fgLat) || fgLat < focusTodayMs);
            if (ug is not null)
            {
                focusCardGoal = ug;
                var tips = new[] {
                    "What's the next step that would move this forward the most?",
                    "What went well recently? What's still in the way?",
                    "One small action today keeps the momentum going.",
                    "What would make this week a win for this goal?",
                    "Picture where you'll be when this is done — feel it!",
                };
                var dayKey = DateTime.Today.DayOfYear + DateTime.Today.Year * 366;
                focusCardMsg = tips[dayKey % tips.Length];
                focusCardBtn = "Add a note →";
            }
        }
    }
}
@if (focusCardGoal is not null)
{
    var fcName = focusCardGoal.GoalText?.Length > 60 ? focusCardGoal.GoalText[..60] + "…" : focusCardGoal.GoalText;
    <MudPaper Elevation="1" Class="pa-3 mb-3" Style="border-radius:12px;border-left:3px solid var(--mud-palette-primary);">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
            <MudStack Spacing="0" Style="flex:1;min-width:0;">
                <MudText Typo="Typo.overline" Color="Color.Primary" Style="font-weight:700;letter-spacing:1px;">Today's Focus</MudText>
                <MudText Typo="Typo.body2" Style="font-weight:600;">@fcName</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@focusCardMsg</MudText>
            </MudStack>
            <MudButton Href="@($"/goals/{focusCardGoal.Guid}")" Variant="Variant.Outlined" Color="Color.Primary"
                       Size="Size.Small" Style="white-space:nowrap;">@focusCardBtn</MudButton>
        </MudStack>
    </MudPaper>
}
<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap" Spacing="1">
    <MudText Typo="Typo.h5">
        <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Class="mr-2" />
        My Goals
    </MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenAddGoalDialog" Style="border-radius:20px;font-weight:600;">
        Add Goal
    </MudButton>
    <MudSpacer />
    <MudSelect T="string" Value="@GoalSortOrder" Variant="Variant.Outlined" Margin="Margin.Dense"
               Label="Sort" Style="max-width:170px;" Dense="true"
               AdornmentIcon="@Icons.Material.Filled.Sort" Adornment="Adornment.Start"
               ValueChanged="@((string v) => { GoalSortOrder = v; ApplyFilter(); _ = Analytics.TrackAsync("goal_sort", AccountGuid, "home", v); })">
        <MudSelectItem T="string" Value="@("attention")">Needs Attention</MudSelectItem>
        <MudSelectItem T="string" Value="@("most_active")">Most Active</MudSelectItem>
        <MudSelectItem T="string" Value="@("due_date")">Due Date</MudSelectItem>
        <MudSelectItem T="string" Value="@("newest")">Newest First</MudSelectItem>
        <MudSelectItem T="string" Value="@("alpha")">A → Z</MudSelectItem>
    </MudSelect>
    <MudTextField Value="@FilterText" ValueChanged="@((string v) => OnFilterChanged(v))"
                  Placeholder="Search goals…" Variant="Variant.Outlined"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                  Clearable="true" Margin="Margin.Dense" Style="max-width:220px;" />
    <MudTooltip Text="@(_compactGoalView ? "Switch to card view" : "Switch to compact list view")">
        <MudIconButton Icon="@(_compactGoalView ? Icons.Material.Filled.ViewModule : Icons.Material.Filled.ViewList)"
                       Color="@(_compactGoalView ? Color.Primary : Color.Default)"
                       Size="Size.Small"
                       OnClick="ToggleCompactView"
                       aria-label="Toggle compact view" />
    </MudTooltip>
</MudStack>
@{
    var qfNowMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
    var qfMtg7Ms = qfNowMs + 7L * 86_400_000L;
    var meetingSoonCount = AllActiveGoals.Count(g => g.NextMeetingDate.HasValue && g.NextMeetingDate.Value > qfNowMs && g.NextMeetingDate.Value <= qfMtg7Ms);
}
<MudStack Row="true" Spacing="1" Class="mb-3" Wrap="Wrap.Wrap">
    <MudChip T="string" Size="Size.Small" Variant="@(QuickFilter == "all" ? Variant.Filled : Variant.Outlined)"
             Color="Color.Primary" OnClick='() => SetQuickFilter("all")'>All</MudChip>
    <MudChip T="string" Size="Size.Small" Variant="@(QuickFilter == "attention" ? Variant.Filled : Variant.Outlined)"
             Color="Color.Warning" OnClick='() => SetQuickFilter("attention")'
             Icon="@Icons.Material.Filled.AccessTime">Needs Attention</MudChip>
    <MudChip T="string" Size="Size.Small" Variant="@(QuickFilter == "streak" ? Variant.Filled : Variant.Outlined)"
             Color="Color.Error" OnClick='() => SetQuickFilter("streak")'
             Icon="@Icons.Material.Filled.LocalFireDepartment">On a Streak 🔥</MudChip>
    @if (meetingSoonCount > 0)
    {
        <MudChip T="string" Size="Size.Small" Variant="@(QuickFilter == "meeting" ? Variant.Filled : Variant.Outlined)"
                 Color="Color.Info" OnClick='() => SetQuickFilter("meeting")'
                 Icon="@Icons.Material.Filled.Event">Meeting Soon (@meetingSoonCount)</MudChip>
    }
    @foreach (var cat in new[] { "Academic", "Health", "Social", "Creative", "Hobby", "Other" })
    {
        var catCount = AllActiveGoals.Count(g => g.Category == cat);
        if (catCount > 0)
        {
            var filterKey = $"cat:{cat}";
            <MudChip T="string" Size="Size.Small" Variant="@(QuickFilter == filterKey ? Variant.Filled : Variant.Outlined)"
                     Color="Color.Secondary" OnClick="() => SetQuickFilter(filterKey)">@cat (@catCount)</MudChip>
        }
    }
</MudStack>

@if (!string.IsNullOrWhiteSpace(FilterText) && ActiveGoals.Count == 0)
{
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">No goals matching "@FilterText".</MudText>
}

@{
    var dueSoonNowMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
    var dueSoonTodayStart = new DateTimeOffset(DateTime.SpecifyKind(DateTime.Today, DateTimeKind.Local)).ToUnixTimeMilliseconds();
    var dueSoon7Ms = dueSoonTodayStart + 7L * 86_400_000L;
    var dueSoonGoals = AllActiveGoals
        .Where(g => g.ExpirationDate.HasValue && g.ExpirationDate.Value >= dueSoonNowMs && g.ExpirationDate.Value < dueSoon7Ms)
        .OrderBy(g => g.ExpirationDate)
        .ToList();
}
@if (dueSoonGoals.Any() && string.IsNullOrWhiteSpace(FilterText) && QuickFilter == "all")
{
    <MudPaper Elevation="2" Class="pa-3 mb-4"
              Style="border-radius:12px;border-left:4px solid var(--mud-palette-warning);background:linear-gradient(135deg,rgba(255,152,0,.06) 0%,rgba(255,255,255,0) 100%);">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Spacing="1">
            <MudIcon Icon="@Icons.Material.Filled.Alarm" Color="Color.Warning" Size="Size.Small" />
            <MudText Typo="Typo.overline" Color="Color.Warning" Style="font-weight:700;letter-spacing:1px;">
                Due Within 7 Days (@dueSoonGoals.Count)
            </MudText>
        </MudStack>
        @foreach (var ds in dueSoonGoals)
        {
            var expDate = DateTimeOffset.FromUnixTimeMilliseconds(ds.ExpirationDate!.Value).LocalDateTime.Date;
            var daysLeft = (expDate - DateTime.Today).Days;
            var daysLabel = daysLeft == 0 ? "Due today!" : daysLeft == 1 ? "Due tomorrow" : $"Due in {daysLeft} days";
            var labelColor = daysLeft <= 1 ? "color:var(--mud-palette-error)" : "color:var(--mud-palette-warning-darken)";
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1" Spacing="2">
                <MudText Typo="Typo.body2" Style="flex:1">@ds.GoalText</MudText>
                <MudText Typo="Typo.caption" Style="@labelColor">@daysLabel</MudText>
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning"
                           Href="@($"/goals/{ds.Guid}")">Open</MudButton>
            </MudStack>
        }
    </MudPaper>
}

@if (!AllActiveGoals.Any() && string.IsNullOrWhiteSpace(FilterText))
{
    @if (CompletedGoals.Count == 0)
    {
        @* First-time user onboarding *@
        <MudPaper Elevation="3" Class="pa-6 mb-6 text-center" Style="border-radius:24px;background:linear-gradient(135deg,rgba(57,73,171,.08) 0%,rgba(255,143,0,.06) 100%);">
            <MudText Typo="Typo.h2" Style="font-size:3rem;">🎯</MudText>
            <MudText Typo="Typo.h5" Color="Color.Primary" Class="mt-2 mb-1">Welcome! Let's set your first goal.</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4" Style="max-width:480px;margin:0 auto;">
