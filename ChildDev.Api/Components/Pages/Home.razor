    {
        ShowCelebration = false;
        var reflection = CelebrationReflection.Trim();
        if (!string.IsNullOrWhiteSpace(reflection) && _celebratingGoalGuid is not null && AccountGuid is not null)
        {
            var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
            Db.GoalProgresses.Add(new GoalProgress
            {
                Guid = System.Guid.NewGuid().ToString(),
                AccountFk = AccountGuid,
                GoalFk = _celebratingGoalGuid,
                NextStepItems = $"🏆 Reflection: {reflection}",
                UpdatedOn = now
            });
            await Db.SaveChangesAsync();
            await Analytics.TrackAsync("goal_reflection", AccountGuid, "home", _celebratingGoalGuid);
        }
        _celebratingGoalGuid = null;
        CelebrationReflection = string.Empty;
        if (openNewGoal) OpenAddGoalDialog();
    }

