}

<MudGrid Class="mb-6">
    <MudItem xs="12" sm="4">
        <MudPaper Elevation="2" Class="pa-4 text-center stat-card-goals" Style="cursor:default;border-radius:12px;">
            <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Primary" Style="font-size:2rem;" />
            <MudText Typo="Typo.h4" Class="mt-1">@AllActiveGoals.Count</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Active Goal@(AllActiveGoals.Count == 1 ? "" : "s")</MudText>
            @if (CompletedGoals.Count > 0)
            {
                var yearStartMs = new DateTimeOffset(new DateTime(DateTime.Today.Year, 1, 1), TimeZoneInfo.Local.GetUtcOffset(DateTime.Now)).ToUnixTimeMilliseconds();
                var completedThisYear = CompletedGoals.Count(g => g.CompletionDate.HasValue && g.CompletionDate.Value >= yearStartMs);
                <MudText Typo="Typo.caption" Color="Color.Success">✅ @CompletedGoals.Count completed</MudText>
                if (completedThisYear > 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Success">🏆 @completedThisYear completed this year!</MudText>
                }
            }
            @if (GoalStreaks.Count > 0)
            {
                <MudText Typo="Typo.caption" Color="Color.Warning">🔥 @GoalStreaks.Count on a streak</MudText>
            }
            @if (TotalProgressNotes > 0)
            {
                var estHours = TotalProgressNotes * 5 / 60;
                var estMins = TotalProgressNotes * 5 % 60;
                <MudText Typo="Typo.caption" Color="Color.Primary">📝 @TotalProgressNotes total progress note@(TotalProgressNotes == 1 ? "" : "s")</MudText>
                if (estHours >= 1)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">⏱️ ~@estHours hr@(estHours == 1 ? "" : "s") invested in your goals</MudText>
                }
                else if (TotalProgressNotes >= 3)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">⏱️ ~@estMins min invested so far — keep going!</MudText>
                }
            }
            @if (AllActiveGoals.Count >= 2)
            {
                var totalNotesAll = AllActiveGoals.Sum(g => ProgressCounts.GetValueOrDefault(g.Guid));
                var avgNotesPerGoal = (double)totalNotesAll / AllActiveGoals.Count;
                <MudText Typo="Typo.caption" Color="Color.Secondary">avg @avgNotesPerGoal.ToString("F1") notes/goal</MudText>
            }
            @{
                var stale14Ms = DateTimeOffset.UtcNow.AddDays(-14).ToUnixTimeMilliseconds();
                var staleCount = AllActiveGoals.Count(g => !LastProgressAt.TryGetValue(g.Guid, out var lp) || lp < stale14Ms);
            }
            @if (staleCount > 0)
            {
                <MudText Typo="Typo.caption" Color="Color.Warning">⏰ @staleCount awaiting your visit</MudText>
            }
            @if (AllActiveGoals.Count >= 2 && GoalsProgressedThisWeek > 0)
            {
                <MudText Typo="Typo.caption" Color="@(GoalsProgressedThisWeek >= AllActiveGoals.Count ? Color.Success : Color.Info)">
                    📊 @GoalsProgressedThisWeek of @AllActiveGoals.Count goals worked this week
                </MudText>
            }
            @{
                var nowMsMtgs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
                var mtgsThisWeek = AllActiveGoals.Count(g => g.NextMeetingDate.HasValue
                    && g.NextMeetingDate.Value > nowMsMtgs
                    && (DateTimeOffset.FromUnixTimeMilliseconds(g.NextMeetingDate.Value).LocalDateTime.Date - DateTime.Today).Days <= 7);
            }
            @if (mtgsThisWeek > 0)
            {
                <MudText Typo="Typo.caption" Color="Color.Info">
                    📅 @mtgsThisWeek meeting@(mtgsThisWeek == 1 ? "" : "s") this week
                </MudText>
            }
            @if (ProgressNotesToday > 0)
            {
                <MudText Typo="Typo.caption" Color="@(ProgressNotesToday >= 3 ? Color.Warning : Color.Success)">
                    🔥 @ProgressNotesToday note@(ProgressNotesToday == 1 ? "" : "s") logged today!
                </MudText>
            }
            @{
                var gcmLocalNow = DateTimeOffset.Now.LocalDateTime;
                var gcmMonthStartMs = new DateTimeOffset(new DateTime(gcmLocalNow.Year, gcmLocalNow.Month, 1), TimeZoneInfo.Local.GetUtcOffset(DateTime.Now)).ToUnixTimeMilliseconds();
                var goalsThisMonth = AllActiveGoals.Count(g => g.EnteredDate >= gcmMonthStartMs)
                    + CompletedGoals.Count(g => g.EnteredDate >= gcmMonthStartMs);
            }
            @if (goalsThisMonth > 0)
            {
                <MudText Typo="Typo.caption" Color="Color.Success">
                    🆕 @goalsThisMonth new goal@(goalsThisMonth == 1 ? "" : "s") this month
                </MudText>
            }
            @if (AllActiveGoals.Count >= 3)
            {
                var portNowMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
                var portHot   = AllActiveGoals.Count(g => LastProgressAt.TryGetValue(g.Guid, out var pa) && pa >= portNowMs - 86_400_000L);
                var portCold  = AllActiveGoals.Count(g => !LastProgressAt.TryGetValue(g.Guid, out var pa2) || pa2 < portNowMs - 13L * 86_400_000L);
                var portWarm  = AllActiveGoals.Count - portHot - portCold;
                @if (portHot > 0 || portCold > 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @(portHot > 0 ? $"🔥{portHot} hot " : "")@(portWarm > 0 ? $"🟡{portWarm} warm " : "")@(portCold > 0 ? $"❄️{portCold} cold" : "")
                    </MudText>
                }
            }
            @{
                var goalsWithNextStep = AllActiveGoals.Count(g => LatestNextStep.ContainsKey(g.Guid));
            }
            @if (goalsWithNextStep > 0)
            {
                <MudText Typo="Typo.caption" Color="Color.Primary">
                    📌 @goalsWithNextStep goal@(goalsWithNextStep == 1 ? "" : "s") with a next step ready
                </MudText>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudLink Href="/todos" Underline="Underline.None" Style="display:block;">
            <MudPaper Elevation="2" Class="pa-4 text-center stat-card-todos" Style="cursor:pointer;border-radius:12px;">
                <MudIcon Icon="@Icons.Material.Filled.CheckBox" Color="@(OverdueTodoCount > 0 ? Color.Error : Color.Primary)" Style="font-size:2rem;" />
                <MudText Typo="Typo.h4" Class="mt-1">
                    @PendingTodoCount
                    @if (OverdueTodoCount > 0)
                    {
                        <MudChip T="string" Color="Color.Error" Size="Size.Small" Class="ml-1">@OverdueTodoCount overdue</MudChip>
                    }
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Pending Todo@(PendingTodoCount == 1 ? "" : "s")</MudText>
            </MudPaper>
        </MudLink>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudLink Href="/journal" Underline="Underline.None" Style="display:block;">
            <MudPaper Elevation="2" Class="pa-4 text-center stat-card-journal" Style="cursor:pointer;border-radius:12px;">
                <MudIcon Icon="@Icons.Material.Filled.Book" Color="Color.Primary" Style="font-size:2rem;" />
                <MudText Typo="Typo.h4" Class="mt-1">@JournalThisWeek</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Journal Entr@(JournalThisWeek == 1 ? "y" : "ies") This Week</MudText>
                @if (TodosCompletedThisWeek > 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Success">✅ @TodosCompletedThisWeek quick win@(TodosCompletedThisWeek == 1 ? "" : "s") this week</MudText>
                }
            </MudPaper>
        </MudLink>
    </MudItem>
</MudGrid>

@if ((YtdProgressNotes >= 5 || YtdGoalsCompleted >= 1) && string.IsNullOrWhiteSpace(FilterText))
{
    var yearLabel = $"{DateTime.Today.Year}";
    var ytdMsg = YtdGoalsCompleted >= 1 && YtdProgressNotes >= 1
        ? $"📅 {yearLabel} so far: {YtdProgressNotes} progress note{(YtdProgressNotes == 1 ? "" : "s")} + {YtdGoalsCompleted} goal{(YtdGoalsCompleted == 1 ? "" : "s")} completed"
        : YtdGoalsCompleted >= 1
            ? $"📅 {yearLabel} so far: {YtdGoalsCompleted} goal{(YtdGoalsCompleted == 1 ? "" : "s")} completed — incredible!"
            : $"📅 {yearLabel} so far: {YtdProgressNotes} progress note{(YtdProgressNotes == 1 ? "" : "s")} logged — keep it going!";
    <MudAlert Severity="Severity.Success" Dense="true" Class="mb-4" Icon="@Icons.Material.Filled.CalendarMonth">
        @ytdMsg 🌟
    </MudAlert>
}

@if (NotesThisMonth + NotesLastMonth > 0 && string.IsNullOrWhiteSpace(FilterText))
{
    var diff = NotesThisMonth - NotesLastMonth;
    var (trendIcon2, trendColor2, trendText2) = diff > 0
        ? (Icons.Material.Filled.TrendingUp, Color.Success, $"+{diff} vs last month")
        : diff < 0
            ? (Icons.Material.Filled.TrendingDown, Color.Warning, $"{diff} vs last month")
            : (Icons.Material.Filled.TrendingFlat, Color.Default, "same as last month");
    <MudPaper Elevation="0" Class="pa-3 mb-4 d-flex align-items-center" Style="border-radius:12px;background:var(--mud-palette-background-grey);gap:12px;">
        <MudIcon Icon="@Icons.Material.Filled.BarChart" Color="Color.Primary" Size="Size.Small" />
        <MudText Typo="Typo.body2" Style="flex:1">
            Progress notes this month: <strong>@NotesThisMonth</strong>
            @if (NotesLastMonth > 0)
            {
                <MudIcon Icon="@trendIcon2" Color="@trendColor2" Size="Size.Small" Style="vertical-align:middle;margin:0 2px;" />
                <MudText Typo="Typo.caption" Color="@trendColor2" Style="display:inline;">@trendText2</MudText>
            }
        </MudText>
        <MudChip T="string" Size="Size.Small" Color="Color.Default">@NotesLastMonth last mo.</MudChip>
    </MudPaper>
}

@if (CompletedGoals.Count >= 5 && string.IsNullOrWhiteSpace(FilterText))
{
    var cgLabel = CompletedGoals.Count >= 25 ? $"🌟 LEGENDARY! {CompletedGoals.Count} goals completed — you are extraordinary!"
                : CompletedGoals.Count >= 10 ? $"🏆 {CompletedGoals.Count} goals completed — you're a Champion-level achiever!"
                :                               $"⭐ {CompletedGoals.Count} goals completed — you're someone who finishes what they start!";
    <MudAlert Severity="Severity.Success" Icon="@Icons.Material.Filled.EmojiEvents" Dense="true" Class="mb-3">
        @cgLabel
    </MudAlert>
}

@if (CompletedGoals.Any() && string.IsNullOrWhiteSpace(FilterText))
{
    var recentWin = CompletedGoals.MaxBy(g => g.CompletionDate ?? 0);
    if (recentWin?.CompletionDate is not null)
    {
        var winDays = (int)((DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - recentWin.CompletionDate.Value) / 86_400_000L);
        var winLabel = winDays == 0 ? "today!" : winDays == 1 ? "yesterday" : $"{winDays} days ago";
        var winText = recentWin.GoalText?.Length > 60 ? recentWin.GoalText[..60] + "…" : recentWin.GoalText;
        <MudPaper Elevation="0" Class="pa-3 mb-3"
                  Style="border-left:3px solid var(--mud-palette-success);background:rgba(76,175,80,.05);border-radius:0 8px 8px 0;">
            <MudText Typo="Typo.body2">🎉 <strong>Most recent win:</strong> "@winText" — completed @winLabel</MudText>
        </MudPaper>
    }
}

