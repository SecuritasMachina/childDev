    protected override async Task OnInitializedAsync()
    {
        Db = DbFactory.CreateDbContext();
        ApkExists = System.IO.File.Exists(System.IO.Path.Combine(HostEnv.WebRootPath, "downloads", "LevelUp.apk"));
        AccountGuid = HttpContextAccessor.HttpContext?.Session.GetString("AccountGuid");
        if (AccountGuid is null) return;
        await LoadGoals();
        await LoadStats();
        await Analytics.TrackAsync("page_view", AccountGuid, "home");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var saved = await JS.InvokeAsync<string?>("localStorage.getItem", "childdev_pinned_goals");
                if (!string.IsNullOrWhiteSpace(saved))
                {
                    _pinnedGoals = saved.Split(',', StringSplitOptions.RemoveEmptyEntries).ToHashSet();
                    ApplyFilter();
                }
                var compactSaved = await JS.InvokeAsync<string?>("localStorage.getItem", "childdev_compact_goals");
                if (compactSaved == "true") _compactGoalView = true;
                StateHasChanged();
            }
            catch { }

            if (AccountGuid is not null)
            {
                _selfRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("childdev.registerPageShortcut", "n", _selfRef, "OpenAddGoalShortcut");
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("childdev.unregisterPageShortcut"); } catch { }
        _selfRef?.Dispose();
        Db?.Dispose();
    }

    [JSInvokable]
    public void OpenAddGoalShortcut() => OpenAddGoalDialog();

    private async Task ToggleCompactView()
    {
        _compactGoalView = !_compactGoalView;
        try { await JS.InvokeVoidAsync("localStorage.setItem", "childdev_compact_goals", _compactGoalView ? "true" : "false"); }
        catch { }
        _ = Analytics.TrackAsync("goal_view_toggle", AccountGuid, "home", _compactGoalView ? "compact" : "card");
    }

    private async Task TogglePinGoal(string guid)
    {
        var pinned = !_pinnedGoals.Contains(guid);
        if (pinned) _pinnedGoals.Add(guid);
        else _pinnedGoals.Remove(guid);
        try { await JS.InvokeVoidAsync("localStorage.setItem", "childdev_pinned_goals", string.Join(",", _pinnedGoals)); }
        catch { }
        _ = Analytics.TrackAsync("goal_pin", AccountGuid, "home", pinned ? "pin" : "unpin");
        ApplyFilter();
    }

    private async Task LoadStats()
    {
        var todos = await Db.Todos
            .Where(t => t.AccountFk == AccountGuid && t.DeletedAt == null && t.CompletedAt == null)
            .Select(t => new { t.Guid, t.DueDate, t.Title, t.Notes })
            .ToListAsync();
        var todayStartMs = new DateTimeOffset(DateTime.SpecifyKind(DateTime.Today, DateTimeKind.Local)).ToUnixTimeMilliseconds();
        var tomorrowStartMs = todayStartMs + 86_400_000L;
        PendingTodoCount = todos.Count;
        var goalTextToGuid = AllActiveGoals.Where(g => !string.IsNullOrWhiteSpace(g.GoalText))
            .ToDictionary(g => g.GoalText!, g => g.Guid, StringComparer.OrdinalIgnoreCase);
        _pendingTodosByGoalGuid = [];
        foreach (var t in todos.Where(t => t.Notes is not null && t.Notes.StartsWith("Goal: ")))
        {
            var prefixText = t.Notes!["Goal: ".Length..];
            var newlineIdx = prefixText.IndexOf('\n');
            var goalText = newlineIdx >= 0 ? prefixText[..newlineIdx] : prefixText;
            if (goalTextToGuid.TryGetValue(goalText, out var gGuid))
                _pendingTodosByGoalGuid[gGuid] = _pendingTodosByGoalGuid.GetValueOrDefault(gGuid) + 1;
        }
        OverdueTodoCount = todos.Count(t => t.DueDate.HasValue && t.DueDate.Value < todayStartMs);
        TodosDueToday = todos.Count(t => t.DueDate.HasValue && t.DueDate.Value >= todayStartMs && t.DueDate.Value < tomorrowStartMs);
        var firstDueToday = todos.FirstOrDefault(t => t.DueDate.HasValue && t.DueDate.Value >= todayStartMs && t.DueDate.Value < tomorrowStartMs);
        FirstTodoDueTodayTitle = firstDueToday?.Title is { Length: > 0 } ttl ? (ttl.Length > 50 ? ttl[..50] + "…" : ttl) : null;
        TopPendingTodos = todos
            .OrderBy(t => t.DueDate ?? long.MaxValue)
            .Take(3)
            .Select(t => (Guid: t.Guid, Title: t.Title ?? "", DueDate: t.DueDate))
            .ToList();

        var weekStartMs = DateTimeOffset.UtcNow.AddDays(-7).ToUnixTimeMilliseconds();
        JournalThisWeek = await Db.Journals
            .CountAsync(j => j.AccountFk == AccountGuid && j.DeletedAt == null && j.EnteredDate >= weekStartMs);
        TotalJournalCount = await Db.Journals
            .CountAsync(j => j.AccountFk == AccountGuid && j.DeletedAt == null);
        TodosCompletedThisWeek = await Db.Todos
            .CountAsync(t => t.AccountFk == AccountGuid && t.DeletedAt == null && t.CompletedAt != null && t.CompletedAt >= weekStartMs);
        TodosCompletedToday = await Db.Todos
            .CountAsync(t => t.AccountFk == AccountGuid && t.DeletedAt == null && t.CompletedAt != null && t.CompletedAt >= todayStartMs);

        RecentJournals = await Db.Journals
            .Where(j => j.AccountFk == AccountGuid && j.DeletedAt == null)
            .OrderByDescending(j => j.EnteredDate)
            .Take(3)
            .ToListAsync();

        // Journal streak for home page nudge
        var journalDatesRaw = await Db.Journals
            .Where(j => j.AccountFk == AccountGuid && j.DeletedAt == null
                     && j.EnteredDate >= DateTimeOffset.UtcNow.AddDays(-30).ToUnixTimeMilliseconds())
            .Select(j => j.EnteredDate)
            .ToListAsync();
        var journalDates30 = journalDatesRaw
            .Select(ms => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime))
            .ToHashSet();
        HomeHasJournalToday = journalDates30.Contains(DateOnly.FromDateTime(DateTime.Today));
        var jsDay = HomeHasJournalToday
            ? DateOnly.FromDateTime(DateTime.Today)
            : DateOnly.FromDateTime(DateTime.Today).AddDays(-1);
        HomeJournalStreak = 0;
        while (journalDates30.Contains(jsDay)) { HomeJournalStreak++; jsDay = jsDay.AddDays(-1); }

        // On this day: prior-year entries matching today's month+day
        var today = DateTime.Today;
        var dayStart = new DateTimeOffset(today, TimeSpan.Zero).ToUnixTimeMilliseconds();
        var allJournalsForOtd = await Db.Journals
            .Where(j => j.AccountFk == AccountGuid && j.DeletedAt == null && j.EnteredDate < dayStart)
            .Select(j => new { j.EnteredDate, j.Notes, j.Activity, j.Mood, j.Guid })
            .ToListAsync();
        OnThisDayJournals = allJournalsForOtd
            .Where(j =>
            {
                var d = DateTimeOffset.FromUnixTimeMilliseconds(j.EnteredDate).LocalDateTime;
                return d.Month == today.Month && d.Day == today.Day;
            })
            .OrderByDescending(j => j.EnteredDate)
            .Take(3)
            .Select(j => new Journal { Guid = j.Guid, EnteredDate = j.EnteredDate, Notes = j.Notes, Activity = j.Activity, Mood = j.Mood })
            .ToList();
    }

    private async Task LoadGoals()
    {
        var goals = await Db.Goals
            .Where(g => g.AccountFk == AccountGuid && g.DeletedAt == null)
            .OrderByDescending(g => g.EnteredDate)
            .ToListAsync();

        AllActiveGoals = goals.Where(g => g.CompletionDate == null).ToList();
        CompletedGoals = goals.Where(g => g.CompletionDate != null).ToList();

        var guids = AllActiveGoals.Select(g => g.Guid).ToList();
        var progressGroups = await Db.GoalProgresses
            .Where(p => guids.Contains(p.GoalFk) && p.DeletedAt == null)
            .GroupBy(p => p.GoalFk)
            .Select(grp => new { GoalFk = grp.Key, Count = grp.Count(), LastAt = grp.Max(p => p.UpdatedOn) })
            .ToListAsync();
        ProgressCounts = progressGroups.ToDictionary(x => x.GoalFk, x => x.Count);

        if (CompletedGoals.Count > 0)
        {
            var completedGuids = CompletedGoals.Select(g => g.Guid).ToList();
            var completedProgressGroups = await Db.GoalProgresses
                .Where(p => completedGuids.Contains(p.GoalFk) && p.DeletedAt == null)
                .GroupBy(p => p.GoalFk)
                .Select(grp => new { GoalFk = grp.Key, Count = grp.Count() })
                .ToListAsync();
            CompletedGoalProgressCounts = completedProgressGroups.ToDictionary(x => x.GoalFk, x => x.Count);
        }
        LastProgressAt = progressGroups.ToDictionary(x => x.GoalFk, x => x.LastAt);

        // Latest next step per goal for card preview
        var stepRows = await Db.GoalProgresses
            .Where(p => guids.Contains(p.GoalFk) && p.DeletedAt == null
                     && p.NextStepItems != null && p.NextStepItems != "")
            .Select(p => new { p.GoalFk, p.NextStepItems, p.UpdatedOn })
            .ToListAsync();
        LatestNextStep = stepRows
            .GroupBy(p => p.GoalFk)
            .ToDictionary(g => g.Key, g => g.OrderByDescending(p => p.UpdatedOn).First().NextStepItems!);

        // Compute consecutive-week streaks from raw timestamps
        var allTimestamps = await Db.GoalProgresses
            .Where(p => guids.Contains(p.GoalFk) && p.DeletedAt == null)
            .Select(p => new { p.GoalFk, p.UpdatedOn })
            .ToListAsync();
        var nowMsStreak = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        var tsByGoal = allTimestamps.GroupBy(p => p.GoalFk)
            .ToDictionary(g => g.Key, g => g.Select(p => p.UpdatedOn).ToList());
        GoalStreaks = new Dictionary<string, int>();
        foreach (var goalGuid in guids)
        {
            var ts = tsByGoal.GetValueOrDefault(goalGuid, []);
            int streak = 0;
            for (int week = 0; week < 52; week++)
            {
                var windowEnd   = nowMsStreak - (long)week * 7 * 86_400_000L;
                var windowStart = windowEnd   - 7 * 86_400_000L;
                if (ts.Any(t => t >= windowStart && t < windowEnd)) streak++;
                else break;
            }
            if (streak >= 2) GoalStreaks[goalGuid] = streak;
        }

        var weekAgoMs = nowMsStreak - 7L * 86_400_000L;
        var twoWeeksAgoMs = nowMsStreak - 14L * 86_400_000L;
        var weekEntries = allTimestamps.Where(p => p.UpdatedOn >= weekAgoMs).ToList();
        ProgressThisWeek = weekEntries.Count;
        ProgressLastWeek = allTimestamps.Count(p => p.UpdatedOn >= twoWeeksAgoMs && p.UpdatedOn < weekAgoMs);
        GoalsProgressedThisWeek = weekEntries.Select(p => p.GoalFk).Distinct().Count();

        // Most focused goal this week (when >= 2 different goals were worked)
        if (GoalsProgressedThisWeek >= 2)
        {
            var mfTop = weekEntries
                .GroupBy(p => p.GoalFk)
                .Select(g => new { GoalFk = g.Key, Count = g.Count() })
                .OrderByDescending(x => x.Count)
                .FirstOrDefault();
            if (mfTop?.Count >= 2)
            {
                var mfGoal = AllActiveGoals.FirstOrDefault(g => g.Guid == mfTop.GoalFk);
                if (mfGoal is not null)
                {
                    MostFocusedGoalThisWeekName = mfGoal.GoalText;
                    MostFocusedGoalThisWeekGuid = mfGoal.Guid;
                    MostFocusedGoalThisWeekCount = mfTop.Count;
                }
            }
        }

        // Progress notes logged today across all active goals
        var todayStartMsLocal = new DateTimeOffset(DateTime.SpecifyKind(DateTime.Today, DateTimeKind.Local)).ToUnixTimeMilliseconds();
        ProgressNotesToday = allTimestamps.Count(p => p.UpdatedOn >= todayStartMsLocal);
        TodayCountByGoal = allTimestamps
            .Where(p => p.UpdatedOn >= todayStartMsLocal)
            .GroupBy(p => p.GoalFk)
            .ToDictionary(g => g.Key, g => g.Count());

        // Daily progress streak: consecutive calendar days ending today with any progress note
        var dailyDates = allTimestamps
            .Select(p => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(p.UpdatedOn).LocalDateTime))
            .ToHashSet();
        DailyProgressStreak = 0;
        var dsDay = DateOnly.FromDateTime(DateTime.Today);
        while (dailyDates.Contains(dsDay)) { DailyProgressStreak++; dsDay = dsDay.AddDays(-1); }

        // Biggest single day: most progress notes on any one calendar day
        var biggestDayGroup = allTimestamps
            .GroupBy(p => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(p.UpdatedOn).LocalDateTime))
            .OrderByDescending(g => g.Count())
            .FirstOrDefault();
        if (biggestDayGroup is not null && biggestDayGroup.Count() >= 3)
        {
            BiggestDayDate = biggestDayGroup.Key.ToString("MMM d, yyyy");
            BiggestDayCount = biggestDayGroup.Count();
        }

        // Personal record week: compare ProgressThisWeek to max of prior 12 weeks
        var priorMaxWeeklyNotes = 0;
        for (int pw = 1; pw <= 12; pw++)
        {
            var priorWeekEnd   = nowMsStreak - (long)pw * 7 * 86_400_000L;
            var priorWeekStart = priorWeekEnd - 7 * 86_400_000L;
            var priorCount = allTimestamps.Count(p => p.UpdatedOn >= priorWeekStart && p.UpdatedOn < priorWeekEnd);
            if (priorCount > priorMaxWeeklyNotes) priorMaxWeeklyNotes = priorCount;
        }
        IsNewWeeklyRecord = ProgressThisWeek > priorMaxWeeklyNotes && ProgressThisWeek >= 3;

        // 8-week chart: notes + journals + todos completed
        var chartEightWeeksAgo = nowMsStreak - 8L * 7 * 86_400_000L;
        var chartJournalMs = await Db.Journals
            .Where(j => j.AccountFk == AccountGuid && j.DeletedAt == null && j.EnteredDate >= chartEightWeeksAgo)
            .Select(j => j.EnteredDate).ToListAsync();
        var chartTodoMs = await Db.Todos
            .Where(t => t.AccountFk == AccountGuid && t.DeletedAt == null && t.CompletedAt != null && t.CompletedAt >= chartEightWeeksAgo)
            .Select(t => t.CompletedAt!.Value).ToListAsync();

        var chartCounts = new double[8];
        var chartJournalCounts = new double[8];
        var chartTodoCounts = new double[8];
        var chartLabels = new string[8];
        for (int cw = 0; cw < 8; cw++)
        {
            var cwEnd = nowMsStreak - (long)(7 - cw) * 7 * 86_400_000L;
            var cwStart = cwEnd - 7L * 86_400_000L;
            chartCounts[cw] = allTimestamps.Count(p => p.UpdatedOn >= cwStart && p.UpdatedOn < cwEnd);
            chartJournalCounts[cw] = chartJournalMs.Count(j => j >= cwStart && j < cwEnd);
            chartTodoCounts[cw] = chartTodoMs.Count(t => t >= cwStart && t < cwEnd);
            chartLabels[cw] = DateTimeOffset.FromUnixTimeMilliseconds(cwEnd).LocalDateTime.ToString("M/d");
        }
        if (chartCounts.Any(c => c > 0) || chartJournalCounts.Any(c => c > 0) || chartTodoCounts.Any(c => c > 0))
        {
            WeeklyProgressSeries = [
                new ChartSeries { Name = "Notes", Data = chartCounts },
                new ChartSeries { Name = "Journal", Data = chartJournalCounts },
                new ChartSeries { Name = "Todos", Data = chartTodoCounts },
            ];
            WeeklyProgressLabels = chartLabels;
        }

        // Goal of the month: most progress notes in last 30 days
        var monthAgoMs = nowMsStreak - 30L * 86_400_000L;
        var monthTopEntry = allTimestamps
            .Where(p => p.UpdatedOn >= monthAgoMs)
            .GroupBy(p => p.GoalFk)
            .OrderByDescending(g => g.Count())
            .FirstOrDefault();
        if (monthTopEntry is not null && monthTopEntry.Count() >= 2)
        {
            GoalOfMonthGuid = monthTopEntry.Key;
            GoalOfMonthText = AllActiveGoals.FirstOrDefault(g => g.Guid == monthTopEntry.Key)?.GoalText;
            GoalOfMonthCount = monthTopEntry.Count();
        }

        // Monthly note counts for comparison widget
        var localNow = DateTimeOffset.Now.LocalDateTime;
        var thisMonthStartMs = new DateTimeOffset(new DateTime(localNow.Year, localNow.Month, 1), TimeZoneInfo.Local.GetUtcOffset(DateTime.Now)).ToUnixTimeMilliseconds();
        var lastMonthStartMs = new DateTimeOffset(new DateTime(localNow.Year, localNow.Month, 1).AddMonths(-1), TimeZoneInfo.Local.GetUtcOffset(DateTime.Now)).ToUnixTimeMilliseconds();
        NotesThisMonth = allTimestamps.Count(p => p.UpdatedOn >= thisMonthStartMs);
        NotesLastMonth = allTimestamps.Count(p => p.UpdatedOn >= lastMonthStartMs && p.UpdatedOn < thisMonthStartMs);

        // Year-to-date stats
        var yearStartMs = new DateTimeOffset(new DateTime(localNow.Year, 1, 1), TimeZoneInfo.Local.GetUtcOffset(DateTime.Now)).ToUnixTimeMilliseconds();
        YtdProgressNotes = allTimestamps.Count(p => p.UpdatedOn >= yearStartMs);
        YtdGoalsCompleted = CompletedGoals.Count(g => g.CompletionDate.HasValue && g.CompletionDate.Value >= yearStartMs);
        TotalProgressNotes = await Db.GoalProgresses.CountAsync(p => p.AccountFk == AccountGuid && p.DeletedAt == null);

        // Comeback detection: goals stale 14+ days that have a new note in the last 48h
        var now2dMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        var comeback48hMs = now2dMs - 2L * 86_400_000L;
        ComebackGoalName = null;
        ComebackGoalGuid = null;
        ComebackGapDays = 0;
        foreach (var cg in AllActiveGoals)
        {
            var cgTs = tsByGoal.GetValueOrDefault(cg.Guid, []);
            if (cgTs.Count >= 2)
            {
                var sortedCgTs = cgTs.OrderByDescending(t => t).ToList();
                var latestNote = sortedCgTs[0];
                var prevNote   = sortedCgTs[1];
                var gapDays = (int)((latestNote - prevNote) / 86_400_000L);
                if (latestNote >= comeback48hMs && gapDays >= 14)
                {
                    ComebackGoalName = cg.GoalText?.Length > 50 ? cg.GoalText[..50] + "…" : cg.GoalText;
                    ComebackGoalGuid = cg.Guid;
                    ComebackGapDays = gapDays;
                    break;
                }
            }
        }

        // Streak at risk: find first goal with weekly streak ≥2 that hasn't been updated today
        var todayStartMsStreak = new DateTimeOffset(DateTime.SpecifyKind(DateTime.Today, DateTimeKind.Local)).ToUnixTimeMilliseconds();
        StreakAtRiskGoalName = null; StreakAtRiskGoalGuid = null; StreakAtRiskWeeks = 0;
        foreach (var sag in AllActiveGoals)
        {
            if (GoalStreaks.TryGetValue(sag.Guid, out var sagStreak) && sagStreak >= 2)
            {
                var sagLastAt = LastProgressAt.GetValueOrDefault(sag.Guid);
                if (sagLastAt < todayStartMsStreak)
                {
                    StreakAtRiskGoalName = sag.GoalText?.Length > 50 ? sag.GoalText[..50] + "…" : sag.GoalText;
                    StreakAtRiskGoalGuid = sag.Guid;
                    StreakAtRiskWeeks = sagStreak;
                    break;
                }
            }
        }

        // Goal anniversaries: find first goal approaching or just reaching 30/60/90/180/365 day milestone
        var nowMsAnniv = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        var anniversaryMilestones = new[] { 365, 180, 90, 60, 30 };
        AnniversaryGoalName = null; AnniversaryGoalGuid = null; AnniversaryDays = 0; AnniversaryDaysUntil = -1;
        foreach (var ag in AllActiveGoals)
        {
            var agDaysSince = (int)((nowMsAnniv - ag.EnteredDate) / 86_400_000L);
            foreach (var milestone in anniversaryMilestones)
            {
                var daysUntil = milestone - agDaysSince;
                if (daysUntil >= 0 && daysUntil <= 3)
                {
                    AnniversaryGoalName = ag.GoalText?.Length > 50 ? ag.GoalText[..50] + "…" : ag.GoalText;
                    AnniversaryGoalGuid = ag.Guid;
                    AnniversaryDays = milestone;
                    AnniversaryDaysUntil = daysUntil;
                    break;
                }
                if (daysUntil < 0 && daysUntil >= -7)
                {
                    AnniversaryGoalName = ag.GoalText?.Length > 50 ? ag.GoalText[..50] + "…" : ag.GoalText;
                    AnniversaryGoalGuid = ag.Guid;
                    AnniversaryDays = milestone;
                    AnniversaryDaysUntil = daysUntil;
                    break;
                }
            }
            if (AnniversaryGoalName is not null) break;
        }

        // Next meeting countdown: find first active goal with meeting within 7 calendar days
        var nowMsMtg = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        NextMeetingGoalName = null; NextMeetingGoalGuid = null; NextMeetingDaysAway = -1;
        foreach (var mg in AllActiveGoals)
        {
            if (mg.NextMeetingDate.HasValue && mg.NextMeetingDate.Value > nowMsMtg)
            {
                var mtgDate = DateTimeOffset.FromUnixTimeMilliseconds(mg.NextMeetingDate.Value).LocalDateTime.Date;
                var daysAway = (mtgDate - DateTime.Today).Days;
                if (daysAway <= 7)
                {
                    NextMeetingGoalName = mg.GoalText?.Length > 50 ? mg.GoalText[..50] + "…" : mg.GoalText;
                    NextMeetingGoalGuid = mg.Guid;
                    NextMeetingDaysAway = daysAway;
                    break;
                }
            }
        }

        // Sort: goals with no progress first (needs attention), then by oldest-update-first
        AllActiveGoals = AllActiveGoals
            .OrderBy(g => LastProgressAt.ContainsKey(g.Guid) ? 1 : 0)
            .ThenBy(g => LastProgressAt.GetValueOrDefault(g.Guid, 0))
            .ToList();

        // Recent cross-goal progress notes for activity feed
        var allGoalGuids = goals.Where(g => g.CompletionDate == null).Select(g => g.Guid).ToList();
        var goalTextMap = goals.ToDictionary(g => g.Guid, g => g.GoalText ?? "");
        var recentRaw = await Db.GoalProgresses
            .Where(p => allGoalGuids.Contains(p.GoalFk) && p.DeletedAt == null
                     && p.NextStepItems != null && p.NextStepItems != "")
            .OrderByDescending(p => p.UpdatedOn)
            .Take(7)
            .Select(p => new { p.GoalFk, p.NextStepItems, p.UpdatedOn })
            .ToListAsync();
        RecentProgressNotes = recentRaw
            .Select(r => (GoalFk: r.GoalFk, GoalText: goalTextMap.GetValueOrDefault(r.GoalFk, ""), NoteText: r.NextStepItems!, Timestamp: r.UpdatedOn))
            .ToList();

        ApplyFilter();
    }

    private void OnFilterChanged(string value)
    {
        FilterText = value;
        if (!string.IsNullOrWhiteSpace(value)) QuickFilter = "all";
        ApplyFilter();
        if (!string.IsNullOrWhiteSpace(value))
            _ = Analytics.TrackAsync("goal_filter", AccountGuid, "home");
    }

    private void ApplyFilter()
    {
        var nowMsF = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        IEnumerable<Goal> filtered = AllActiveGoals;

        if (!string.IsNullOrWhiteSpace(FilterText))
        {
            var q = FilterText.Trim();
            filtered = filtered.Where(g => (g.GoalText?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                                        || (g.MeasurableOutcome?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                                        || (LatestNextStep.TryGetValue(g.Guid, out var ns) && ns.Contains(q, StringComparison.OrdinalIgnoreCase)));
        }
        if (QuickFilter == "attention")
            filtered = filtered.Where(g => {
                var p = ProgressCounts.GetValueOrDefault(g.Guid);
                var l = LastProgressAt.GetValueOrDefault(g.Guid);
                var d = p > 0 ? (int)((nowMsF - l) / 86_400_000L) : -1;
                return p == 0 || d >= 14;
            });
        else if (QuickFilter == "streak")
            filtered = filtered.Where(g => GoalStreaks.ContainsKey(g.Guid));
        else if (QuickFilter == "meeting")
        {
            var mtg7Ms = nowMsF + 7L * 86_400_000L;
            filtered = filtered.Where(g => g.NextMeetingDate.HasValue && g.NextMeetingDate.Value > nowMsF && g.NextMeetingDate.Value <= mtg7Ms)
                               .OrderBy(g => g.NextMeetingDate);
        }
        else if (QuickFilter.StartsWith("cat:"))
        {
            var catVal = QuickFilter[4..];
            filtered = filtered.Where(g => g.Category == catVal);
        }

        // Apply sort order (pinned goals always float to top)
        filtered = GoalSortOrder switch
        {
            "most_active" => filtered.OrderByDescending(g => _pinnedGoals.Contains(g.Guid)).ThenByDescending(g => ProgressCounts.GetValueOrDefault(g.Guid)),
            "newest"      => filtered.OrderByDescending(g => _pinnedGoals.Contains(g.Guid)).ThenByDescending(g => g.EnteredDate),
            "alpha"       => filtered.OrderByDescending(g => _pinnedGoals.Contains(g.Guid)).ThenBy(g => g.GoalText, StringComparer.OrdinalIgnoreCase),
            // "due_date": goals with soonest deadline first; goals without a deadline go last
            "due_date"    => filtered.OrderByDescending(g => _pinnedGoals.Contains(g.Guid))
                                     .ThenBy(g => g.ExpirationDate.HasValue ? 0 : 1)
                                     .ThenBy(g => g.ExpirationDate ?? long.MaxValue),
            // "attention": goals with no notes first, then by oldest last-progress-date (most neglected first)
            _             => filtered.OrderByDescending(g => _pinnedGoals.Contains(g.Guid))
                                     .ThenBy(g => ProgressCounts.GetValueOrDefault(g.Guid) == 0 ? 0 : 1)
                                     .ThenBy(g => LastProgressAt.GetValueOrDefault(g.Guid, long.MaxValue))
        };

        if (string.IsNullOrWhiteSpace(FilterText) && QuickFilter == "all" && GoalSortOrder == "attention")
        {
            var list = filtered.ToList();
            var candidate = list.FirstOrDefault(g => !_skippedFocusGoals.Contains(g.Guid))
                            ?? list.FirstOrDefault();
            FeaturedGoal = list.Count >= 2 ? candidate : null;
            ActiveGoals = FeaturedGoal is not null ? list.Where(g => g.Guid != FeaturedGoal.Guid).ToList() : list;
        }
        else
        {
            FeaturedGoal = null;
            ActiveGoals = filtered.ToList();
        }
    }

    private void SkipFocusGoal()
    {
        if (FeaturedGoal is null) return;
        _ = Analytics.TrackAsync("goal_focus_skip", AccountGuid, "home", FeaturedGoal.Guid);
        _skippedFocusGoals.Add(FeaturedGoal.Guid);
        if (_skippedFocusGoals.Count >= AllActiveGoals.Count)
            _skippedFocusGoals.Clear();
        ApplyFilter();
    }

    private void SetQuickFilter(string filter)
    {
        QuickFilter = filter;
        if (filter != "all") FilterText = string.Empty;
        ApplyFilter();
        _ = Analytics.TrackAsync("goal_quick_filter", AccountGuid, "home", filter);
    }

