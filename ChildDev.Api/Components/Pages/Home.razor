                    <MudStack Spacing="0" Style="flex:1">
                        <MudText Typo="Typo.caption" Color="Color.Warning" Style="font-weight:700;letter-spacing:0.5px;">STREAK CHAMPION — @bestEntry.Value WEEKS!</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">"@truncName" — @bestEntry.Value consecutive weeks of progress. That's extraordinary dedication! 🌟</MudText>
                    </MudStack>
                    @if (!string.IsNullOrWhiteSpace(bestGoal.Guid))
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Href="@($"/goals/{bestGoal.Guid}")">View</MudButton>
                    }
                </MudStack>
            </MudPaper>
        }
        else
        {
            <MudAlert Severity="Severity.Warning" Icon="@Icons.Material.Filled.LocalFireDepartment" Dense="true" Class="mb-2">
                🔥 Best streak: <strong>@bestEntry.Value weeks</strong> on "@truncName" — keep it going!
            </MudAlert>
        }
    }
}
@if (TotalProgressNotes == 0 && AllActiveGoals.Count > 0 && string.IsNullOrWhiteSpace(FilterText))
{
    var firstGoal = AllActiveGoals.First();
    var firstGoalName = firstGoal.GoalText?.Length > 50 ? firstGoal.GoalText[..50] + "…" : firstGoal.GoalText;
