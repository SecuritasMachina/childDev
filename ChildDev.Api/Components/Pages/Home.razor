            </MudText>
            <MudGrid Spacing="2" Justify="Justify.Center" Class="mb-4">
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.h4">🎯</MudText>
                    <MudText Typo="Typo.body2" Style="font-weight:600;">1. Set a Goal</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">What do you want to achieve?</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.h4">📝</MudText>
                    <MudText Typo="Typo.body2" Style="font-weight:600;">2. Track Progress</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Add notes as you work toward it</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.h4">🎉</MudText>
                    <MudText Typo="Typo.body2" Style="font-weight:600;">3. Celebrate Wins!</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Mark it complete and level up</MudText>
                </MudItem>
            </MudGrid>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                       StartIcon="@Icons.Material.Filled.Flag"
                       OnClick="OpenAddGoalDialog" Style="border-radius:12px;font-weight:700;">
                Set My First Goal! ✨
            </MudButton>
        </MudPaper>
    }
    else
    {
        @* User has completed all goals — ready for the next one *@
        <MudAlert Severity="Severity.Success" Icon="@Icons.Material.Filled.EmojiEvents" Class="mb-4">
            <strong>All goals completed! 🎉</strong> You've achieved everything on your list — ready to set a new goal?
        </MudAlert>
    }
}

@* Goal of the Day — featured spotlight on the goal that needs attention most *@
@if (FeaturedGoal is not null)
{
    var fg = FeaturedGoal;
    var fgPCount = ProgressCounts.GetValueOrDefault(fg.Guid);
    var fgLastAt = LastProgressAt.GetValueOrDefault(fg.Guid);
    var fgDaysSince = fgPCount > 0 ? (int)((DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - fgLastAt) / 86_400_000L) : -1;
    var fgNudge = fgPCount == 0 ? "No progress notes yet — add your first one!" :
                  fgDaysSince == 0 ? "You worked on this today! 🔥 Keep the streak alive!" :
                  fgDaysSince == 1 ? "You updated this yesterday — stay on it! 💪" :
                  fgDaysSince <= 7 ? $"Last updated {fgDaysSince} days ago — time for a new note!" :
                  $"It's been {fgDaysSince} days — let's check in on this goal! 🌱";
    LatestNextStep.TryGetValue(fg.Guid, out var fgNextStep);
    <MudPaper Elevation="4" Class="pa-4 mb-4" Style="border-radius:16px;border:2px solid var(--mud-palette-primary);background:linear-gradient(135deg,rgba(63,81,181,.06) 0%,rgba(255,255,255,0) 100%);">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
            <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" />
            <MudText Typo="Typo.overline" Color="Color.Primary" Style="font-weight:700;letter-spacing:1.5px;">Focus Goal</MudText>
        </MudStack>
        <MudText Typo="Typo.h6" Class="mb-1">@fg.GoalText</MudText>
        @if (fg.MeasurableOutcome is not null)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">📏 @fg.MeasurableOutcome</MudText>
        }
        <MudAlert Severity="@(fgDaysSince >= 0 && fgDaysSince <= 1 ? Severity.Success : Severity.Info)"
                  Dense="true" Class="mb-2" NoIcon="@(fgPCount == 0)">@fgNudge</MudAlert>
        @if (!string.IsNullOrWhiteSpace(fgNextStep))
        {
            var truncated = fgNextStep.Length > 120 ? fgNextStep[..120] + "…" : fgNextStep;
            var fgNsFirstLine = fgNextStep.Split('\n', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? fgNextStep;
            var fgTodoTitle = fgNsFirstLine.Length > 100 ? fgNsFirstLine[..100] : fgNsFirstLine;
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-3">
                <MudText Typo="Typo.body2" Color="Color.Primary" Style="flex:1;">
                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Style="vertical-align:middle;" /> @truncated
                </MudText>
                <MudTooltip Text="Create a todo from this next step">
                    <MudIconButton Icon="@Icons.Material.Filled.AddTask" Size="Size.Small" Color="Color.Info"
                                   OnClick="() => OpenGoalTodoDialogWithTitle(fg.Guid, fgTodoTitle)"
                                   aria-label="Create todo from next step" />
                </MudTooltip>
            </MudStack>
        }
        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@($"/goals/{fg.Guid}")"
                       StartIcon="@Icons.Material.Filled.TrendingUp">View Progress</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="async () => await OpenQuickNote(fg.Guid)">Add Note</MudButton>
            @if (fg.CompletionDate is null)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.EmojiEvents"
                           OnClick="() => CompleteGoal(fg.Guid)">Mark Complete 🎉</MudButton>
            }
            @if (AllActiveGoals.Count > 2)
            {
                <MudTooltip Text="Show a different focus goal">
                    <MudIconButton Icon="@Icons.Material.Filled.SkipNext" Size="Size.Small"
                                   Color="Color.Default" OnClick="SkipFocusGoal"
                                   aria-label="Skip to next focus goal" />
                </MudTooltip>
            }
        </MudStack>
    </MudPaper>
}

@if (_compactGoalView)
{
    <MudList T="Goal" Dense="true" Class="mt-2">
        @foreach (var g in ActiveGoals)
        {
            var cgPCount = ProgressCounts.GetValueOrDefault(g.Guid);
            var cgLastAt = LastProgressAt.GetValueOrDefault(g.Guid);
            var cgDays   = cgPCount > 0 ? (int)((DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - cgLastAt) / 86_400_000L) : -1;
            var cgHeatColor = cgPCount == 0 ? Color.Default
                            : cgDays <= 1   ? Color.Success
                            : cgDays <= 13  ? Color.Warning
                            : Color.Error;
            var cgHeatIcon = cgPCount == 0 ? Icons.Material.Filled.FiberNew
                           : cgDays <= 1   ? Icons.Material.Filled.LocalFireDepartment
                           : cgDays <= 13  ? Icons.Material.Filled.WbSunny
                           : Icons.Material.Filled.AcUnit;
            var cgLastLabel = cgPCount == 0 ? "No notes" : cgDays == 0 ? "Today" : cgDays == 1 ? "Yesterday" : $"{cgDays}d ago";
            var cgIsPinned = _pinnedGoals.Contains(g.Guid);
            string? cgNextStepTodoTitle = null;
            if (LatestNextStep.TryGetValue(g.Guid, out var cgNS) && !string.IsNullOrWhiteSpace(cgNS))
            {
                var cgNsLine = cgNS.Split('\n', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? cgNS;
                cgNextStepTodoTitle = cgNsLine.Length > 100 ? cgNsLine[..100] : cgNsLine;
            }
            var cgCapturedGuid = g.Guid;
            <MudListItem T="Goal">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@cgHeatIcon" Color="@cgHeatColor" Size="Size.Small" />
                    <MudText Typo="Typo.body2" Style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@((MarkupString)HighlightMatch(g.GoalText ?? "", FilterText.Trim()))</MudText>
                    @if (!string.IsNullOrWhiteSpace(g.Category))
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Style="font-size:0.68rem;height:20px;">@g.Category</MudChip>
                    }
                    @if (g.ProgressPercent.HasValue)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Primary" Style="white-space:nowrap;">@g.ProgressPercent%</MudText>
                    }
                    <MudChip T="string" Size="Size.Small" Color="@(cgPCount > 0 ? Color.Default : Color.Secondary)" Style="font-size:0.7rem;height:20px;">
                        @cgPCount note@(cgPCount == 1 ? "" : "s")
                    </MudChip>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="white-space:nowrap;min-width:70px;text-align:right;">@cgLastLabel</MudText>
                    <MudIconButton Icon="@(cgIsPinned ? Icons.Material.Filled.PushPin : Icons.Material.Outlined.PushPin)"
                                   Size="Size.Small" Color="@(cgIsPinned ? Color.Warning : Color.Default)"
                                   OnClick="() => TogglePinGoal(cgCapturedGuid)" aria-label="Pin goal" />
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                               Href="@($"/goals/{cgCapturedGuid}")">View</MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="async () => await OpenQuickNote(cgCapturedGuid)">Note</MudButton>
                    <MudTooltip Text="@(cgNextStepTodoTitle != null ? $"Create todo from next step" : "Add todo for this goal")">
                        <MudIconButton Icon="@Icons.Material.Filled.AddTask" Color="Color.Info" Size="Size.Small"
                                       OnClick="@(cgNextStepTodoTitle != null ? () => OpenGoalTodoDialogWithTitle(cgCapturedGuid, cgNextStepTodoTitle!) : () => OpenGoalTodoDialog(cgCapturedGuid))"
                                       aria-label="@(cgNextStepTodoTitle != null ? "Create todo from next step" : "Add todo for this goal")" />
                    </MudTooltip>
                </MudStack>
            </MudListItem>
        }
    </MudList>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddCircleOutline"
               OnClick="OpenAddGoalDialog" Class="mt-2">Add New Goal</MudButton>
}
else
{
<MudGrid>
    @foreach (var g in ActiveGoals)
    {
        <MudItem xs="12" sm="6" md="4">
            @{
                var gPCount = ProgressCounts.GetValueOrDefault(g.Guid);
                var gLastAt = LastProgressAt.GetValueOrDefault(g.Guid);
                var gDays   = gPCount > 0 ? (int)((DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - gLastAt) / 86_400_000L) : -1;
                var heatClass = gPCount == 0 ? "goal-heat-new"
                              : gDays <= 1   ? "goal-heat-hot"
                              : gDays <= 13  ? "goal-heat-warm"
                              : "goal-heat-cold";
            }
            <MudCard Elevation="2" Class="@($"h-100 {heatClass}")">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudAvatar Color="Color.Primary" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Filled.Flag" />
                        </MudAvatar>
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudText Typo="Typo.body1">@((MarkupString)HighlightMatch(g.GoalText ?? "", FilterText.Trim()))</MudText>
                        @if (!string.IsNullOrWhiteSpace(g.Category))
                        {
                            var catColor = g.Category switch {
                                "Academic" => Color.Primary, "Health" => Color.Success,
                                "Social" => Color.Info, "Creative" => Color.Secondary,
                                "Hobby" => Color.Warning, _ => Color.Default };
                            <MudChip T="string" Size="Size.Small" Color="@catColor" Style="font-size:0.68rem;height:20px;" Class="mb-1">@g.Category</MudChip>
                        }
                        @if (!string.IsNullOrWhiteSpace(GoalOfMonthGuid) && g.Guid == GoalOfMonthGuid)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Style="font-size:0.68rem;height:20px;" Class="mb-1">🥇 Month's Top Goal</MudChip>
                        }
                        @if (g.ProgressPercent.HasValue)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-1">
                                <MudProgressLinear Value="@g.ProgressPercent.Value" Color="Color.Primary" Rounded="true" Size="Size.Small" Style="flex:1;" />
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@g.ProgressPercent%</MudText>
                            </MudStack>
                        }
                        @if (g.MeasurableOutcome is not null)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">📏 @g.MeasurableOutcome</MudText>
                        }
                        @if (g.NextMeetingDate.HasValue)
                        {
                            var mtg = DateTimeOffset.FromUnixTimeMilliseconds(g.NextMeetingDate.Value).LocalDateTime;
                            var mtgDays = (mtg.Date - DateTime.Today).Days;
                            string mtgLabel2;
                            Color mtgColor2;
                            if (mtgDays < 0) { mtgLabel2 = mtgDays == -1 ? "📅 Missed yesterday" : $"📅 Missed {-mtgDays}d ago"; mtgColor2 = Color.Warning; }
                            else if (mtgDays == 0) { mtgLabel2 = "📅 Meeting today!"; mtgColor2 = Color.Success; }
                            else if (mtgDays == 1) { mtgLabel2 = "📅 Meeting tomorrow"; mtgColor2 = Color.Info; }
                            else { mtgLabel2 = $"📅 Meeting in {mtgDays} days"; mtgColor2 = Color.Info; }
                            <MudText Typo="Typo.caption" Color="@mtgColor2">@mtgLabel2</MudText>
                        }
                    </CardHeaderContent>
                    <CardHeaderActions>
                        @{var isPinned = _pinnedGoals.Contains(g.Guid);}
                        <MudTooltip Text="@(isPinned ? "Unpin goal" : "Pin to top")">
                            <MudIconButton Icon="@(isPinned ? Icons.Material.Filled.PushPin : Icons.Material.Outlined.PushPin)"
                                           Size="Size.Small"
                                           Color="@(isPinned ? Color.Warning : Color.Default)"
                                           OnClick="() => TogglePinGoal(g.Guid)"
                                           aria-label="@(isPinned ? "Unpin goal" : "Pin goal to top")" />
                        </MudTooltip>
                    </CardHeaderActions>
                </MudCardHeader>
                @{
                    var pCount = ProgressCounts.GetValueOrDefault(g.Guid);
                    var nowMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
                    var todayStartMs = new DateTimeOffset(DateTime.SpecifyKind(DateTime.Today, DateTimeKind.Local)).ToUnixTimeMilliseconds();
                    var fourteenDaysFromNowMs = todayStartMs + 14L * 86_400_000L;
                    var isExpired = g.ExpirationDate.HasValue && g.ExpirationDate.Value < todayStartMs;
                    var isExpiringSoon = !isExpired && g.ExpirationDate.HasValue && g.ExpirationDate.Value < fourteenDaysFromNowMs;
                    var lastAt = LastProgressAt.GetValueOrDefault(g.Guid);
                    var daysSinceProgress = pCount > 0 ? (int)((nowMs - lastAt) / 86_400_000L) : -1;
                    var isStale = daysSinceProgress >= 14;
                    // Countdown chip label + color
                    string? expiryLabel = null;
                    Color expiryColor = Color.Default;
                    if (isExpired && g.ExpirationDate.HasValue)
                    {
                        var daysOver = (int)((todayStartMs - g.ExpirationDate.Value) / 86_400_000L);
                        expiryLabel = daysOver <= 1 ? "⏰ Past due" : $"⏰ {daysOver}d overdue";
                        expiryColor = Color.Error;
                    }
                    else if (isExpiringSoon && g.ExpirationDate.HasValue)
                    {
                        var expDate = DateTimeOffset.FromUnixTimeMilliseconds(g.ExpirationDate.Value).LocalDateTime.Date;
                        var daysLeft = (expDate - DateTime.Today).Days;
                        if (daysLeft <= 3)      { expiryLabel = daysLeft == 0 ? "⏳ Due today!" : daysLeft == 1 ? "⏳ Due tomorrow!" : $"⏳ {daysLeft} days left!"; expiryColor = Color.Error; }
                        else if (daysLeft <= 7) { expiryLabel = $"⏳ {daysLeft} days left"; expiryColor = Color.Warning; }
                        else                    { expiryLabel = $"📅 {daysLeft} days left"; expiryColor = Color.Info; }
                    }
                }
                <MudCardContent Class="pt-0">
                    @if (pCount == 0 && !isExpired && !isExpiringSoon)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">No notes yet</MudText>
                    }
                    @if (pCount > 0)
                    {
                        <MudChip T="string" Icon="@Icons.Material.Filled.CheckCircle" Color="@(isStale ? Color.Warning : Color.Success)" Size="Size.Small" Class="mr-1">
                            @if (daysSinceProgress == 0)
                            {
                                var todayGoalCount = TodayCountByGoal.GetValueOrDefault(g.Guid);
                                @(todayGoalCount >= 2 ? $"Updated today ({todayGoalCount}x)" : "Updated today")
                            }
                            else if (daysSinceProgress == 1)
                            {
                                @("Updated yesterday")
                            }
                            else
                            {
                                @($"Updated {daysSinceProgress}d ago")
                            }
                        </MudChip>
                    }
                    @if ((isExpired || isExpiringSoon) && expiryLabel is not null)
                    {
                        <MudChip T="string" Size="Size.Small" Color="@expiryColor" Class="mr-1">@expiryLabel</MudChip>
                    }
                    @{
                        var lvlCount = ProgressCounts.GetValueOrDefault(g.Guid);
                        var (lvlEmoji, lvlLabel, lvlColor) = lvlCount switch
                        {
                            0             => ("🌱", "Seedling",   Color.Default),
                            >= 1 and < 5  => ("⚡", "Getting Started", Color.Info),
                            >= 5 and < 10 => ("🚀", "Momentum",  Color.Primary),
                            >= 10 and < 25=> ("⭐", "Strong",    Color.Success),
                            >= 25 and < 50=> ("🏆", "Champion",  Color.Warning),
                            _             => ("🌟", "Legendary", Color.Error)
                        };
                    }
                    <MudChip T="string" Size="Size.Small" Color="@lvlColor" Class="mr-1" Style="font-size:0.72rem;">
                        @lvlEmoji @lvlLabel
                    </MudChip>
                    @{
                        var cardNotesToNext = lvlCount switch
                        {
                            0       => 1,
                            < 5     => 5 - lvlCount,
                            < 10    => 10 - lvlCount,
                            < 25    => 25 - lvlCount,
                            < 50    => 50 - lvlCount,
                            _       => 0
                        };
                        var cardNextLvlName = lvlCount switch
                        {
                            0       => "⚡ Getting Started",
                            < 5     => "🚀 Momentum",
                            < 10    => "⭐ Strong",
                            < 25    => "🏆 Champion",
                            < 50    => "🌟 Legendary",
                            _       => null
                        };
                    }
                    @{
                        int cardLvlPct2 = 0;
                        if (lvlCount > 0 && cardNotesToNext > 0)
                        {
                            var cardLvlPrev = lvlCount < 5 ? 1 : lvlCount < 10 ? 5 : lvlCount < 25 ? 10 : lvlCount < 50 ? 25 : 50;
                            var cardLvlCeil = lvlCount < 5 ? 5 : lvlCount < 10 ? 10 : lvlCount < 25 ? 25 : lvlCount < 50 ? 50 : 50;
                            cardLvlPct2 = (int)((lvlCount - cardLvlPrev) * 100.0 / (cardLvlCeil - cardLvlPrev));
                        }
                    }
                    @if (lvlCount > 0 && cardNotesToNext > 0)
                    {
                        <MudProgressLinear Value="@cardLvlPct2" Color="Color.Warning" Rounded="true" Size="Size.Small" Class="mt-2 mb-0" />
                    }
                    @if (cardNotesToNext > 0 && cardNotesToNext <= 3 && cardNextLvlName is not null)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Info" Class="mt-1 d-block">
                            ⚡ @cardNotesToNext more note@(cardNotesToNext == 1 ? "" : "s") to @cardNextLvlName!
                        </MudText>
                    }
                    @if (daysSinceProgress >= 2 && daysSinceProgress <= 7)
                    {
                        <MudChip T="string" Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" Class="mr-1" Style="font-size:0.72rem;">
                            Active this week! ✅
                        </MudChip>
                    }
                    @if (GoalStreaks.TryGetValue(g.Guid, out var streak))
                    {
                        <MudChip T="string" Icon="@Icons.Material.Filled.LocalFireDepartment" Color="Color.Warning" Size="Size.Small" Class="mr-1">
                            @streak week streak! 🔥
                        </MudChip>
                    }
                    @{
                        var cardPendingTodos = _pendingTodosByGoalGuid.GetValueOrDefault(g.Guid);
                    }
                    @if (cardPendingTodos > 0)
                    {
                        <MudChip T="string" Icon="@Icons.Material.Filled.CheckBox" Color="Color.Info" Size="Size.Small" Class="mr-1" Style="font-size:0.72rem;">
                            @cardPendingTodos todo@(cardPendingTodos == 1 ? "" : "s") open
                        </MudChip>
                    }
                    @if (LatestNextStep.TryGetValue(g.Guid, out var nextStep))
                    {
                        var truncated = nextStep.Length > 90 ? nextStep[..90] + "…" : nextStep;
                        var nsFirstLine = nextStep.Split('\n', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? nextStep;
                        var nsTodoTitle = nsFirstLine.Length > 100 ? nsFirstLine[..100] : nsFirstLine;
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0" Class="mt-2">
                            <MudText Typo="Typo.caption" Color="Color.Primary" Style="flex:1;min-width:0;">
                                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Style="vertical-align:middle;" /> @truncated
                            </MudText>
                            <MudTooltip Text="Create a todo from this next step">
                                <MudIconButton Icon="@Icons.Material.Filled.AddTask" Size="Size.Small" Color="Color.Info"
                                               OnClick="() => OpenGoalTodoDialogWithTitle(g.Guid, nsTodoTitle)"
                                               aria-label="Create todo from next step" Style="margin:-4px -4px -4px 2px;" />
                            </MudTooltip>
                        </MudStack>
                    }
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary"
                               Href="@($"/goals/{g.Guid}")">View</MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="async () => await OpenQuickNote(g.Guid)">Note</MudButton>
                    <MudTooltip Text="Add a todo linked to this goal">
                        <MudIconButton Icon="@Icons.Material.Filled.AddTask" Color="Color.Info" Size="Size.Small"
                                       OnClick="() => OpenGoalTodoDialog(g.Guid)" aria-label="Add todo for this goal" />
                    </MudTooltip>
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                   Color="Color.Success" aria-label="Mark goal complete"
                                   OnClick="() => CompleteGoal(g.Guid)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error" Size="Size.Small" aria-label="Delete goal"
                                   OnClick="() => _confirmDeleteGoalGuid = g.Guid" />
                </MudCardActions>
            </MudCard>
        </MudItem>
    }

    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="1" Style="border: 2px dashed var(--mud-palette-primary); cursor:pointer;"
                 Class="h-100 d-flex align-items-center justify-content-center"
                 @onclick="OpenAddGoalDialog">
            <MudCardContent Class="text-center">
                <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Color="Color.Primary" Style="font-size:3rem;" />
                <MudText Typo="Typo.body1" Color="Color.Primary" Class="mt-2">Add New Goal</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>
}

@{
    var nowMsAttn = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
    var needsAttn = AllActiveGoals.Where(g => {
        var p2 = ProgressCounts.GetValueOrDefault(g.Guid);
        var l2 = LastProgressAt.GetValueOrDefault(g.Guid);
        var d2 = p2 > 0 ? (int)((nowMsAttn - l2) / 86_400_000L) : -1;
        return p2 == 0 || d2 >= 14;
    }).ToList();
}
@if (needsAttn.Any() && string.IsNullOrWhiteSpace(FilterText))
{
    <MudExpansionPanels Class="mt-4 mb-2">
        <MudExpansionPanel Text="@($"Goals Needing Attention ({needsAttn.Count})")"
                           Icon="@Icons.Material.Filled.NotificationsActive">
            <MudList T="Goal" Dense="true">
                @foreach (var sg in needsAttn)
                {
                    var sgP = ProgressCounts.GetValueOrDefault(sg.Guid);
                    var sgL = LastProgressAt.GetValueOrDefault(sg.Guid);
                    var sgD = sgP > 0 ? (int)((nowMsAttn - sgL) / 86_400_000L) : -1;
                    var sgLabel = sgP == 0 ? "No notes yet" : $"{sgD} day{(sgD == 1 ? "" : "s")} since last note";
                    <MudListItem>
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@(sgP == 0 ? Icons.Material.Filled.FiberNew : Icons.Material.Filled.AccessTime)"
                                     Color="@(sgP == 0 ? Color.Info : Color.Warning)" Size="Size.Small" />
                            <MudStack Spacing="0" Style="flex:1">
                                <MudText Typo="Typo.body2">@sg.GoalText</MudText>
                                <MudText Typo="Typo.caption" Color="@(sgP == 0 ? Color.Info : Color.Warning)">@sgLabel</MudText>
                            </MudStack>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary"
                                       Href="@($"/goals/{sg.Guid}")">View</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="async () => await OpenQuickNote(sg.Guid)">Add Note</MudButton>
                        </MudStack>
                    </MudListItem>
                }
            </MudList>
        </MudExpansionPanel>
    </MudExpansionPanels>
}

@if (CompletedGoals.Any())
{
    var recentCompleted = CompletedGoals
        .OrderByDescending(g => g.CompletionDate ?? 0)
        .Take(6)
        .ToList();
    var hasMore = CompletedGoals.Count > 6;
    <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mt-6 mb-2" Style="text-transform:uppercase;letter-spacing:1px;">
        🏆 Achievement Gallery (@CompletedGoals.Count)
    </MudText>
    <MudGrid Class="mb-2">
        @foreach (var g in recentCompleted)
        {
            var completedOn = DateTimeOffset.FromUnixTimeMilliseconds(g.CompletionDate!.Value).LocalDateTime;
            var daysAgo = (int)(DateTime.Now - completedOn).TotalDays;
            var dateLabel = daysAgo == 0 ? "Today! 🎉" : daysAgo == 1 ? "Yesterday" : daysAgo < 7 ? $"{daysAgo}d ago" : completedOn.ToString("MMM d");
            var titleShort = g.GoalText is not null && g.GoalText.Length > 55 ? g.GoalText[..55] + "…" : (g.GoalText ?? "");
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="1" Class="pa-3" Style="border-radius:12px;border:1.5px solid var(--mud-palette-warning);background:linear-gradient(135deg,rgba(255,193,7,.06) 0%,rgba(255,255,255,0) 100%);">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudText Style="font-size:1.4rem;line-height:1;">🏆</MudText>
                        @{
                            var agNotes = CompletedGoalProgressCounts.GetValueOrDefault(g.Guid);
                            var agShareText = g.GoalText is not null ? $"🏆 I achieved my goal: \"{g.GoalText}\"" + (agNotes > 0 ? $" — {agNotes} progress note{(agNotes == 1 ? "" : "s")} logged! 💪 #LevelUp" : " 💪 #LevelUp") : "";
                            var agCapturedGuid = g.Guid;
                        }
                        <MudStack Spacing="0" Style="flex:1;min-width:0;">
                            <MudText Typo="Typo.body2" Style="font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@titleShort</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @dateLabel@(agNotes > 0 ? $" · {agNotes} note{(agNotes == 1 ? "" : "s")}" : "")
                            </MudText>
                        </MudStack>
                        <MudTooltip Text="Copy achievement to clipboard">
                            <MudIconButton Icon="@Icons.Material.Filled.Share" Size="Size.Small"
                                           Color="Color.Default"
                                           OnClick="@(async () => await ShareAchievement(agCapturedGuid, agShareText))"
                                           aria-label="Copy achievement to clipboard" />
                        </MudTooltip>
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small"
                                       Color="Color.Warning" Href="@($"/goals/{g.Guid}")" />
                    </MudStack>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
    @if (hasMore)
    {
        <MudExpansionPanels Class="mb-2">
            <MudExpansionPanel Text="@($"See all {CompletedGoals.Count} achievements…")">
                <MudList T="Goal" Dense="true">
                    @foreach (var g in CompletedGoals.OrderByDescending(g => g.CompletionDate ?? 0).Skip(6))
                    {
                        var completedOn2 = DateTimeOffset.FromUnixTimeMilliseconds(g.CompletionDate!.Value).LocalDateTime;
                        <MudListItem>
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Warning" Size="Size.Small" />
                                <MudText Typo="Typo.body2" Style="flex:1">@g.GoalText</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mr-2">@completedOn2.ToString("MMM d, yyyy")</MudText>
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Href="@($"/goals/{g.Guid}")">View</MudButton>
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            </MudExpansionPanel>
        </MudExpansionPanels>
    }
}

@* Goal completion celebration *@
<MudDialog @bind-Visible="ShowCelebration" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <DialogContent>
        <div class="confetti-burst">
            <span></span><span></span><span></span><span></span>
            <span></span><span></span><span></span><span></span>
            <span></span><span></span><span></span><span></span>
        </div>
        <MudStack AlignItems="AlignItems.Center" Spacing="3" Class="pa-4">
            <MudText Typo="Typo.h2" Class="celeb-emoji">🎉</MudText>
            <MudText Typo="Typo.h5" Align="Align.Center" Color="Color.Success">Goal Achieved!</MudText>
            <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary">@CelebratedGoalText</MudText>
            <MudText Typo="Typo.body2" Align="Align.Center">
                Amazing work! Every big achievement starts with a single step. 🌟
            </MudText>
            @if (CompletedGoals.Count >= 1)
            {
                <MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Warning" Style="font-weight:600;">
                    🏆 @CompletedGoals.Count goal@(CompletedGoals.Count == 1 ? "" : "s") completed all-time!
                </MudText>
            }
            <MudTextField @bind-Value="CelebrationReflection"
                          Label="What did you learn? What are you most proud of? (optional)"
                          Variant="Variant.Outlined" Lines="2" FullWidth="true" Immediate="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.AutoAwesome"
                          AdornmentColor="Color.Warning"
