@{
    // Show at most ONE activity alert — pick the most notable
    string? activityAlert = null;
    if (string.IsNullOrWhiteSpace(FilterText))
    {
        if (BiggestDayDate is not null && ProgressNotesToday >= BiggestDayCount && ProgressNotesToday >= 3)
            activityAlert = $"🏆 New personal best! {ProgressNotesToday} notes today — you just beat your all-time record!";
        else if (IsNewWeeklyRecord)
            activityAlert = $"🎉 New weekly record! {ProgressThisWeek} notes this week — your best week yet!";
        else if (ProgressNotesToday >= 5)
            activityAlert = $"🚀 {ProgressNotesToday} notes today — exceptional! Keep that fire going.";
        else if (ProgressNotesToday >= 3)
            activityAlert = $"⭐ {ProgressNotesToday} notes today — great momentum!";
        else if (TodosCompletedToday >= 3)
            activityAlert = $"✅ {TodosCompletedToday} todos done today — you're crushing it!";
        else if (ProgressThisWeek == 1 && ProgressNotesToday >= 1)
            activityAlert = "🚀 First note of the week — great start!";
        else if (ProgressNotesToday >= 1 && DateTime.Now.Hour < 12)
            activityAlert = "🌅 Morning check-in complete — starting the day with purpose!";
        else if (TodosCompletedToday >= 1)
            activityAlert = $"✅ {TodosCompletedToday} todo{(TodosCompletedToday == 1 ? "" : "s")} done today — every task counts.";
    }
}
@if (activityAlert is not null)
{
    <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">@activityAlert</MudAlert>
}
@if (MostFocusedGoalThisWeekName is not null && string.IsNullOrWhiteSpace(FilterText))
{
