@{
    var nmMilestones576 = new[] { 100, 50, 25, 10, 5 };
    Goal? nmNearGoal = null;
    int nmNearTarget = 0;
    int nmNearLeft = 0;
    if (string.IsNullOrWhiteSpace(FilterText))
    {
        foreach (var nmG in AllActiveGoals)
        {
            var nmCount = ProgressCounts.GetValueOrDefault(nmG.Guid);
            foreach (var nmT in nmMilestones576)
            {
                var nmLeft = nmT - nmCount;
                if (nmLeft > 0 && nmLeft <= 2) { nmNearGoal = nmG; nmNearTarget = nmT; nmNearLeft = nmLeft; break; }
            }
            if (nmNearGoal is not null) break;
        }
    }
}
@if (nmNearGoal is not null)
{
    var nmNearName = nmNearGoal.GoalText?.Length > 50 ? nmNearGoal.GoalText[..50] + "…" : nmNearGoal.GoalText;
    <MudAlert Severity="Severity.Success" Icon="@Icons.Material.Filled.EmojiEvents" Dense="true" Class="mb-3">
        🏆 <strong>Almost there!</strong> "@nmNearName" is just @nmNearLeft more note@(nmNearLeft == 1 ? "" : "s") away from @nmNearTarget! Keep going!
        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success"
                   Href="@($"/goals/{nmNearGoal.Guid}")" Class="ml-1">Add Note</MudButton>
    </MudAlert>
}
@{
    var ddNowMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
    Goal? ddGoal = null;
    int ddDaysLeft = 0;
    if (string.IsNullOrWhiteSpace(FilterText))
    {
        foreach (var ddG in AllActiveGoals.Where(g => g.ExpirationDate.HasValue && g.CompletionDate == null).OrderBy(g => g.ExpirationDate))
        {
            var ddLeft = (int)Math.Ceiling((ddG.ExpirationDate!.Value - ddNowMs) / 86_400_000.0);
            if (ddLeft <= 7 && ddLeft >= 0) { ddGoal = ddG; ddDaysLeft = ddLeft; break; }
        }
    }
}
@if (ddGoal is not null)
{
    var ddName = ddGoal.GoalText?.Length > 50 ? ddGoal.GoalText[..50] + "…" : ddGoal.GoalText;
    var ddLabel = ddDaysLeft == 0 ? "due today!" : ddDaysLeft == 1 ? "due tomorrow" : $"due in {ddDaysLeft} days";
    <MudAlert Severity="Severity.Warning" Icon="@Icons.Material.Filled.Timer" Dense="true" Class="mb-3">
        ⏰ <strong>"@ddName"</strong> is @ddLabel — now's the time to make it count!
        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning"
                   Href="@($"/goals/{ddGoal.Guid}")" Class="ml-1">View goal</MudButton>
    </MudAlert>
}
@{
    Goal? mxdGoal = null;
    int mxdDaysLeft = 0;
    if (ddGoal is null && string.IsNullOrWhiteSpace(FilterText))
    {
        foreach (var mxdG in AllActiveGoals.Where(g => g.ExpirationDate.HasValue && g.CompletionDate == null).OrderBy(g => g.ExpirationDate))
        {
            var mxdLeft = (int)Math.Ceiling((mxdG.ExpirationDate!.Value - ddNowMs) / 86_400_000.0);
            if (mxdLeft > 7 && mxdLeft <= 30) { mxdGoal = mxdG; mxdDaysLeft = mxdLeft; break; }
        }
    }
}
@if (mxdGoal is not null)
{
    var mxdName = mxdGoal.GoalText?.Length > 50 ? mxdGoal.GoalText[..50] + "…" : mxdGoal.GoalText;
    <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.CalendarToday" Dense="true" Class="mb-3">
        📋 <strong>"@mxdName"</strong> — target date in @mxdDaysLeft days. Steady progress matters — keep going!
        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Info"
                   Href="@($"/goals/{mxdGoal.Guid}")" Class="ml-1">View goal</MudButton>
    </MudAlert>
}
@{
    Goal? odGoal = null;
    int odDaysOver = 0;
    if (string.IsNullOrWhiteSpace(FilterText))
    {
        foreach (var odG in AllActiveGoals.Where(g => g.ExpirationDate.HasValue && g.CompletionDate == null).OrderBy(g => g.ExpirationDate))
        {
            var odOver = (int)Math.Floor((ddNowMs - odG.ExpirationDate!.Value) / 86_400_000.0);
            if (odOver >= 1) { odGoal = odG; odDaysOver = odOver; break; }
        }
    }
}
@if (odGoal is not null)
{
    var odName = odGoal.GoalText?.Length > 50 ? odGoal.GoalText[..50] + "…" : odGoal.GoalText;
    var odMsg = odDaysOver == 1
        ? $"This goal's target date was yesterday — take a moment to reflect or set a new target!"
        : $"This goal's target date was {odDaysOver} days ago — it's worth a moment to reflect on where you are!";
    <MudAlert Severity="Severity.Warning" Icon="@Icons.Material.Filled.EventBusy" Dense="true" Class="mb-3">
        ⏰ <strong>"@odName"</strong> — @odMsg
        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning"
                   Href="@($"/goals/{odGoal.Guid}")" Class="ml-1">Reflect on goal</MudButton>
    </MudAlert>
}
@if (AnniversaryGoalName is not null && string.IsNullOrWhiteSpace(FilterText))
{
    var annivMsg = AnniversaryDaysUntil == 0
        ? $"🎂 <strong>Today is day {AnniversaryDays}!</strong> Congratulations on \"{AnniversaryGoalName}\" — {AnniversaryDays} days of real commitment! 🎉"
        : AnniversaryDaysUntil > 0
            ? $"🎂 <strong>{AnniversaryDays}-day milestone in {AnniversaryDaysUntil} day{(AnniversaryDaysUntil == 1 ? "" : "s")}!</strong> Nearly {AnniversaryDays} days on \"{AnniversaryGoalName}\" — the finish line is close!"
            : $"🎉 <strong>{AnniversaryDays}-day milestone reached!</strong> \"{AnniversaryGoalName}\" just hit {AnniversaryDays} days — that's incredible dedication! Celebrate this! 🌟";
    <MudAlert Severity="Severity.Success" Icon="@Icons.Material.Filled.Celebration" Dense="true" Class="mb-3">
        @((MarkupString)annivMsg)
        @if (!string.IsNullOrWhiteSpace(AnniversaryGoalGuid))
        {
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success"
                       Href="@($"/goals/{AnniversaryGoalGuid}")" Class="ml-1">View goal</MudButton>
        }
    </MudAlert>
}
@if (NextMeetingGoalName is not null && string.IsNullOrWhiteSpace(FilterText))
{
    var mtgDaysLabel = NextMeetingDaysAway == 0 ? "today!" : NextMeetingDaysAway == 1 ? "tomorrow" : $"in {NextMeetingDaysAway} days";
    <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.CalendarToday" Dense="true" Class="mb-3">
        📅 <strong>Meeting @mtgDaysLabel</strong> on "@NextMeetingGoalName" — time to prepare your update!
        @if (!string.IsNullOrWhiteSpace(NextMeetingGoalGuid))
        {
