<MudPaper Elevation="0" Class="pa-3 mb-3"
          Style="border-left:3px solid var(--mud-palette-primary-lighten);background:transparent;">
    <MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-style:italic;">@todayQuote</MudText>
</MudPaper>

@if (IsNewWeeklyRecord && string.IsNullOrWhiteSpace(FilterText))
{
    <MudAlert Severity="Severity.Success" Icon="@Icons.Material.Filled.EmojiEvents" Dense="true" Class="mb-2">
        🎉 <strong>NEW PERSONAL RECORD!</strong> @ProgressThisWeek progress notes this week — your best week in months! Incredible! 🌟
    </MudAlert>
}
@if (ProgressThisWeek > 0 && string.IsNullOrWhiteSpace(FilterText))
{
    var wMsg = GoalsProgressedThisWeek == 1
        ? $"This week: {ProgressThisWeek} progress note{(ProgressThisWeek == 1 ? "" : "s")} on 1 goal! 💪 Keep going!"
        : $"This week: {ProgressThisWeek} progress note{(ProgressThisWeek == 1 ? "" : "s")} across {GoalsProgressedThisWeek} goals! 🌟 Amazing work!";
    <MudAlert Severity="Severity.Success" Icon="@Icons.Material.Filled.TrendingUp" Dense="true" Class="mb-2">@wMsg</MudAlert>
}
@if (GoalStreaks.Any() && string.IsNullOrWhiteSpace(FilterText))
{
    var bestEntry = GoalStreaks.MaxBy(kv => kv.Value);
    var bestGoal = AllActiveGoals.FirstOrDefault(g => g.Guid == bestEntry.Key);
    if (bestGoal is not null && bestEntry.Value >= 2)
    {
        var truncName = bestGoal.GoalText?.Length > 50 ? bestGoal.GoalText[..50] + "…" : bestGoal.GoalText;
        if (bestEntry.Value >= 8)
        {
            <MudPaper Elevation="3" Class="pa-3 mb-2" Style="border-radius:14px;background:linear-gradient(135deg,rgba(255,152,0,.18) 0%,rgba(255,193,7,.10) 100%);border:2px solid var(--mud-palette-warning);">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudText Typo="Typo.h5" Style="line-height:1;">🏆</MudText>
                    <MudStack Spacing="0" Style="flex:1">
                        <MudText Typo="Typo.caption" Color="Color.Warning" Style="font-weight:700;letter-spacing:0.5px;">STREAK CHAMPION — @bestEntry.Value WEEKS!</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">"@truncName" — @bestEntry.Value consecutive weeks of progress. That's extraordinary dedication! 🌟</MudText>
                    </MudStack>
