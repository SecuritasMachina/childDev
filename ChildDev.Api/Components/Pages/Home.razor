@page "/"
@inject AppDbContext Db
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor
@inject ISnackbar Snackbar
@inject WebAnalyticsService Analytics

<PageTitle>My Goals – ChildDev</PageTitle>

@if (AccountGuid is null)
{
    <div class="hero-section" style="min-height:72vh;display:flex;align-items:center;">
        <MudGrid Spacing="6" Justify="Justify.Center" Style="align-items:center;width:100%;">
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.overline" Color="Color.Primary" Style="font-weight:700;letter-spacing:2.5px;">
                    🚀 Goal Achievement for Kids
                </MudText>
                <MudText Typo="Typo.h3" Class="mt-2 mb-4" Style="line-height:1.15;font-weight:800;">
                    Set Goals.<br />
                    Track Progress.<br />
                    <span style="color:#F57C00;">Celebrate Wins! 🎉</span>
                </MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6"
                         Style="max-width:480px;line-height:1.8;font-size:1.05rem;">
                    ChildDev helps kids and caregivers set meaningful goals, track every step forward, and
                    celebrate achievements along the way.
                </MudText>
                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/login"
                               Size="Size.Large" Style="font-weight:700;min-width:130px;border-radius:12px;">
                        Log In
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Href="/register" Size="Size.Large"
                               Style="background:#F57C00;color:#fff;font-weight:700;min-width:160px;border-radius:12px;">
                        Get Started Free ✨
                    </MudButton>
                </MudStack>
            </MudItem>
            <MudItem xs="12" md="6">
                <div class="growth-graphic">
                    <!-- Inline SVG: child growth journey illustration -->
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 360 300" width="360" height="300" aria-label="Child growth journey">
                        <!-- Ground -->
                        <rect x="0" y="260" width="360" height="40" rx="4" fill="#e8eaf6"/>
                        <!-- Path/steps going upward -->
                        <rect x="40"  y="240" width="50" height="20" rx="4" fill="#c5cae9"/>
                        <rect x="110" y="210" width="50" height="50" rx="4" fill="#9fa8da"/>
                        <rect x="180" y="175" width="50" height="85" rx="4" fill="#7986cb"/>
                        <rect x="250" y="140" width="50" height="120" rx="4" fill="#3949ab"/>
                        <!-- Stars above each step -->
                        <!-- Step 1 star -->
                        <text x="65"  y="228" text-anchor="middle" font-size="18" class="star-pop">⭐</text>
                        <!-- Step 2 star -->
                        <text x="135" y="198" text-anchor="middle" font-size="20" class="star-pop" style="animation-delay:.1s">⭐</text>
                        <!-- Step 3 star -->
                        <text x="205" y="163" text-anchor="middle" font-size="22" class="star-pop" style="animation-delay:.2s">⭐</text>
                        <!-- Step 4 star (trophy) -->
                        <text x="275" y="125" text-anchor="middle" font-size="30" class="star-pop" style="animation-delay:.3s">🏆</text>
                        <!-- Kid figure at top step -->
                        <!-- Body -->
                        <circle cx="275" cy="100" r="14" fill="#FFB74D" stroke="#F57C00" stroke-width="2"/>
                        <!-- Smile -->
                        <path d="M269 103 Q275 108 281 103" stroke="#E65100" stroke-width="1.5" fill="none" stroke-linecap="round"/>
                        <!-- Eyes -->
                        <circle cx="271" cy="98" r="2" fill="#333"/>
                        <circle cx="279" cy="98" r="2" fill="#333"/>
                        <!-- Arms raised (celebrating) -->
                        <line x1="261" y1="107" x2="251" y2="95" stroke="#F57C00" stroke-width="3" stroke-linecap="round"/>
                        <line x1="289" y1="107" x2="299" y2="95" stroke="#F57C00" stroke-width="3" stroke-linecap="round"/>
                        <!-- Body -->
                        <rect x="265" y="114" width="20" height="22" rx="4" fill="#3949AB"/>
                        <!-- Legs -->
                        <line x1="269" y1="136" x2="265" y2="155" stroke="#3949AB" stroke-width="4" stroke-linecap="round"/>
                        <line x1="281" y1="136" x2="285" y2="155" stroke="#3949AB" stroke-width="4" stroke-linecap="round"/>
                        <!-- Floating stars decoration -->
                        <text x="20"  y="180" font-size="14" opacity=".5">✨</text>
                        <text x="330" y="200" font-size="12" opacity=".4">✨</text>
                        <text x="150" y="60"  font-size="10" opacity=".35">⭐</text>
                        <text x="310" y="80"  font-size="16" opacity=".4">🌟</text>
                        <!-- Labels on steps -->
                        <text x="65"  y="253" text-anchor="middle" font-size="9" fill="#5c6bc0" font-weight="600">Start</text>
                        <text x="135" y="253" text-anchor="middle" font-size="9" fill="#5c6bc0" font-weight="600">Learn</text>
                        <text x="205" y="253" text-anchor="middle" font-size="9" fill="#fff" font-weight="600">Grow</text>
                        <text x="275" y="253" text-anchor="middle" font-size="9" fill="#fff" font-weight="600">Win!</text>
                    </svg>
                </div>
                <MudGrid Spacing="2" Class="mt-3">
                    <MudItem xs="6">
                        <MudPaper Elevation="3" Class="pa-3 text-center feature-card">
                            <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Primary" Style="font-size:2rem;" />
                            <MudText Typo="Typo.subtitle2" Class="mt-1">Track Goals</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Meaningful milestones</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="6">
                        <MudPaper Elevation="3" Class="pa-3 text-center feature-card">
                            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Success" Style="font-size:2rem;" />
                            <MudText Typo="Typo.subtitle2" Class="mt-1">See Progress</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Celebrate each step</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="6">
                        <MudPaper Elevation="3" Class="pa-3 text-center feature-card">
                            <MudIcon Icon="@Icons.Material.Filled.Book" Color="Color.Info" Style="font-size:2rem;" />
                            <MudText Typo="Typo.subtitle2" Class="mt-1">Journal</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Record growth moments</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="6">
                        <MudPaper Elevation="3" Class="pa-3 text-center feature-card">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Warning" Style="font-size:2rem;" />
                            <MudText Typo="Typo.subtitle2" Class="mt-1">Manage Tasks</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Goals into action</MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudItem>
        </MudGrid>
    </div>
    return;
}

<MudGrid Class="mb-6">
    <MudItem xs="12" sm="4">
        <MudPaper Elevation="2" Class="pa-4 text-center stat-card-goals" Style="cursor:default;border-radius:12px;">
            <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Primary" Style="font-size:2rem;" />
            <MudText Typo="Typo.h4" Class="mt-1">@AllActiveGoals.Count</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Active Goal@(AllActiveGoals.Count == 1 ? "" : "s")</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudLink Href="/todos" Underline="Underline.None" Style="display:block;">
            <MudPaper Elevation="2" Class="pa-4 text-center stat-card-todos" Style="cursor:pointer;border-radius:12px;">
                <MudIcon Icon="@Icons.Material.Filled.CheckBox" Color="@(OverdueTodoCount > 0 ? Color.Error : Color.Primary)" Style="font-size:2rem;" />
                <MudText Typo="Typo.h4" Class="mt-1">
                    @PendingTodoCount
                    @if (OverdueTodoCount > 0)
                    {
                        <MudChip T="string" Color="Color.Error" Size="Size.Small" Class="ml-1">@OverdueTodoCount overdue</MudChip>
                    }
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Pending Todo@(PendingTodoCount == 1 ? "" : "s")</MudText>
            </MudPaper>
        </MudLink>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudLink Href="/journal" Underline="Underline.None" Style="display:block;">
            <MudPaper Elevation="2" Class="pa-4 text-center stat-card-journal" Style="cursor:pointer;border-radius:12px;">
                <MudIcon Icon="@Icons.Material.Filled.Book" Color="Color.Primary" Style="font-size:2rem;" />
                <MudText Typo="Typo.h4" Class="mt-1">@JournalThisWeek</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Journal Entr@(JournalThisWeek == 1 ? "y" : "ies") This Week</MudText>
            </MudPaper>
        </MudLink>
    </MudItem>
</MudGrid>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5">
        <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Class="mr-2" />
        My Goals
    </MudText>
    <MudSpacer />
    <MudTextField Value="@FilterText" ValueChanged="@((string v) => OnFilterChanged(v))"
                  Placeholder="Search goals…" Variant="Variant.Outlined"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                  Clearable="true" Margin="Margin.Dense" Style="max-width:260px;" />
</MudStack>

@if (!string.IsNullOrWhiteSpace(FilterText) && ActiveGoals.Count == 0)
{
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">No goals matching "@FilterText".</MudText>
}

@if (!AllActiveGoals.Any() && string.IsNullOrWhiteSpace(FilterText))
{
    <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.Lightbulb" Class="mb-4">
        <strong>Get started:</strong> Add your first goal below. Goals are the heart of ChildDev — everything else (progress notes, todos, and journal entries) ties back to helping you reach them.
    </MudAlert>
}

@* Goal of the Day — featured spotlight on the goal that needs attention most *@
@if (FeaturedGoal is not null)
{
    var fg = FeaturedGoal;
    var fgPCount = ProgressCounts.GetValueOrDefault(fg.Guid);
    var fgLastAt = LastProgressAt.GetValueOrDefault(fg.Guid);
    var fgDaysSince = fgPCount > 0 ? (int)((DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - fgLastAt) / 86_400_000L) : -1;
    var fgNudge = fgPCount == 0 ? "No progress notes yet — add your first one!" :
                  fgDaysSince == 0 ? "You worked on this today! 🔥 Keep the streak alive!" :
                  fgDaysSince == 1 ? "You updated this yesterday — stay on it! 💪" :
                  fgDaysSince <= 7 ? $"Last updated {fgDaysSince} days ago — time for a new note!" :
                  $"It's been {fgDaysSince} days — let's check in on this goal! 🌱";
    LatestNextStep.TryGetValue(fg.Guid, out var fgNextStep);
    <MudPaper Elevation="4" Class="pa-4 mb-4" Style="border-radius:16px;border:2px solid var(--mud-palette-primary);background:linear-gradient(135deg,rgba(63,81,181,.06) 0%,rgba(255,255,255,0) 100%);">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
            <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" />
            <MudText Typo="Typo.overline" Color="Color.Primary" Style="font-weight:700;letter-spacing:1.5px;">Focus Goal</MudText>
        </MudStack>
        <MudText Typo="Typo.h6" Class="mb-1">@fg.GoalText</MudText>
        @if (fg.MeasurableOutcome is not null)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">📏 @fg.MeasurableOutcome</MudText>
        }
        <MudAlert Severity="@(fgDaysSince >= 0 && fgDaysSince <= 1 ? Severity.Success : Severity.Info)"
                  Dense="true" Class="mb-2" NoIcon="@(fgPCount == 0)">@fgNudge</MudAlert>
        @if (!string.IsNullOrWhiteSpace(fgNextStep))
        {
            var truncated = fgNextStep.Length > 120 ? fgNextStep[..120] + "…" : fgNextStep;
            <MudText Typo="Typo.body2" Color="Color.Primary" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Style="vertical-align:middle;" /> @truncated
            </MudText>
        }
        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@($"/goals/{fg.Guid}")"
                       StartIcon="@Icons.Material.Filled.TrendingUp">View Progress</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="() => OpenQuickNote(fg.Guid)">Add Note</MudButton>
            @if (fg.CompletionDate is null)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.EmojiEvents"
                           OnClick="() => CompleteGoal(fg.Guid)">Mark Complete 🎉</MudButton>
            }
        </MudStack>
    </MudPaper>
}

<MudGrid>
    @foreach (var g in ActiveGoals)
    {
        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="2" Class="h-100">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudAvatar Color="Color.Primary" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Filled.Flag" />
                        </MudAvatar>
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudText Typo="Typo.body1">@g.GoalText</MudText>
                        @if (g.MeasurableOutcome is not null)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">📏 @g.MeasurableOutcome</MudText>
                        }
                        @if (g.NextMeetingDate.HasValue)
                        {
                            var mtg = DateTimeOffset.FromUnixTimeMilliseconds(g.NextMeetingDate.Value).LocalDateTime;
                            var mtgDays = (mtg.Date - DateTime.Today).Days;
                            string mtgLabel2;
                            Color mtgColor2;
                            if (mtgDays < 0) { mtgLabel2 = mtgDays == -1 ? "📅 Missed yesterday" : $"📅 Missed {-mtgDays}d ago"; mtgColor2 = Color.Warning; }
                            else if (mtgDays == 0) { mtgLabel2 = "📅 Meeting today!"; mtgColor2 = Color.Success; }
                            else if (mtgDays == 1) { mtgLabel2 = "📅 Meeting tomorrow"; mtgColor2 = Color.Info; }
                            else { mtgLabel2 = $"📅 Meeting in {mtgDays} days"; mtgColor2 = Color.Info; }
                            <MudText Typo="Typo.caption" Color="@mtgColor2">@mtgLabel2</MudText>
                        }
                    </CardHeaderContent>
                </MudCardHeader>
                @{
                    var pCount = ProgressCounts.GetValueOrDefault(g.Guid);
                    var nowMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
                    var todayStartMs = new DateTimeOffset(DateTime.SpecifyKind(DateTime.Today, DateTimeKind.Local)).ToUnixTimeMilliseconds();
                    var sevenDaysFromNowMs = todayStartMs + 7L * 86_400_000L;
                    var isExpired = g.ExpirationDate.HasValue && g.ExpirationDate.Value < todayStartMs;
                    var isExpiringSoon = !isExpired && g.ExpirationDate.HasValue && g.ExpirationDate.Value < sevenDaysFromNowMs;
                    var lastAt = LastProgressAt.GetValueOrDefault(g.Guid);
                    var daysSinceProgress = pCount > 0 ? (int)((nowMs - lastAt) / 86_400_000L) : -1;
                    var isStale = daysSinceProgress >= 14;
                    // Countdown label
                    string? expiryLabel = null;
                    if (isExpired && g.ExpirationDate.HasValue)
                    {
                        var daysOver = (int)((todayStartMs - g.ExpirationDate.Value) / 86_400_000L);
                        expiryLabel = daysOver <= 1 ? "Past due" : $"{daysOver}d overdue";
                    }
                    else if (isExpiringSoon && g.ExpirationDate.HasValue)
                    {
                        var expDate = DateTimeOffset.FromUnixTimeMilliseconds(g.ExpirationDate.Value).LocalDateTime.Date;
                        var daysLeft = (expDate - DateTime.Today).Days;
                        expiryLabel = daysLeft == 0 ? "Due today" : daysLeft == 1 ? "Due tomorrow" : $"Due in {daysLeft}d";
                    }
                }
                <MudCardContent Class="pt-0">
                    @if (pCount == 0 && !isExpired && !isExpiringSoon)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">No notes yet</MudText>
                    }
                    @if (pCount > 0)
                    {
                        <MudChip T="string" Icon="@Icons.Material.Filled.CheckCircle" Color="@(isStale ? Color.Warning : Color.Success)" Size="Size.Small" Class="mr-1">
                            @if (daysSinceProgress == 0)
                            {
                                @("Updated today")
                            }
                            else if (daysSinceProgress == 1)
                            {
                                @("Updated yesterday")
                            }
                            else
                            {
                                @($"Updated {daysSinceProgress}d ago")
                            }
                        </MudChip>
                    }
                    @if (isExpired)
                    {
                        <MudChip T="string" Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Size="Size.Small">@expiryLabel</MudChip>
                    }
                    else if (isExpiringSoon)
                    {
                        <MudChip T="string" Icon="@Icons.Material.Filled.Schedule" Color="Color.Warning" Size="Size.Small">@expiryLabel</MudChip>
                    }
                    @if (LatestNextStep.TryGetValue(g.Guid, out var nextStep))
                    {
                        var truncated = nextStep.Length > 90 ? nextStep[..90] + "…" : nextStep;
                        <MudText Typo="Typo.caption" Color="Color.Primary" Class="mt-2 d-block">
                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Style="vertical-align:middle;" /> @truncated
                        </MudText>
                    }
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary"
                               Href="@($"/goals/{g.Guid}")">View</MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="() => OpenQuickNote(g.Guid)">Note</MudButton>
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                   Color="Color.Success" aria-label="Mark goal complete"
                                   OnClick="() => CompleteGoal(g.Guid)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error" Size="Size.Small" aria-label="Delete goal"
                                   OnClick="() => _confirmDeleteGoalGuid = g.Guid" />
                </MudCardActions>
            </MudCard>
        </MudItem>
    }

    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="1" Style="border: 2px dashed var(--mud-palette-primary); cursor:pointer;"
                 Class="h-100 d-flex align-items-center justify-content-center"
                 @onclick="OpenAddGoalDialog">
            <MudCardContent Class="text-center">
                <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Color="Color.Primary" Style="font-size:3rem;" />
                <MudText Typo="Typo.body1" Color="Color.Primary" Class="mt-2">Add New Goal</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@if (CompletedGoals.Any())
{
    <MudExpansionPanels Class="mt-6">
        <MudExpansionPanel Text="@($"Completed Goals ({CompletedGoals.Count})")">
            <MudList T="Goal" Dense="true">
                @foreach (var g in CompletedGoals)
                {
                    var completedOn = DateTimeOffset.FromUnixTimeMilliseconds(g.CompletionDate!.Value).LocalDateTime;
                    var daysAgo = (int)(DateTime.Now - completedOn).TotalDays;
                    string completedLabel;
                    if (daysAgo == 0) completedLabel = "Completed today!";
                    else if (daysAgo == 1) completedLabel = "Completed yesterday";
                    else if (daysAgo < 7) completedLabel = $"Completed {daysAgo} days ago";
                    else if (daysAgo < 14) completedLabel = "Completed 1 week ago";
                    else if (daysAgo < 60) completedLabel = $"Completed {daysAgo / 7} weeks ago";
                    else if (daysAgo < 365) completedLabel = $"Completed {daysAgo / 30} months ago";
                    else completedLabel = $"Completed {completedOn:MMM d, yyyy}";
                    <MudListItem>
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                            <MudStack Spacing="0" Style="flex:1">
                                <MudText Typo="Typo.body2" Class="text-decoration-line-through">@g.GoalText</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@completedLabel</MudText>
                            </MudStack>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                       Href="@($"/goals/{g.Guid}")">View</MudButton>
                        </MudStack>
                    </MudListItem>
                }
            </MudList>
        </MudExpansionPanel>
    </MudExpansionPanels>
}

@* Goal completion celebration *@
<MudDialog @bind-Visible="ShowCelebration" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <DialogContent>
        <MudStack AlignItems="AlignItems.Center" Spacing="3" Class="pa-4">
            <MudText Typo="Typo.h2" Class="celeb-emoji">🎉</MudText>
            <MudText Typo="Typo.h5" Align="Align.Center" Color="Color.Success">Goal Achieved!</MudText>
            <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary">@CelebratedGoalText</MudText>
            <MudText Typo="Typo.body2" Align="Align.Center">
                Amazing work! Every big achievement starts with a single step. 🌟
            </MudText>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true"
                   OnClick="() => ShowCelebration = false">Awesome! 🙌</MudButton>
    </DialogActions>
</MudDialog>

@* Quick Add Todo *@
<MudPaper Elevation="1" Class="pa-4 mt-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
        <MudText Typo="Typo.subtitle2">
            <MudIcon Icon="@Icons.Material.Filled.CheckBox" Class="mr-1" Size="Size.Small" />
            Quick Add Todo
        </MudText>
        <MudSpacer />
        <MudButton Href="/todos" Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small">View All</MudButton>
    </MudStack>
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudTextField @bind-Value="QuickTodoText"
                      Label="What needs to be done?"
                      Variant="Variant.Outlined" Margin="Margin.Dense"
                      Style="flex:1" Immediate="true"
                      @onkeydown="@(async (e) => { if (e.Key == "Enter") await SaveQuickTodo(); })" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Disabled="@string.IsNullOrWhiteSpace(QuickTodoText)"
                   OnClick="SaveQuickTodo">Add</MudButton>
    </MudStack>
</MudPaper>

@* Recent journal entries + quick-add *@
<MudPaper Elevation="1" Class="pa-4 mt-6">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
        <MudText Typo="Typo.subtitle2">
            <MudIcon Icon="@Icons.Material.Filled.Book" Class="mr-1" Size="Size.Small" />
            Recent Journal
        </MudText>
        <MudSpacer />
        <MudButton Href="/journal" Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small">View All</MudButton>
    </MudStack>
    @if (RecentJournals.Any())
    {
        <MudList T="Journal" Dense="true" Class="mb-4">
            @foreach (var j in RecentJournals)
            {
                var jDate = DateTimeOffset.FromUnixTimeMilliseconds(j.EnteredDate).LocalDateTime;
                <MudListItem>
                    <MudStack Row="true" AlignItems="AlignItems.Start">
                        <MudStack Spacing="0" Style="flex:1">
                            @{
                                var displayText = j.Notes ?? j.Activity;
                                var truncated = displayText?.Length > 120 ? displayText[..120] + "…" : displayText;
                            }
                            <MudText Typo="Typo.body2">@truncated</MudText>
                            @if (!string.IsNullOrWhiteSpace(j.Notes) && !string.IsNullOrWhiteSpace(j.Activity))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@j.Activity</MudText>
                            }
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="white-space:nowrap">@jDate.ToString("MMM d")</MudText>
                    </MudStack>
                </MudListItem>
            }
        </MudList>
    }
    else
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">No journal entries yet.</MudText>
    }
    <MudDivider Class="mb-3" />
    <MudText Typo="Typo.subtitle2" Class="mb-3">
        <MudIcon Icon="@Icons.Material.Filled.EditNote" Class="mr-1" Size="Size.Small" />
        Quick Journal Entry
    </MudText>
    <MudTextField @bind-Value="QuickJournalText"
                  Label="What happened today? What did you observe?"
                  Variant="Variant.Outlined" Lines="2" Class="mb-3" />
    <MudButton Variant="Variant.Filled" Color="Color.Secondary"
               StartIcon="@Icons.Material.Filled.Save"
               Disabled="@string.IsNullOrWhiteSpace(QuickJournalText)"
               OnClick="SaveQuickJournal">Save Entry</MudButton>
</MudPaper>

@* Quick progress note dialog *@
<MudDialog @bind-Visible="ShowQuickNoteDialog">
    <TitleContent>
        <MudStack Spacing="0">
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Class="mr-2" />
                Add Progress Note
            </MudText>
            @if (!string.IsNullOrWhiteSpace(QuickNoteGoalText))
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">@QuickNoteGoalText</MudText>
            }
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="QuickNoteText" Label="What happened? What's the next step?"
                      Variant="Variant.Outlined" Lines="3" AutoFocus="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => ShowQuickNoteDialog = false">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveQuickNote"
                   Disabled="@string.IsNullOrWhiteSpace(QuickNoteText)">Save Note</MudButton>
    </DialogActions>
</MudDialog>

@* Delete Goal Confirmation *@
<MudDialog Visible="@(_confirmDeleteGoalGuid is not null)" VisibleChanged="@((bool v) => { if (!v) _confirmDeleteGoalGuid = null; })">
    <TitleContent>
        <MudText Typo="Typo.h6" Color="Color.Error">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Class="mr-2" />
            Delete Goal?
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText>This will permanently remove the goal. This action cannot be undone.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _confirmDeleteGoalGuid = null">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ConfirmDeleteGoal">Delete</MudButton>
    </DialogActions>
</MudDialog>

@* Add Goal Dialog *@
<MudDialog @bind-Visible="ShowAddDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Flag" Class="mr-2" />
            New Goal
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="NewGoalText" Label="What's the goal?" Variant="Variant.Outlined"
                      Lines="2" Class="mb-4" AutoFocus="true" />
        <MudTextField @bind-Value="NewMeasurableOutcome" Label="How will you measure success? (optional)"
                      Variant="Variant.Outlined" HelperText="e.g. Read 10 books, Tie shoes independently" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => ShowAddDialog = false">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddGoal"
                   Disabled="@string.IsNullOrWhiteSpace(NewGoalText)">Add Goal</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private string? AccountGuid;
    private List<Goal> AllActiveGoals = [];
    private List<Goal> ActiveGoals = [];
    private List<Goal> CompletedGoals = [];
    private Goal? FeaturedGoal;
    private string FilterText = string.Empty;
    private Dictionary<string, int> ProgressCounts = new();
    private Dictionary<string, long> LastProgressAt = new();
    private Dictionary<string, string> LatestNextStep = new();
    private bool ShowAddDialog;
    private string NewGoalText = string.Empty;
    private string? NewMeasurableOutcome;
    private int PendingTodoCount;
    private int OverdueTodoCount;
    private int JournalThisWeek;
    private string QuickJournalText = string.Empty;
    private string QuickTodoText = string.Empty;
    private List<Journal> RecentJournals = [];
    private bool ShowCelebration;
    private string? CelebratedGoalText;
    private bool ShowQuickNoteDialog;
    private string? QuickNoteGoalGuid;
    private string? QuickNoteGoalText;
    private string QuickNoteText = string.Empty;
    private string? _confirmDeleteGoalGuid;

    protected override async Task OnInitializedAsync()
    {
        AccountGuid = HttpContextAccessor.HttpContext?.Session.GetString("AccountGuid");
        if (AccountGuid is null) return;
        await LoadGoals();
        await LoadStats();
        await Analytics.TrackAsync("page_view", AccountGuid, "home");
    }

    private async Task LoadStats()
    {
        var todos = await Db.Todos
            .Where(t => t.AccountFk == AccountGuid && t.DeletedAt == null && t.CompletedAt == null)
            .Select(t => t.DueDate)
            .ToListAsync();
        var todayStartMs = new DateTimeOffset(DateTime.SpecifyKind(DateTime.Today, DateTimeKind.Local)).ToUnixTimeMilliseconds();
        PendingTodoCount = todos.Count;
        OverdueTodoCount = todos.Count(d => d.HasValue && d.Value < todayStartMs);

        var weekStartMs = DateTimeOffset.UtcNow.AddDays(-7).ToUnixTimeMilliseconds();
        JournalThisWeek = await Db.Journals
            .CountAsync(j => j.AccountFk == AccountGuid && j.DeletedAt == null && j.EnteredDate >= weekStartMs);

        RecentJournals = await Db.Journals
            .Where(j => j.AccountFk == AccountGuid && j.DeletedAt == null)
            .OrderByDescending(j => j.EnteredDate)
            .Take(3)
            .ToListAsync();
    }

    private async Task LoadGoals()
    {
        var goals = await Db.Goals
            .Where(g => g.AccountFk == AccountGuid && g.DeletedAt == null)
            .OrderByDescending(g => g.EnteredDate)
            .ToListAsync();

        AllActiveGoals = goals.Where(g => g.CompletionDate == null).ToList();
        CompletedGoals = goals.Where(g => g.CompletionDate != null).ToList();

        var guids = AllActiveGoals.Select(g => g.Guid).ToList();
        var progressGroups = await Db.GoalProgresses
            .Where(p => guids.Contains(p.GoalFk) && p.DeletedAt == null)
            .GroupBy(p => p.GoalFk)
            .Select(grp => new { GoalFk = grp.Key, Count = grp.Count(), LastAt = grp.Max(p => p.UpdatedOn) })
            .ToListAsync();
        ProgressCounts = progressGroups.ToDictionary(x => x.GoalFk, x => x.Count);
        LastProgressAt = progressGroups.ToDictionary(x => x.GoalFk, x => x.LastAt);

        // Latest next step per goal for card preview
        var stepRows = await Db.GoalProgresses
            .Where(p => guids.Contains(p.GoalFk) && p.DeletedAt == null
                     && p.NextStepItems != null && p.NextStepItems != "")
            .Select(p => new { p.GoalFk, p.NextStepItems, p.UpdatedOn })
            .ToListAsync();
        LatestNextStep = stepRows
            .GroupBy(p => p.GoalFk)
            .ToDictionary(g => g.Key, g => g.OrderByDescending(p => p.UpdatedOn).First().NextStepItems!);

        // Sort: goals with no progress first (needs attention), then by oldest-update-first
        AllActiveGoals = AllActiveGoals
            .OrderBy(g => LastProgressAt.ContainsKey(g.Guid) ? 1 : 0)
            .ThenBy(g => LastProgressAt.GetValueOrDefault(g.Guid, 0))
            .ToList();
        ApplyFilter();
    }

    private void OnFilterChanged(string value)
    {
        FilterText = value;
        ApplyFilter();
        if (!string.IsNullOrWhiteSpace(value))
            _ = Analytics.TrackAsync("goal_filter", AccountGuid, "home");
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(FilterText))
        {
            // First goal gets "Goal of the Day" treatment; rest go in the grid
            FeaturedGoal = AllActiveGoals.Count >= 2 ? AllActiveGoals[0] : null;
            ActiveGoals = FeaturedGoal is not null ? AllActiveGoals.Skip(1).ToList() : AllActiveGoals;
            return;
        }
        FeaturedGoal = null;
        var q = FilterText.Trim();
        ActiveGoals = AllActiveGoals
            .Where(g => (g.GoalText?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                     || (g.MeasurableOutcome?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false))
            .ToList();
    }

    private void OpenAddGoalDialog()
    {
        NewGoalText = string.Empty;
        NewMeasurableOutcome = null;
        ShowAddDialog = true;
    }

    private async Task AddGoal()
    {
        var text = NewGoalText.Trim();
        if (string.IsNullOrWhiteSpace(text)) return;

        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        Db.Goals.Add(new Goal
        {
            Guid = System.Guid.NewGuid().ToString(),
            AccountFk = AccountGuid!,
            GoalText = text,
            MeasurableOutcome = string.IsNullOrWhiteSpace(NewMeasurableOutcome) ? null : NewMeasurableOutcome.Trim(),
            EnteredDate = now,
            UpdatedOn = now
        });
        await Db.SaveChangesAsync();

        NewGoalText = string.Empty;
        NewMeasurableOutcome = null;
        ShowAddDialog = false;
        await Analytics.TrackAsync("goal_add", AccountGuid, "home");
        Snackbar.Add("Goal added!", Severity.Success);
        await LoadGoals();
    }

    private async Task CompleteGoal(string guid)
    {
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        var rows = await Db.Goals
            .Where(g => g.Guid == guid && g.AccountFk == AccountGuid && g.CompletionDate == null && g.DeletedAt == null)
            .ExecuteUpdateAsync(s => s
                .SetProperty(g => g.CompletionDate, now)
                .SetProperty(g => g.UpdatedOn, now));
        if (rows == 0) return;
        await Analytics.TrackAsync("goal_complete", AccountGuid, "home", guid);
        CelebratedGoalText = AllActiveGoals.FirstOrDefault(g => g.Guid == guid)?.GoalText;
        ShowCelebration = true;
        await LoadGoals();
    }

    private async Task ConfirmDeleteGoal()
    {
        var guid = _confirmDeleteGoalGuid;
        _confirmDeleteGoalGuid = null;
        if (guid is null) return;
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        var rows = await Db.Goals
            .Where(g => g.Guid == guid && g.AccountFk == AccountGuid && g.DeletedAt == null)
            .ExecuteUpdateAsync(s => s
                .SetProperty(g => g.DeletedAt, now)
                .SetProperty(g => g.UpdatedOn, now));
        if (rows == 0) return;
        await Analytics.TrackAsync("goal_delete", AccountGuid, "home", guid);
        Snackbar.Add("Goal deleted.", Severity.Info);
        await LoadGoals();
        await LoadStats();
    }

    private void OpenQuickNote(string goalGuid)
    {
        QuickNoteGoalGuid = goalGuid;
        QuickNoteGoalText = AllActiveGoals.FirstOrDefault(g => g.Guid == goalGuid)?.GoalText;
        QuickNoteText = string.Empty;
        ShowQuickNoteDialog = true;
    }

    private async Task SaveQuickNote()
    {
        var text = QuickNoteText.Trim();
        if (string.IsNullOrWhiteSpace(text) || QuickNoteGoalGuid is null) return;
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        Db.GoalProgresses.Add(new GoalProgress
        {
            Guid = System.Guid.NewGuid().ToString(),
            AccountFk = AccountGuid!,
            GoalFk = QuickNoteGoalGuid,
            NextStepItems = text,
            UpdatedOn = now
        });
        await Db.SaveChangesAsync();
        await Analytics.TrackAsync("progress_quickadd", AccountGuid, "home", QuickNoteGoalGuid);
        ShowQuickNoteDialog = false;
        QuickNoteText = string.Empty;
        Snackbar.Add("Progress note saved!", Severity.Success);
        await LoadGoals();
    }

    private async Task SaveQuickTodo()
    {
        var title = QuickTodoText.Trim();
        if (string.IsNullOrWhiteSpace(title)) return;
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        Db.Todos.Add(new Todo
        {
            Guid = System.Guid.NewGuid().ToString(),
            AccountFk = AccountGuid!,
            Title = title,
            UpdatedOn = now
        });
        await Db.SaveChangesAsync();
        await Analytics.TrackAsync("todo_quickadd", AccountGuid, "home");
        QuickTodoText = string.Empty;
        PendingTodoCount++;
        Snackbar.Add("Todo added!", Severity.Success);
    }

    private async Task SaveQuickJournal()
    {
        var text = QuickJournalText.Trim();
        if (string.IsNullOrWhiteSpace(text)) return;
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        Db.Journals.Add(new Journal
        {
            Guid = System.Guid.NewGuid().ToString(),
            AccountFk = AccountGuid!,
            Notes = text,
            EnteredDate = now,
            UpdatedOn = now
        });
        await Db.SaveChangesAsync();
        await Analytics.TrackAsync("journal_quickadd", AccountGuid, "home");
        QuickJournalText = string.Empty;
        Snackbar.Add("Journal entry saved!", Severity.Success);
        await LoadStats();
        StateHasChanged();
    }
}
