</MudDialog>

@* Recent Progress Activity Feed *@
@if (RecentProgressNotes.Count >= 2 && string.IsNullOrWhiteSpace(FilterText))
{
    <MudPaper Elevation="1" Class="pa-4 mt-6">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
            <MudText Typo="Typo.subtitle2">
                <MudIcon Icon="@Icons.Material.Filled.Timeline" Class="mr-1" Size="Size.Small" />
                Recent Goal Activity
            </MudText>
        </MudStack>
        <MudList T="string" Dense="true">
            @foreach (var (goalFk, goalText, noteText, ts) in RecentProgressNotes)
            {
                var rpaDate = DateTimeOffset.FromUnixTimeMilliseconds(ts).LocalDateTime;
                var rpaDaysAgo = (int)(DateTime.Now - rpaDate).TotalDays;
                var rpaWhen = rpaDaysAgo == 0 ? "Today" : rpaDaysAgo == 1 ? "Yesterday" : $"{rpaDaysAgo}d ago";
                var rpaNote = noteText.Length > 100 ? noteText[..100] + "…" : noteText;
                var rpaGoal = goalText.Length > 45 ? goalText[..45] + "…" : goalText;
                var rpaHref = $"/goals/{goalFk}";
                <MudListItem Href="@rpaHref">
                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Primary" Size="Size.Small" Style="margin-top:2px;" />
                        <MudStack Spacing="0" Style="flex:1;min-width:0;">
                            <MudText Typo="Typo.body2" Style="white-space:normal;">@rpaNote</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@rpaGoal · @rpaWhen</MudText>
                        </MudStack>
                    </MudStack>
                </MudListItem>
            }
        </MudList>
    </MudPaper>
}

@* Quick Add Todo *@
<MudPaper Elevation="1" Class="pa-4 mt-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
        <MudText Typo="Typo.subtitle2">
            <MudIcon Icon="@Icons.Material.Filled.CheckBox" Class="mr-1" Size="Size.Small" />
            Quick Add Todo
        </MudText>
        <MudSpacer />
        <MudButton Href="/todos" Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small">View All</MudButton>
    </MudStack>
    @if (TopPendingTodos.Any())
    {
        var todayStartMsQ = new DateTimeOffset(DateTime.SpecifyKind(DateTime.Today, DateTimeKind.Local)).ToUnixTimeMilliseconds();
        <MudList T="string" Dense="true" Class="mb-2 py-0">
            @foreach (var (guid, title, dueDate) in TopPendingTodos)
            {
                var isOverdueQ = dueDate.HasValue && dueDate.Value < todayStartMsQ;
                var isDueTodayQ = dueDate.HasValue && dueDate.Value >= todayStartMsQ && dueDate.Value < todayStartMsQ + 86_400_000L;
                var dueLabelQ = isOverdueQ ? "overdue" : isDueTodayQ ? "today" : dueDate.HasValue ? DateTimeOffset.FromUnixTimeMilliseconds(dueDate.Value).LocalDateTime.ToString("MMM d") : null;
                var dueLabelColorQ = isOverdueQ ? "var(--mud-palette-error)" : isDueTodayQ ? "var(--mud-palette-warning-darken)" : "var(--mud-palette-text-secondary)";
                var truncTitle = title.Length > 60 ? title[..60] + "…" : title;
                var capturedGuid = guid;
                <MudListItem Style="padding-top:2px;padding-bottom:2px;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIconButton Icon="@Icons.Material.Filled.RadioButtonUnchecked" Size="Size.Small"
                                       Color="Color.Primary" Style="padding:2px;"
                                       title="Complete todo"
                                       OnClick="() => QuickCompleteTodo(capturedGuid)" />
                        <MudText Typo="Typo.body2" Style="flex:1;">@truncTitle</MudText>
                        @if (dueLabelQ is not null)
                        {
                            <MudText Typo="Typo.caption" Style="@($"color:{dueLabelColorQ};white-space:nowrap;")">@dueLabelQ</MudText>
                        }
                    </MudStack>
                </MudListItem>
            }
        </MudList>
        @if (PendingTodoCount > 3)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">+@(PendingTodoCount - 3) more pending</MudText>
        }
        <MudDivider Class="mb-3" />
    }
    @if (string.IsNullOrWhiteSpace(QuickTodoText))
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">💡 Quick ideas:</MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-3">
            @foreach (var idea in new[] { "Read 20 minutes 📚", "Do homework ✏️", "Exercise 🏃", "Clean room 🧹", "Practice instrument 🎵", "Review goal progress 🎯" })
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                         Style="cursor:pointer;" OnClick="() => QuickTodoText = idea">@idea</MudChip>
            }
        </MudStack>
    }
    @if (AllActiveGoals.Count > 0)
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Link to a goal (optional):</MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-2">
            @foreach (var ag in AllActiveGoals.Take(10))
            {
                var agShort = ag.GoalText is { Length: > 30 } t ? t[..30] + "…" : ag.GoalText ?? "";
                <MudChip T="string" Size="Size.Small"
                         Variant="@(QuickTodoGoalGuid == ag.Guid ? Variant.Filled : Variant.Outlined)"
                         Color="@(QuickTodoGoalGuid == ag.Guid ? Color.Warning : Color.Default)"
                         Style="cursor:pointer;"
                         OnClick="() => QuickTodoGoalGuid = QuickTodoGoalGuid == ag.Guid ? null : ag.Guid">@agShort</MudChip>
            }
        </MudStack>
    }
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
        <MudTextField @bind-Value="QuickTodoText"
                      Label="What needs to be done?"
                      Variant="Variant.Outlined" Margin="Margin.Dense"
                      Style="flex:1;min-width:160px;" Immediate="true"
                      @onkeydown="@(async (e) => { if (e.Key == "Enter") await SaveQuickTodo(); })" />
        <MudDatePicker @bind-Date="QuickTodoDueDate" Label="Due (opt.)"
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       Style="max-width:130px;" />
        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined"
                 Style="cursor:pointer;" title="Set due today"
                 OnClick="() => QuickTodoDueDate = DateTime.Today">Today</MudChip>
        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined"
                 Style="cursor:pointer;" title="Set due tomorrow"
                 OnClick="() => QuickTodoDueDate = DateTime.Today.AddDays(1)">Tomorrow</MudChip>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Disabled="@string.IsNullOrWhiteSpace(QuickTodoText)"
                   OnClick="SaveQuickTodo">Add</MudButton>
    </MudStack>
</MudPaper>

@* Recent journal entries + quick-add *@
<MudPaper Elevation="1" Class="pa-4 mt-6">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
        <MudText Typo="Typo.subtitle2">
            <MudIcon Icon="@Icons.Material.Filled.Book" Class="mr-1" Size="Size.Small" />
            Recent Journal
        </MudText>
        <MudSpacer />
        <MudButton Href="/journal" Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small">View All</MudButton>
    </MudStack>
    @if (RecentJournals.Any())
    {
        <MudList T="Journal" Dense="true" Class="mb-4">
            @foreach (var j in RecentJournals)
            {
                var jDate = DateTimeOffset.FromUnixTimeMilliseconds(j.EnteredDate).LocalDateTime;
                var jSearchText = j.Notes ?? j.Activity ?? "";
                var jSearchWords = string.Join(" ", jSearchText.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(4));
                var jHref = !string.IsNullOrWhiteSpace(jSearchWords) ? $"/journal?search={Uri.EscapeDataString(jSearchWords)}" : "/journal";
                <MudListItem Href="@jHref">
                    <MudStack Row="true" AlignItems="AlignItems.Start">
                        @{
                            var jMoodEmoji = j.Mood switch {
                                "happy" => "😊", "excited" => "🤩", "grateful" => "🙏", "proud" => "💪",
                                "calm" => "😌", "focused" => "🎯", "sad" => "😢", "tired" => "😴",
                                "anxious" => "😟", "angry" => "😠", _ => null
                            };
                        }
                        @if (jMoodEmoji is not null)
                        {
                            <MudText Typo="Typo.body1" Style="line-height:1.4;margin-right:4px;">@jMoodEmoji</MudText>
                        }
                        <MudStack Spacing="0" Style="flex:1">
                            @{
                                var displayText = j.Notes ?? j.Activity;
                                var truncated = displayText?.Length > 120 ? displayText[..120] + "…" : displayText;
                            }
                            <MudText Typo="Typo.body2">@truncated</MudText>
                            @if (!string.IsNullOrWhiteSpace(j.Notes) && !string.IsNullOrWhiteSpace(j.Activity))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@j.Activity</MudText>
                            }
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="white-space:nowrap">@jDate.ToString("MMM d")</MudText>
                    </MudStack>
                </MudListItem>
            }
        </MudList>
    }
    else
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">No journal entries yet.</MudText>
    }
    @if (OnThisDayJournals.Count > 0)
    {
        <MudDivider Class="mb-3" />
        <MudText Typo="Typo.subtitle2" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.History" Class="mr-1" Size="Size.Small" />
            📅 On this day in past years
        </MudText>
        <MudList T="Journal" Dense="true" Class="mb-4">
            @foreach (var j in OnThisDayJournals)
            {
                var otdDate = DateTimeOffset.FromUnixTimeMilliseconds(j.EnteredDate).LocalDateTime;
                var otdYearsAgo = DateTime.Today.Year - otdDate.Year;
                var otdLabel = otdYearsAgo == 1 ? "1 year ago" : $"{otdYearsAgo} years ago";
                var otdSearchRaw = j.Notes ?? j.Activity ?? "";
                var otdSearchWords = string.Join(" ", otdSearchRaw.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(4));
                var otdHref = !string.IsNullOrWhiteSpace(otdSearchWords) ? $"/journal?search={Uri.EscapeDataString(otdSearchWords)}" : "/journal";
                <MudListItem Href="@otdHref">
                    <MudStack Row="true" AlignItems="AlignItems.Start">
                        @{
                            var otdMoodEmoji = j.Mood switch {
                                "happy" => "😊", "excited" => "🤩", "grateful" => "🙏", "proud" => "💪",
                                "calm" => "😌", "focused" => "🎯", "sad" => "😢", "tired" => "😴",
                                "anxious" => "😟", "angry" => "😠", _ => "📖"
                            };
                        }
                        <MudText Typo="Typo.body1" Style="line-height:1.4;margin-right:4px;">@otdMoodEmoji</MudText>
                        <MudStack Spacing="0" Style="flex:1">
                            @{
                                var otdText = j.Notes ?? j.Activity;
                                var otdTrunc = otdText?.Length > 120 ? otdText[..120] + "…" : otdText;
                            }
                            <MudText Typo="Typo.body2">@otdTrunc</MudText>
                        </MudStack>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Style="white-space:nowrap;margin:0">@otdLabel</MudChip>
                    </MudStack>
                </MudListItem>
            }
        </MudList>
    }
    <MudDivider Class="mb-3" />
    <MudText Typo="Typo.subtitle2" Class="mb-3">
        <MudIcon Icon="@Icons.Material.Filled.EditNote" Class="mr-1" Size="Size.Small" />
        Quick Journal Entry
    </MudText>
    @if (string.IsNullOrWhiteSpace(QuickJournalText))
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">💡 Writing prompts:</MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-3">
            @foreach (var p in new[] { "What made me proud today?", "What did I learn?", "Something I'm grateful for…", "What challenged me today?" })
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary"
                         Style="cursor:pointer;" OnClick="() => QuickJournalText = p">@p</MudChip>
            }
        </MudStack>
    }
    <MudTextField @bind-Value="QuickJournalText"
                  Label="What happened today? What did you observe?"
                  Variant="Variant.Outlined" Lines="2" Class="mb-3" />
    @if (AllActiveGoals.Count > 0)
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Tag a goal (optional):</MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-3">
            @foreach (var ag2 in AllActiveGoals.Take(10))
            {
                var agText2 = ag2.GoalText ?? "";
                var agShort2 = agText2.Length > 28 ? agText2[..28] + "…" : agText2;
                <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Flag"
                         Variant="@(QuickJournalGoalTag == agText2 ? Variant.Filled : Variant.Outlined)"
                         Color="@(QuickJournalGoalTag == agText2 ? Color.Success : Color.Default)"
                         Style="cursor:pointer;"
                         OnClick="() => QuickJournalGoalTag = QuickJournalGoalTag == agText2 ? string.Empty : agText2">@agShort2</MudChip>
            }
        </MudStack>
    }
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">How are you feeling? (optional)</MudText>
    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-3">
        @foreach (var (emoji, mood) in new[] { ("😊","happy"), ("🤩","excited"), ("🙏","grateful"), ("💪","proud"), ("😌","calm"), ("🎯","focused"), ("😢","sad"), ("😴","tired"), ("😟","anxious"), ("😠","angry") })
        {
            <MudChip T="string" Size="Size.Small"
                     Variant="@(QuickJournalMood == mood ? Variant.Filled : Variant.Outlined)"
                     Color="@(QuickJournalMood == mood ? Color.Primary : Color.Default)"
                     Style="cursor:pointer;"
                     OnClick="() => QuickJournalMood = QuickJournalMood == mood ? string.Empty : mood">@emoji</MudChip>
        }
    </MudStack>
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.Save"
                   Disabled="@string.IsNullOrWhiteSpace(QuickJournalText)"
                   OnClick="SaveQuickJournal">Save Entry</MudButton>
        @if (!string.IsNullOrWhiteSpace(QuickJournalMood))
        {
            <MudText Typo="Typo.caption" Color="Color.Primary">Mood: @QuickJournalMood</MudText>
        }
    </MudStack>
</MudPaper>

@* Quick progress note dialog *@
<MudDialog @bind-Visible="ShowQuickNoteDialog">
    <TitleContent>
        <MudStack Spacing="0">
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Class="mr-2" />
                Add Progress Note
            </MudText>
            @if (!string.IsNullOrWhiteSpace(QuickNoteGoalText))
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">@QuickNoteGoalText</MudText>
            }
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (_quickNotePrevNote is not null)
        {
            var prevSnip = _quickNotePrevNote.Length > 100 ? _quickNotePrevNote[..100] + "…" : _quickNotePrevNote;
            <MudPaper Elevation="0" Class="pa-2 mb-3" Style="border-radius:8px;background:var(--mud-palette-background-grey);border-left:3px solid var(--mud-palette-primary-lighten);">
                <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="1">
                    <MudStack Spacing="0" Style="flex:1">
                        <MudText Typo="Typo.caption" Color="Color.Primary" Style="font-weight:600;">📋 Last note:</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@prevSnip</MudText>
                    </MudStack>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                               OnClick="@(() => QuickNoteText = _quickNotePrevNote!)">Use</MudButton>
                </MudStack>
            </MudPaper>
        }
        @if (string.IsNullOrWhiteSpace(QuickNoteText))
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">💡 Quick-start prompts:</MudText>
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-2">
                @foreach (var s in new[] {
                    "How did I work toward this goal today?",
                    "What's my next step?",
                    "What did I learn or discover?",
                    "What went well? What can I improve?"
                })
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                             Style="cursor:pointer;" OnClick="() => QuickNoteText = s">@s</MudChip>
                }
            </MudStack>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1 mt-2">📝 Structured templates:</MudText>
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-3">
                @foreach (var (lbl, tmpl) in new[] {
                    ("What I did / Next step", "What I did:\n\nNext step:"),
                    ("Tried / Learned / Plan", "What I tried:\n\nWhat I learned:\n\nMy plan next time:"),
                    ("Win + Challenge", "A win today:\n\nChallenge I faced:\n\nHow I'll handle it:"),
                    ("🏆 Reflection", "🏆 Reflection: What I'm most proud of:\n\nWhat I learned about myself:\n\nAdvice I'd give my earlier self:")
                })
                {
                    var capturedTmpl = tmpl;
                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined"
                             Style="cursor:pointer;" OnClick="() => QuickNoteText = capturedTmpl">@lbl</MudChip>
                }
            </MudStack>
        }
        @{
            var qnWc = QuickNoteText.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length;
            var qnWcHelper = qnWc == 0 ? "Be specific — your future self will thank you!" : $"{qnWc} word{(qnWc == 1 ? "" : "s")}";
        }
        <MudTextField @bind-Value="QuickNoteText" Label="What happened? What's the next step?"
                      Variant="Variant.Outlined" Lines="5" AutoFocus="true" Immediate="true"
                      HelperText="@qnWcHelper" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => ShowQuickNoteDialog = false">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveQuickNote"
                   Disabled="@string.IsNullOrWhiteSpace(QuickNoteText)">Save Note</MudButton>
    </DialogActions>
</MudDialog>

@* Quick Add Todo for Goal (from goal card) *@
<MudDialog @bind-Visible="_showGoalTodoDialog">
    <TitleContent>
        <MudStack Spacing="0">
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.AddTask" Class="mr-2" />
                Add Todo for Goal
            </MudText>
            @if (!string.IsNullOrWhiteSpace(_goalTodoGoalText))
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">@_goalTodoGoalText</MudText>
            }
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_goalTodoTitle" Label="What needs to be done?" Variant="Variant.Outlined"
                      Class="mb-3" AutoFocus="true" Immediate="true"
                      @onkeydown="@(async (e) => { if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_goalTodoTitle)) await SaveGoalTodo(); })" />
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudDatePicker @bind-Date="_goalTodoDueDate" Label="Due date (optional)" Variant="Variant.Outlined" Style="flex:1;" />
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined"
                     Style="cursor:pointer;white-space:nowrap;"
                     OnClick="() => _goalTodoDueDate = DateTime.Today">Today</MudChip>
            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined"
                     Style="cursor:pointer;white-space:nowrap;"
                     OnClick="() => _goalTodoDueDate = DateTime.Today.AddDays(1)">Tomorrow</MudChip>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showGoalTodoDialog = false">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveGoalTodo"
                   Disabled="@string.IsNullOrWhiteSpace(_goalTodoTitle)">Add Todo</MudButton>
    </DialogActions>
</MudDialog>

@* Delete Goal Confirmation *@
<MudDialog Visible="@(_confirmDeleteGoalGuid is not null)" VisibleChanged="@((bool v) => { if (!v) _confirmDeleteGoalGuid = null; })">
    <TitleContent>
        <MudText Typo="Typo.h6" Color="Color.Error">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Class="mr-2" />
            Delete Goal?
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText>This will permanently remove the goal. This action cannot be undone.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _confirmDeleteGoalGuid = null">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ConfirmDeleteGoal">Delete</MudButton>
    </DialogActions>
</MudDialog>

@* Add Goal Dialog *@
<MudDialog @bind-Visible="ShowAddDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Flag" Class="mr-2" />
            New Goal
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1"
                  Style="cursor:pointer;" @onclick="() => _inspirationOpen = !_inspirationOpen">
            <MudText Typo="Typo.caption" Color="Color.Secondary">💡 Need inspiration? Try one of these</MudText>
            <MudIcon Icon="@(_inspirationOpen ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                     Size="Size.Small" Color="Color.Secondary" />
        </MudStack>
        <MudCollapse Expanded="_inspirationOpen">
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-3">
                @{
                    var goalSuggestions = new (string Goal, string Outcome)[] {
                        ("Read more books 📚", "Read 10 books this year"),
                        ("Get better at math ➕", "Score 90%+ on tests consistently"),
                        ("Improve my writing ✏️", "Write at least 3 paragraphs per day"),
                        ("Learn something new 🎯", "Practice for 30 minutes, 3× per week"),
                        ("Be more organized 📋", "Complete homework before dinner every day"),
                        ("Exercise regularly 🏃", "Exercise at least 3 times per week"),
                        ("Improve at a sport ⚽", "Practice drills for 30 min, 3× per week"),
                        ("Eat healthier 🥦", "Choose a healthy snack every day"),
                        ("Get enough sleep 😴", "Be in bed by 9pm on school nights"),
                        ("Practice an instrument 🎵", "Practice 20 minutes every day"),
                        ("Get better at art 🎨", "Complete one drawing or project per week"),
                        ("Learn to code 💻", "Complete one coding lesson per week"),
                        ("Start a collection 🏅", "Add to my collection every two weeks"),
                        ("Make more friends 🤝", "Have a positive social interaction each week"),
                        ("Help around the house 🏠", "Complete 3 chores per week without being asked"),
                        ("Be kinder 💛", "Do one unexpected kind act every day"),
                        ("Manage my feelings 🧘", "Use a calming strategy when upset"),
                        ("Learn to cook 🍳", "Cook 5 different meals independently"),
                        ("Save money 💰", "Save $5 per week toward my goal"),
                        ("Spend less screen time 📵", "Less than 1 hour of screens on school days"),
                    };
                }
                @foreach (var (goalText, outcomeText) in goalSuggestions)
                {
                    var capturedGoal = goalText;
                    var capturedOutcome = outcomeText;
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                             Style="cursor:pointer;" OnClick="() => { NewGoalText = capturedGoal; NewMeasurableOutcome = capturedOutcome; }">@goalText</MudChip>
                }
            </MudStack>
        </MudCollapse>
        <MudTextField @bind-Value="NewGoalText" Label="What's the goal?" Variant="Variant.Outlined"
                      Lines="2" Class="mb-4" AutoFocus="true" Immediate="true" />
        <MudTextField @bind-Value="NewMeasurableOutcome" Label="How will you measure success? (optional)"
                      Variant="Variant.Outlined" Immediate="true" HelperText="e.g. Read 10 books, Tie shoes independently" Class="mb-4" />
        <MudTextField @bind-Value="NewGoalSteps" Label="Steps to achieve this goal (optional)"
                      Variant="Variant.Outlined" Lines="4" Immediate="true" Class="mb-4"
                      HelperText="Enter each step on a new line — break your goal into small, achievable actions" />
        <MudDatePicker @bind-Date="NewGoalExpirationDate" Label="Target completion date (optional)"
                       Variant="Variant.Outlined" HelperText="When do you want to achieve this by?" Class="mb-4" />
        <MudDatePicker @bind-Date="NewGoalNextMeetingDate" Label="Next check-in / meeting date (optional)"
                       Variant="Variant.Outlined" HelperText="Schedule a review to check on progress" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => ShowAddDialog = false">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddGoal"
                   Disabled="@string.IsNullOrWhiteSpace(NewGoalText)">Add Goal</MudButton>
    </DialogActions>
</MudDialog>

