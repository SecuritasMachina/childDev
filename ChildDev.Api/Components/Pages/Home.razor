    private async Task AddGoal()
    {
        var text = NewGoalText.Trim();
        if (string.IsNullOrWhiteSpace(text)) return;

        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        long? expirationMs = NewGoalExpirationDate.HasValue
            ? new DateTimeOffset(DateTime.SpecifyKind(NewGoalExpirationDate.Value, DateTimeKind.Local)).ToUnixTimeMilliseconds()
            : null;
        long? nextMeetingMs = NewGoalNextMeetingDate.HasValue
            ? new DateTimeOffset(DateTime.SpecifyKind(NewGoalNextMeetingDate.Value, DateTimeKind.Local)).ToUnixTimeMilliseconds()
            : null;
        Db.Goals.Add(new Goal
        {
            Guid = System.Guid.NewGuid().ToString(),
            AccountFk = AccountGuid!,
            GoalText = text,
            MeasurableOutcome = string.IsNullOrWhiteSpace(NewMeasurableOutcome) ? null : NewMeasurableOutcome.Trim(),
            Steps = string.IsNullOrWhiteSpace(NewGoalSteps) ? null : NewGoalSteps.Trim(),
            ExpirationDate = expirationMs,
            NextMeetingDate = nextMeetingMs,
            EnteredDate = now,
            UpdatedOn = now
        });
        await Db.SaveChangesAsync();

        NewGoalText = string.Empty;
        NewMeasurableOutcome = null;
        NewGoalSteps = null;
        NewGoalExpirationDate = null;
        NewGoalNextMeetingDate = null;
        ShowAddDialog = false;
        await Analytics.TrackAsync("goal_add", AccountGuid, "home");
        Snackbar.Add("Goal added!", Severity.Success);
        await LoadGoals();
    }

    private async Task CompleteGoal(string guid)
    {
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        var rows = await Db.Goals
            .Where(g => g.Guid == guid && g.AccountFk == AccountGuid && g.CompletionDate == null && g.DeletedAt == null)
            .ExecuteUpdateAsync(s => s
                .SetProperty(g => g.CompletionDate, now)
                .SetProperty(g => g.UpdatedOn, now));
        if (rows == 0) return;
        await Analytics.TrackAsync("goal_complete", AccountGuid, "home", guid);
        _ = SendGoalCompleteEmailIfEnabled(AllActiveGoals.FirstOrDefault(g => g.Guid == guid)?.GoalText ?? string.Empty);
        CelebratedGoalText = AllActiveGoals.FirstOrDefault(g => g.Guid == guid)?.GoalText;
        _celebratingGoalGuid = guid;
        CelebrationReflection = string.Empty;
        ShowCelebration = true;
        await LoadGoals();
    }

    private async Task SendGoalCompleteEmailIfEnabled(string goalText)
    {
        if (AccountGuid is null) return;
        await using var db = DbFactory.CreateDbContext();
        var acct = await db.Accounts
            .Where(a => a.Guid == AccountGuid)
            .Select(a => new { a.Email, a.AlertGoalComplete, a.NickName })
            .FirstOrDefaultAsync();
        if (acct?.Email is not null && acct.AlertGoalComplete)
            await EmailService.SendGoalCompleteAsync(acct.Email, acct.NickName, goalText);
    }

