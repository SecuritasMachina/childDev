else @if (ProgressThisWeek == 0 && AllActiveGoals.Count > 0 && string.IsNullOrWhiteSpace(FilterText))
{
    <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.Lightbulb" Dense="true" Class="mb-3">
        You haven't logged any progress this week yet — pick a goal and add a note! You've got this. 💪
