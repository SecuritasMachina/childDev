@page "/goals/{GoalGuid}"
@inject AppDbContext Db
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor
@inject ISnackbar Snackbar
@inject WebAnalyticsService Analytics

<PageTitle>Goal Progress – ChildDev</PageTitle>

@if (AccountGuid is null)
{
    Nav.NavigateTo("/login");
    return;
}

@if (Goal is null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">Goal not found or has been deleted.</MudAlert>
    <MudButton Href="/" Variant="Variant.Outlined" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.ArrowBack">Back to Goals</MudButton>
    return;
}

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/" aria-label="Back to goals" />
    <MudText Typo="Typo.h5" Style="flex:1">@Goal.GoalText</MudText>
    @if (Goal.CompletionDate is null)
    {
        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Default" Size="Size.Small"
                       OnClick="OpenEditDialog" aria-label="Edit goal" />
    }
    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                   OnClick="() => _confirmDeleteGoal = true" aria-label="Delete goal" />
</MudStack>

@if (Goal.CompletionDate.HasValue)
{
    var completedDate = DateTimeOffset.FromUnixTimeMilliseconds(Goal.CompletionDate.Value).LocalDateTime;
    <MudAlert Severity="Severity.Success" Icon="@Icons.Material.Filled.EmojiEvents" Class="mb-1">
        Completed on @completedDate.ToString("MMM d, yyyy")
    </MudAlert>
    <MudButton Size="Size.Small" Color="Color.Default" StartIcon="@Icons.Material.Filled.Undo"
               OnClick="ReopenGoal" Class="mb-3">Reopen Goal</MudButton>
}
@if (Goal.MeasurableOutcome is not null)
{
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">📏 @Goal.MeasurableOutcome</MudText>
}
@if (Goal.NextMeetingDate.HasValue)
{
    var mtgDate = DateTimeOffset.FromUnixTimeMilliseconds(Goal.NextMeetingDate.Value).LocalDateTime;
    var mtgDays = (mtgDate.Date - DateTime.Today).Days;
    string mtgLabel;
    Color mtgColor;
    if (mtgDays < 0)
    {
        mtgLabel = mtgDays == -1 ? "Missed yesterday" : $"Missed {-mtgDays} days ago";
        mtgColor = Color.Warning;
    }
    else if (mtgDays == 0) { mtgLabel = "Meeting today!"; mtgColor = Color.Success; }
    else if (mtgDays == 1) { mtgLabel = "Meeting tomorrow"; mtgColor = Color.Info; }
    else { mtgLabel = $"Meeting in {mtgDays} days"; mtgColor = Color.Info; }
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1" Spacing="1">
        <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" Color="@mtgColor" />
        <MudText Typo="Typo.body2" Color="@mtgColor">@mtgLabel</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">(@mtgDate.ToString("MMM d"))</MudText>
    </MudStack>
}
@if (Goal.ExpirationDate.HasValue && Goal.CompletionDate is null)
{
    var expDate = DateTimeOffset.FromUnixTimeMilliseconds(Goal.ExpirationDate.Value).LocalDateTime;
    var isOverdue = expDate.Date < DateTime.Today;
    <MudText Typo="Typo.body2" Color="@(isOverdue ? Color.Error : Color.Secondary)" Class="mb-1">
        <MudIcon Icon="@Icons.Material.Filled.Flag" Size="Size.Small" />
        Target: @expDate.ToString("MMM d, yyyy")@(isOverdue ? " — overdue" : "")
    </MudText>
}
@{
    var goalDate = DateTimeOffset.FromUnixTimeMilliseconds(Goal.EnteredDate).LocalDateTime;
    var daysSince = (int)(DateTime.Now - goalDate).TotalDays;
    var durationText = daysSince == 0 ? "today" : daysSince == 1 ? "1 day ago" : $"{daysSince} days ago";
}
<MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
    Set on @goalDate.ToString("MMM d, yyyy") — @durationText
</MudText>
@if (Goal.ExpirationDate.HasValue && Goal.CompletionDate is null)
{
    var nowMs2 = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
    var totalMs = Goal.ExpirationDate.Value - Goal.EnteredDate;
    var elapsedMs = nowMs2 - Goal.EnteredDate;
    var pct = totalMs > 0 ? (int)Math.Clamp((double)elapsedMs / totalMs * 100, 0, 100) : 100;
    var daysElapsed2 = (int)(elapsedMs / 86_400_000L);
    var totalDays = (int)(totalMs / 86_400_000L);
    var daysLeft2 = totalDays - daysElapsed2;
    var isOverdue2 = nowMs2 > Goal.ExpirationDate.Value;
    Color barColor2 = pct < 50 ? Color.Success : pct < 80 ? Color.Warning : Color.Error;
    string barLabel2 = isOverdue2
        ? $"Past target — {-daysLeft2} days overdue"
        : daysLeft2 == 0 ? "Last day to reach this goal! 💪"
        : daysLeft2 == 1 ? "1 day left — you've got this! 💪"
        : $"Day {daysElapsed2} of {totalDays} — {daysLeft2} days to go!";
    <MudStack Spacing="1" Class="mb-3">
        <MudText Typo="Typo.caption" Color="@barColor2">@barLabel2</MudText>
        <MudProgressLinear Value="@pct" Color="@barColor2" Rounded="true" Size="Size.Small" />
    </MudStack>
}

@if (Goal.CompletionDate is null && ProgressEntries.Any())
{
    var latestMs = ProgressEntries.Max(p => p.UpdatedOn);
    var daysSinceNote = (int)((DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - latestMs) / 86_400_000L);
    var totalNotes = ProgressEntries.Count;
    string? nudgeText = null;
    Color nudgeColor = Color.Success;
    string nudgeIcon = Icons.Material.Filled.Celebration;
    if (daysSinceNote == 0)
    { nudgeText = $"You logged progress today — you're on a roll! 🔥 ({totalNotes} {(totalNotes == 1 ? "note" : "notes")} total)"; nudgeIcon = Icons.Material.Filled.LocalFireDepartment; }
    else if (daysSinceNote <= 3)
    { nudgeText = $"Great consistency! Last update {daysSinceNote}d ago. ({totalNotes} {(totalNotes == 1 ? "note" : "notes")} total) 💪"; nudgeIcon = Icons.Material.Filled.TrendingUp; }
    else if (daysSinceNote <= 13)
    { nudgeText = $"It's been {daysSinceNote} days — time to log your next update! You've got this!"; nudgeColor = Color.Warning; nudgeIcon = Icons.Material.Filled.NotificationsActive; }
    else
    { nudgeText = $"It's been {daysSinceNote} days since your last note. Let's get back on track! 💪"; nudgeColor = Color.Warning; nudgeIcon = Icons.Material.Filled.EmojiPeople; }
    @if (nudgeText is not null)
    {
        <MudAlert Severity="@(nudgeColor == Color.Success ? Severity.Success : Severity.Warning)"
                  Icon="@nudgeIcon" Class="mb-3" Dense="true">
            @nudgeText
        </MudAlert>
    }
}

<MudText Typo="Typo.subtitle1" Class="mb-2">
    Progress Notes
    @if (ProgressEntries.Any())
    {
        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="ml-2">@ProgressEntries.Count</MudChip>
    }
</MudText>

@if (ProgressEntries.Count >= 2)
{
    <MudChart ChartType="ChartType.Bar"
              ChartSeries="@ProgressChartSeries"
              XAxisLabels="@ProgressChartLabels"
              Width="100%" Height="140px"
              ChartOptions="@(new ChartOptions { YAxisTicks = 1 })"
              Class="mb-4" />
}

@if (!ProgressEntries.Any())
{
    <MudPaper Elevation="0" Class="pa-6 mb-4 text-center"
              Style="border:2px dashed var(--mud-palette-primary-lighten);border-radius:16px;background:rgba(63,81,181,.04);">
        <MudText Typo="Typo.h2" Style="line-height:1;">🚀</MudText>
        <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-2 mb-1">Ready to take the first step?</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Every journey starts with one note. What's the very first thing you'll do to move toward this goal?
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.RocketLaunch"
                   OnClick="OpenAddProgressDialog">Write My First Note ✨</MudButton>
    </MudPaper>
}
else
{
    <MudTimeline TimelinePosition="TimelinePosition.Start" Class="mb-4">
        @foreach (var p in ProgressEntries)
        {
            var enteredDate = DateTimeOffset.FromUnixTimeMilliseconds(p.UpdatedOn).LocalDateTime;
            <MudTimelineItem Color="Color.Primary" Size="Size.Small">
                <ItemContent>
                    <MudPaper Elevation="1" Class="pa-3 mb-2">
                        <MudStack Row="true" AlignItems="AlignItems.Start">
                            <MudStack Spacing="0" Style="flex:1">
                                @if (!string.IsNullOrWhiteSpace(p.NextStepItems))
                                {
                                    <MudText Typo="Typo.body2">@p.NextStepItems</MudText>
                                }
                                @if (p.NextMeetingDate.HasValue)
                                {
                                    var meetingDate = DateTimeOffset.FromUnixTimeMilliseconds(p.NextMeetingDate.Value).LocalDateTime;
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                        <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" /> Next meeting: @meetingDate.ToString("MMM d, yyyy")
                                    </MudText>
                                }
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@enteredDate.ToString("MMM d, yyyy h:mm tt")</MudText>
                            </MudStack>
                            @if (!string.IsNullOrWhiteSpace(p.NextStepItems))
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success"
                                           OnClick="() => CelebrateStep(p.NextStepItems!)"
                                           aria-label="Mark step done">Done! 🎉</MudButton>
                            }
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                           Color="Color.Default" OnClick="() => OpenEditProgress(p)" aria-label="Edit progress note" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                           Color="Color.Error" OnClick="() => _confirmDeleteProgressGuid = p.Guid" aria-label="Delete progress note" />
                        </MudStack>
                    </MudPaper>
                </ItemContent>
            </MudTimelineItem>
        }
    </MudTimeline>
}

<MudStack Row="true" Spacing="2" Class="mt-2">
    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenAddProgressDialog">Add Progress Note</MudButton>
    @if (Goal.CompletionDate is null)
    {
        <MudButton Variant="Variant.Outlined" Color="Color.Success"
                   StartIcon="@Icons.Material.Filled.EmojiEvents"
                   OnClick="MarkComplete">Mark as Complete</MudButton>
    }
</MudStack>

<MudDialog @bind-Visible="ShowCelebration" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <DialogContent>
        <div class="confetti-burst">
            <span></span><span></span><span></span><span></span>
            <span></span><span></span><span></span><span></span>
            <span></span><span></span><span></span><span></span>
        </div>
        <MudStack AlignItems="AlignItems.Center" Spacing="3" Class="pa-4">
            <MudText Typo="Typo.h2" Class="celeb-emoji">🎉</MudText>
            <MudText Typo="Typo.h5" Align="Align.Center" Color="Color.Success">Goal Achieved!</MudText>
            <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary">
                @Goal?.GoalText
            </MudText>
            <MudText Typo="Typo.body2" Align="Align.Center">
                Amazing work! Every big achievement starts with a single step. 🌟
            </MudText>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true"
                   OnClick="() => ShowCelebration = false">Awesome! 🙌</MudButton>
    </DialogActions>
</MudDialog>

@* Progress milestone encouragement *@
<MudDialog @bind-Visible="ShowMilestone" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <DialogContent>
        <MudStack AlignItems="AlignItems.Center" Spacing="3" Class="pa-4">
            <MudText Typo="Typo.h2" Class="celeb-emoji">@MilestoneEmoji</MudText>
            <MudText Typo="Typo.h5" Align="Align.Center" Color="Color.Primary">You're making progress!</MudText>
            <MudText Typo="Typo.body1" Align="Align.Center">@MilestoneMessage</MudText>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                   OnClick="() => ShowMilestone = false">Thanks! 💪</MudButton>
    </DialogActions>
</MudDialog>

@* Delete Goal Confirmation *@
<MudDialog @bind-Visible="_confirmDeleteGoal">
    <TitleContent>
        <MudText Typo="Typo.h6" Color="Color.Error">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Class="mr-2" />
            Delete Goal?
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText>This will permanently remove the goal and all its progress notes. This action cannot be undone.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _confirmDeleteGoal = false">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="DeleteGoal">Delete</MudButton>
    </DialogActions>
</MudDialog>

@* Delete Progress Confirmation *@
<MudDialog Visible="@(_confirmDeleteProgressGuid is not null)" VisibleChanged="@((bool v) => { if (!v) _confirmDeleteProgressGuid = null; })">
    <TitleContent>
        <MudText Typo="Typo.h6" Color="Color.Error">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Class="mr-2" />
            Delete Progress Note?
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText>Remove this progress note?</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _confirmDeleteProgressGuid = null">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ConfirmDeleteProgress">Delete</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="ShowAddDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Class="mr-2" />
            New Progress Note
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="NewNextSteps" Label="Progress / next steps" Variant="Variant.Outlined"
                      Lines="3" Class="mb-4" AutoFocus="true" />
        <MudDatePicker @bind-Date="NewMeetingDate" Label="Next meeting date (optional)" Variant="Variant.Outlined" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => ShowAddDialog = false">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddProgress"
                   Disabled="@(string.IsNullOrWhiteSpace(NewNextSteps) && !NewMeetingDate.HasValue)">Save</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="ShowEditProgressDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2" />
            Edit Progress Note
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="EditProgressNextSteps" Label="Progress / next steps" Variant="Variant.Outlined"
                      Lines="3" Class="mb-4" AutoFocus="true" />
        <MudDatePicker @bind-Date="EditProgressMeetingDate" Label="Next meeting date (optional)" Variant="Variant.Outlined" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => ShowEditProgressDialog = false">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveProgressEdit"
                   Disabled="@(string.IsNullOrWhiteSpace(EditProgressNextSteps) && !EditProgressMeetingDate.HasValue)">Save</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="ShowEditDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2" />
            Edit Goal
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="EditGoalText" Label="Goal" Variant="Variant.Outlined"
                      Lines="2" Class="mb-4" AutoFocus="true" />
        <MudTextField @bind-Value="EditMeasurableOutcome" Label="How will you measure success? (optional)"
                      Variant="Variant.Outlined" Class="mb-4" />
        <MudDatePicker @bind-Date="EditNextMeetingDate" Label="Next meeting date (optional)"
                       Variant="Variant.Outlined" Class="mb-4" />
        <MudDatePicker @bind-Date="EditExpirationDate" Label="Target completion date (optional)"
                       Variant="Variant.Outlined" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => ShowEditDialog = false">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveGoalEdit"
                   Disabled="@string.IsNullOrWhiteSpace(EditGoalText)">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public string GoalGuid { get; set; } = string.Empty;

    private string? AccountGuid;
    private Goal? Goal;
    private List<GoalProgress> ProgressEntries = [];
    private bool ShowAddDialog;
    private string NewNextSteps = string.Empty;
    private DateTime? NewMeetingDate;
    private bool ShowCelebration;
    private List<ChartSeries> ProgressChartSeries = [];
    private string[] ProgressChartLabels = [];
    private bool ShowEditProgressDialog;
    private string? EditingProgressGuid;
    private string EditProgressNextSteps = string.Empty;
    private DateTime? EditProgressMeetingDate;
    private bool ShowEditDialog;
    private string EditGoalText = string.Empty;
    private string? EditMeasurableOutcome;
    private DateTime? EditNextMeetingDate;
    private DateTime? EditExpirationDate;
    private bool _confirmDeleteGoal;
    private string? _confirmDeleteProgressGuid;
    private bool ShowMilestone;
    private string MilestoneEmoji = "⭐";
    private string MilestoneMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        AccountGuid = HttpContextAccessor.HttpContext?.Session.GetString("AccountGuid");
        if (AccountGuid is null) return;

        Goal = await Db.Goals.FirstOrDefaultAsync(g => g.Guid == GoalGuid && g.AccountFk == AccountGuid && g.DeletedAt == null);
        if (Goal is null) return;

        await LoadProgress();
        await Analytics.TrackAsync("page_view", AccountGuid, "goal_detail", GoalGuid);
    }

    private async Task LoadProgress()
    {
        ProgressEntries = await Db.GoalProgresses
            .Where(p => p.GoalFk == GoalGuid && p.AccountFk == AccountGuid && p.DeletedAt == null)
            .OrderByDescending(p => p.UpdatedOn)
            .ToListAsync();
        BuildProgressChart();
    }

    private void BuildProgressChart()
    {
        const int weeks = 8;
        var now = DateTime.Now;
        var counts = new double[weeks];
        var labels = new string[weeks];

        for (var i = 0; i < weeks; i++)
        {
            var weekStart = now.AddDays(-(weeks - 1 - i) * 7).Date;
            weekStart = weekStart.AddDays(-(int)weekStart.DayOfWeek); // Sunday of that week
            var weekStartMs = new DateTimeOffset(DateTime.SpecifyKind(weekStart, DateTimeKind.Local)).ToUnixTimeMilliseconds();
            var weekEndMs = weekStartMs + 7L * 24 * 60 * 60 * 1000;
            counts[i] = ProgressEntries.Count(p => p.UpdatedOn >= weekStartMs && p.UpdatedOn < weekEndMs);
            labels[i] = weekStart.ToString("MMM d");
        }

        ProgressChartSeries = [new ChartSeries { Name = "Notes", Data = counts }];
        ProgressChartLabels = labels;
    }

    private async Task CelebrateStep(string stepText)
    {
        var short_ = stepText.Length > 60 ? stepText[..60] + "…" : stepText;
        Snackbar.Add($"🎉 Step done: \"{short_}\" — amazing! What's your next step?", Severity.Success);
        await Analytics.TrackAsync("step_celebrate", AccountGuid, "goal_detail", GoalGuid);
        OpenAddProgressDialog();
    }

    private void OpenAddProgressDialog()
    {
        NewNextSteps = string.Empty;
        var todayStartMs = new DateTimeOffset(DateTime.SpecifyKind(DateTime.Today, DateTimeKind.Local)).ToUnixTimeMilliseconds();
        NewMeetingDate = Goal?.NextMeetingDate.HasValue == true && Goal.NextMeetingDate.Value >= todayStartMs
            ? DateTimeOffset.FromUnixTimeMilliseconds(Goal.NextMeetingDate.Value).LocalDateTime
            : null;
        ShowAddDialog = true;
    }

    private async Task AddProgress()
    {
        var steps = NewNextSteps.Trim();
        if (string.IsNullOrWhiteSpace(steps) && !NewMeetingDate.HasValue)
        {
            Snackbar.Add("Enter notes or a meeting date.", Severity.Warning);
            return;
        }

        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        var meetingMs = NewMeetingDate.HasValue
            ? new DateTimeOffset(DateTime.SpecifyKind(NewMeetingDate.Value, DateTimeKind.Local)).ToUnixTimeMilliseconds()
            : (long?)null;

        Db.GoalProgresses.Add(new GoalProgress
        {
            Guid = System.Guid.NewGuid().ToString(),
            AccountFk = AccountGuid!,
            GoalFk = GoalGuid,
            NextStepItems = string.IsNullOrWhiteSpace(steps) ? null : steps,
            NextMeetingDate = meetingMs,
            UpdatedOn = now
        });

        // Propagate new meeting date to Goal so the card header stays in sync (matches mobile behaviour)
        if (meetingMs.HasValue && Goal is not null)
        {
            await Db.Goals
                .Where(g => g.Guid == GoalGuid && g.AccountFk == AccountGuid)
                .ExecuteUpdateAsync(s => s
                    .SetProperty(g => g.NextMeetingDate, meetingMs)
                    .SetProperty(g => g.UpdatedOn, now));
            Goal.NextMeetingDate = meetingMs;
        }

        await Db.SaveChangesAsync();
        await Analytics.TrackAsync("progress_add", AccountGuid, "goal_detail", GoalGuid);

        NewNextSteps = string.Empty;
        NewMeetingDate = null;
        ShowAddDialog = false;
        await LoadProgress();

        // Check for encouragement milestones
        var count = ProgressEntries.Count;
        (MilestoneEmoji, MilestoneMessage) = count switch
        {
            1  => ("🌱", "First progress note! You've taken the first step — that's the hardest part!"),
            5  => ("🚀", "5 progress notes! You're building real momentum. Keep it up!"),
            10 => ("⭐", "10 notes! You're seriously committed to this goal. Amazing!"),
            25 => ("🏆", "25 progress notes! You're a goal champion. Nothing can stop you!"),
            50 => ("🌟", "50 notes! Legendary dedication. This goal doesn't stand a chance!"),
            _  => (string.Empty, string.Empty)
        };
        if (!string.IsNullOrEmpty(MilestoneMessage))
        {
            ShowMilestone = true;
            await Analytics.TrackAsync("progress_milestone", AccountGuid, "goal_detail", count.ToString());
        }
        else
        {
            Snackbar.Add("Progress note saved!", Severity.Success);
        }
    }

    private async Task DeleteProgress(string guid)
    {
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        var rows = await Db.GoalProgresses
            .Where(p => p.Guid == guid && p.AccountFk == AccountGuid && p.DeletedAt == null)
            .ExecuteUpdateAsync(s => s
                .SetProperty(p => p.DeletedAt, now)
                .SetProperty(p => p.UpdatedOn, now));
        if (rows == 0) return;
        await Analytics.TrackAsync("progress_delete", AccountGuid, "goal_detail", GoalGuid);
        Snackbar.Add("Progress note removed.", Severity.Info);
        await LoadProgress();
    }

    private async Task DeleteGoal()
    {
        _confirmDeleteGoal = false;
        if (Goal is null) return;
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        Goal.DeletedAt = now;
        Goal.UpdatedOn = now;
        await Db.SaveChangesAsync();
        await Analytics.TrackAsync("goal_delete", AccountGuid, "goal_detail", GoalGuid);
        Snackbar.Add("Goal deleted.", Severity.Info);
        Nav.NavigateTo("/");
    }

    private async Task ConfirmDeleteProgress()
    {
        var guid = _confirmDeleteProgressGuid;
        _confirmDeleteProgressGuid = null;
        if (guid is null) return;
        await DeleteProgress(guid);
    }

    private void OpenEditProgress(GoalProgress p)
    {
        EditingProgressGuid = p.Guid;
        EditProgressNextSteps = p.NextStepItems ?? string.Empty;
        EditProgressMeetingDate = p.NextMeetingDate.HasValue
            ? DateTimeOffset.FromUnixTimeMilliseconds(p.NextMeetingDate.Value).LocalDateTime
            : null;
        ShowEditProgressDialog = true;
    }

    private async Task SaveProgressEdit()
    {
        if (EditingProgressGuid is null) return;
        var steps = EditProgressNextSteps.Trim();
        if (string.IsNullOrWhiteSpace(steps) && !EditProgressMeetingDate.HasValue)
        {
            Snackbar.Add("Enter notes or a meeting date.", Severity.Warning);
            return;
        }
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        var nextSteps = string.IsNullOrWhiteSpace(steps) ? null : steps;
        long? meetingDate = EditProgressMeetingDate.HasValue
            ? new DateTimeOffset(DateTime.SpecifyKind(EditProgressMeetingDate.Value, DateTimeKind.Local)).ToUnixTimeMilliseconds()
            : null;
        var rows = await Db.GoalProgresses
            .Where(p => p.Guid == EditingProgressGuid && p.AccountFk == AccountGuid)
            .ExecuteUpdateAsync(s => s
                .SetProperty(p => p.NextStepItems, nextSteps)
                .SetProperty(p => p.NextMeetingDate, meetingDate)
                .SetProperty(p => p.UpdatedOn, now));
        if (rows == 0) return;
        await Analytics.TrackAsync("progress_edit", AccountGuid, "goal_detail", GoalGuid);
        ShowEditProgressDialog = false;
        Snackbar.Add("Progress note updated.", Severity.Success);
        await LoadProgress();
    }

    private async Task MarkComplete()
    {
        if (Goal is null || Goal.CompletionDate.HasValue) return;
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        Goal.CompletionDate = now;
        Goal.UpdatedOn = now;
        await Db.SaveChangesAsync();
        await Analytics.TrackAsync("goal_complete", AccountGuid, "goal_detail", GoalGuid);
        ShowCelebration = true;
    }

    private async Task ReopenGoal()
    {
        if (Goal is null || !Goal.CompletionDate.HasValue) return;
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        Goal.CompletionDate = null;
        Goal.UpdatedOn = now;
        await Db.SaveChangesAsync();
        await Analytics.TrackAsync("goal_reopen", AccountGuid, "goal_detail", GoalGuid);
        Snackbar.Add("Goal reopened.", Severity.Info);
    }

    private void OpenEditDialog()
    {
        EditGoalText = Goal?.GoalText ?? string.Empty;
        EditMeasurableOutcome = Goal?.MeasurableOutcome;
        EditNextMeetingDate = Goal?.NextMeetingDate.HasValue == true
            ? DateTimeOffset.FromUnixTimeMilliseconds(Goal.NextMeetingDate!.Value).LocalDateTime
            : null;
        EditExpirationDate = Goal?.ExpirationDate.HasValue == true
            ? DateTimeOffset.FromUnixTimeMilliseconds(Goal.ExpirationDate!.Value).LocalDateTime
            : null;
        ShowEditDialog = true;
    }

    private async Task SaveGoalEdit()
    {
        var text = EditGoalText.Trim();
        if (string.IsNullOrWhiteSpace(text) || Goal is null) return;
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        Goal.GoalText = text;
        Goal.MeasurableOutcome = string.IsNullOrWhiteSpace(EditMeasurableOutcome) ? null : EditMeasurableOutcome.Trim();
        Goal.NextMeetingDate = EditNextMeetingDate.HasValue
            ? new DateTimeOffset(DateTime.SpecifyKind(EditNextMeetingDate.Value, DateTimeKind.Local)).ToUnixTimeMilliseconds()
            : null;
        Goal.ExpirationDate = EditExpirationDate.HasValue
            ? new DateTimeOffset(DateTime.SpecifyKind(EditExpirationDate.Value, DateTimeKind.Local)).ToUnixTimeMilliseconds()
            : null;
        Goal.UpdatedOn = now;
        await Db.SaveChangesAsync();
        await Analytics.TrackAsync("goal_edit", AccountGuid, "goal_detail", GoalGuid);
        ShowEditDialog = false;
        Snackbar.Add("Goal updated!", Severity.Success);
    }
}
