<MudDialog @bind-Visible="ShowAddDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Class="mr-2" />
            New Progress Note
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (string.IsNullOrWhiteSpace(NewNextSteps))
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">💡 Quick-start prompts:</MudText>
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-3">
                @foreach (var s in NextStepSuggestions)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined"
                             OnClick="@(() => NewNextSteps = s)">@s</MudChip>
                }
