@page "/goals/{GoalGuid}"
@inject AppDbContext Db
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor
@inject ISnackbar Snackbar
@inject WebAnalyticsService Analytics

<PageTitle>Goal Progress – ChildDev</PageTitle>

@if (AccountGuid is null)
{
    Nav.NavigateTo("/login");
    return;
}

@if (Goal is null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">Goal not found or has been deleted.</MudAlert>
    <MudButton Href="/" Variant="Variant.Outlined" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.ArrowBack">Back to Goals</MudButton>
    return;
}

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/" aria-label="Back to goals" />
    <MudText Typo="Typo.h5" Style="flex:1">@Goal.GoalText</MudText>
    @if (Goal.CompletionDate is null)
    {
        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Default" Size="Size.Small"
                       OnClick="OpenEditDialog" aria-label="Edit goal" />
    }
    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                   OnClick="() => _confirmDeleteGoal = true" aria-label="Delete goal" />
</MudStack>

@{
    var growthQuotes = new[] {
        "\"The secret of getting ahead is getting started.\" — Mark Twain",
        "\"It always seems impossible until it's done.\" — Nelson Mandela",
        "\"You don't have to be great to start, but you have to start to be great.\" — Zig Ziglar",
        "\"Believe you can and you're halfway there.\" — Theodore Roosevelt",
        "\"The only way to do great work is to love what you do.\" — Steve Jobs",
        "\"Success is the sum of small efforts, repeated day in and day out.\" — Robert Collier",
        "\"Don't watch the clock; do what it does. Keep going.\" — Sam Levenson",
        "\"You are never too old to set another goal or dream a new dream.\" — C.S. Lewis",
        "\"Every expert was once a beginner.\" — Helen Hayes",
        "\"Dreams don't work unless you do.\" — John C. Maxwell",
        "\"What you get by achieving your goals is not as important as what you become.\" — Thoreau",
        "\"The best time to plant a tree was 20 years ago. The second best time is now.\" — Proverb",
        "\"Small steps every day lead to big results.\" — Anonymous",
        "\"Progress, not perfection.\" — Anonymous",
        "\"You've got this. One note at a time.\" — ChildDev",
        "\"Persistence is the key that unlocks every door.\" — Anonymous",
        "\"Be proud of every step, no matter how small.\" — Anonymous",
        "\"Hard things are hard because they're worth doing.\" — Anonymous",
        "\"Keep going. Your future self will thank you.\" — Anonymous",
        "\"Consistency beats intensity every time.\" — Anonymous"
    };
    var quoteIdx = Math.Abs(Goal.Guid.GetHashCode()) % growthQuotes.Length;
    var todayQuoteShift = DateTime.Today.DayOfYear % growthQuotes.Length;
    var selectedQuote = growthQuotes[(quoteIdx + todayQuoteShift) % growthQuotes.Length];
}
@if (Goal.CompletionDate is null && ProgressEntries.Count >= 1)
{
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3" Style="font-style:italic;opacity:.8;">💬 @selectedQuote</MudText>
}
@if (Goal.CompletionDate.HasValue)
{
    var completedDate = DateTimeOffset.FromUnixTimeMilliseconds(Goal.CompletionDate.Value).LocalDateTime;
    var startDate = DateTimeOffset.FromUnixTimeMilliseconds(Goal.EnteredDate).LocalDateTime;
    var journeyTotalDays = Math.Max((int)(completedDate - startDate).TotalDays, 1);
    var journeyDurText = journeyTotalDays >= 365
        ? $"{journeyTotalDays / 365} year{(journeyTotalDays / 365 == 1 ? "" : "s")}"
        : journeyTotalDays >= 30
            ? $"{journeyTotalDays / 30} month{(journeyTotalDays / 30 == 1 ? "" : "s")}"
            : $"{journeyTotalDays} day{(journeyTotalDays == 1 ? "" : "s")}";
    var totalWords522 = ProgressEntries
        .Where(p => !string.IsNullOrWhiteSpace(p.NextStepItems))
        .Sum(p => p.NextStepItems!.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length);
    var firstNoteDate = ProgressEntries.Count > 0
        ? DateTimeOffset.FromUnixTimeMilliseconds(ProgressEntries.Last().UpdatedOn).LocalDateTime
        : (DateTime?)null;
    var lastNoteDate = ProgressEntries.Count > 0
        ? DateTimeOffset.FromUnixTimeMilliseconds(ProgressEntries.First().UpdatedOn).LocalDateTime
        : (DateTime?)null;
    var noteRangeText = firstNoteDate.HasValue && lastNoteDate.HasValue && firstNoteDate.Value.Date != lastNoteDate.Value.Date
        ? $"{firstNoteDate.Value.ToString("MMM d, yyyy")} → {lastNoteDate.Value.ToString("MMM d, yyyy")}"
        : firstNoteDate.HasValue ? firstNoteDate.Value.ToString("MMM d, yyyy") : null;
    <MudPaper Elevation="4" Class="pa-4 mb-4" Style="border-radius:16px;background:linear-gradient(135deg,rgba(76,175,80,.10) 0%,rgba(255,193,7,.06) 100%);border:2px solid var(--mud-palette-success);">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
            <MudText Typo="Typo.h3" Style="line-height:1;">🏆</MudText>
            <MudStack Spacing="0">
                <MudText Typo="Typo.overline" Color="Color.Success" Style="font-weight:700;letter-spacing:1.5px;">GOAL ACHIEVED!</MudText>
                <MudText Typo="Typo.h6" Color="Color.Success">Completed @completedDate.ToString("MMMM d, yyyy")</MudText>
            </MudStack>
        </MudStack>
        <MudGrid Spacing="2" Class="mb-3">
            <MudItem xs="6" sm="3">
                <MudPaper Elevation="0" Class="pa-2 text-center" Style="border-radius:8px;background:rgba(76,175,80,.08);">
                    <MudText Typo="Typo.h5" Color="Color.Success">@journeyDurText</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Journey length</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Elevation="0" Class="pa-2 text-center" Style="border-radius:8px;background:rgba(63,81,181,.08);">
                    <MudText Typo="Typo.h5" Color="Color.Primary">@ProgressEntries.Count</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Progress note@(ProgressEntries.Count == 1 ? "" : "s")</MudText>
                </MudPaper>
            </MudItem>
            @if (totalWords522 >= 10)
            {
                <MudItem xs="6" sm="3">
                    <MudPaper Elevation="0" Class="pa-2 text-center" Style="border-radius:8px;background:rgba(156,39,176,.08);">
                        <MudText Typo="Typo.h5" Style="color:var(--mud-palette-primary);">~@totalWords522</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Words written</MudText>
                    </MudPaper>
                </MudItem>
            }
            @if (noteRangeText is not null)
            {
                <MudItem xs="6" sm="3">
                    <MudPaper Elevation="0" Class="pa-2 text-center" Style="border-radius:8px;background:rgba(255,152,0,.08);">
                        <MudText Typo="Typo.caption" Color="Color.Warning" Style="font-weight:600;">📅 Note period</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@noteRangeText</MudText>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
            🌟 You set this goal and saw it through — that takes real dedication and grit. Be proud of this win!
        </MudText>
        <MudButton Size="Size.Small" Color="Color.Default" StartIcon="@Icons.Material.Filled.Undo"
                   OnClick="ReopenGoal">Reopen Goal</MudButton>
    </MudPaper>
}
@if (Goal.MeasurableOutcome is not null)
{
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">📏 @Goal.MeasurableOutcome</MudText>
}
@if (Goal.NextMeetingDate.HasValue)
{
    var mtgDate = DateTimeOffset.FromUnixTimeMilliseconds(Goal.NextMeetingDate.Value).LocalDateTime;
    var mtgDays = (mtgDate.Date - DateTime.Today).Days;
    string mtgLabel;
    Color mtgColor;
    if (mtgDays < 0)
    {
        mtgLabel = mtgDays == -1 ? "Missed yesterday" : $"Missed {-mtgDays} days ago";
        mtgColor = Color.Warning;
    }
    else if (mtgDays == 0) { mtgLabel = "Meeting today!"; mtgColor = Color.Success; }
    else if (mtgDays == 1) { mtgLabel = "Meeting tomorrow"; mtgColor = Color.Info; }
    else { mtgLabel = $"Meeting in {mtgDays} days"; mtgColor = Color.Info; }
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1" Spacing="1">
        <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" Color="@mtgColor" />
        <MudText Typo="Typo.body2" Color="@mtgColor">@mtgLabel</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">(@mtgDate.ToString("MMM d"))</MudText>
    </MudStack>
}
@if (Goal.ExpirationDate.HasValue && Goal.CompletionDate is null)
{
    var expDate = DateTimeOffset.FromUnixTimeMilliseconds(Goal.ExpirationDate.Value).LocalDateTime;
    var isOverdue = expDate.Date < DateTime.Today;
    <MudText Typo="Typo.body2" Color="@(isOverdue ? Color.Error : Color.Secondary)" Class="mb-1">
        <MudIcon Icon="@Icons.Material.Filled.Flag" Size="Size.Small" />
        Target: @expDate.ToString("MMM d, yyyy")@(isOverdue ? " — overdue" : "")
    </MudText>
}
@{
    var goalDate = DateTimeOffset.FromUnixTimeMilliseconds(Goal.EnteredDate).LocalDateTime;
    var daysSince = (int)(DateTime.Now - goalDate).TotalDays;
    var durationText = daysSince == 0 ? "today" : daysSince == 1 ? "1 day ago" : $"{daysSince} days ago";
}
<MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
    Set on @goalDate.ToString("MMM d, yyyy") — @durationText
</MudText>
@{
    string? ageMilestoneEmoji = null;
    string? ageMilestoneName = null;
    foreach (var (ageT, ageE, ageN) in new[] { (365, "🌟", "1 Year"), (180, "🏆", "6 Months"), (90, "⭐", "3 Months"), (60, "🚀", "2 Months"), (30, "💪", "1 Month") })
    {
        if (daysSince >= ageT && daysSince < ageT + 7) { ageMilestoneEmoji = ageE; ageMilestoneName = ageN; break; }
    }
}
@if (ageMilestoneEmoji is not null && Goal.CompletionDate is null)
{
    <MudAlert Severity="Severity.Success" Icon="@Icons.Material.Filled.Celebration" Dense="true" Class="mb-3">
        @ageMilestoneEmoji <strong>@ageMilestoneName on this goal!</strong> @daysSince days of working toward this — that's real long-term commitment! 🎉
    </MudAlert>
}
@if (Goal.ExpirationDate.HasValue && Goal.CompletionDate is null)
{
    var nowMs2 = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
    var totalMs = Goal.ExpirationDate.Value - Goal.EnteredDate;
    var elapsedMs = nowMs2 - Goal.EnteredDate;
    var pct = totalMs > 0 ? (int)Math.Clamp((double)elapsedMs / totalMs * 100, 0, 100) : 100;
    var daysElapsed2 = (int)(elapsedMs / 86_400_000L);
    var totalDays = (int)(totalMs / 86_400_000L);
    var daysLeft2 = totalDays - daysElapsed2;
    var isOverdue2 = nowMs2 > Goal.ExpirationDate.Value;
    Color barColor2 = pct < 50 ? Color.Success : pct < 80 ? Color.Warning : Color.Error;
    string barLabel2 = isOverdue2
        ? $"Past target — {-daysLeft2} days overdue"
        : daysLeft2 == 0 ? "Last day to reach this goal! 💪"
        : daysLeft2 == 1 ? "1 day left — you've got this! 💪"
        : $"Day {daysElapsed2} of {totalDays} — {daysLeft2} days to go!";
    <MudStack Spacing="1" Class="mb-2">
        <MudText Typo="Typo.caption" Color="@barColor2">@barLabel2</MudText>
        <MudProgressLinear Value="@pct" Color="@barColor2" Rounded="true" Size="Size.Small" />
    </MudStack>
    @if (ProgressEntries.Count >= 2 && !isOverdue2 && daysLeft2 > 0)
    {
        var weeksElapsed = Math.Max(elapsedMs / (7.0 * 86_400_000.0), 0.5);
        var notesPerWeek = ProgressEntries.Count / weeksElapsed;
        var weeksLeft = daysLeft2 / 7.0;
        var projectedNotes = notesPerWeek * weeksLeft;
        string velocityMsg;
        Color velocityColor;
        if (notesPerWeek >= 1)
        {
            velocityMsg = $"📈 Pace: {notesPerWeek:F1} notes/week — you're building good momentum!";
            velocityColor = Color.Success;
        }
        else
        {
            var neededPerWeek = Math.Ceiling(1.0 / weeksLeft * 10) / 10;
            velocityMsg = $"📉 Pace: {notesPerWeek:F1} notes/week — try to log at least 1 note per week!";
            velocityColor = Color.Warning;
        }
        <MudText Typo="Typo.caption" Color="@velocityColor" Class="mb-3">@velocityMsg</MudText>
    }
    else
    {
        <div class="mb-3"></div>
    }
}

@if (ProgressEntries.Any() && !string.IsNullOrWhiteSpace(ProgressEntries.First().NextStepItems) && Goal.CompletionDate is null)
{
    var pinnedStep = ProgressEntries.First().NextStepItems!;
    <MudPaper Elevation="2" Class="pa-3 mb-3" Style="border-radius:12px;border-left:4px solid var(--mud-palette-primary);background:linear-gradient(135deg,rgba(63,81,181,.06) 0%,rgba(255,255,255,0) 100%);">
        <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Color="Color.Primary" Size="Size.Small" Style="margin-top:2px;" />
            <MudStack Spacing="0">
                <MudText Typo="Typo.caption" Color="Color.Primary" Style="font-weight:600;letter-spacing:0.5px;">📌 Next Step</MudText>
                <MudText Typo="Typo.body2">@pinnedStep</MudText>
            </MudStack>
        </MudStack>
    </MudPaper>
}
@if (daysSince >= 14 && daysSince < 30 && Goal.CompletionDate is null && ProgressEntries.Count >= 3)
{
    var obstaclePrompts = new[] {
        "What's the biggest thing getting in the way right now?",
        "What one small action could move this forward this week?",
        "If this goal were easier, what would you do differently?",
        "Who could help you make progress on this goal?"
    };
    var obstaclePrompt = obstaclePrompts[ProgressEntries.Count % obstaclePrompts.Length];
    <MudPaper Elevation="1" Class="pa-3 mb-3" Style="border-radius:12px;border-left:4px solid var(--mud-palette-warning);background:linear-gradient(135deg,rgba(255,152,0,.06) 0%,rgba(255,255,255,0) 100%);">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
            <MudText Typo="Typo.h5" Style="line-height:1;">🤔</MudText>
            <MudText Typo="Typo.caption" Color="Color.Warning" Style="font-weight:700;letter-spacing:0.5px;">QUICK REFLECTION — @daysSince DAYS IN</MudText>
        </MudStack>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1"><strong>@obstaclePrompt</strong></MudText>
        <MudText Typo="Typo.caption" Color="Color.Warning">
            💡 Answering this question honestly in a progress note can unlock your next breakthrough!
        </MudText>
    </MudPaper>
}
@if (daysSince >= 30 && Goal.CompletionDate is null && ProgressEntries.Count >= 2)
{
    var reflectDurLabel = daysSince >= 365
        ? $"{daysSince / 365} year{(daysSince / 365 == 1 ? "" : "s")}"
        : daysSince >= 60 ? $"{daysSince / 30} months"
        : $"{daysSince} days";
    <MudPaper Elevation="1" Class="pa-3 mb-3" Style="border-radius:12px;border-left:4px solid var(--mud-palette-info);background:linear-gradient(135deg,rgba(33,150,243,.06) 0%,rgba(255,255,255,0) 100%);">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
            <MudText Typo="Typo.h5" Style="line-height:1;">🌱</MudText>
            <MudText Typo="Typo.caption" Color="Color.Info" Style="font-weight:700;letter-spacing:0.5px;">HOW YOU'VE GROWN — @reflectDurLabel on this goal</MudText>
        </MudStack>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">
            Think about where you started vs where you are now. What's changed? What surprised you most about this journey?
        </MudText>
        <MudText Typo="Typo.caption" Color="Color.Info">
            🤔 Reflecting on your growth makes the next steps clearer — and reminds you how far you've already come!
        </MudText>
    </MudPaper>
}
@{
    // Focus score: recency (0-40) + frequency (0-40) + streak (0-20)
    var nowMsFS = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
    var goalAgeWeeksFS = Math.Max((nowMsFS - Goal.EnteredDate) / (7.0 * 86_400_000.0), 0.1);
    int focusScore = 0;
    string focusGrade = "F";
    Color focusColor = Color.Default;
    if (ProgressEntries.Count > 0)
    {
        var latestMs = ProgressEntries.First().UpdatedOn;
        var daysSinceFS = (int)((nowMsFS - latestMs) / 86_400_000L);
        var recencyPts = daysSinceFS == 0 ? 40 : daysSinceFS == 1 ? 30 : daysSinceFS <= 3 ? 20 : daysSinceFS <= 7 ? 10 : 0;
        var notesPerWeekFS = ProgressEntries.Count / goalAgeWeeksFS;
        var freqPts = (int)Math.Min(notesPerWeekFS * 4.0, 40);
        var fsActiveDates = ProgressEntries
            .Select(p => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(p.UpdatedOn).LocalDateTime))
            .ToHashSet();
        var fsStreak = 0;
        var fsDay = DateOnly.FromDateTime(DateTime.Today);
        while (fsActiveDates.Contains(fsDay)) { fsStreak++; fsDay = fsDay.AddDays(-1); }
        var streakPts = (int)Math.Min(fsStreak * 4, 20);
        focusScore = recencyPts + freqPts + streakPts;
        (focusGrade, focusColor) = focusScore >= 90 ? ("A", Color.Success)
            : focusScore >= 75 ? ("B", Color.Primary)
            : focusScore >= 55 ? ("C", Color.Warning)
            : focusScore >= 35 ? ("D", Color.Warning)
            : ("F", Color.Default);
    }
}
@if (ProgressEntries.Count >= 1 && Goal.CompletionDate is null)
{
    var focusDesc = focusGrade switch
    {
        "A" => "Outstanding focus — this goal is getting your best effort!",
        "B" => "Strong focus — great consistency on this goal!",
        "C" => "Good effort — keep adding notes to build momentum!",
        "D" => "This goal needs more attention — even one note helps!",
        _   => "Let's get back to this goal — every note counts!"
    };
    <MudPaper Elevation="1" Class="pa-3 mb-3" Style="border-radius:12px;border-left:4px solid var(--mud-palette-primary);">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h4" Style="@($"font-weight:900;color:var(--mud-palette-{(focusGrade == "A" ? "success" : focusGrade == "B" ? "primary" : "warning")}-text,currentColor);min-width:36px;text-align:center;")">@focusGrade</MudText>
            <MudStack Spacing="0">
                <MudText Typo="Typo.caption" Style="font-weight:600;">Focus Score: @focusScore/100</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@focusDesc</MudText>
            </MudStack>
        </MudStack>
    </MudPaper>
}
@{
    // Rule-based goal insight narrative
    var nowMsI = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
    var goaldAgeWeeks = Math.Max((nowMsI - Goal.EnteredDate) / (7.0 * 86_400_000.0), 0.1);
    string goalInsightText;
    if (ProgressEntries.Count == 0)
    {
        goalInsightText = "No progress notes yet. Every great achievement starts with one note — add yours today! 🌱";
    }
    else
    {
        var n = ProgressEntries.Count;
        var lastMs = ProgressEntries.First().UpdatedOn;
        var daysSinceLast = (int)((nowMsI - lastMs) / 86_400_000L);
        var notesPerWeek = n / goaldAgeWeeks;
        if (n >= 25)
            goalInsightText = $"🏆 {n} notes — Champion-level commitment to this goal. Incredible!";
        else if (n >= 10 && notesPerWeek >= 1)
            goalInsightText = $"⭐ {n} notes at {notesPerWeek:F1}/week — strong, consistent progress. Keep going!";
        else if (daysSinceLast == 0)
            goalInsightText = $"🔥 Logged progress today! {n} total note{(n == 1 ? "" : "s")} — you're on a roll!";
        else if (daysSinceLast <= 3)
            goalInsightText = $"💪 Last updated {daysSinceLast} day{(daysSinceLast == 1 ? "" : "s")} ago — good consistency! {n} note{(n == 1 ? "" : "s")} total.";
        else if (daysSinceLast >= 14)
            goalInsightText = $"⏰ {n} note{(n == 1 ? "" : "s")} logged — it's been {daysSinceLast} days since the last one. Ready to continue?";
        else
            goalInsightText = $"📝 {n} progress note{(n == 1 ? "" : "s")} so far — every note moves you closer!";
    }
}
<MudText Typo="Typo.body2" Color="Color.Primary" Class="mb-3" Style="font-style:italic;">@goalInsightText</MudText>

@if (Goal.CompletionDate is null && ProgressEntries.Any())
{
    var latestMs = ProgressEntries.Max(p => p.UpdatedOn);
    var daysSinceNote = (int)((DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - latestMs) / 86_400_000L);
    var totalNotes = ProgressEntries.Count;
    string? nudgeText = null;
    Color nudgeColor = Color.Success;
    string nudgeIcon = Icons.Material.Filled.Celebration;
    if (daysSinceNote == 0)
    { nudgeText = $"You logged progress today — you're on a roll! 🔥 ({totalNotes} {(totalNotes == 1 ? "note" : "notes")} total)"; nudgeIcon = Icons.Material.Filled.LocalFireDepartment; }
    else if (daysSinceNote <= 3)
    { nudgeText = $"Great consistency! Last update {daysSinceNote}d ago. ({totalNotes} {(totalNotes == 1 ? "note" : "notes")} total) 💪"; nudgeIcon = Icons.Material.Filled.TrendingUp; }
    else if (daysSinceNote <= 13)
    { nudgeText = $"It's been {daysSinceNote} days — time to log your next update! You've got this!"; nudgeColor = Color.Warning; nudgeIcon = Icons.Material.Filled.NotificationsActive; }
    else
    { nudgeText = $"It's been {daysSinceNote} days since your last note. Let's get back on track! 💪"; nudgeColor = Color.Warning; nudgeIcon = Icons.Material.Filled.EmojiPeople; }
    @if (nudgeText is not null)
    {
        <MudAlert Severity="@(nudgeColor == Color.Success ? Severity.Success : Severity.Warning)"
                  Icon="@nudgeIcon" Class="mb-3" Dense="true">
            @nudgeText
        </MudAlert>
    }
}

@if (ProgressEntries.Count >= 3)
{
    var firstNote  = ProgressEntries.Last();
    var latestNote = ProgressEntries.First();
    var journeyStartDt = DateTimeOffset.FromUnixTimeMilliseconds(firstNote.UpdatedOn).LocalDateTime;
    var journeyDays = Math.Max((int)(DateTime.Now - journeyStartDt).TotalDays, 1);
    var journeyDaysLabel = journeyDays == 1 ? "1 day" : journeyDays < 7 ? $"{journeyDays} days" : journeyDays < 30 ? $"{journeyDays / 7} week{(journeyDays / 7 == 1 ? "" : "s")}" : $"{journeyDays / 30} month{(journeyDays / 30 == 1 ? "" : "s")}";
    var firstSnip  = !string.IsNullOrWhiteSpace(firstNote.NextStepItems)
        ? (firstNote.NextStepItems.Length > 80 ? firstNote.NextStepItems[..80] + "…" : firstNote.NextStepItems)
        : null;
    var latestSnip = !string.IsNullOrWhiteSpace(latestNote.NextStepItems)
        ? (latestNote.NextStepItems.Length > 80 ? latestNote.NextStepItems[..80] + "…" : latestNote.NextStepItems)
        : null;
    <MudPaper Elevation="0" Class="pa-3 mb-3" Style="border-radius:12px;background:linear-gradient(135deg,rgba(63,81,181,.04) 0%,rgba(255,255,255,0) 100%);border-left:3px solid var(--mud-palette-primary-lighten);">
        <MudText Typo="Typo.caption" Color="Color.Primary" Style="font-weight:600;letter-spacing:0.5px;" Class="mb-1">📖 Your Journey</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">
            🗓️ You started this journey on <strong>@journeyStartDt.ToString("MMMM d, yyyy")</strong> — that's <strong>@journeyDaysLabel</strong> of working toward this goal!
        </MudText>
        @{
            var totalWords = ProgressEntries
                .Where(p => !string.IsNullOrWhiteSpace(p.NextStepItems))
                .Sum(p => p.NextStepItems!.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length);
        }
        @if (totalWords >= 20)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">
                ✍️ You've written about <strong>~@totalWords words</strong> on this goal — that's real depth!
            </MudText>
        }
        @{
            var activeRateDates = ProgressEntries
                .Select(p => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(p.UpdatedOn).LocalDateTime))
                .ToHashSet();
            var activeRatePct = (int)(activeRateDates.Count * 100.0 / Math.Max(journeyDays, 1));
        }
        @if (journeyDays >= 7 && activeRatePct > 0)
        {
            var rateColor = activeRatePct >= 50 ? "var(--mud-palette-success)" : activeRatePct >= 20 ? "var(--mud-palette-primary)" : "var(--mud-palette-text-secondary)";
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">
                📊 Active <strong style="color:@rateColor;">@activeRatePct%</strong> of days (@activeRateDates.Count of @journeyDays days with notes)
            </MudText>
        }
        @{
            var activeMonths = ProgressEntries
                .Select(p => DateTimeOffset.FromUnixTimeMilliseconds(p.UpdatedOn).LocalDateTime)
                .GroupBy(d => new { d.Year, d.Month })
                .OrderBy(g => g.Key.Year).ThenBy(g => g.Key.Month)
                .Select(g => (Label: new DateTime(g.Key.Year, g.Key.Month, 1).ToString("MMM yy"), Count: g.Count()))
                .ToList();
        }
        @if (activeMonths.Count >= 2)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1 mb-1">Active months:</MudText>
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                @foreach (var (label, count) in activeMonths)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined"
                             Style="font-size:0.7rem;height:22px;">
                        @label <span style="opacity:.65;margin-left:3px;">@count</span>
                    </MudChip>
                }
            </MudStack>
        }
        @{
            var topWeekdays = ProgressEntries
                .Select(p => DateTimeOffset.FromUnixTimeMilliseconds(p.UpdatedOn).LocalDateTime.DayOfWeek)
                .GroupBy(d => d)
                .OrderByDescending(g => g.Count())
                .Take(2)
                .Where(g => g.Count() >= 2)
                .Select(g => g.Key.ToString())
                .ToList();
        }
        @if (topWeekdays.Count >= 1)
        {
            var wdLabel = topWeekdays.Count == 1 ? topWeekdays[0] : $"{topWeekdays[0]} & {topWeekdays[1]}";
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                📅 You tend to work on this goal on <strong>@wdLabel</strong> — keep that habit going!
            </MudText>
        }
        @{
            var bestWeekGroup = ProgressEntries
                .GroupBy(p => {
                    var dt = DateTimeOffset.FromUnixTimeMilliseconds(p.UpdatedOn).LocalDateTime;
                    var daysToMon = (int)dt.DayOfWeek == 0 ? 6 : (int)dt.DayOfWeek - 1;
                    return dt.AddDays(-daysToMon).Date;
                })
                .OrderByDescending(g => g.Count())
                .FirstOrDefault();
        }
        @if (bestWeekGroup is not null && bestWeekGroup.Count() >= 3)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                🏅 <strong>Best week:</strong> @bestWeekGroup.Count() notes in the week of @bestWeekGroup.Key.ToString("MMM d, yyyy") — can you match it?
            </MudText>
        }
        @{
            var bestDayGroup = ProgressEntries
                .GroupBy(p => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(p.UpdatedOn).LocalDateTime))
                .OrderByDescending(g => g.Count())
                .FirstOrDefault();
        }
        @if (bestDayGroup is not null && bestDayGroup.Count() >= 3)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                ⚡ <strong>Best day ever:</strong> @bestDayGroup.Count() notes on @bestDayGroup.Key.ToString("MMM d, yyyy") — can you beat it?
            </MudText>
        }
        @if (firstSnip is not null && latestSnip is not null)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                <strong>Then:</strong> "@firstSnip"
            </MudText>
            <MudText Typo="Typo.caption" Color="Color.Primary" Class="mt-1">
                <strong>Now:</strong> "@latestSnip"
            </MudText>
        }
    </MudPaper>
}

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
    <MudText Typo="Typo.subtitle1">
        Progress Notes
        @if (ProgressEntries.Any())
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="ml-2">@ProgressEntries.Count</MudChip>
        }
    </MudText>
    @if (ProgressEntries.Count >= 5)
    {
        <MudSpacer />
        <MudTextField Value="@_noteFilter" ValueChanged="@((string v) => _noteFilter = v)"
                      Placeholder="Search notes…" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true" Immediate="true" Style="max-width:200px;" />
    }
</MudStack>
@{
    var noteCount = ProgressEntries.Count;
    var (curLvlEmoji, curLvlName, nextLvlEmoji, nextLvlName, lvlStart, lvlEnd) = noteCount switch
    {
        0             => ("🌱", "Seedling",         "⚡", "Getting Started", 0,  1),
        >= 1 and < 5  => ("⚡", "Getting Started",  "🚀", "Momentum",        1,  5),
        >= 5 and < 10 => ("🚀", "Momentum",         "⭐", "Strong",          5,  10),
        >= 10 and < 25=> ("⭐", "Strong",            "🏆", "Champion",        10, 25),
        >= 25 and < 50=> ("🏆", "Champion",          "🌟", "Legendary",       25, 50),
        _             => ("🌟", "Legendary",         "🌟", "Legendary",       50, 50)
    };
    var isMaxLevel = noteCount >= 50;
    var lvlPct = isMaxLevel ? 100 : (int)((double)(noteCount - lvlStart) / (lvlEnd - lvlStart) * 100);
    var notesToNext = isMaxLevel ? 0 : lvlEnd - noteCount;
    // Goal-specific consecutive day streak
    var goalActiveDates = ProgressEntries
        .Select(p => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(p.UpdatedOn).LocalDateTime))
        .ToHashSet();
    var goalStreak = 0;
    var streakCheckDay = DateOnly.FromDateTime(DateTime.Today);
    while (goalActiveDates.Contains(streakCheckDay))
    {
        goalStreak++;
        streakCheckDay = streakCheckDay.AddDays(-1);
    }
    var bestGoalStreak = 0;
    if (goalActiveDates.Count > 0)
    {
        var sortedDates = goalActiveDates.OrderBy(d => d).ToList();
        var bestRun = 1;
        var curRun = 1;
        for (int di = 1; di < sortedDates.Count; di++)
        {
            if (sortedDates[di] == sortedDates[di - 1].AddDays(1)) curRun++;
            else curRun = 1;
            if (curRun > bestRun) bestRun = curRun;
        }
        bestGoalStreak = bestRun;
    }
    // Longest gap between consecutive progress notes
    int longestGapDays = 0;
    if (ProgressEntries.Count >= 2)
    {
        var sortedMs = ProgressEntries.Select(p => p.UpdatedOn).OrderBy(ms => ms).ToList();
        for (int gi = 1; gi < sortedMs.Count; gi++)
        {
            var gapDays = (int)((sortedMs[gi] - sortedMs[gi - 1]) / 86_400_000L);
            if (gapDays > longestGapDays) longestGapDays = gapDays;
        }
    }
}
<MudStack Spacing="0" Class="mb-3">
    @if (isMaxLevel)
    {
        <MudText Typo="Typo.caption" Color="Color.Warning">🌟 Legendary — Maximum level reached! Incredible dedication!</MudText>
        <MudProgressLinear Value="100" Color="Color.Warning" Rounded="true" Size="Size.Small" />
    }
    else
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            @curLvlEmoji @curLvlName — @notesToNext more note@(notesToNext == 1 ? "" : "s") to reach @nextLvlEmoji @nextLvlName
        </MudText>
        <MudProgressLinear Value="@_animLvlPct" Color="Color.Primary" Rounded="true" Size="Size.Small" Class="level-anim-bar" />
    }
</MudStack>
@if (goalStreak >= 2)
{
    <MudText Typo="Typo.caption" Color="@(goalStreak >= 7 ? Color.Error : goalStreak >= 4 ? Color.Warning : Color.Success)" Class="mb-1">
        🔥 @goalStreak-day streak on this goal — incredible consistency! Keep it going!
    </MudText>
}
@if (bestGoalStreak >= 2 && goalStreak == bestGoalStreak)
{
    <MudText Typo="Typo.caption" Color="Color.Warning" Class="mb-2">
        🏆 Personal best! This is your longest streak ever on this goal!
    </MudText>
}
else if (bestGoalStreak >= 2 && goalStreak < bestGoalStreak)
{
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">
        🏆 Best streak ever: <strong>@bestGoalStreak days</strong> — can you beat it?
    </MudText>
}
@if (longestGapDays >= 7 && ProgressEntries.Count >= 3)
{
    var gapMsg = longestGapDays >= 30
        ? $"🌱 You once had a {longestGapDays}-day gap — but you came back! Persistence is everything."
        : $"📌 Longest gap between notes: {longestGapDays} days — every return to a goal shows real commitment!";
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">@gapMsg</MudText>
}
@if (ProgressEntries.Any() && Goal.CompletionDate is null)
{
    var weekStart = DateOnly.FromDateTime(DateTime.Today.AddDays(-(int)DateTime.Today.DayOfWeek == 0 ? 6 : (int)DateTime.Today.DayOfWeek - 1));
    var thisWeekDots = goalActiveDates;
    var dotDays = new[] { "M", "T", "W", "T", "F", "S", "S" };
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2">
        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="min-width:60px;">This week:</MudText>
        @for (int dotI = 0; dotI < 7; dotI++)
        {
            var dotDay = weekStart.AddDays(dotI);
            var dotFilled = thisWeekDots.Contains(dotDay);
            var dotIsToday = dotDay == DateOnly.FromDateTime(DateTime.Today);
            <MudTooltip Text="@dotDay.ToString("ddd MMM d")">
                <div style="@($"width:22px;height:22px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.6rem;font-weight:700;{(dotFilled ? "background:var(--mud-palette-primary);color:white;" : "background:var(--mud-palette-background-grey);color:var(--mud-palette-text-disabled);"  )}{(dotIsToday ? "border:2px solid var(--mud-palette-primary);" : "")}")">
                    @dotDays[dotI]
                </div>
            </MudTooltip>
        }
        @{
            var weekCount = Enumerable.Range(0, 7).Count(di => thisWeekDots.Contains(weekStart.AddDays(di)));
        }
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-1">@weekCount/7</MudText>
    </MudStack>
}

@if (ProgressEntries.Count >= 3)
{
    var hmGoalToday = DateOnly.FromDateTime(DateTime.Today);
    var hmGoalStart = hmGoalToday.AddDays(-34);
    var hmGoalMap = ProgressEntries
        .GroupBy(p => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(p.UpdatedOn).LocalDateTime))
        .ToDictionary(g => g.Key, g => g.Count());
    <MudPaper Elevation="0" Class="pa-2 mb-3" Style="border-radius:10px;background:var(--mud-palette-background-grey);">
        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight:600;" Class="mb-1">📅 Activity — last 5 weeks</MudText>
        <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:3px;max-width:220px;">
            @for (int hdi = 0; hdi < 35; hdi++)
            {
                var hDay = hmGoalStart.AddDays(hdi);
                var hCount = hmGoalMap.GetValueOrDefault(hDay, 0);
                var hBg = hCount == 0 ? "#e8eaf6" : hCount == 1 ? "#90CAF9" : hCount <= 3 ? "#42A5F5" : "#1565C0";
                var hTip = hCount == 0 ? hDay.ToString("MMM d") : $"{hDay:MMM d}: {hCount} note{(hCount == 1 ? "" : "s")}";
                <div title="@hTip" style="width:100%;aspect-ratio:1;border-radius:2px;background:@hBg;cursor:default;"></div>
            }
        </div>
    </MudPaper>
}
@{
    // Milestone achievement check (exact: 5, 10, 25, 50)
    var milestoneCount = ProgressEntries.Count;
    var (achievedMs, achievedMsEmoji, achievedMsTitle, achievedMsMsg) = milestoneCount switch
    {
        5  => (true, "🚀", "Momentum Milestone!", "You've logged 5 progress notes — you're building real momentum! Keep it going!"),
        10 => (true, "⭐", "Strong Progress!", "10 notes! You're a goal-chasing machine — you've reached the Strong tier!"),
        25 => (true, "🏆", "Champion Milestone!", "25 notes! You are a CHAMPION! Your dedication is absolutely incredible!"),
        50 => (true, "🌟", "Legendary Achievement!", "50 notes! You've reached LEGENDARY status! This kind of persistence is extraordinary!"),
        _  => (false, "", "", "")
    };
    // Previous milestone: find which tier was last crossed and when
    string? prevMsEmoji = null;
    string? prevMsLabel = null;
    string? prevMsDate = null;
    int? prevMsDaysAgo = null;
    var msThresholds = new[] { (50, "🌟", "Legendary"), (25, "🏆", "Champion"), (10, "⭐", "Strong"), (5, "🚀", "Momentum") };
    foreach (var (thresh, emoji, label) in msThresholds)
    {
        if (milestoneCount > thresh)
        {
            var msNoteIdx = milestoneCount - thresh; // descending index of the nth note
            if (msNoteIdx >= 0 && msNoteIdx < ProgressEntries.Count)
            {
                var msNote = ProgressEntries[msNoteIdx];
                var msDt = DateTimeOffset.FromUnixTimeMilliseconds(msNote.UpdatedOn).LocalDateTime;
                prevMsEmoji = emoji;
                prevMsLabel = label;
                prevMsDate = msDt.ToString("MMM d, yyyy");
                prevMsDaysAgo = (int)(DateTime.Now - msDt).TotalDays;
            }
            break;
        }
    }
}
@if (achievedMs)
{
    <MudPaper Elevation="2" Class="pa-3 mb-3" Style="border-radius:14px;background:linear-gradient(135deg,rgba(249,168,37,.18) 0%,rgba(255,255,255,0) 100%);border:2px solid var(--mud-palette-warning);">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h5" Style="line-height:1;">@achievedMsEmoji</MudText>
            <MudStack Spacing="0">
                <MudText Typo="Typo.subtitle2" Color="Color.Warning" Style="font-weight:700;">@achievedMsTitle</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@achievedMsMsg</MudText>
            </MudStack>
        </MudStack>
    </MudPaper>
}
@if (prevMsEmoji is not null && prevMsDate is not null)
{
    var prevDaysLabel = prevMsDaysAgo == 0 ? "today" : prevMsDaysAgo == 1 ? "yesterday" : $"{prevMsDaysAgo} days ago";
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
        @prevMsEmoji Reached <strong>@prevMsLabel</strong> on @prevMsDate (@prevDaysLabel)
    </MudText>
}
@{
    // Next milestone teaser (1, 5, 10, 25, 50)
    var teaserCount = ProgressEntries.Count;
    var nextMilestone = teaserCount < 1 ? 1 : teaserCount < 5 ? 5 : teaserCount < 10 ? 10 : teaserCount < 25 ? 25 : teaserCount < 50 ? 50 : 0;
    var (msEmoji, msLabel) = nextMilestone switch
    {
        1  => ("🌱", "your first milestone!"),
        5  => ("🚀", "Momentum milestone!"),
        10 => ("⭐", "Strong Progress milestone!"),
        25 => ("🏆", "Champion milestone!"),
        50 => ("🌟", "Legendary milestone!"),
        _  => ("", "")
    };
    var notesNeeded = nextMilestone - teaserCount;
    // Pace prediction: how many days to next milestone at current cadence
    string? paceMsg = null;
    if (nextMilestone > 0 && notesNeeded > 0 && ProgressEntries.Count >= 2)
    {
        var nowPaceMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        var oldestMs = ProgressEntries.Last().UpdatedOn;
        var daysElapsedPace = Math.Max((nowPaceMs - oldestMs) / 86_400_000.0, 1.0);
        var notesPerDay = ProgressEntries.Count / daysElapsedPace;
        if (notesPerDay > 0)
        {
            var daysToNext = (int)Math.Ceiling(notesNeeded / notesPerDay);
            var targetDate = DateTime.Today.AddDays(daysToNext);
            if (daysToNext <= 1)
                paceMsg = $"📅 At your current pace, you'll reach {msEmoji} {msLabel} tomorrow!";
            else if (daysToNext <= 30)
                paceMsg = $"📅 At your current pace, you'll reach {msEmoji} {msLabel} in about {daysToNext} days ({targetDate:MMM d})!";
        }
    }
}
@if (nextMilestone > 0 && notesNeeded > 0 && notesNeeded <= 3)
{
    <MudText Typo="Typo.caption" Color="Color.Warning" Class="mb-1">
        @msEmoji Only @notesNeeded more note@(notesNeeded == 1 ? "" : "s") to unlock @msLabel 🎉
    </MudText>
}
@if (paceMsg is not null && notesNeeded > 3)
{
    <MudText Typo="Typo.caption" Color="Color.Info" Class="mb-2">@paceMsg</MudText>
}

@if (ProgressEntries.Count >= 2)
{
    <MudChart ChartType="ChartType.Bar"
              ChartSeries="@ProgressChartSeries"
              XAxisLabels="@ProgressChartLabels"
              Width="100%" Height="140px"
              ChartOptions="@(new ChartOptions { YAxisTicks = 1 })"
              Class="mb-4" />
}

@{
    var bestNoteGuid = ProgressEntries
        .Where(p => !string.IsNullOrWhiteSpace(p.NextStepItems) && p.NextStepItems.Length >= 30)
        .OrderByDescending(p => p.NextStepItems!.Length)
        .FirstOrDefault()?.Guid;
    var displayedNotes = string.IsNullOrWhiteSpace(_noteFilter)
        ? ProgressEntries
        : ProgressEntries.Where(p => (p.NextStepItems ?? "").Contains(_noteFilter.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
}
@if (!ProgressEntries.Any())
{
    <MudPaper Elevation="2" Class="pa-5 mb-4 text-center"
              Style="border:2px dashed var(--mud-palette-primary-lighten);border-radius:16px;background:linear-gradient(135deg,rgba(63,81,181,.06) 0%,rgba(255,255,255,0) 100%);">
        <MudText Typo="Typo.h2" Style="line-height:1;">🚀</MudText>
        <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-2 mb-1">Ready to take the first step?</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Every journey starts with one note. What's the very first thing you'll do to move toward this goal?
        </MudText>
        <MudPaper Elevation="0" Class="pa-3 mb-4 text-left" Style="border-radius:10px;background:rgba(255,255,255,0.7);">
            <MudText Typo="Typo.caption" Color="Color.Primary" Style="font-weight:600;" Class="mb-1">💡 Ideas for your first note:</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">• What's your plan for working toward this goal?</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">• What's one small action you could take today?</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">• What resources or support do you need?</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">• How will you know you're making progress?</MudText>
        </MudPaper>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.RocketLaunch"
                   OnClick="OpenAddProgressDialog">Write My First Note ✨</MudButton>
    </MudPaper>
}
else
{
    @if (!displayedNotes.Any() && !string.IsNullOrWhiteSpace(_noteFilter))
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">No notes matching "@_noteFilter".</MudText>
    }
    <MudTimeline TimelinePosition="TimelinePosition.Start" Class="mb-4">
        @foreach (var p in displayedNotes)
        {
            var enteredDate = DateTimeOffset.FromUnixTimeMilliseconds(p.UpdatedOn).LocalDateTime;
            var isPersonalBest = bestNoteGuid is not null && p.Guid == bestNoteGuid;
            var noteTextLower = (p.NextStepItems ?? "").ToLowerInvariant();
            var isLearnNote = noteTextLower.Contains("learn") || noteTextLower.Contains("discover") ||
                              noteTextLower.Contains("realiz") || noteTextLower.Contains("figured out") ||
                              noteTextLower.Contains("understand") || noteTextLower.Contains("found out");
            <MudTimelineItem Color="@(isPersonalBest ? Color.Warning : isLearnNote ? Color.Info : Color.Primary)" Size="Size.Small">
                <ItemContent>
                    <MudPaper Elevation="1" Class="pa-3 mb-2" Style="@(isPersonalBest ? "border:1.5px solid var(--mud-palette-warning);" : isLearnNote ? "border:1.5px solid var(--mud-palette-info);" : "")">
                        @if (isPersonalBest)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="mb-1" Style="font-size:0.7rem;">⭐ Your most detailed note!</MudChip>
                        }
                        @if (isLearnNote && !isPersonalBest)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="mb-1" Style="font-size:0.7rem;">💡 Learning moment!</MudChip>
                        }
                        <MudStack Row="true" AlignItems="AlignItems.Start">
                            <MudStack Spacing="0" Style="flex:1">
                                @if (!string.IsNullOrWhiteSpace(p.NextStepItems))
                                {
                                    <MudText Typo="Typo.body2">@p.NextStepItems</MudText>
                                }
                                @if (p.NextMeetingDate.HasValue)
                                {
                                    var meetingDate = DateTimeOffset.FromUnixTimeMilliseconds(p.NextMeetingDate.Value).LocalDateTime;
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                        <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" /> Next meeting: @meetingDate.ToString("MMM d, yyyy")
                                    </MudText>
                                }
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@enteredDate.ToString("MMM d, yyyy h:mm tt")</MudText>
                            </MudStack>
                            @if (!string.IsNullOrWhiteSpace(p.NextStepItems))
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success"
                                           OnClick="() => CelebrateStep(p.NextStepItems!)"
                                           aria-label="Mark step done">Done! 🎉</MudButton>
                            }
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                           Color="Color.Default" OnClick="() => OpenEditProgress(p)" aria-label="Edit progress note" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                           Color="Color.Error" OnClick="() => _confirmDeleteProgressGuid = p.Guid" aria-label="Delete progress note" />
                        </MudStack>
                    </MudPaper>
                </ItemContent>
            </MudTimelineItem>
        }
    </MudTimeline>
}

@if (ProgressEntries.Any())
{
    var oldest = ProgressEntries.Last();
    var newest = ProgressEntries.First();
    var firstDate = DateTimeOffset.FromUnixTimeMilliseconds(oldest.UpdatedOn).LocalDateTime;
    var lastMs = newest.UpdatedOn;
    var daysAgoLast = (int)((DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - lastMs) / 86_400_000L);
    var lastLabel = daysAgoLast == 0 ? "today" : daysAgoLast == 1 ? "yesterday" : $"{daysAgoLast} days ago";
    var daysWorking = Math.Max(1, (int)((lastMs - oldest.UpdatedOn) / 86_400_000L) + 1);
    <MudPaper Elevation="0" Class="pa-3 mb-3"
              Style="background:var(--mud-palette-background-grey);border-radius:12px;">
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="3" AlignItems="AlignItems.Center">
            <MudStack Spacing="0" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Started</MudText>
                <MudText Typo="Typo.body2" Style="font-weight:600;">@firstDate.ToString("MMM d, yyyy")</MudText>
            </MudStack>
            <MudDivider Vertical="true" FlexItem="true" />
            <MudStack Spacing="0" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Total Notes</MudText>
                <MudText Typo="Typo.body2" Style="font-weight:600;">@ProgressEntries.Count</MudText>
            </MudStack>
            <MudDivider Vertical="true" FlexItem="true" />
            <MudStack Spacing="0" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Time Invested</MudText>
                <MudText Typo="Typo.body2" Style="font-weight:600;">@daysWorking day@(daysWorking == 1 ? "" : "s") ⏱</MudText>
            </MudStack>
            <MudDivider Vertical="true" FlexItem="true" />
            <MudStack Spacing="0" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Last Update</MudText>
                <MudText Typo="Typo.body2" Style="font-weight:600;">@lastLabel</MudText>
            </MudStack>
        </MudStack>
    </MudPaper>
}

@{
    var todayStartGoal = new DateTimeOffset(DateTime.SpecifyKind(DateTime.Today, DateTimeKind.Local)).ToUnixTimeMilliseconds();
