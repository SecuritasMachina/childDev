        }
        <MudTextField @bind-Value="NewNextSteps"
                      Label="What happened? What's the next step?"
                      HelperText="@(string.IsNullOrWhiteSpace(NewNextSteps) ? "" : "Pre-filled from your last note — edit or replace as needed")"
                      Variant="Variant.Outlined" Lines="3" Class="mb-4" AutoFocus="true" />
        <MudDatePicker @bind-Date="NewMeetingDate" Label="Next meeting date (optional)" Variant="Variant.Outlined" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => ShowAddDialog = false">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddProgress"
                   Disabled="@(string.IsNullOrWhiteSpace(NewNextSteps) && !NewMeetingDate.HasValue)">Save</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="ShowEditProgressDialog">
    <TitleContent>
