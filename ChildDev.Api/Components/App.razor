<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LevelUp</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="app.css" rel="stylesheet" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#3949AB" />
    <HeadOutlet @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
</head>
<body>
    <Routes @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />

    <div id="components-reconnect-modal" aria-live="polite">
        <div class="reconnect-backdrop"></div>
        <div class="reconnect-card">
            <div class="reconnect-icon-ring">
                <span class="material-icons reconnect-spin-icon">sync</span>
            </div>
            <p class="reconnect-title">Reconnecting…</p>
            <p class="reconnect-subtitle">Lost connection to the server. Trying to reconnect…</p>
            <div class="reconnect-dots"><span></span><span></span><span></span></div>

            <div class="reconnect-failed-content">
                <span class="material-icons reconnect-failed-icon">wifi_off</span>
                <p class="reconnect-title">Connection Lost</p>
                <p class="reconnect-subtitle">Could not reconnect to the server.</p>
                <button class="reconnect-btn" onclick="window.Blazor.reconnect()">Try Again</button>
                <button class="reconnect-btn reconnect-btn-secondary" onclick="window.location.reload()">Reload Page</button>
            </div>
        </div>
    </div>

    <script src="_framework/blazor.server.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="/site.js"></script>
</body>
</html>
