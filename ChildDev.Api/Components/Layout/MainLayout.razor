@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor
@inject IDbContextFactory<AppDbContext> DbFactory
@implements IDisposable
@inject IJSRuntime JS
@inject WebAnalyticsService Analytics
@using Microsoft.EntityFrameworkCore

<MudThemeProvider Theme="_theme" IsDarkMode="@_darkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="3" Color="Color.Primary">
        @if (NickName is not null)
        {
            <MudHidden Breakpoint="Breakpoint.MdAndUp">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                               OnClick="ToggleDrawer" />
            </MudHidden>
        }
        <MudLink Href="/" Underline="Underline.None" Color="Color.Inherit">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Style="gap:6px;">
                <MudIcon Icon="@Icons.Material.Filled.RocketLaunch" Size="Size.Small" />
                <MudText Typo="Typo.h6" Style="font-weight:700;letter-spacing:.3px;">LevelUp</MudText>
            </MudStack>
        </MudLink>
        @if (_dailyStreak >= 2)
        {
            var streakEmoji = _dailyStreak >= 14 ? "🌟" : _dailyStreak >= 7 ? "🔥" : "⚡";
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled"
                     Style="font-weight:700;font-size:0.78rem;margin-left:8px;cursor:default;"
                     title="@($"{_dailyStreak}-day streak!")">
                @streakEmoji @_dailyStreak
            </MudChip>
        }
        <MudSpacer />
        @if (NickName is not null)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Inherit" Size="Size.Small"
                           OnClick="OpenSearch" title="Search goals, todos, journal (Ctrl+K)" aria-label="Global search" />
        }
        <MudIconButton Icon="@(_darkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" Size="Size.Small"
                       OnClick="ToggleDarkMode"
                       title="@(_darkMode ? "Switch to light mode" : "Switch to dark mode")" />
        @if (NickName is not null)
        {
            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                <MudBadge Content="@(_meetingSoonCount > 0 ? _meetingSoonCount.ToString() : null)"
                          Color="Color.Info" Overlap="true" Bordered="true"
                          Visible="@(_meetingSoonCount > 0)" title="@(_meetingSoonCount > 0 ? $"{_meetingSoonCount} goal meeting(s) this week" : "")">
                    <MudButton Color="Color.Inherit" Href="/"
                               StartIcon="@Icons.Material.Filled.EmojiEvents"
                               Variant="@(IsActive("/") ? Variant.Outlined : Variant.Text)">Goals</MudButton>
                </MudBadge>
                <MudBadge Content="@(_overdueTodoCount > 0 ? _overdueTodoCount.ToString() : null)"
                          Color="Color.Error" Overlap="true" Bordered="true"
                          Visible="@(_overdueTodoCount > 0)">
                    <MudButton Color="Color.Inherit" Href="/todos"
                               StartIcon="@Icons.Material.Filled.CheckBox"
                               Variant="@(IsActive("/todos") ? Variant.Outlined : Variant.Text)">Todos</MudButton>
                </MudBadge>
                <MudBadge Dot="true" Color="Color.Success" Overlap="true" Bordered="true"
                          Visible="@_hasJournalToday" title="Journaled today ✓">
                    <MudButton Color="Color.Inherit" Href="/journal"
                               StartIcon="@Icons.Material.Filled.Book"
                               Variant="@(IsActive("/journal") ? Variant.Outlined : Variant.Text)">Journal</MudButton>
                </MudBadge>
                <MudButton Color="Color.Inherit" Href="/insights"
                           StartIcon="@Icons.Material.Filled.Insights"
                           Variant="@(IsActive("/insights") ? Variant.Outlined : Variant.Text)">Insights</MudButton>
                <MudTooltip Text="Achievements">
                    <MudIconButton Color="Color.Inherit" Href="/achievements" Icon="@Icons.Material.Filled.EmojiEvents"
                                   Variant="@(IsActive("/achievements") ? Variant.Outlined : Variant.Text)"
                                   aria-label="Achievements" />
                </MudTooltip>
            </MudHidden>
            <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit"
                     Label="@NickName" EndIcon="@Icons.Material.Filled.ExpandMore"
                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                     Class="ml-1">
                <MudMenuItem Icon="@Icons.Material.Filled.Settings" Href="/settings">Settings</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Logout" Href="/logout">Log Out</MudMenuItem>
            </MudMenu>
        }
        else
        {
            <MudButton Color="Color.Inherit" Variant="Variant.Text" Href="/login">Log In</MudButton>
            <MudButton Variant="Variant.Filled" Href="/register" Class="ml-2"
                       Style="background:#FF8F00;color:#fff;font-weight:600;">Get Started</MudButton>
        }
    </MudAppBar>

    @if (NickName is not null)
    {
        <MudDrawer @bind-Open="_drawerOpen" Elevation="2" Variant="DrawerVariant.Temporary"
                   ClipMode="DrawerClipMode.Never">
            <MudDrawerHeader>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Style="gap:6px;">
                    <MudIcon Icon="@Icons.Material.Filled.RocketLaunch" Color="Color.Primary" />
                    <MudText Typo="Typo.h6" Color="Color.Primary" Style="font-weight:700;">LevelUp</MudText>
                </MudStack>
            </MudDrawerHeader>
            <MudNavMenu>
                <MudNavLink Href="/" Match="NavLinkMatch.All"
                            Icon="@Icons.Material.Filled.EmojiEvents" OnClick="CloseDrawer">Goals@(_meetingSoonCount > 0 ? $" ({_meetingSoonCount} meeting soon)" : "")</MudNavLink>
                <MudNavLink Href="/todos"
                            Icon="@Icons.Material.Filled.CheckBox" OnClick="CloseDrawer">
                    Todos@(_overdueTodoCount > 0 ? $" ({_overdueTodoCount} overdue)" : "")
                </MudNavLink>
                <MudNavLink Href="/journal"
                            Icon="@Icons.Material.Filled.Book" OnClick="CloseDrawer">Journal@(_hasJournalToday ? " ✓" : "")</MudNavLink>
                <MudNavLink Href="/insights"
                            Icon="@Icons.Material.Filled.Insights" OnClick="CloseDrawer">Insights</MudNavLink>
                <MudNavLink Href="/achievements"
                            Icon="@Icons.Material.Filled.MilitaryTech" OnClick="CloseDrawer">Achievements</MudNavLink>
                <MudDivider Class="my-2" />
                <MudNavLink Icon="@Icons.Material.Filled.Search"
                            OnClick="@(() => { CloseDrawer(); OpenSearch(); })">Search</MudNavLink>
                <MudNavLink Href="/settings"
                            Icon="@Icons.Material.Filled.Settings" OnClick="CloseDrawer">Settings</MudNavLink>
                <MudNavLink Href="/logout" Icon="@Icons.Material.Filled.Logout">Log Out</MudNavLink>
            </MudNavMenu>
        </MudDrawer>
    }

    <MudScrollToTop>
        <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Small"
                Style="opacity:0.85;" title="Scroll to top" aria-label="Scroll to top" />
    </MudScrollToTop>

    <MudMainContent Class="pt-4">
        <MudContainer MaxWidth="MaxWidth.Large" Class="pb-8">
            @Body
        </MudContainer>
        <MudPaper Elevation="0" Class="mt-4 py-3" Style="background:var(--mud-palette-background-grey);border-top:1px solid var(--mud-palette-lines-default);">
            <MudContainer MaxWidth="MaxWidth.Large">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2" Wrap="Wrap.Wrap">
                    <MudIcon Icon="@Icons.Material.Filled.Android" Size="Size.Small" Style="color:#3DDC84;" />
                    <MudLink Href="/downloads/LevelUp.apk" Typo="Typo.caption" Color="Color.Primary"
                             Style="font-weight:600;">Download LevelUp for Android</MudLink>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">— install the mobile app</MudText>
                    @if (NickName is not null)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">·</MudText>
                        <MudLink Typo="Typo.caption" Color="Color.Secondary" Style="cursor:pointer;"
                                 OnClick="OpenHelp">⌨️ Keyboard shortcuts</MudLink>
                    }
                    <MudText Typo="Typo.caption" Color="Color.Secondary">·</MudText>
                    <MudLink Href="/about" Typo="Typo.caption" Color="Color.Secondary" Style="opacity:.8;">About LevelUp</MudLink>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">·</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="opacity:.6;">Build: @ChildDev.Api.BuildInfo.BuildTimestamp</MudText>
                </MudStack>
            </MudContainer>
        </MudPaper>
    </MudMainContent>

    @if (_helpOpen)
    {
        <MudOverlay Visible="true" DarkBackground="true" ZIndex="2000" OnClick="CloseHelp">
            <MudPaper Elevation="8" @onclick:stopPropagation="true"
                      Style="width:min(480px,96vw);border-radius:12px;overflow:hidden;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="pa-4"
                          Style="border-bottom:1px solid var(--mud-palette-lines-default);">
                    <MudIcon Icon="@Icons.Material.Filled.Keyboard" Color="Color.Primary" Class="mr-2" />
                    <MudText Typo="Typo.h6" Style="flex:1;font-weight:700;">Keyboard Shortcuts</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseHelp" />
                </MudStack>
                <div class="pa-4">
                    @foreach (var (key, desc) in new[] {
                        ("Ctrl + K", "Open global search"),
                        ("↑ / ↓", "Navigate search results"),
                        ("Enter", "Go to selected search result"),
                        ("Escape", "Close any open panel"),
                        ("?", "Show this help"),
                    })
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3" Spacing="2">
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined"
                                     Style="font-family:monospace;font-weight:700;min-width:90px;justify-content:center;">@key</MudChip>
                            <MudText Typo="Typo.body2" Style="flex:1;">@desc</MudText>
                        </MudStack>
                    }
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.overline" Color="Color.Primary" Style="font-weight:700;letter-spacing:1px;" Class="mb-2">Page Shortcuts</MudText>
                    @foreach (var (key, desc) in new[] {
                        ("N", "On Goals: open Add Goal dialog"),
                        ("N", "On Todos: focus quick-add input"),
                        ("N", "On Goal detail: open Add Note dialog"),
                        ("N", "On Journal: open New Entry dialog"),
                    })
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3" Spacing="2">
                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined"
                                     Style="font-family:monospace;font-weight:700;min-width:90px;justify-content:center;">@key</MudChip>
                            <MudText Typo="Typo.body2" Style="flex:1;">@desc</MudText>
                        </MudStack>
                    }
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Tip: Press <strong>Ctrl+K</strong> from anywhere to instantly search goals, todos, and journal entries.
                    </MudText>
                </div>
            </MudPaper>
        </MudOverlay>
    }

    @if (_searchOpen)
    {
        <MudOverlay Visible="true" DarkBackground="true" ZIndex="2000" OnClick="CloseSearch">
            <MudPaper Elevation="8" @onclick:stopPropagation="true"
                      Style="width:min(640px,96vw);max-height:80vh;overflow:hidden;display:flex;flex-direction:column;border-radius:8px;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="pa-3"
                          Style="border-bottom:1px solid var(--mud-palette-lines-default);">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Color="Color.Primary" Class="mr-1" />
                    <MudTextField @bind-Value="_searchQuery" Placeholder="Search goals, todos, journal…"
                                  Variant="Variant.Text" Margin="Margin.Dense"
                                  Style="flex:1;" Immediate="true"
                                  DebounceInterval="300" OnDebounceIntervalElapsed="RunSearchDebounced"
                                  AutoFocus="true"
                                  @onkeydown="OnSearchKeyDown" />
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseSearch" />
                </MudStack>
                <div style="overflow-y:auto;max-height:calc(80vh - 64px);">
                    @if (_searchLoading)
                    {
                        <MudStack AlignItems="AlignItems.Center" Class="pa-6">
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                        </MudStack>
                    }
                    else if (_searchQuery.Length >= 2 && _searchResults.Count == 0)
                    {
                        <MudStack AlignItems="AlignItems.Center" Class="pa-6">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No results for "@_searchQuery"</MudText>
                        </MudStack>
                    }
                    else if (_searchResults.Count > 0)
                    {
                        var flatResults = _searchResults.ToList();
                        var flatIdx = 0;
                        @foreach (var grp in _searchResults.GroupBy(r => r.Category))
                        {
                            <MudText Typo="Typo.overline" Color="Color.Secondary" Class="px-4 pt-3 pb-1">@grp.Key</MudText>
                            @foreach (var result in grp)
                            {
                                var isSelected = flatIdx == _searchSelectedIdx;
                                var capturedIdx = flatIdx;
                                <MudListItem T="string" OnClick="() => NavigateSearch(result.Href)"
                                             Style="@($"cursor:pointer;{(isSelected ? "background:rgba(63,81,181,.12);" : "")}")" Dense="true">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudIcon Icon="@result.Icon" Size="Size.Small" Color="@(isSelected ? Color.Primary : Color.Secondary)" />
                                        <span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:0.875rem;@(isSelected ? "font-weight:600;" : "")">@((MarkupString)HighlightMatch(result.Text, _searchQuery))</span>
                                        @if (isSelected) { <MudIcon Icon="@Icons.Material.Filled.KeyboardReturn" Size="Size.Small" Color="Color.Secondary" Style="opacity:.5;" /> }
                                    </MudStack>
                                </MudListItem>
                                flatIdx++;
                            }
                        }
                    }
                    else if (_recentGoals.Count > 0)
                    {
                        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="px-4 pt-3 pb-1">Recent Goals</MudText>
                        @foreach (var (guid, text) in _recentGoals)
                        {
                            var shortText = text.Length > 70 ? text[..70] + "…" : text;
                            <MudListItem T="string" OnClick="@(() => NavigateSearch($"/goals/{guid}"))"
                                         Style="cursor:pointer;" Dense="true">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Outlined.History" Size="Size.Small" Color="Color.Secondary" />
                                    <span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:0.875rem;">@shortText</span>
                                </MudStack>
                            </MudListItem>
                        }
                        <MudDivider Class="mt-2 mx-4" />
                        <MudStack AlignItems="AlignItems.Center" Class="pa-3">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Type to search goals, todos, journal…</MudText>
                        </MudStack>
                    }
                    else
                    {
                        <MudStack AlignItems="AlignItems.Center" Class="pa-6">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Type at least 2 characters to search</MudText>
                        </MudStack>
                    }
                </div>
            </MudPaper>
        </MudOverlay>
    }
</MudLayout>

@code {
    private AppDbContext Db = null!;
    private string? NickName;
    private bool _drawerOpen;
    private bool _darkMode;
    private int _overdueTodoCount;
    private int _dailyStreak;
    private bool _hasJournalToday;
    private int _meetingSoonCount;

    private bool _searchOpen;
    private string _searchQuery = string.Empty;
    private bool _searchLoading;
    private List<SearchResult> _searchResults = [];
    private int _searchSelectedIdx = -1;
    private bool _helpOpen;
    private List<(string Guid, string Text)> _recentGoals = [];

    private record SearchResult(string Category, string Text, string Href, string Icon);

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#3949AB",
            PrimaryDarken = "#283593",
            PrimaryLighten = "#7986CB",
            Secondary = "#F57C00",
            SecondaryDarken = "#E65100",
            SecondaryLighten = "#FFB74D",
            AppbarBackground = "#3949AB",
            AppbarText = "#FFFFFF",
            Success = "#43A047",
            Info = "#0288D1",
            Warning = "#F9A825",
            Error = "#E53935",
            Surface = "#FFFFFF",
            Background = "#F5F5F7",
            DrawerBackground = "#FFFFFF",
            DrawerText = "#212121",
            TextPrimary = "#212121",
            TextSecondary = "#616161",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#7986CB",
            PrimaryDarken = "#5C6BC0",
            PrimaryLighten = "#9FA8DA",
            Secondary = "#FFB74D",
            SecondaryDarken = "#FFA726",
            SecondaryLighten = "#FFD54F",
            AppbarBackground = "#1A237E",
            AppbarText = "#FFFFFF",
            Success = "#66BB6A",
            Info = "#29B6F6",
            Warning = "#FFA726",
            Error = "#EF5350",
            Surface = "#1E1E2E",
            Background = "#121220",
            DrawerBackground = "#1A1A2E",
            DrawerText = "#E8EAF6",
            TextPrimary = "#E8EAF6",
            TextSecondary = "#9FA8DA",
            ActionDefault = "#9FA8DA",
            LinesDefault = "rgba(255,255,255,0.08)",
            TableLines = "rgba(255,255,255,0.08)",
        },
        LayoutProperties = new LayoutProperties
        {
            AppbarHeight = "64px",
        }
    };

    protected override async Task OnInitializedAsync()
    {
        Db = DbFactory.CreateDbContext();
        NickName = HttpContextAccessor.HttpContext?.Session.GetString("NickName");
        if (NickName is not null)
        {
            var accountGuid = HttpContextAccessor.HttpContext?.Session.GetString("AccountGuid");
            if (accountGuid is not null)
            {
                var todayStart = new DateTimeOffset(DateTime.SpecifyKind(DateTime.Today, DateTimeKind.Local)).ToUnixTimeMilliseconds();
                _overdueTodoCount = await Db.Todos
                    .CountAsync(t => t.AccountFk == accountGuid && t.DeletedAt == null
                                  && t.CompletedAt == null && t.DueDate.HasValue && t.DueDate < todayStart);
                _hasJournalToday = await Db.Journals
                    .AnyAsync(j => j.AccountFk == accountGuid && j.DeletedAt == null && j.EnteredDate >= todayStart);

                var nowMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
                var next7Ms = nowMs + 7L * 86_400_000L;
                _meetingSoonCount = await Db.Goals
                    .CountAsync(g => g.AccountFk == accountGuid && g.DeletedAt == null && g.CompletionDate == null
                                  && g.NextMeetingDate.HasValue && g.NextMeetingDate.Value > nowMs && g.NextMeetingDate.Value <= next7Ms);

                var recentDays = await Db.GoalProgresses
                    .Where(p => p.AccountFk == accountGuid && p.DeletedAt == null
                             && p.UpdatedOn >= todayStart - 60L * 86_400_000L)
                    .Select(p => p.UpdatedOn)
                    .ToListAsync();
                var activeDates = recentDays
                    .Select(ms => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime))
                    .ToHashSet();
                var streakDay = DateOnly.FromDateTime(DateTime.Today);
                if (!activeDates.Contains(streakDay)) streakDay = streakDay.AddDays(-1);
                while (activeDates.Contains(streakDay))
                {
                    _dailyStreak++;
                    streakDay = streakDay.AddDays(-1);
                }
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var saved = await JS.InvokeAsync<string?>("localStorage.getItem", "childdev_dark_mode");
                bool newDark;
                if (saved == "true") newDark = true;
                else if (saved == "false") newDark = false;
                else newDark = await JS.InvokeAsync<bool>("eval", "window.matchMedia('(prefers-color-scheme:dark)').matches");
                if (newDark != _darkMode)
                {
                    _darkMode = newDark;
                    StateHasChanged();
                }
            }
            catch { /* localStorage unavailable (e.g., SSR pre-render) */ }

            if (NickName is not null)
            {
                try
                {
                    await JS.InvokeVoidAsync("childdev.setupSearchHotkey", DotNetObjectReference.Create(this));
                }
                catch { }
            }
        }
    }

    [Microsoft.JSInterop.JSInvokable]
    public void TriggerOpenSearch()
    {
        OpenSearch();
        _helpOpen = false;
        StateHasChanged();
    }

    [Microsoft.JSInterop.JSInvokable]
    public void TriggerCloseSearch()
    {
        if (_searchOpen)
        {
            CloseSearch();
            StateHasChanged();
        }
    }

    [Microsoft.JSInterop.JSInvokable]
    public void TriggerCloseAll()
    {
        var changed = _searchOpen || _helpOpen;
        _searchOpen = false;
        _helpOpen = false;
        if (changed) StateHasChanged();
    }

    [Microsoft.JSInterop.JSInvokable]
    public void TriggerOpenHelp()
    {
        _helpOpen = true;
        _searchOpen = false;
        StateHasChanged();
    }

    private void OpenHelp() { _helpOpen = true; _searchOpen = false; }
    private void CloseHelp() => _helpOpen = false;

    private async Task ToggleDarkMode()
    {
        _darkMode = !_darkMode;
        try { await JS.InvokeVoidAsync("localStorage.setItem", "childdev_dark_mode", _darkMode ? "true" : "false"); }
        catch { }
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    private void CloseDrawer() => _drawerOpen = false;

    private void OpenSearch()
    {
        _searchOpen = true;
        _searchQuery = string.Empty;
        _searchResults.Clear();
        _searchLoading = false;
        _ = LoadRecentGoalsAsync();
    }

    private async Task LoadRecentGoalsAsync()
    {
        _recentGoals.Clear();
        var accountGuid = HttpContextAccessor.HttpContext?.Session.GetString("AccountGuid");
        if (accountGuid is null) return;
        try
        {
            var recentKey = $"childdev_recent_goals_{accountGuid}";
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", recentKey);
            if (string.IsNullOrWhiteSpace(stored)) return;
            var guids = stored.Split(',', StringSplitOptions.RemoveEmptyEntries).Take(5).ToList();
            if (guids.Count == 0) return;
            var goals = await Db.Goals
                .Where(g => guids.Contains(g.Guid) && g.AccountFk == accountGuid && g.DeletedAt == null)
                .Select(g => new { g.Guid, g.GoalText })
                .ToListAsync();
            _recentGoals = guids
                .Select(id => goals.FirstOrDefault(g => g.Guid == id))
                .Where(g => g is not null)
                .Select(g => (g!.Guid, g.GoalText ?? ""))
                .ToList();
            StateHasChanged();
        }
        catch { }
    }

    private void CloseSearch() => _searchOpen = false;

    private async Task RunSearchDebounced()
    {
        if (_searchQuery.Length < 2)
        {
            _searchResults.Clear();
            _searchLoading = false;
            StateHasChanged();
            return;
        }
        _searchLoading = true;
        StateHasChanged();

        var accountGuid = HttpContextAccessor.HttpContext?.Session.GetString("AccountGuid");
        if (accountGuid is null) { _searchLoading = false; return; }

        var q = _searchQuery.Trim();
        var results = new List<SearchResult>();

        var goals = await Db.Goals
            .Where(g => g.AccountFk == accountGuid && g.DeletedAt == null
                     && g.CompletionDate == null && g.GoalText.Contains(q))
            .Select(g => new { g.Guid, g.GoalText })
            .Take(5).ToListAsync();
        results.AddRange(goals.Select(g =>
            new SearchResult("Goals", g.GoalText, $"/goals/{g.Guid}", Icons.Material.Filled.EmojiEvents)));

        var completedGoals = await Db.Goals
            .Where(g => g.AccountFk == accountGuid && g.DeletedAt == null
                     && g.CompletionDate != null && g.GoalText != null && g.GoalText.Contains(q))
            .OrderByDescending(g => g.CompletionDate)
            .Select(g => new { g.Guid, g.GoalText })
            .Take(3).ToListAsync();
        results.AddRange(completedGoals.Select(g =>
            new SearchResult("Completed Goals", g.GoalText ?? "", $"/goals/{g.Guid}", Icons.Material.Filled.CheckCircle)));

        var todos = await Db.Todos
            .Where(t => t.AccountFk == accountGuid && t.DeletedAt == null
                     && t.CompletedAt == null && t.Title != null && t.Title.Contains(q))
            .Select(t => new { t.Guid, Title = t.Title ?? "" })
            .Take(5).ToListAsync();
        results.AddRange(todos.Select(t =>
            new SearchResult("Todos", t.Title, $"/todos?search={Uri.EscapeDataString(q)}", Icons.Material.Filled.CheckBox)));

        var journals = await Db.Journals
            .Where(j => j.AccountFk == accountGuid && j.DeletedAt == null
                     && ((j.Notes != null && j.Notes.Contains(q))
                      || (j.Tags != null && j.Tags.Contains(q))
                      || (j.Activity != null && j.Activity.Contains(q))))
            .OrderByDescending(j => j.EnteredDate)
            .Select(j => new { j.Notes, j.Tags, j.Activity })
            .Take(5).ToListAsync();
        results.AddRange(journals.Select(j =>
        {
            var notes = j.Notes ?? "";
            var preview = string.IsNullOrWhiteSpace(notes)
                ? (!string.IsNullOrWhiteSpace(j.Activity) ? $"[{j.Activity}] {j.Tags ?? ""}" : j.Tags ?? "")
                : notes.Length > 80 ? notes[..80] + "…" : notes;
            return new SearchResult("Journal", preview.Trim(), $"/journal?search={Uri.EscapeDataString(q)}", Icons.Material.Filled.Book);
        }));

        var progressNotes = await Db.GoalProgresses
            .Where(p => p.AccountFk == accountGuid && p.DeletedAt == null
                     && p.NextStepItems != null && p.NextStepItems.Contains(q))
            .OrderByDescending(p => p.UpdatedOn)
            .Select(p => new { p.GoalFk, p.NextStepItems })
            .Take(3).ToListAsync();
        var noteGoalGuids = progressNotes.Select(p => p.GoalFk).Distinct().ToList();
        var noteGoalTexts = await Db.Goals
            .Where(g => noteGoalGuids.Contains(g.Guid) && g.DeletedAt == null)
            .Select(g => new { g.Guid, g.GoalText })
            .ToListAsync();
        var noteGoalMap = noteGoalTexts.ToDictionary(g => g.Guid, g => g.GoalText ?? "");
        results.AddRange(progressNotes.Select(p =>
        {
            var snippet = (p.NextStepItems ?? "").Length > 70 ? p.NextStepItems![..70] + "…" : p.NextStepItems ?? "";
            var goalName = noteGoalMap.GetValueOrDefault(p.GoalFk, "");
            return new SearchResult("Progress Notes", $"[{goalName[..Math.Min(goalName.Length, 30)]}] {snippet}",
                $"/goals/{p.GoalFk}?noteFilter={Uri.EscapeDataString(q)}", Icons.Material.Filled.TrendingUp);
        }));

        _searchResults = results;
        _searchSelectedIdx = -1;
        _searchLoading = false;
        StateHasChanged();
        await Analytics.TrackAsync("global_search", accountGuid, "layout", $"q:{q},hits:{results.Count}");
    }

    private void NavigateSearch(string href)
    {
        CloseSearch();
        Nav.NavigateTo(href);
    }

    private void OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (_searchResults.Count == 0) return;
        if (e.Key == "ArrowDown")
        {
            _searchSelectedIdx = Math.Min(_searchSelectedIdx + 1, _searchResults.Count - 1);
            StateHasChanged();
        }
        else if (e.Key == "ArrowUp")
        {
            _searchSelectedIdx = Math.Max(_searchSelectedIdx - 1, 0);
            StateHasChanged();
        }
        else if (e.Key == "Enter" && _searchResults.Count > 0)
        {
            var idx = _searchSelectedIdx >= 0 ? _searchSelectedIdx : 0;
            NavigateSearch(_searchResults[idx].Href);
        }
    }

    private static string HighlightMatch(string text, string query)
    {
        if (string.IsNullOrEmpty(query) || query.Length < 2) return System.Net.WebUtility.HtmlEncode(text);
        var idx = text.IndexOf(query, StringComparison.OrdinalIgnoreCase);
        if (idx < 0) return System.Net.WebUtility.HtmlEncode(text);
        var before = System.Net.WebUtility.HtmlEncode(text[..idx]);
        var match = System.Net.WebUtility.HtmlEncode(text[idx..(idx + query.Length)]);
        var after = System.Net.WebUtility.HtmlEncode(text[(idx + query.Length)..]);
        return $"{before}<mark style='background:rgba(63,81,181,.18);color:inherit;border-radius:2px;padding:0 2px;'>{match}</mark>{after}";
    }

    private bool IsActive(string path)
    {
        var uri = new Uri(Nav.Uri);
        if (path == "/")
            return uri.AbsolutePath == "/" || uri.AbsolutePath.StartsWith("/goals/");
        return uri.AbsolutePath.StartsWith(path, StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose() => Db?.Dispose();
}
