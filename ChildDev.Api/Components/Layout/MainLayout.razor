@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor
@inject AppDbContext Db
@inject IJSRuntime JS
@using Microsoft.EntityFrameworkCore

<MudThemeProvider Theme="_theme" IsDarkMode="@_darkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="3" Color="Color.Primary">
        @if (NickName is not null)
        {
            <MudHidden Breakpoint="Breakpoint.MdAndUp">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                               OnClick="ToggleDrawer" />
            </MudHidden>
        }
        <MudLink Href="/" Underline="Underline.None" Color="Color.Inherit">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Style="gap:6px;">
                <MudIcon Icon="@Icons.Material.Filled.RocketLaunch" Size="Size.Small" />
                <MudText Typo="Typo.h6" Style="font-weight:700;letter-spacing:.3px;">ChildDev</MudText>
            </MudStack>
        </MudLink>
        @if (_dailyStreak >= 2)
        {
            var streakEmoji = _dailyStreak >= 14 ? "🌟" : _dailyStreak >= 7 ? "🔥" : "⚡";
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled"
                     Style="font-weight:700;font-size:0.78rem;margin-left:8px;cursor:default;"
                     title="@($"{_dailyStreak}-day streak!")">
                @streakEmoji @_dailyStreak
            </MudChip>
        }
        <MudSpacer />
        <MudIconButton Icon="@(_darkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" Size="Size.Small"
                       OnClick="ToggleDarkMode"
                       title="@(_darkMode ? "Switch to light mode" : "Switch to dark mode")" />
        @if (NickName is not null)
        {
            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                <MudBadge Content="@(_meetingSoonCount > 0 ? _meetingSoonCount.ToString() : null)"
                          Color="Color.Info" Overlap="true" Bordered="true"
                          Visible="@(_meetingSoonCount > 0)" title="@(_meetingSoonCount > 0 ? $"{_meetingSoonCount} goal meeting(s) this week" : "")">
                    <MudButton Color="Color.Inherit" Href="/"
                               StartIcon="@Icons.Material.Filled.EmojiEvents"
                               Variant="@(IsActive("/") ? Variant.Outlined : Variant.Text)">Goals</MudButton>
                </MudBadge>
                <MudBadge Content="@(_overdueTodoCount > 0 ? _overdueTodoCount.ToString() : null)"
                          Color="Color.Error" Overlap="true" Bordered="true"
                          Visible="@(_overdueTodoCount > 0)">
                    <MudButton Color="Color.Inherit" Href="/todos"
                               StartIcon="@Icons.Material.Filled.CheckBox"
                               Variant="@(IsActive("/todos") ? Variant.Outlined : Variant.Text)">Todos</MudButton>
                </MudBadge>
                <MudBadge Dot="true" Color="Color.Success" Overlap="true" Bordered="true"
                          Visible="@_hasJournalToday" title="Journaled today ✓">
                    <MudButton Color="Color.Inherit" Href="/journal"
                               StartIcon="@Icons.Material.Filled.Book"
                               Variant="@(IsActive("/journal") ? Variant.Outlined : Variant.Text)">Journal</MudButton>
                </MudBadge>
                <MudButton Color="Color.Inherit" Href="/insights"
                           StartIcon="@Icons.Material.Filled.Insights"
                           Variant="@(IsActive("/insights") ? Variant.Outlined : Variant.Text)">Insights</MudButton>
                <MudTooltip Text="Achievements">
                    <MudIconButton Color="Color.Inherit" Href="/achievements" Icon="@Icons.Material.Filled.EmojiEvents"
                                   Variant="@(IsActive("/achievements") ? Variant.Outlined : Variant.Text)"
                                   aria-label="Achievements" />
                </MudTooltip>
            </MudHidden>
            <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit"
                     Label="@NickName" EndIcon="@Icons.Material.Filled.ExpandMore"
                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                     Class="ml-1">
                <MudMenuItem Icon="@Icons.Material.Filled.Settings" Href="/settings">Settings</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Logout" Href="/logout">Log Out</MudMenuItem>
            </MudMenu>
        }
        else
        {
            <MudButton Color="Color.Inherit" Variant="Variant.Text" Href="/login">Log In</MudButton>
            <MudButton Variant="Variant.Filled" Href="/register" Class="ml-2"
                       Style="background:#FF8F00;color:#fff;font-weight:600;">Get Started</MudButton>
        }
    </MudAppBar>

    @if (NickName is not null)
    {
        <MudDrawer @bind-Open="_drawerOpen" Elevation="2" Variant="DrawerVariant.Temporary"
                   ClipMode="DrawerClipMode.Never">
            <MudDrawerHeader>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Style="gap:6px;">
                    <MudIcon Icon="@Icons.Material.Filled.RocketLaunch" Color="Color.Primary" />
                    <MudText Typo="Typo.h6" Color="Color.Primary" Style="font-weight:700;">ChildDev</MudText>
                </MudStack>
            </MudDrawerHeader>
            <MudNavMenu>
                <MudNavLink Href="/" Match="NavLinkMatch.All"
                            Icon="@Icons.Material.Filled.EmojiEvents" OnClick="CloseDrawer">Goals@(_meetingSoonCount > 0 ? $" ({_meetingSoonCount} meeting soon)" : "")</MudNavLink>
                <MudNavLink Href="/todos"
                            Icon="@Icons.Material.Filled.CheckBox" OnClick="CloseDrawer">
                    Todos@(_overdueTodoCount > 0 ? $" ({_overdueTodoCount} overdue)" : "")
                </MudNavLink>
                <MudNavLink Href="/journal"
                            Icon="@Icons.Material.Filled.Book" OnClick="CloseDrawer">Journal@(_hasJournalToday ? " ✓" : "")</MudNavLink>
                <MudNavLink Href="/insights"
                            Icon="@Icons.Material.Filled.Insights" OnClick="CloseDrawer">Insights</MudNavLink>
                <MudNavLink Href="/achievements"
                            Icon="@Icons.Material.Filled.EmojiEvents" OnClick="CloseDrawer">Achievements</MudNavLink>
                <MudDivider Class="my-2" />
                <MudNavLink Href="/settings"
                            Icon="@Icons.Material.Filled.Settings" OnClick="CloseDrawer">Settings</MudNavLink>
                <MudNavLink Href="/logout" Icon="@Icons.Material.Filled.Logout">Log Out</MudNavLink>
            </MudNavMenu>
        </MudDrawer>
    }

    <MudMainContent Class="pt-4">
        <MudContainer MaxWidth="MaxWidth.Large" Class="pb-8">
            @Body
        </MudContainer>
        <MudPaper Elevation="0" Class="mt-4 py-3" Style="background:var(--mud-palette-background-grey);border-top:1px solid var(--mud-palette-lines-default);">
            <MudContainer MaxWidth="MaxWidth.Large">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Android" Size="Size.Small" Style="color:#3DDC84;" />
                    <MudLink Href="/downloads/ChildDev.apk" Typo="Typo.caption" Color="Color.Primary"
                             Style="font-weight:600;">Download ChildDev for Android</MudLink>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">— install the mobile app</MudText>
                </MudStack>
            </MudContainer>
        </MudPaper>
    </MudMainContent>
</MudLayout>

@code {
    private string? NickName;
    private bool _drawerOpen;
    private bool _darkMode;
    private int _overdueTodoCount;
    private int _dailyStreak;
    private bool _hasJournalToday;

    private int _meetingSoonCount;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#3949AB",
            PrimaryDarken = "#283593",
            PrimaryLighten = "#7986CB",
            Secondary = "#F57C00",
            SecondaryDarken = "#E65100",
            SecondaryLighten = "#FFB74D",
            AppbarBackground = "#3949AB",
            AppbarText = "#FFFFFF",
            Success = "#43A047",
            Info = "#0288D1",
            Warning = "#F9A825",
            Error = "#E53935",
            Surface = "#FFFFFF",
            Background = "#F5F5F7",
            DrawerBackground = "#FFFFFF",
            DrawerText = "#212121",
            TextPrimary = "#212121",
            TextSecondary = "#616161",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#7986CB",
            PrimaryDarken = "#5C6BC0",
            PrimaryLighten = "#9FA8DA",
            Secondary = "#FFB74D",
            SecondaryDarken = "#FFA726",
            SecondaryLighten = "#FFD54F",
            AppbarBackground = "#1A237E",
            AppbarText = "#FFFFFF",
            Success = "#66BB6A",
            Info = "#29B6F6",
            Warning = "#FFA726",
            Error = "#EF5350",
            Surface = "#1E1E2E",
            Background = "#121220",
            DrawerBackground = "#1A1A2E",
            DrawerText = "#E8EAF6",
            TextPrimary = "#E8EAF6",
            TextSecondary = "#9FA8DA",
            ActionDefault = "#9FA8DA",
            LinesDefault = "rgba(255,255,255,0.08)",
            TableLines = "rgba(255,255,255,0.08)",
        },
        LayoutProperties = new LayoutProperties
        {
            AppbarHeight = "64px",
        }
    };

    protected override async Task OnInitializedAsync()
    {
        NickName = HttpContextAccessor.HttpContext?.Session.GetString("NickName");
        if (NickName is not null)
        {
            var accountGuid = HttpContextAccessor.HttpContext?.Session.GetString("AccountGuid");
            if (accountGuid is not null)
            {
                var todayStart = new DateTimeOffset(DateTime.SpecifyKind(DateTime.Today, DateTimeKind.Local)).ToUnixTimeMilliseconds();
                _overdueTodoCount = await Db.Todos
                    .CountAsync(t => t.AccountFk == accountGuid && t.DeletedAt == null
                                  && t.CompletedAt == null && t.DueDate.HasValue && t.DueDate < todayStart);
                _hasJournalToday = await Db.Journals
                    .AnyAsync(j => j.AccountFk == accountGuid && j.DeletedAt == null && j.EnteredDate >= todayStart);

                var nowMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
                var next7Ms = nowMs + 7L * 86_400_000L;
                _meetingSoonCount = await Db.Goals
                    .CountAsync(g => g.AccountFk == accountGuid && g.DeletedAt == null && g.CompletionDate == null
                                  && g.NextMeetingDate.HasValue && g.NextMeetingDate.Value > nowMs && g.NextMeetingDate.Value <= next7Ms);

                var recentDays = await Db.GoalProgresses
                    .Where(p => p.AccountFk == accountGuid && p.DeletedAt == null
                             && p.UpdatedOn >= todayStart - 60L * 86_400_000L)
                    .Select(p => p.UpdatedOn)
                    .ToListAsync();
                var activeDates = recentDays
                    .Select(ms => DateOnly.FromDateTime(DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime))
                    .ToHashSet();
                var streakDay = DateOnly.FromDateTime(DateTime.Today);
                if (!activeDates.Contains(streakDay)) streakDay = streakDay.AddDays(-1);
                while (activeDates.Contains(streakDay))
                {
                    _dailyStreak++;
                    streakDay = streakDay.AddDays(-1);
                }
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var saved = await JS.InvokeAsync<string?>("localStorage.getItem", "childdev_dark_mode");
                if (saved == "true" && !_darkMode)
                {
                    _darkMode = true;
                    StateHasChanged();
                }
            }
            catch { /* localStorage unavailable (e.g., SSR pre-render) */ }
        }
    }

    private async Task ToggleDarkMode()
    {
        _darkMode = !_darkMode;
        try { await JS.InvokeVoidAsync("localStorage.setItem", "childdev_dark_mode", _darkMode ? "true" : "false"); }
        catch { }
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    private void CloseDrawer() => _drawerOpen = false;

    private bool IsActive(string path)
    {
        var uri = new Uri(Nav.Uri);
        if (path == "/")
            return uri.AbsolutePath == "/" || uri.AbsolutePath.StartsWith("/goals/");
        return uri.AbsolutePath.StartsWith(path, StringComparison.OrdinalIgnoreCase);
    }
}
