<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:ChildDev.Mobile.Converters"
             x:Class="ChildDev.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:NotNullConverter x:Key="NotNullConverter" />
            <converters:DueDateLabelConverter x:Key="DueDateLabelConverter" />
            <converters:DueDateColorConverter x:Key="DueDateColorConverter" />
            <converters:EntryDateConverter x:Key="EntryDateConverter" />
            <converters:MeetingDateConverter x:Key="MeetingDateConverter" />
            <converters:ExpirationDateConverter x:Key="ExpirationDateConverter" />
            <converters:ExpirationColorConverter x:Key="ExpirationColorConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
