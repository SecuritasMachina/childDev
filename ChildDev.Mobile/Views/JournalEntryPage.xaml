<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChildDev.Mobile.Views.JournalEntryPage"
             Title="Journal Entry">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save" Command="{Binding SaveCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="Entry Date" FontSize="12" TextColor="Gray" />
            <DatePicker Date="{Binding EnteredDate}" MaximumDate="{x:Static system:DateTime.Today}"
                        xmlns:system="clr-namespace:System;assembly=netstandard" />
            <Label Text="Notes" />
            <Editor Text="{Binding Notes}" HeightRequest="150" AutoSize="TextChanges" />
            <Label Text="{Binding NotesLength, StringFormat='{0} characters'}"
                   FontSize="11" TextColor="Gray" HorizontalOptions="End" />
            <Label Text="Activity" />
            <Entry Text="{Binding Activity}" Placeholder="e.g. Reading, Drawing" />
            <Label Text="Mood" />
            <Entry Text="{Binding Mood}" Placeholder="e.g. Happy, Focused" />
            <Label Text="Tags" />
            <Entry Text="{Binding Tags}" Placeholder="comma-separated" />
            <Button Text="Delete Entry" Command="{Binding DeleteCommand}"
                    BackgroundColor="Red" TextColor="White"
                    IsVisible="{Binding IsExisting}" Margin="0,8,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
