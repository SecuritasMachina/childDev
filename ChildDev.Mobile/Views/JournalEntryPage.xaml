<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:system="clr-namespace:System;assembly=netstandard"
             x:Class="LevelUp.Views.JournalEntryPage"
             Title="Journal Entry">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save" Command="{Binding SaveCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="Entry Date" FontSize="12" TextColor="Gray" />
            <DatePicker Date="{Binding EnteredDate}" MaximumDate="{x:Static system:DateTime.Today}" />
            <Label Text="Notes" />
            <Editor Text="{Binding Notes}" HeightRequest="150" AutoSize="TextChanges" />
            <Label Text="{Binding NotesWordCount, StringFormat='{0} words'}"
                   FontSize="11" TextColor="Gray" HorizontalOptions="End" />
            <Label Text="Activity" />
            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start">
                <Button Text="📚 Reading" Command="{Binding SetActivityCommand}" CommandParameter="Reading"
                        BackgroundColor="Transparent" TextColor="#5C35D9" FontSize="12" Padding="8,4" Margin="0,0,4,4"
                        BorderColor="#C5CAE9" BorderWidth="1" CornerRadius="16" />
                <Button Text="🎨 Drawing" Command="{Binding SetActivityCommand}" CommandParameter="Drawing"
                        BackgroundColor="Transparent" TextColor="#5C35D9" FontSize="12" Padding="8,4" Margin="0,0,4,4"
                        BorderColor="#C5CAE9" BorderWidth="1" CornerRadius="16" />
                <Button Text="⚽ Sports" Command="{Binding SetActivityCommand}" CommandParameter="Sports"
                        BackgroundColor="Transparent" TextColor="#5C35D9" FontSize="12" Padding="8,4" Margin="0,0,4,4"
                        BorderColor="#C5CAE9" BorderWidth="1" CornerRadius="16" />
                <Button Text="🎵 Music" Command="{Binding SetActivityCommand}" CommandParameter="Music"
                        BackgroundColor="Transparent" TextColor="#5C35D9" FontSize="12" Padding="8,4" Margin="0,0,4,4"
                        BorderColor="#C5CAE9" BorderWidth="1" CornerRadius="16" />
                <Button Text="📝 Homework" Command="{Binding SetActivityCommand}" CommandParameter="Homework"
                        BackgroundColor="Transparent" TextColor="#5C35D9" FontSize="12" Padding="8,4" Margin="0,0,4,4"
                        BorderColor="#C5CAE9" BorderWidth="1" CornerRadius="16" />
            </FlexLayout>
            <Entry Text="{Binding Activity}" Placeholder="e.g. Reading, Drawing" />
            <Label Text="{Binding ActivityLength, StringFormat='{0} characters'}"
                   FontSize="11" TextColor="Gray" HorizontalOptions="End" />
            <Label Text="How did you feel?" />
            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start">
                <Button Text="😊 Happy" Command="{Binding SetMoodCommand}" CommandParameter="Happy"
                        BackgroundColor="Transparent" TextColor="#5C35D9" FontSize="12" Padding="8,4" Margin="0,0,4,4"
                        BorderColor="#C5CAE9" BorderWidth="1" CornerRadius="16" />
                <Button Text="😤 Focused" Command="{Binding SetMoodCommand}" CommandParameter="Focused"
                        BackgroundColor="Transparent" TextColor="#5C35D9" FontSize="12" Padding="8,4" Margin="0,0,4,4"
                        BorderColor="#C5CAE9" BorderWidth="1" CornerRadius="16" />
                <Button Text="😅 Excited" Command="{Binding SetMoodCommand}" CommandParameter="Excited"
                        BackgroundColor="Transparent" TextColor="#5C35D9" FontSize="12" Padding="8,4" Margin="0,0,4,4"
                        BorderColor="#C5CAE9" BorderWidth="1" CornerRadius="16" />
                <Button Text="😴 Tired" Command="{Binding SetMoodCommand}" CommandParameter="Tired"
                        BackgroundColor="Transparent" TextColor="#5C35D9" FontSize="12" Padding="8,4" Margin="0,0,4,4"
                        BorderColor="#C5CAE9" BorderWidth="1" CornerRadius="16" />
                <Button Text="🙁 Frustrated" Command="{Binding SetMoodCommand}" CommandParameter="Frustrated"
                        BackgroundColor="Transparent" TextColor="#5C35D9" FontSize="12" Padding="8,4" Margin="0,0,4,4"
                        BorderColor="#C5CAE9" BorderWidth="1" CornerRadius="16" />
                <Button Text="😐 Okay" Command="{Binding SetMoodCommand}" CommandParameter="Okay"
                        BackgroundColor="Transparent" TextColor="#5C35D9" FontSize="12" Padding="8,4" Margin="0,0,4,4"
                        BorderColor="#C5CAE9" BorderWidth="1" CornerRadius="16" />
            </FlexLayout>
            <Entry Text="{Binding Mood}" Placeholder="e.g. Happy, Focused" />
            <Label Text="{Binding MoodLength, StringFormat='{0} characters'}"
                   FontSize="11" TextColor="Gray" HorizontalOptions="End" />
            <Label Text="Why did you feel that way?" />
            <Editor Text="{Binding EmotionReason}" Placeholder="What made you feel that way?" HeightRequest="80" AutoSize="TextChanges" />
            <Label Text="{Binding EmotionReasonLength, StringFormat='{0} characters'}"
                   FontSize="11" TextColor="Gray" HorizontalOptions="End" />
            <Label Text="Tags" />
            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start">
                <Button Text="🏫 school" Command="{Binding ToggleTagCommand}" CommandParameter="school"
                        BackgroundColor="Transparent" TextColor="#5C35D9" FontSize="12" Padding="8,4" Margin="0,0,4,4"
                        BorderColor="#C5CAE9" BorderWidth="1" CornerRadius="16" />
                <Button Text="👨‍👩‍👧 family" Command="{Binding ToggleTagCommand}" CommandParameter="family"
                        BackgroundColor="Transparent" TextColor="#5C35D9" FontSize="12" Padding="8,4" Margin="0,0,4,4"
                        BorderColor="#C5CAE9" BorderWidth="1" CornerRadius="16" />
                <Button Text="👫 friends" Command="{Binding ToggleTagCommand}" CommandParameter="friends"
                        BackgroundColor="Transparent" TextColor="#5C35D9" FontSize="12" Padding="8,4" Margin="0,0,4,4"
                        BorderColor="#C5CAE9" BorderWidth="1" CornerRadius="16" />
                <Button Text="🎯 goals" Command="{Binding ToggleTagCommand}" CommandParameter="goals"
                        BackgroundColor="Transparent" TextColor="#5C35D9" FontSize="12" Padding="8,4" Margin="0,0,4,4"
                        BorderColor="#C5CAE9" BorderWidth="1" CornerRadius="16" />
                <Button Text="⚽ sports" Command="{Binding ToggleTagCommand}" CommandParameter="sports"
                        BackgroundColor="Transparent" TextColor="#5C35D9" FontSize="12" Padding="8,4" Margin="0,0,4,4"
                        BorderColor="#C5CAE9" BorderWidth="1" CornerRadius="16" />
                <Button Text="🎨 creative" Command="{Binding ToggleTagCommand}" CommandParameter="creative"
                        BackgroundColor="Transparent" TextColor="#5C35D9" FontSize="12" Padding="8,4" Margin="0,0,4,4"
                        BorderColor="#C5CAE9" BorderWidth="1" CornerRadius="16" />
                <Button Text="💪 health" Command="{Binding ToggleTagCommand}" CommandParameter="health"
                        BackgroundColor="Transparent" TextColor="#5C35D9" FontSize="12" Padding="8,4" Margin="0,0,4,4"
                        BorderColor="#C5CAE9" BorderWidth="1" CornerRadius="16" />
            </FlexLayout>
            <Entry Text="{Binding Tags}" Placeholder="comma-separated, or tap chips above" />
            <Label Text="{Binding TagsLength, StringFormat='{0} characters'}"
                   FontSize="11" TextColor="Gray" HorizontalOptions="End" />
            <Button Text="Delete Entry" Command="{Binding DeleteCommand}"
                    BackgroundColor="Red" TextColor="White"
                    IsVisible="{Binding IsExisting}" Margin="0,8,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
