<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LevelUp.ViewModels"
             xmlns:models="clr-namespace:LevelUp.Models"
             x:Class="LevelUp.Views.TodoListPage"
             Title="Todos">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <Label Grid.Row="0" Text="{Binding StatusMessage}" TextColor="Red"
               FontSize="13" Padding="16,8"
               IsVisible="{Binding StatusMessage, Converter={x:StaticResource StringToBoolConverter}}" />
        <Label Grid.Row="1"
               Text="{Binding OverdueTodoCount, StringFormat='{0} task(s) overdue'}"
               BackgroundColor="#FFEEEE" TextColor="Red" FontSize="12" Padding="16,6"
               IsVisible="{Binding HasOverdueTodos}" />
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Padding="16,8">
            <Entry Grid.Column="0" Placeholder="Add a task..." Text="{Binding NewTodoTitle}"
                   ReturnCommand="{Binding AddCommand}" />
            <Button Grid.Column="1" Text="Add" Command="{Binding AddCommand}" Margin="8,0,0,0" />
        </Grid>
        <SearchBar Grid.Row="3" Placeholder="Filter tasks..." Text="{Binding FilterText}" Margin="8,0,8,4" />

        <ScrollView Grid.Row="4">
            <VerticalStackLayout>
                <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
                    <CollectionView ItemsSource="{Binding Todos}">
                        <CollectionView.EmptyView>
                            <Label Text="{Binding EmptyMessage}" FontSize="18" TextColor="Gray"
                                   HorizontalOptions="Center" VerticalOptions="Center" Padding="32" />
                        </CollectionView.EmptyView>
                        <CollectionView.Footer>
                            <Label Text="{Binding EntryCountDisplay}" FontSize="11" TextColor="Gray"
                                   HorizontalOptions="Center" Padding="0,8,0,4"
                                   IsVisible="{Binding EntryCountDisplay, Converter={StaticResource StringToBoolConverter}}" />
                        </CollectionView.Footer>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Todo">
                                <SwipeView>
                                    <SwipeView.LeftItems>
                                        <SwipeItems>
                                            <SwipeItem Text="Done" BackgroundColor="Green"
                                                       Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TodoListViewModel}}, Path=CompleteCommand}"
                                                       CommandParameter="{Binding .}" />
                                        </SwipeItems>
                                    </SwipeView.LeftItems>
                                    <SwipeView.RightItems>
                                        <SwipeItems>
                                            <SwipeItem Text="Delete" BackgroundColor="Red"
                                                       Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TodoListViewModel}}, Path=DeleteCommand}"
                                                       CommandParameter="{Binding .}" />
                                        </SwipeItems>
                                    </SwipeView.RightItems>
                                    <Grid Padding="16,12">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TodoListViewModel}}, Path=OpenCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout>
                                                <Label Text="{Binding Title}" />
                                                <Label Text="{Binding Notes}" FontSize="12" TextColor="Gray"
                                                       LineBreakMode="TailTruncation" MaxLines="1"
                                                       IsVisible="{Binding Notes, Converter={x:StaticResource StringToBoolConverter}}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1"
                                                   Text="{Binding DueDate, Converter={x:StaticResource DueDateLabelConverter}}"
                                                   TextColor="{Binding DueDate, Converter={x:StaticResource DueDateColorConverter}}"
                                                   FontSize="11" VerticalOptions="Center"
                                                   IsVisible="{Binding DueDate, Converter={x:StaticResource NotNullConverter}}" />
                                        </Grid>
                                    </Grid>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>

                <!-- Completed todos section -->
                <Grid IsVisible="{Binding HasCompletedTodos}" Margin="0,8,0,0">
                    <Button Text="{Binding CompletedTodoCount, StringFormat='▸ {0} completed'}"
                            Command="{Binding ToggleCompletedCommand}"
                            BackgroundColor="Transparent" TextColor="Gray"
                            FontSize="13" HorizontalOptions="Start" Padding="16,4"
                            IsVisible="{Binding ShowCompletedTodos, Converter={StaticResource InverseBoolConverter}}" />
                    <Button Text="{Binding CompletedTodoCount, StringFormat='▾ {0} completed'}"
                            Command="{Binding ToggleCompletedCommand}"
                            BackgroundColor="Transparent" TextColor="Gray"
                            FontSize="13" HorizontalOptions="Start" Padding="16,4"
                            IsVisible="{Binding ShowCompletedTodos}" />
                </Grid>

                <CollectionView ItemsSource="{Binding CompletedTodos}"
                                IsVisible="{Binding ShowCompletedTodos}"
                                Margin="0,0,0,16">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Todo">
                            <SwipeView>
                                <SwipeView.LeftItems>
                                    <SwipeItems>
                                        <SwipeItem Text="Undo" BackgroundColor="#888"
                                                   Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TodoListViewModel}}, Path=UncompleteCommand}"
                                                   CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.LeftItems>
                                <SwipeView.RightItems>
                                    <SwipeItems>
                                        <SwipeItem Text="Delete" BackgroundColor="Red"
                                                   Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TodoListViewModel}}, Path=DeleteCommand}"
                                                   CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>
                                <Grid Padding="16,10" BackgroundColor="#F5F5F5">
                                    <Label Text="{Binding Title}" TextColor="Gray"
                                           TextDecorations="Strikethrough" FontSize="14" />
                                </Grid>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <Label Grid.Row="5" IsVisible="False" />
    </Grid>
</ContentPage>
