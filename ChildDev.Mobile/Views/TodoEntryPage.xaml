<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LevelUp.Views.TodoEntryPage"
             Title="Todo">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save" Command="{Binding SaveCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="Title" />
            <Entry Text="{Binding Title}" Placeholder="What needs to be done?" />
            <Label Text="{Binding TitleLength, StringFormat='{0} characters'}"
                   FontSize="11" TextColor="Gray" HorizontalOptions="End" />
            <!-- Link to Goal -->
            <Label Text="Link to Goal (optional)" />
            <Picker Title="Choose a goal..."
                    ItemsSource="{Binding AvailableGoals}"
                    ItemDisplayBinding="{Binding GoalText}"
                    SelectedItem="{Binding LinkedGoal}" />
            <Label Text="Notes" />
            <Editor Text="{Binding Notes}" Placeholder="Optional details..." HeightRequest="80" AutoSize="TextChanges" />
            <Label Text="{Binding NotesLength, StringFormat='{0} characters'}"
                   FontSize="11" TextColor="Gray" HorizontalOptions="End" />
            <HorizontalStackLayout Spacing="8">
                <CheckBox IsChecked="{Binding HasDueDate}" />
                <Label Text="Due Date" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start">
                <Button Text="Today" Command="{Binding SetDueTodayCommand}"
                        BackgroundColor="Transparent" TextColor="#5C35D9" FontSize="12" Padding="8,4" Margin="0,0,4,4"
                        BorderColor="#C5CAE9" BorderWidth="1" CornerRadius="16" />
                <Button Text="Tomorrow" Command="{Binding SetDueTomorrowCommand}"
                        BackgroundColor="Transparent" TextColor="#5C35D9" FontSize="12" Padding="8,4" Margin="0,0,4,4"
                        BorderColor="#C5CAE9" BorderWidth="1" CornerRadius="16" />
                <Button Text="This Week" Command="{Binding SetDueThisWeekCommand}"
                        BackgroundColor="Transparent" TextColor="#5C35D9" FontSize="12" Padding="8,4" Margin="0,0,4,4"
                        BorderColor="#C5CAE9" BorderWidth="1" CornerRadius="16" />
            </FlexLayout>
            <DatePicker Date="{Binding DueDate}" IsVisible="{Binding HasDueDate}" />
            <Button Text="Mark as Done" Command="{Binding MarkDoneCommand}"
                    BackgroundColor="Green" TextColor="White"
                    Margin="0,8,0,0">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsExisting}" Value="False">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                    <DataTrigger TargetType="Button" Binding="{Binding IsCompleted}" Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Text="Restore Task" Command="{Binding RestoreCommand}"
                    BackgroundColor="CornflowerBlue" TextColor="White"
                    IsVisible="{Binding IsCompleted}" Margin="0,4,0,0" />
            <Button Text="Delete Task" Command="{Binding DeleteCommand}"
                    BackgroundColor="Red" TextColor="White"
                    IsVisible="{Binding IsExisting}" Margin="0,4,0,0" />
            <Button Text="🔔 Set Reminder" Command="{Binding SetReminderCommand}"
                    BackgroundColor="#444" TextColor="White"
                    IsVisible="{Binding IsExisting}" Margin="0,4,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
