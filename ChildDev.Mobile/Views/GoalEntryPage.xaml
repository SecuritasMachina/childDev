<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:LevelUp.Models"
             x:Class="LevelUp.Views.GoalEntryPage"
             Title="Goal">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16" Spacing="12">
                <Grid ColumnDefinitions="*,Auto"
                      IsVisible="{Binding IsExisting}">
                    <Label Grid.Column="0" Text="{Binding EnteredDateDisplay}" FontSize="12" TextColor="Gray"
                           IsVisible="{Binding EnteredDateDisplay, Converter={StaticResource StringToBoolConverter}}" />
                    <Label Grid.Column="1" Text="{Binding TierLabel}" FontSize="12" TextColor="#5C35D9"
                           IsVisible="{Binding TierLabel, Converter={StaticResource StringToBoolConverter}}" />
                </Grid>
                <Label Text="{Binding NextTierLabel}" FontSize="11" TextColor="#7E57C2"
                       HorizontalOptions="End"
                       IsVisible="{Binding NextTierLabel, Converter={StaticResource StringToBoolConverter}}" />
                <Label Text="Goal" />
                <Editor Text="{Binding GoalText}" HeightRequest="100" AutoSize="TextChanges" />
                <Label Text="{Binding GoalTextLength, StringFormat='{0} characters'}"
                       FontSize="11" TextColor="Gray" HorizontalOptions="End" />
                <!-- Category -->
                <Label Text="Category" />
                <Picker SelectedItem="{Binding Category}" Title="Choose a category">
                    <Picker.Items>
                        <x:String>Academic</x:String>
                        <x:String>Health</x:String>
                        <x:String>Social</x:String>
                        <x:String>Creative</x:String>
                        <x:String>Hobby</x:String>
                        <x:String>Other</x:String>
                    </Picker.Items>
                </Picker>

                <!-- Progress -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <Label Grid.Column="0" Text="Progress" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding ProgressPercent, StringFormat='{0}%'}"
                           FontSize="13" TextColor="Gray" VerticalOptions="Center" />
                </Grid>
                <Slider Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" />
                <ProgressBar Progress="{Binding ProgressBarValue}" ProgressColor="#5C35D9" HeightRequest="6" />

                <!-- Pin -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <Label Grid.Column="0" Text="📌 Pin this goal to top" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding IsPinned}" />
                </Grid>

                <Label Text="Measurable Outcome" />
                <Entry Text="{Binding MeasurableOutcome}" Placeholder="How will you know it's achieved?" />
                <Label Text="{Binding MeasurableOutcomeLength, StringFormat='{0} characters'}"
                       FontSize="11" TextColor="Gray" HorizontalOptions="End" />
                <Label Text="Plan (Steps to Achieve)" />
                <Editor Text="{Binding Steps}" HeightRequest="100" AutoSize="TextChanges"
                        Placeholder="Enter each step on a new line — break your goal into small, achievable actions" />
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <Label Grid.Column="0" Text="Progress Notes" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="{Binding ProgressNotesCount, StringFormat='{0} total'}"
                           FontSize="11" TextColor="#7E57C2" VerticalOptions="Center"
                           IsVisible="{Binding IsExisting}"/>
                </Grid>
                <!-- Note templates -->
                <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start" IsVisible="{Binding IsExisting}">
                    <Button Text="🏆 Win" Command="{Binding SetNoteTemplateCommand}" CommandParameter="A win today: "
                            BackgroundColor="Transparent" TextColor="#5C35D9" FontSize="12" Padding="8,4" Margin="0,0,4,4"
                            BorderColor="#C5CAE9" BorderWidth="1" CornerRadius="16" />
                    <Button Text="⚡ Next step" Command="{Binding SetNoteTemplateCommand}" CommandParameter="Next step: "
                            BackgroundColor="Transparent" TextColor="#5C35D9" FontSize="12" Padding="8,4" Margin="0,0,4,4"
                            BorderColor="#C5CAE9" BorderWidth="1" CornerRadius="16" />
                    <Button Text="🚧 Obstacle" Command="{Binding SetNoteTemplateCommand}" CommandParameter="Obstacle: "
                            BackgroundColor="Transparent" TextColor="#5C35D9" FontSize="12" Padding="8,4" Margin="0,0,4,4"
                            BorderColor="#C5CAE9" BorderWidth="1" CornerRadius="16" />
                    <Button Text="🌱 Reflection" Command="{Binding SetNoteTemplateCommand}" CommandParameter="Reflection: "
                            BackgroundColor="Transparent" TextColor="#5C35D9" FontSize="12" Padding="8,4" Margin="0,0,4,4"
                            BorderColor="#C5CAE9" BorderWidth="1" CornerRadius="16" />
                </FlexLayout>
                <Editor Text="{Binding NextStepItems}" HeightRequest="80" AutoSize="TextChanges" />
                <Label Text="{Binding NextStepItemsLength, StringFormat='{0} characters'}"
                       FontSize="11" TextColor="Gray" HorizontalOptions="End" />
                <!-- Previous progress notes history -->
                <Label Text="Previous Notes" FontSize="13" FontAttributes="Bold"
                       IsVisible="{Binding HasProgressHistory}" Margin="0,8,0,2" />
                <CollectionView ItemsSource="{Binding ProgressHistory}"
                                IsVisible="{Binding HasProgressHistory}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:GoalProgress">
                            <VerticalStackLayout Padding="0,6" Spacing="2">
                                <Label Text="{Binding UpdatedOn, Converter={StaticResource EntryDateConverter}}"
                                       FontSize="11" TextColor="Gray" />
                                <Label Text="{Binding NextStepItems}" FontSize="12"
                                       LineBreakMode="TailTruncation" MaxLines="3" />
                                <BoxView HeightRequest="1" Color="LightGray" Opacity="0.4" Margin="0,4,0,0" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <Label Grid.Column="0" Text="Next Meeting Date" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding HasNextMeetingDate}" />
                </Grid>
                <DatePicker Date="{Binding NextMeetingDate}"
                            IsVisible="{Binding HasNextMeetingDate}" />
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <Label Grid.Column="0" Text="Target Completion Date" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding HasExpirationDate}" />
                </Grid>
                <DatePicker Date="{Binding ExpirationDate}"
                            IsVisible="{Binding HasExpirationDate}" />
                <Button Text="Mark as Complete" Command="{Binding MarkCompleteCommand}"
                        BackgroundColor="Green" TextColor="White"
                        IsVisible="{Binding IsExisting}" Margin="0,8,0,0">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsCompleted}" Value="True">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Text="Reopen Goal" Command="{Binding ReopenCommand}"
                        BackgroundColor="CornflowerBlue" TextColor="White"
                        IsVisible="{Binding IsCompleted}" Margin="0,4,0,0" />
                <Button Text="Delete Goal" Command="{Binding DeleteCommand}"
                        BackgroundColor="Red" TextColor="White"
                        IsVisible="{Binding IsExisting}" Margin="0,4,0,0" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Save button pinned above keyboard -->
        <Button Grid.Row="1"
                Text="Save Goal"
                Command="{Binding SaveCommand}"
                BackgroundColor="#5C35D9"
                TextColor="White"
                FontAttributes="Bold"
                Margin="16,8"
                CornerRadius="10" />
    </Grid>
</ContentPage>
