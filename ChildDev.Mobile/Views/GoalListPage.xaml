<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChildDev.Mobile.ViewModels"
             xmlns:models="clr-namespace:ChildDev.Mobile.Models"
             x:Class="ChildDev.Mobile.Views.GoalListPage"
             Title="Goals">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+" Command="{Binding AddCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*">
        <Label Grid.Row="0" Text="{Binding StatusMessage}" TextColor="Red"
               FontSize="13" Padding="16,8"
               IsVisible="{Binding StatusMessage, Converter={x:StaticResource StringToBoolConverter}}" />
        <SearchBar Grid.Row="1" Placeholder="Search goals..." Text="{Binding FilterText}" Margin="8,0,8,4" />
        <RefreshView Grid.Row="2" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
        <CollectionView ItemsSource="{Binding Goals}">
        <CollectionView.EmptyView>
            <Label Text="{Binding EmptyMessage}" FontSize="18" TextColor="Gray"
                   HorizontalOptions="Center" VerticalOptions="Center" Padding="32" />
        </CollectionView.EmptyView>
        <CollectionView.Footer>
            <Label Text="{Binding EntryCountDisplay}" FontSize="11" TextColor="Gray"
                   HorizontalOptions="Center" Padding="0,8,0,16"
                   IsVisible="{Binding EntryCountDisplay, Converter={StaticResource StringToBoolConverter}}" />
        </CollectionView.Footer>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:Goal">
                <SwipeView>
                    <SwipeView.RightItems>
                        <SwipeItems>
                            <SwipeItem Text="Delete" BackgroundColor="Red"
                                       Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GoalListViewModel}}, Path=DeleteCommand}"
                                       CommandParameter="{Binding .}" />
                        </SwipeItems>
                    </SwipeView.RightItems>
                    <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                        <Grid.Triggers>
                            <DataTrigger TargetType="Grid"
                                         Binding="{Binding CompletionDate, Converter={x:StaticResource NotNullConverter}}"
                                         Value="True">
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </Grid.Triggers>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GoalListViewModel}}, Path=OpenCommand}"
                                CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout>
                            <Label Text="{Binding GoalText}" LineBreakMode="TailTruncation" MaxLines="2" />
                            <Label Text="{Binding MeasurableOutcome}" FontSize="12" TextColor="Gray"
                                   LineBreakMode="TailTruncation" MaxLines="1"
                                   IsVisible="{Binding MeasurableOutcome, Converter={x:StaticResource StringToBoolConverter}}" />
                            <Label Text="{Binding NextMeetingDate, Converter={x:StaticResource MeetingDateConverter}}"
                                   TextColor="{Binding NextMeetingDate, Converter={x:StaticResource MeetingDateColorConverter}}"
                                   FontSize="11"
                                   IsVisible="{Binding NextMeetingDate, Converter={x:StaticResource NotNullConverter}}" />
                            <Label Text="{Binding ExpirationDate, Converter={x:StaticResource ExpirationDateConverter}}"
                                   TextColor="{Binding ExpirationDate, Converter={x:StaticResource ExpirationColorConverter}}"
                                   FontSize="11"
                                   IsVisible="{Binding ExpirationDate, Converter={x:StaticResource NotNullConverter}}" />
                            <Label Text="{Binding LatestNextStepItems}" FontSize="11" TextColor="Gray"
                                   LineBreakMode="TailTruncation" MaxLines="2"
                                   IsVisible="{Binding LatestNextStepItems, Converter={x:StaticResource StringToBoolConverter}}" />
                            <Label Text="{Binding LatestProgressAt, Converter={x:StaticResource ProgressStalenessConverter}}"
                                   TextColor="{Binding LatestProgressAt, Converter={x:StaticResource ProgressStalenessColorConverter}}"
                                   FontSize="10"
                                   IsVisible="{Binding LatestProgressAt, Converter={x:StaticResource NotNullConverter}}" />
                            <Label Text="No notes yet" FontSize="10" TextColor="Gray"
                                   IsVisible="{Binding ShowNoNotesYet}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="✓ Done" FontSize="11" TextColor="Green"
                               VerticalOptions="Start" Margin="8,2,0,0"
                               IsVisible="{Binding CompletionDate, Converter={x:StaticResource NotNullConverter}}" />
                    </Grid>
                </SwipeView>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
