<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LevelUp.ViewModels"
             xmlns:models="clr-namespace:LevelUp.Models"
             x:Class="LevelUp.Views.GoalListPage"
             Title="Goals">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+" Command="{Binding AddCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <Label Grid.Row="0" Text="{Binding StatusMessage}" TextColor="Red"
               FontSize="13" Padding="16,8"
               IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}" />
        <SearchBar Grid.Row="1" Placeholder="Search goals..." Text="{Binding FilterText}" Margin="8,0,8,4" />
        <!-- Category filter chips -->
        <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="8,0,8,4">
            <HorizontalStackLayout Spacing="6" Padding="2,4">
                <Button Text="All" Command="{Binding SetCategoryFilterCommand}" CommandParameter="All"
                        FontSize="12" Padding="10,4" CornerRadius="16"
                        BackgroundColor="{Binding CategoryFilter, Converter={StaticResource CategoryChipBgConverter}, ConverterParameter=All}"
                        TextColor="{Binding CategoryFilter, Converter={StaticResource CategoryChipFgConverter}, ConverterParameter=All}"
                        BorderColor="#C5CAE9" BorderWidth="1" />
                <Button Text="Academic" Command="{Binding SetCategoryFilterCommand}" CommandParameter="Academic"
                        FontSize="12" Padding="10,4" CornerRadius="16"
                        BackgroundColor="{Binding CategoryFilter, Converter={StaticResource CategoryChipBgConverter}, ConverterParameter=Academic}"
                        TextColor="{Binding CategoryFilter, Converter={StaticResource CategoryChipFgConverter}, ConverterParameter=Academic}"
                        BorderColor="#C5CAE9" BorderWidth="1" />
                <Button Text="Health" Command="{Binding SetCategoryFilterCommand}" CommandParameter="Health"
                        FontSize="12" Padding="10,4" CornerRadius="16"
                        BackgroundColor="{Binding CategoryFilter, Converter={StaticResource CategoryChipBgConverter}, ConverterParameter=Health}"
                        TextColor="{Binding CategoryFilter, Converter={StaticResource CategoryChipFgConverter}, ConverterParameter=Health}"
                        BorderColor="#C5CAE9" BorderWidth="1" />
                <Button Text="Social" Command="{Binding SetCategoryFilterCommand}" CommandParameter="Social"
                        FontSize="12" Padding="10,4" CornerRadius="16"
                        BackgroundColor="{Binding CategoryFilter, Converter={StaticResource CategoryChipBgConverter}, ConverterParameter=Social}"
                        TextColor="{Binding CategoryFilter, Converter={StaticResource CategoryChipFgConverter}, ConverterParameter=Social}"
                        BorderColor="#C5CAE9" BorderWidth="1" />
                <Button Text="Creative" Command="{Binding SetCategoryFilterCommand}" CommandParameter="Creative"
                        FontSize="12" Padding="10,4" CornerRadius="16"
                        BackgroundColor="{Binding CategoryFilter, Converter={StaticResource CategoryChipBgConverter}, ConverterParameter=Creative}"
                        TextColor="{Binding CategoryFilter, Converter={StaticResource CategoryChipFgConverter}, ConverterParameter=Creative}"
                        BorderColor="#C5CAE9" BorderWidth="1" />
                <Button Text="Hobby" Command="{Binding SetCategoryFilterCommand}" CommandParameter="Hobby"
                        FontSize="12" Padding="10,4" CornerRadius="16"
                        BackgroundColor="{Binding CategoryFilter, Converter={StaticResource CategoryChipBgConverter}, ConverterParameter=Hobby}"
                        TextColor="{Binding CategoryFilter, Converter={StaticResource CategoryChipFgConverter}, ConverterParameter=Hobby}"
                        BorderColor="#C5CAE9" BorderWidth="1" />
                <Button Text="Other" Command="{Binding SetCategoryFilterCommand}" CommandParameter="Other"
                        FontSize="12" Padding="10,4" CornerRadius="16"
                        BackgroundColor="{Binding CategoryFilter, Converter={StaticResource CategoryChipBgConverter}, ConverterParameter=Other}"
                        TextColor="{Binding CategoryFilter, Converter={StaticResource CategoryChipFgConverter}, ConverterParameter=Other}"
                        BorderColor="#C5CAE9" BorderWidth="1" />
            </HorizontalStackLayout>
        </ScrollView>
        <RefreshView Grid.Row="3" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
        <CollectionView ItemsSource="{Binding Goals}">
        <CollectionView.EmptyView>
            <Label Text="{Binding EmptyMessage}" FontSize="18" TextColor="Gray"
                   HorizontalOptions="Center" VerticalOptions="Center" Padding="32" />
        </CollectionView.EmptyView>
        <CollectionView.Header>
            <Label Text="← Swipe to pin or add a note  •  → Swipe to delete"
                   FontSize="10" TextColor="Gray" HorizontalOptions="Center"
                   Padding="0,6,0,2"
                   IsVisible="{Binding HasGoals}"/>
        </CollectionView.Header>
        <CollectionView.Footer>
            <Label Text="{Binding EntryCountDisplay}" FontSize="11" TextColor="Gray"
                   HorizontalOptions="Center" Padding="0,8,0,16"
                   IsVisible="{Binding EntryCountDisplay, Converter={StaticResource StringToBoolConverter}}" />
        </CollectionView.Footer>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:Goal">
                <SwipeView>
                    <SwipeView.LeftItems>
                        <SwipeItems>
                            <SwipeItem Text="📌 Pin" BackgroundColor="#5C35D9"
                                       Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GoalListViewModel}}, Path=TogglePinCommand}"
                                       CommandParameter="{Binding .}" />
                            <SwipeItem Text="📝 Note" BackgroundColor="#26C6A0"
                                       Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GoalListViewModel}}, Path=QuickNoteCommand}"
                                       CommandParameter="{Binding .}" />
                        </SwipeItems>
                    </SwipeView.LeftItems>
                    <SwipeView.RightItems>
                        <SwipeItems>
                            <SwipeItem Text="Delete" BackgroundColor="Red"
                                       Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GoalListViewModel}}, Path=DeleteCommand}"
                                       CommandParameter="{Binding .}" />
                        </SwipeItems>
                    </SwipeView.RightItems>
                    <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                        <Grid.Triggers>
                            <DataTrigger TargetType="Grid"
                                         Binding="{Binding CompletionDate, Converter={StaticResource NotNullConverter}}"
                                         Value="True">
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </Grid.Triggers>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GoalListViewModel}}, Path=OpenCommand}"
                                CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout>
                            <!-- Category + pin indicator row -->
                            <HorizontalStackLayout Spacing="6" Margin="0,0,0,2">
                                <Label Text="📌" FontSize="11" TextColor="#5C35D9"
                                       IsVisible="{Binding IsPinned}" />
                                <Border BackgroundColor="#EDE7F6" Padding="4,1" StrokeShape="RoundRectangle 4" StrokeThickness="0"
                                        IsVisible="{Binding Category, Converter={StaticResource StringToBoolConverter}}">
                                    <Label Text="{Binding Category}" FontSize="10" TextColor="#5C35D9" />
                                </Border>
                            </HorizontalStackLayout>
                            <Label Text="{Binding GoalText}" LineBreakMode="TailTruncation" MaxLines="2" />
                            <Label Text="{Binding MeasurableOutcome}" FontSize="12" TextColor="Gray"
                                   LineBreakMode="TailTruncation" MaxLines="1"
                                   IsVisible="{Binding MeasurableOutcome, Converter={StaticResource StringToBoolConverter}}" />
                            <!-- Progress bar -->
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0"
                                  IsVisible="{Binding ProgressPercent, Converter={StaticResource NotNullConverter}}">
                                <ProgressBar Grid.Column="0" Progress="{Binding ProgressBarValue}"
                                             ProgressColor="#5C35D9" HeightRequest="5" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding ProgressPercent, StringFormat='{0}%'}"
                                       FontSize="10" TextColor="Gray" Margin="6,0,0,0" />
                            </Grid>
                            <Label Text="{Binding NextMeetingDate, Converter={StaticResource MeetingDateConverter}}"
                                   TextColor="{Binding NextMeetingDate, Converter={StaticResource MeetingDateColorConverter}}"
                                   FontSize="11"
                                   IsVisible="{Binding NextMeetingDate, Converter={StaticResource NotNullConverter}}" />
                            <Label Text="{Binding ExpirationDate, Converter={StaticResource ExpirationDateConverter}}"
                                   TextColor="{Binding ExpirationDate, Converter={StaticResource ExpirationColorConverter}}"
                                   FontSize="11"
                                   IsVisible="{Binding ExpirationDate, Converter={StaticResource NotNullConverter}}" />
                            <Label Text="{Binding LatestNextStepItems}" FontSize="11" TextColor="Gray"
                                   LineBreakMode="TailTruncation" MaxLines="2"
                                   IsVisible="{Binding LatestNextStepItems, Converter={StaticResource StringToBoolConverter}}" />
                            <Label Text="{Binding LatestProgressAt, Converter={StaticResource ProgressStalenessConverter}}"
                                   TextColor="{Binding LatestProgressAt, Converter={StaticResource ProgressStalenessColorConverter}}"
                                   FontSize="10"
                                   IsVisible="{Binding LatestProgressAt, Converter={StaticResource NotNullConverter}}" />
                            <Label Text="No notes yet" FontSize="10" TextColor="Gray"
                                   IsVisible="{Binding ShowNoNotesYet}" />
                            <Label Text="{Binding TierLabel}" FontSize="10" TextColor="#5C35D9"
                                   IsVisible="{Binding TierLabel, Converter={StaticResource StringToBoolConverter}}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="✓ Done" FontSize="11" TextColor="Green"
                               VerticalOptions="Start" Margin="8,2,0,0"
                               IsVisible="{Binding CompletionDate, Converter={StaticResource NotNullConverter}}" />
                    </Grid>
                </SwipeView>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
