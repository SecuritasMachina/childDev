<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LevelUp.ViewModels"
             xmlns:models="clr-namespace:LevelUp.Models"
             x:Class="LevelUp.Views.JournalListPage"
             Title="Journal">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+" Command="{Binding AddCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
        <Label Grid.Row="0" Text="{Binding StatusMessage}" TextColor="Red"
               FontSize="13" Padding="16,8"
               IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}" />
        <!-- Streak badge -->
        <Border Grid.Row="1" BackgroundColor="#EDE7F6" Padding="12,8" StrokeShape="RoundRectangle 8" StrokeThickness="0"
                Margin="8,8,8,2"
                IsVisible="{Binding StreakDisplay, Converter={StaticResource StringToBoolConverter}}">
            <Label Text="{Binding StreakDisplay}" FontSize="13" FontAttributes="Bold" TextColor="#5C35D9" />
        </Border>
        <!-- Streak protection warning (only when streak active but no entry today) -->
        <Border Grid.Row="2" BackgroundColor="#FFF3E0" Padding="12,8" StrokeShape="RoundRectangle 8" StrokeThickness="0"
                Margin="8,2,8,2"
                IsVisible="{Binding HasStreakWarning}">
            <Label Text="{Binding StreakWarning}" FontSize="12" FontAttributes="Bold" TextColor="#E65100"/>
        </Border>
        <!-- Today's writing prompt (only if no entry today) -->
        <Border Grid.Row="3" BackgroundColor="#F3F0FF" Padding="12,10" StrokeShape="RoundRectangle 8" StrokeThickness="0"
                Margin="8,2,8,4">
            <Border.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding HasTodayEntry}" Value="True">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
            </Border.Triggers>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                <Label Grid.Column="0" Text="{Binding TodayPrompt, StringFormat='💡 {0}'}"
                       FontSize="12" TextColor="#5C35D9" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="🔀"
                        Command="{Binding ShufflePromptCommand}"
                        BackgroundColor="Transparent" TextColor="#5C35D9"
                        FontSize="14" Padding="6,4" CornerRadius="8" />
                <Button Grid.Column="2" Text="Write" Command="{Binding AddCommand}"
                        BackgroundColor="Transparent" TextColor="#5C35D9"
                        FontSize="12" Padding="8,4" CornerRadius="8"
                        BorderColor="#C5CAE9" BorderWidth="1" />
            </Grid>
        </Border>
        <SearchBar Grid.Row="4" Placeholder="Search entries..." Text="{Binding FilterText}" Margin="8,0,8,4" />
        <RefreshView Grid.Row="5" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
        <CollectionView ItemsSource="{Binding Journals}">
        <CollectionView.EmptyView>
            <Label Text="{Binding EmptyMessage}" FontSize="18" TextColor="Gray"
                   HorizontalOptions="Center" VerticalOptions="Center" Padding="32" />
        </CollectionView.EmptyView>
        <CollectionView.Footer>
            <Label Text="{Binding EntryCountDisplay}" FontSize="11" TextColor="Gray"
                   HorizontalOptions="Center" Padding="0,8,0,16"
                   IsVisible="{Binding EntryCountDisplay, Converter={StaticResource StringToBoolConverter}}" />
        </CollectionView.Footer>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:Journal">
                <SwipeView>
                    <SwipeView.RightItems>
                        <SwipeItems>
                            <SwipeItem Text="Delete" BackgroundColor="Red"
                                       Command="{Binding Source={RelativeSource AncestorType={x:Type vm:JournalListViewModel}}, Path=DeleteCommand}"
                                       CommandParameter="{Binding .}" />
                        </SwipeItems>
                    </SwipeView.RightItems>
                    <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:JournalListViewModel}}, Path=OpenCommand}"
                                CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout>
                            <Label Text="{Binding DisplayText}" LineBreakMode="TailTruncation" MaxLines="2" />
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding Mood}" FontSize="12" TextColor="Gray"
                                       IsVisible="{Binding Mood, Converter={StaticResource StringToBoolConverter}}" />
                                <Label Text="{Binding Activity}" FontSize="12" TextColor="CornflowerBlue"
                                       IsVisible="{Binding Activity, Converter={StaticResource StringToBoolConverter}}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="{Binding EnteredDate, Converter={StaticResource EntryDateConverter}}"
                               FontSize="11" TextColor="Gray" VerticalOptions="Start" Margin="8,2,0,0" />
                    </Grid>
                </SwipeView>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
