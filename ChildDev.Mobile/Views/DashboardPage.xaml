<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ChildDev.Mobile.Models"
             xmlns:vm="clr-namespace:ChildDev.Mobile.ViewModels"
             x:Class="ChildDev.Mobile.Views.DashboardPage"
             Title="Dashboard">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="⚙" Command="{Binding GoToSettingsCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <Label Text="{Binding Greeting}" FontSize="20" FontAttributes="Bold"
                   IsVisible="{Binding Greeting, Converter={StaticResource StringToBoolConverter}}" />
            <Label Text="{Binding SyncStatus}" FontSize="12" TextColor="Gray"
                   IsVisible="{Binding SyncStatus, Converter={StaticResource StringToBoolConverter}}" />
            <Label Text="{Binding LastSyncDisplay}" FontSize="11" TextColor="Gray"
                   IsVisible="{Binding LastSyncDisplay, Converter={StaticResource StringToBoolConverter}}" />
            <Label Text="{Binding NextGoalMeeting}" FontSize="13" TextColor="CornflowerBlue"
                   IsVisible="{Binding HasNextGoalMeeting}" />
            <Border BackgroundColor="#FFF3CD" Padding="10,6" StrokeShape="RoundRectangle 6"
                    IsVisible="{Binding HasStaleGoal}">
                <Label TextColor="#856404" FontSize="12">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="⚠ Needs attention: " FontAttributes="Bold" />
                            <Span Text="{Binding StaleGoalText}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </Border>

            <!-- Summary row -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <Border Grid.Column="0" Padding="12" StrokeShape="RoundRectangle 8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToGoalsCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout>
                        <Label Text="{Binding ActiveGoalCount}" FontSize="28" HorizontalOptions="Center" />
                        <Label Text="Goals" FontSize="12" HorizontalOptions="Center" />
                        <Label Text="Add one!" FontSize="10" TextColor="Gray"
                               HorizontalOptions="Center" IsVisible="{Binding HasNoActiveGoals}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Padding="12" StrokeShape="RoundRectangle 8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToTodosCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout>
                        <Label Text="{Binding PendingTodoCount}" FontSize="28" HorizontalOptions="Center" />
                        <Label Text="Todos" FontSize="12" HorizontalOptions="Center" />
                        <Label Text="All done!" FontSize="10" TextColor="Gray"
                               HorizontalOptions="Center" IsVisible="{Binding HasNoPendingTodos}" />
                        <Label Text="{Binding OverdueTodoCount, StringFormat='{0} overdue'}"
                               FontSize="10" TextColor="Red" HorizontalOptions="Center"
                               IsVisible="{Binding HasOverdueTodos}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Padding="12" StrokeShape="RoundRectangle 8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToJournalCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout>
                        <Label Text="{Binding JournalThisWeek}" FontSize="28" HorizontalOptions="Center" />
                        <Label Text="Journal (7d)" FontSize="12" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Recent journal entries -->
            <Label Text="Recent Journal" FontSize="18" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding RecentJournals}">
                <CollectionView.EmptyView>
                    <Label Text="No journal entries yet." TextColor="Gray" Padding="0,4" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Journal">
                        <Border Padding="12" Margin="0,4" StrokeShape="RoundRectangle 8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, Path=OpenJournalCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Notes}" LineBreakMode="TailTruncation" MaxLines="2" />
                                <Label Grid.Column="1"
                                       Text="{Binding EnteredDate, Converter={StaticResource EntryDateConverter}}"
                                       FontSize="11" TextColor="Gray" VerticalOptions="Start" Margin="8,0,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Quick journal entry -->
            <Border Padding="12" StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Quick Journal Entry" FontSize="14" FontAttributes="Bold" />
                    <Editor Text="{Binding QuickJournalText}"
                            Placeholder="What happened today? What did you observe?"
                            HeightRequest="72"
                            AutoSize="TextChanges" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Button Grid.Column="0"
                                Text="Save Entry"
                                Command="{Binding QuickAddJournalCommand}"
                                IsEnabled="{Binding QuickJournalText, Converter={StaticResource StringToBoolConverter}}" />
                        <Button Grid.Column="1"
                                Text="+ Full Entry"
                                Command="{Binding AddJournalCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}" />
                    </Grid>
                    <Label Text="✓ Saved!" FontSize="12" TextColor="Green"
                           IsVisible="{Binding QuickJournalSaved}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
