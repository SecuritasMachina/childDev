<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:LevelUp.Models"
             xmlns:vm="clr-namespace:LevelUp.ViewModels"
             x:Class="LevelUp.Views.DashboardPage"
             Title="Dashboard">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="⚙" Command="{Binding GoToSettingsCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Spacing="14">

            <!-- Hero banner -->
            <Border Margin="0" Padding="0" StrokeThickness="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#5C35D9" Offset="0"/>
                        <GradientStop Color="#3A1AB0" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <VerticalStackLayout Padding="20,24,20,20" Spacing="4">
                    <!-- Stars decoration row -->
                    <Label Text="✦  ✦  ✦  ✦  ✦"
                           FontSize="12" TextColor="#99FFDC50"
                           HorizontalOptions="Center" Margin="0,0,0,4"/>
                    <!-- Greeting -->
                    <Label Text="{Binding Greeting}"
                           FontSize="22" FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           IsVisible="{Binding Greeting, Converter={StaticResource StringToBoolConverter}}"/>
                    <!-- Overall tier badge -->
                    <Label Text="{Binding OverallTierLabel}"
                           FontSize="13" TextColor="#E0FFFFFF"
                           HorizontalOptions="Center"
                           IsVisible="{Binding OverallTierLabel, Converter={StaticResource StringToBoolConverter}}"/>
                    <!-- Streak badge -->
                    <Border BackgroundColor="#22FFFFFF" Padding="10,4" StrokeShape="RoundRectangle 20" StrokeThickness="0"
                            HorizontalOptions="Center"
                            IsVisible="{Binding StreakDisplay, Converter={StaticResource StringToBoolConverter}}">
                        <Label Text="{Binding StreakDisplay}"
                               FontSize="13" FontAttributes="Bold" TextColor="White"
                               HorizontalOptions="Center"/>
                    </Border>
                    <!-- Sync status (subtle) -->
                    <Label Text="{Binding SyncStatus}"
                           FontSize="11" TextColor="#A6FFFFFF"
                           HorizontalOptions="Center"
                           IsVisible="{Binding SyncStatus, Converter={StaticResource StringToBoolConverter}}"/>
                    <Label Text="{Binding LastSyncDisplay}"
                           FontSize="10" TextColor="#80FFFFFF"
                           HorizontalOptions="Center"
                           IsVisible="{Binding LastSyncDisplay, Converter={StaticResource StringToBoolConverter}}"/>
                    <!-- Motivational tagline when no greeting -->
                    <Label Text="🌟 Ready to make progress today?"
                           FontSize="16" TextColor="#D9FFFFFF"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           IsVisible="{Binding Greeting, Converter={StaticResource InverseBoolConverter}}"/>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Padding="16,0,16,16" Spacing="14">

                <!-- Upcoming meeting chip -->
                <Border BackgroundColor="#E8F4FD" Padding="12,8" StrokeShape="RoundRectangle 10" StrokeThickness="0"
                        IsVisible="{Binding HasNextGoalMeeting}">
                    <Label TextColor="#1565C0" FontSize="13" FontAttributes="Bold"
                           Text="{Binding NextGoalMeeting}"/>
                </Border>

                <!-- Today's Focus card -->
                <Border Padding="16,14" StrokeShape="RoundRectangle 14" StrokeThickness="0"
                        IsVisible="{Binding HasStaleGoal}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFF9C4" Offset="0"/>
                            <GradientStop Color="#FFF3E0" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🎯  Today's Focus" FontSize="12" TextColor="#E65100"
                               FontAttributes="Bold" />
                        <Label Text="{Binding StaleGoalText}" FontSize="14" TextColor="#BF360C"
                               LineBreakMode="TailTruncation" MaxLines="2" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Button Grid.Column="0" Text="+ Quick Note"
                                    Command="{Binding QuickNoteForFocusGoalCommand}"
                                    BackgroundColor="#FF9800" TextColor="White"
                                    FontSize="12" Padding="10,6" CornerRadius="8" />
                            <Button Grid.Column="1" Text="View →"
                                    Command="{Binding GoToStaleGoalCommand}"
                                    BackgroundColor="Transparent" TextColor="#E65100"
                                    FontSize="12" Padding="10,6" CornerRadius="8"
                                    BorderColor="#FFB74D" BorderWidth="1" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Colorful stat summary cards -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">

                    <!-- Goals card (purple) -->
                    <Border Grid.Column="0" Padding="12,14" StrokeShape="RoundRectangle 14" StrokeThickness="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#7C4DFF" Offset="0"/>
                                <GradientStop Color="#5C35D9" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToGoalsCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="🎯" FontSize="20" HorizontalOptions="Center"/>
                            <Label Text="{Binding ActiveGoalCount}" FontSize="30" FontAttributes="Bold"
                                   TextColor="White" HorizontalOptions="Center"/>
                            <Label Text="Goals" FontSize="11" TextColor="#CCFFFFFF"
                                   HorizontalOptions="Center"/>
                            <Label Text="Tap to add!" FontSize="9" TextColor="#99FFFFFF"
                                   HorizontalOptions="Center"
                                   IsVisible="{Binding HasNoActiveGoals}"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Todos card (coral/red) -->
                    <Border Grid.Column="1" Padding="12,14" StrokeShape="RoundRectangle 14" StrokeThickness="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF6B6B" Offset="0"/>
                                <GradientStop Color="#E53935" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToTodosCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="✅" FontSize="20" HorizontalOptions="Center"/>
                            <Label Text="{Binding PendingTodoCount}" FontSize="30" FontAttributes="Bold"
                                   TextColor="White" HorizontalOptions="Center"/>
                            <Label Text="Todos" FontSize="11" TextColor="#CCFFFFFF"
                                   HorizontalOptions="Center"/>
                            <Label Text="All done! 🎉" FontSize="9" TextColor="#B3FFFFFF"
                                   HorizontalOptions="Center"
                                   IsVisible="{Binding HasNoPendingTodos}"/>
                            <Label Text="{Binding OverdueTodoCount, StringFormat='{0} overdue!'}"
                                   FontSize="9" TextColor="#FFE0E0" HorizontalOptions="Center"
                                   IsVisible="{Binding HasOverdueTodos}"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Journal card (green/teal) -->
                    <Border Grid.Column="2" Padding="12,14" StrokeShape="RoundRectangle 14" StrokeThickness="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#26C6A0" Offset="0"/>
                                <GradientStop Color="#00897B" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToJournalCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="📓" FontSize="20" HorizontalOptions="Center"/>
                            <Label Text="{Binding JournalThisWeek}" FontSize="30" FontAttributes="Bold"
                                   TextColor="White" HorizontalOptions="Center"/>
                            <Label Text="This Week" FontSize="11" TextColor="#CCFFFFFF"
                                   HorizontalOptions="Center"/>
                            <Label Text="Journal" FontSize="9" TextColor="#99FFFFFF"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Weekly Challenge card -->
                <Border Padding="14,12" StrokeShape="RoundRectangle 14" StrokeThickness="0"
                        IsVisible="{Binding HasWeeklyChallenge}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding WeeklyChallengeDone}" Value="False">
                            <Setter Property="BackgroundColor" Value="#F3F0FF"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding WeeklyChallengeDone}" Value="True">
                            <Setter Property="BackgroundColor" Value="#E8F5E9"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{Binding WeeklyChallengeTitle}"
                                   FontSize="13" FontAttributes="Bold" TextColor="#5C35D9" />
                            <Label Grid.Column="1" Text="{Binding WeeklyChallengeStatus}"
                                   FontSize="12" FontAttributes="Bold">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding WeeklyChallengeDone}" Value="False">
                                        <Setter Property="TextColor" Value="#5C35D9"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding WeeklyChallengeDone}" Value="True">
                                        <Setter Property="TextColor" Value="#2E7D32"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>
                        <Label Text="{Binding WeeklyChallengeDesc}" FontSize="12" TextColor="#7E57C2" />
                        <ProgressBar Progress="{Binding WeeklyChallengePctValue}" ProgressColor="#5C35D9" HeightRequest="5" />
                        <Label Text="{Binding WeeklyChallengeMotivation}" FontSize="11" TextColor="Gray" />
                    </VerticalStackLayout>
                </Border>

                <!-- Weekly Wins card -->
                <Border Padding="16,14" StrokeShape="RoundRectangle 14" StrokeThickness="0"
                        IsVisible="{Binding HasWeeklyWins}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFF9C4" Offset="0"/>
                            <GradientStop Color="#FFF3E0" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🏆  This Week's Wins" FontSize="15" FontAttributes="Bold" TextColor="#E65100"/>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                                <Label Text="{Binding WeekTodosCompleted}" FontSize="24" FontAttributes="Bold"
                                       TextColor="#E65100" HorizontalOptions="Center"/>
                                <Label Text="Todos done" FontSize="10" TextColor="#BF360C" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                                <Label Text="{Binding WeekProgressNotes}" FontSize="24" FontAttributes="Bold"
                                       TextColor="#E65100" HorizontalOptions="Center"/>
                                <Label Text="Progress notes" FontSize="10" TextColor="#BF360C" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                                <Label Text="{Binding WeekJournalEntries}" FontSize="24" FontAttributes="Bold"
                                       TextColor="#E65100" HorizontalOptions="Center"/>
                                <Label Text="Journal entries" FontSize="10" TextColor="#BF360C" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Section header: Recent journal -->
                <Label Text="📖  Recent Journal" FontSize="17" FontAttributes="Bold"
                       Margin="0,6,0,0"/>

                <CollectionView ItemsSource="{Binding RecentJournals}">
                    <CollectionView.EmptyView>
                        <Border Padding="18,14" StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                BackgroundColor="#F3F0FF">
                            <Label Text="📝 No journal entries yet — write your first one below!"
                                   TextColor="#7C4DFF" FontSize="13" HorizontalTextAlignment="Center"/>
                        </Border>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Journal">
                            <Border Padding="14,10" Margin="0,4" StrokeShape="RoundRectangle 10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, Path=OpenJournalCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="📝" FontSize="18" VerticalOptions="Start" Margin="0,1,0,0"/>
                                    <Label Grid.Column="1" Text="{Binding DisplayText}"
                                           LineBreakMode="TailTruncation" MaxLines="2" FontSize="13"/>
                                    <Label Grid.Column="2"
                                           Text="{Binding EnteredDate, Converter={StaticResource EntryDateConverter}}"
                                           FontSize="11" TextColor="Gray" VerticalOptions="Start" Margin="4,2,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Quick journal entry -->
                <Border Padding="16,14" StrokeShape="RoundRectangle 14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0F26C6A0" Offset="0"/>
                            <GradientStop Color="#0826C6A0" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="✍️  Quick Journal Entry" FontSize="15" FontAttributes="Bold"/>
                        <Editor Text="{Binding QuickJournalText}"
                                Placeholder="What happened today? What did you observe?"
                                HeightRequest="72"
                                AutoSize="TextChanges"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Button Grid.Column="0"
                                    Text="💾  Save Entry"
                                    Command="{Binding QuickAddJournalCommand}"
                                    IsEnabled="{Binding QuickJournalText, Converter={StaticResource StringToBoolConverter}}"/>
                            <Button Grid.Column="1"
                                    Text="+ Full"
                                    Command="{Binding AddJournalCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}"/>
                        </Grid>
                        <Label Text="✓ Saved! Great work! 🌟" FontSize="12" TextColor="#00897B"
                               IsVisible="{Binding QuickJournalSaved}"/>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
