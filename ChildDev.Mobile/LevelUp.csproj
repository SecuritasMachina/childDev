<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks Condition="'$(SkipMauiTargets)' != 'true'">net8.0-android;net8.0</TargetFrameworks>
		<TargetFrameworks Condition="'$(SkipMauiTargets)' == 'true'">net8.0</TargetFrameworks>
		<OutputType Condition="'$(TargetFramework)' != 'net8.0'">Exe</OutputType>
		<RootNamespace>LevelUp</RootNamespace>
		<UseMaui Condition="'$(TargetFramework)' != 'net8.0'">true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>LevelUp</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>levelup.securitasmachina.org</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' != 'net8.0'">
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' != 'net8.0'">
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
		<PackageReference Include="Plugin.LocalNotification" Version="12.0.2" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' != 'net8.0'">
		<!-- Force version alignment to resolve duplicate classes in R8/D8 linker -->
		<!-- These .Ktx packages lag behind their non-Ktx counterparts via Plugin.LocalNotification transitive deps -->
		<PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.4.3.1" />
		<PackageReference Include="Xamarin.AndroidX.Activity.Ktx" Version="1.9.2.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" Version="2.8.5.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.8.5.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.8.5.1" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="sqlite-net-sqlcipher" Version="1.9.172" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
	</ItemGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<DefineConstants>$(DefineConstants);NO_MAUI</DefineConstants>
	</PropertyGroup>

	<!-- Disable R8 for Debug Android builds to avoid JAR duplicate class conflicts from transitive deps -->
	<!-- EmbedAssembliesIntoApk=true is required for sideload via `adb install`; without it, -->
	<!-- Fast Deployment APKs crash on launch (SIGABRT: "No assemblies found") -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug' AND '$(TargetFramework)' != 'net8.0'">
		<AndroidLinkMode>None</AndroidLinkMode>
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<Compile Remove="**\*.xaml.cs" />
		<MauiXaml Remove="**\*.xaml" />
		<Compile Remove="Platforms\**\*.cs" />
		<Compile Remove="MauiProgram.cs" />
		<Compile Remove="App.xaml.cs" />
		<Compile Remove="AppShell.xaml.cs" />
		<Compile Remove="MainPage.xaml.cs" />
		<Compile Remove="Converters\**\*.cs" />
		<Compile Remove="ViewModels\SetupViewModel.cs" />

	</ItemGroup>

</Project>
