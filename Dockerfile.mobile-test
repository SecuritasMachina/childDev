FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV ANDROID_HOME=/opt/android-sdk
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${ANDROID_SDK_ROOT}/cmdline-tools/latest/bin:${ANDROID_SDK_ROOT}/platform-tools:${ANDROID_SDK_ROOT}/emulator:${PATH}"

# System dependencies: Java 17 + ADB deps
RUN apt-get update && apt-get install -y \
    openjdk-17-jdk \
    wget curl unzip gosu \
    ca-certificates apt-transport-https \
    && rm -rf /var/lib/apt/lists/*

# .NET 8 SDK from Microsoft feed
RUN wget -q https://packages.microsoft.com/config/ubuntu/20.04/packages-microsoft-prod.deb -O /tmp/ms.deb \
    && dpkg -i /tmp/ms.deb \
    && rm /tmp/ms.deb \
    && apt-get update \
    && apt-get install -y dotnet-sdk-8.0 \
    && rm -rf /var/lib/apt/lists/*

# Android command-line tools
RUN mkdir -p ${ANDROID_SDK_ROOT}/cmdline-tools \
    && wget -q https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip -O /tmp/cmdtools.zip \
    && unzip -q /tmp/cmdtools.zip -d /tmp/cmdtools \
    && mv /tmp/cmdtools/cmdline-tools ${ANDROID_SDK_ROOT}/cmdline-tools/latest \
    && rm -rf /tmp/cmdtools /tmp/cmdtools.zip

# Accept licenses; install platform-tools (adb) + SDK platforms for building
RUN yes | sdkmanager --licenses > /dev/null 2>&1 || true \
    && sdkmanager \
        "platform-tools" \
        "platforms;android-34" \
        "platforms;android-29" \
        "build-tools;34.0.0"

# Create non-root user (UID 1000)
RUN groupadd -g 1000 androidtest \
    && useradd -u 1000 -g 1000 -m -s /bin/bash androidtest \
    && chown -R androidtest:androidtest ${ANDROID_SDK_ROOT}

# Install MAUI Android workload (runs as root — writes to /usr/share/dotnet)
RUN dotnet workload install maui-android --skip-sign-check

# Copy source (respects .dockerignore)
WORKDIR /src
COPY . .
RUN chown -R androidtest:androidtest /src

# Restore packages
RUN gosu androidtest dotnet restore ChildDev.Mobile.Tests/ChildDev.Mobile.Tests.csproj
RUN gosu androidtest dotnet restore ChildDev.Mobile/ChildDev.Mobile.csproj

RUN chmod +x /src/scripts/mobile-test-entrypoint.sh
ENTRYPOINT ["/src/scripts/mobile-test-entrypoint.sh"]
