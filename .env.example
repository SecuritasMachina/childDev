# Required
CHILDDEV_JWT_SECRET=change-me-to-a-long-random-secret
MARIADB_ROOT_PASSWORD=change-me-root-password
# Base64-encoded 32-byte AES key for at-rest column encryption (app fails fast if missing/invalid).
# Real value lives ONLY in ~/data/.secrets/levelUp.enckey (gitignored), identical on dev + prod hosts.
# Generate with: openssl rand -base64 32
CHILDDEV_ENC_KEY=change-me-base64-32-byte-key

# Optional (defaults shown)
CHILDDEV_DB_PASSWORD=changeme
CHILDDEV_HOST=localhost
# CHILDDEV_DB_CONNECTION=Server=mariadb;Database=childdev;User=childdev;Password=changeme;
